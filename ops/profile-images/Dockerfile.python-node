# fabro-python-node:local — sandbox profile image for the `python-node` environment
# (used by the backlog-lawncare-saas automation).
#
# Node is the base; Python comes from uv's managed downloads at runtime
# (UV_PYTHON_DOWNLOADS=true), which is why this image has no system python.
#
# Reconstructed 2026-09-14 from `docker history --no-trunc fabro-python-node:local`.
# Base is the SLIM variant: the live image is 593 MB and has no system python3,
# which is what distinguishes node:22.23.2-bookworm-slim from the full tag
# (full is ~1.76 GB and ships python 3.11.2 via buildpack-deps).
#
#   docker build -f Dockerfile.python-node -t fabro-python-node:local .

FROM node:22.23.2-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends git jq curl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && curl -LsSf https://astral.sh/uv/install.sh | sh \
  && curl -fsSL -o /tmp/gh.tgz https://github.com/cli/cli/releases/download/v2.100.0/gh_2.100.0_linux_amd64.tar.gz \
  && tar -xzf /tmp/gh.tgz -C /usr/local --strip-components=1 && rm /tmp/gh.tgz \
  && gh --version

# The astral installer puts uv in /root/.local/bin, which is not on the base PATH.
ENV PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin \
    UV_PYTHON_DOWNLOADS=true
