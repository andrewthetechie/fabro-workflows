# Sample Dockerfile for the fabro-python sandbox profile image.
#
# NOTE: This is a RECONSTRUCTED starting point, NOT the authoritative Dockerfile.
# The real profile-image Dockerfiles were not persisted on the host (see README.md).
# Adjust base/runtime versions to match your repos' .fabro/setup.sh / .fabro/ci.sh.
#
# Build and tag exactly as registered:  docker build -t fabro-python:local .

FROM python:3.12-slim

# Core tooling every profile image needs (clone + workflow CLI):
#   git    clone stage
#   jq     workflow command gates
#   gh     GitHub CLI (v2.100.0 pinned; must have repo scope at runtime)
#   bash   some command stages invoke bash
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        git ca-certificates curl jq bash; \
    rm -rf /var/lib/apt/lists/*; \
    GH_VERSION=v2.100.0; \
    curl -fsSL "https://github.com/cli/cli/releases/download/${GH_VERSION}/gh_${GH_VERSION#v}_linux_amd64.tar.gz" \
      | tar -xz -C /usr/local --strip-components=1 "gh_${GH_VERSION#v}_linux_amd64/bin/gh"; \
    gh --version

# Language toolchain for this profile (adapt per image):
#   python-node -> node + npm (+ python)
#   rust-node   -> rust / cargo
#   ts          -> node / npm / npx
# Example (uncomment for the Node-based profiles):
# RUN apt-get install -y --no-install-recommends nodejs npm

WORKDIR /workspace
CMD ["/bin/sh"]
