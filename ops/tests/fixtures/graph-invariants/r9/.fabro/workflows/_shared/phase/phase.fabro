digraph Phase {
    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]
    work [label="Work", class="work"]
    report_merged [shape=parallelogram, label="Report", timeout="5m", script="echo done"]

    mark_needs_human [shape=parallelogram, label="Label", timeout="5m", output_schema="routing",
        script="R=$(cat /tmp/fabro/needs_human_reason 2>/dev/null || echo unspecified); echo '{\"context_updates\":{\"r\":\"x\"}}'"]

    start -> work -> report_merged -> exit
    work -> mark_needs_human -> exit
}
