# Copy to ~/fabro/.env and fill in real values (chmod 600).
# The fabro server binds here.
FABRO_PORT=32276
FABRO_WEB_URL=http://<HOST>:<FABRO_PORT>

# The coder scheduler (compose service `scheduler`) both binds and publishes this.
# Optional: the compose file resolves 32280 on both sides when it is unset. It is
# one variable rather than two on purpose — a mapping that publishes a different
# port from the one the process binds points at a closed socket.
SCHEDULER_PORT=32280

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Image tag (docker-compose.yaml defaults to `nightly` when this is unset).
# Pin it. `nightly` is a moving tag, so an unpinned host upgrades itself on the
# next `docker compose pull` with no decision and no rollback plan, and a fabro
# upgrade applies SQLite migrations that the previous binary then refuses to
# start against — the downgrade is a database restore, not a tag change.
# Pinned 2026-09-15 to the last build known good against this host's database:
# nightly 0.357.x applies migration 2026091101 and then crash-loops on
# run-history activation. See ops/README.md "Upgrading the server".
FABRO_VERSION=0.354.0-nightly.0
