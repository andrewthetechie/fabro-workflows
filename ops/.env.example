# Copy to ~/fabro/.env and fill in real values (chmod 600).
# The fabro server binds here.
FABRO_PORT=32276
FABRO_WEB_URL=http://<HOST>:<FABRO_PORT>

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional image tag override (defaults to nightly in docker-compose.yaml).
# FABRO_VERSION=nightly
