# Server settings overlay — deploy to /storage/.home/settings.toml in the container.
# Replace <PLACEHOLDER> values (host addresses, provider base_url). No API keys live
# here; providers authenticate via the fabro vault / server env.

_version = 1

[cli.target]
type = "http"
url = "http://<HOST>:<FABRO_PORT>"

[run.environment]
id = "default"

[server.api]
url = "http://<HOST>:<FABRO_PORT>/api/v1"

[server.artifacts]
prefix = "artifacts"
provider = "local"

[server.artifacts.local]
root = "/storage/objects"

[server.auth]
methods = ["dev-token"]

[server.integrations.github]
strategy = "token"

[server.listen]
address = "0.0.0.0:<FABRO_PORT>"
type = "tcp"

[server.sandbox.providers.daytona]
enabled = false

[server.sandbox.providers.docker]
enabled = true

[server.sandbox.providers.local]
enabled = false

# The scheduler owns admission, so this is a backstop, not an allocator: it stops a
# runaway, it does not decide what runs. Raised from 2 to 4 on 2026-09-18 with the
# scheduler's takeover (ADR 0005). It is server state, not a workflow change, and it is
# copied out **once at startup**: edit this overlay at /storage/.home/settings.toml in
# the container and `docker compose restart fabro` — a restart that fails every
# in-flight run. Editing the overlay without restarting leaves the reported cap and the
# enforced cap disagreeing; `README.md` has the check.
[server.scheduler]
max_concurrent_runs = 4

[server.slatedb]
prefix = "slatedb"
provider = "local"

[server.slatedb.local]
root = "/storage/objects"

[server.web]
enabled = true
url = "http://<HOST>:<FABRO_PORT>"

# --- LLM catalog overlay ---
# Provider credentials live in the fabro vault, not here. There is no litellm
# provider and no `coders` model row (ADR 0007, docs/direct-providers/
# 04-retire-the-litellm-rows.md): the coders pool crossed the LiteLLM ingress
# to balance the two boxes, and every model id now resolves to a direct
# provider. An unpinned `coder_pool` (the operator's fire helpers, the
# stylesheet `default(...)`) resolves to `coders-a`, a pinned box.
#
# The server's default model for small utility calls such as generated run
# titles is the model marked `small_default = true` (long-context on `spark`),
# and `[llm.providers.spark] default_model` names that model for the provider.

# One direct provider per Local inference box (ADR 0007, docs/direct-providers/
# 01-local-boxes-direct.md). `coders-a`/`coders-b`/`long-context` resolve to a
# provider whose base_url is the box, instead of crossing the LiteLLM ingress. The
# model ids do not change; the graphs and workflow TOMLs address them by id. Replace
# <IP>/<PORT> with each box's real address.
#
# A run's `coder_pool` input selects `coders-a` or `coders-b` through the root graph's
# `model_stylesheet`, which is how the scheduler leases a whole llama.cpp box for a
# run (docs/scheduler/00-overview-and-contracts.md, findings 3 and 4).
#
# `limits`/`capabilities` were copied from the litellm rows they replace, so
# only the endpoint changed. `api_model` is the wire name the box
# reports from `/v1/models` -- the same GGUF model answers all three names.
#
# A Local box needs no provider key (`auth = { type = "none" }`). These take effect
# **without a restart** -- unlike `server.scheduler.max_concurrent_runs`, the LLM
# catalog is rebuilt by `replace_runtime_settings` on the 5s settings poll. See the
# `[server.scheduler]` note above for the one value that is not.
[llm.providers.box-a]
display_name = "Local coder A (10.10.0.29)"
base_url = "http://<IP>:8000/v1"
adapter = "openai-compatible"
codec = "openai-chat"
auth = { type = "none" }

[llm.providers.box-a.models."coders-a"]
display_name = "Local coders A (strix 10.10.0.29)"
api_model = "deepseek-v4-flash-0731-iq3-xxs"
limits = { context_tokens = 262144, max_output_tokens = 38400 }
capabilities = { text = true, tools = true, reasoning = true }

[llm.providers.box-b]
display_name = "Local coder B (10.10.0.56)"
base_url = "http://<IP>:8000/v1"
adapter = "openai-compatible"
codec = "openai-chat"
auth = { type = "none" }

[llm.providers.box-b.models."coders-b"]
display_name = "Local coders B (strix 10.10.0.56)"
api_model = "deepseek-v4-flash-0731-iq3-xxs"
limits = { context_tokens = 262144, max_output_tokens = 38400 }
capabilities = { text = true, tools = true, reasoning = true }

[llm.providers.spark]
display_name = "Local long-context (10.10.0.30)"
base_url = "http://<IP>:8888/v1"
adapter = "openai-compatible"
codec = "openai-chat"
auth = { type = "none" }
default_model = "long-context"

[llm.providers.spark.models."long-context"]
display_name = "Local long-context (spark)"
api_model = "deepseek-v4-flash-0731"
limits = { context_tokens = 1048576, max_output_tokens = 65536 }
capabilities = { text = true, tools = true, reasoning = true, response_format = { json_object = true, json_schema = true } }
# Preferred for small utility calls such as generated run titles.
small_default = true

# The hosted models now resolve to their own direct providers (ADR 0007,
# docs/direct-providers/03-hosted-models-direct.md): glm-4.7/glm-5.3 to `zai`
# and kimi-for-coding/kimi-k3 to `kimi`. Both authenticate with a bearer key
# from the fabro vault named after the provider (<PROVIDER>_API_KEY: ZAI_API_KEY
# / KIMI_API_KEY). These take effect without a restart.
#
# `zai` is a lithos BUILT-IN provider already pointed at the Coding Plan
# endpoint; the overlay only adds the glm-5.3 model row (glm-4.7 and glm-5.2 are
# built in). `high-reasoning` is a role alias on zai:glm-5.3; its kimi-k3
# overflow now lives in issue-triage's [run.model.fallbacks] (ADR 0003 reversed).
[llm.providers.zai.models."glm-5.3"]
display_name = "GLM 5.3 (z.ai coding plan)"
api_model = "glm-5.3"
aliases = ["high-reasoning"]
limits = { context_tokens = 202752, max_output_tokens = 16384 }
capabilities = { text = true, tools = true, reasoning = true }

# Kimi is Anthropic-shaped (adapter = anthropic, codec = anthropic-messages) and
# has no built-in provider pointing at the coding plan, so it is defined fully.
[llm.providers.kimi]
display_name = "Kimi (coding plan)"
base_url = "https://api.kimi.com/coding"
enabled = true
adapter = "anthropic"
codec = "anthropic-messages"
auth = { type = "bearer" }

[llm.providers.kimi.models."kimi-for-coding"]
display_name = "Kimi for Coding (coding plan)"
api_model = "kimi-for-coding"
limits = { context_tokens = 1048576, max_output_tokens = 16384 }
capabilities = { text = true, tools = true, reasoning = true }

[llm.providers.kimi.models."kimi-k3"]
display_name = "Kimi K3 (coding plan)"
api_model = "kimi-k3"
limits = { context_tokens = 262144, max_output_tokens = 16384 }
capabilities = { text = true, tools = true, reasoning = true }

# Disabling the built-in `moonshot` provider is load-bearing, not tidying.
# Fabro's built-in `moonshot` provider reads `KIMI_API_KEY` -- the same secret the
# `kimi` provider above needs. Storing that key therefore flips `moonshot` to
# `configured`, and a built-in provider precedes an overlay-defined one when both
# carry the same model id. So an unqualified `kimi-k3` resolves to `moonshot` and
# fails with `Invalid Authentication`, because a coding-plan key is not valid for
# moonshot's own endpoint. `backlog`'s `.review-frontier` class (the `spec` and
# `extra_decompose` nodes) names `kimi-k3` unqualified, and a stylesheet cannot
# qualify it: `kimi:kimi-k3` is `Unknown model`, because `provider:model` is only
# valid as a `[run.model.fallbacks]` target.
#
# Nothing here names `moonshot`, and its only other model (`kimi-k2.5`) is unused.
# Check with `fabro model test -m kimi-k3`, which must report provider `kimi`.
# `venice` carries `kimi-k3` and `glm-5.3` too, but has no key and stays
# `configured = false`, so it never competes.
[llm.providers.moonshot]
enabled = false
