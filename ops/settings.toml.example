# Server settings overlay — deploy to /storage/.home/settings.toml in the container.
# Replace <PLACEHOLDER> values (host addresses, provider base_url). No API keys live
# here; providers authenticate via the fabro vault / server env.

_version = 1

[cli.target]
type = "http"
url = "http://<HOST>:<FABRO_PORT>"

[run.environment]
id = "default"

[server.api]
url = "http://<HOST>:<FABRO_PORT>/api/v1"

[server.artifacts]
prefix = "artifacts"
provider = "local"

[server.artifacts.local]
root = "/storage/objects"

[server.auth]
methods = ["dev-token"]

[server.integrations.github]
strategy = "token"

[server.listen]
address = "0.0.0.0:<FABRO_PORT>"
type = "tcp"

[server.sandbox.providers.daytona]
enabled = false

[server.sandbox.providers.docker]
enabled = true

[server.sandbox.providers.local]
enabled = false

# The scheduler owns admission, so this is a backstop, not an allocator: it stops a
# runaway, it does not decide what runs. Raised from 2 to 4 on 2026-09-18 with the
# scheduler's takeover (ADR 0005). It is server state, not a workflow change, and it is
# copied out **once at startup**: edit this overlay at /storage/.home/settings.toml in
# the container and `docker compose restart fabro` — a restart that fails every
# in-flight run. Editing the overlay without restarting leaves the reported cap and the
# enforced cap disagreeing; `README.md` has the check.
[server.scheduler]
max_concurrent_runs = 4

[server.slatedb]
prefix = "slatedb"
provider = "local"

[server.slatedb.local]
root = "/storage/objects"

[server.web]
enabled = true
url = "http://<HOST>:<FABRO_PORT>"

# --- LLM catalog overlay (litellm proxy) ---
# Provider credentials live in the fabro vault, not here.
[llm.providers.litellm]
base_url = "https://<LITELLM_PROXY>/v1"
enabled = true
default_model = "coders"

[llm.providers.litellm.models."coders"]
display_name = "Local coders (strix x2)"
api_model = "coders"
limits = { context_tokens = 262144, max_output_tokens = 38400 }
capabilities = { text = true, tools = true, reasoning = true }

# One pinned group per box: `coders-a` is 10.10.0.29, `coders-b` is 10.10.0.56. A
# run's `coder_pool` input selects one of them through the root graph's
# `model_stylesheet`, which is how the scheduler leases a whole llama.cpp box for a
# run (docs/scheduler/00-overview-and-contracts.md, findings 3 and 4).
#
# These entries are not decoration. LiteLLM serving the name is not enough: fabro
# resolves a node's model against this catalog, and a name it does not list fails
# before any call is made -- `fabro model test -p litellm -m coders-a` answered
# `Unknown model: coders-a` while only the LiteLLM rows existed. `fabro validate`
# does not check the catalog, so validation cannot stand in for these blocks.
#
# `limits` and `capabilities` are identical to `coders` above: the same GGUF model is
# behind all three names, and only the box differs. `api_model` is the name sent to
# the proxy, so it must equal the LiteLLM `model_name`.
#
# `coders-a`/`coders-b` take effect **without a restart** -- unlike
# `server.scheduler.max_concurrent_runs`, the LLM catalog is rebuilt by
# `replace_runtime_settings` on the 5s settings poll. See the `[server.scheduler]` note
# above for the one value that is not.
[llm.providers.litellm.models."coders-a"]
display_name = "Local coders A (strix 10.10.0.29)"
api_model = "coders-a"
limits = { context_tokens = 262144, max_output_tokens = 38400 }
capabilities = { text = true, tools = true, reasoning = true }

[llm.providers.litellm.models."coders-b"]
display_name = "Local coders B (strix 10.10.0.56)"
api_model = "coders-b"
limits = { context_tokens = 262144, max_output_tokens = 38400 }
capabilities = { text = true, tools = true, reasoning = true }

[llm.providers.litellm.models."long-context"]
display_name = "Local long-context (spark)"
api_model = "long-context"
limits = { context_tokens = 1048576, max_output_tokens = 65536 }
capabilities = { text = true, tools = true, reasoning = true, response_format = { json_object = true, json_schema = true } }
# Preferred for small utility calls such as generated run titles.
small_default = true

[llm.providers.litellm.models."kimi-k3"]
display_name = "Kimi K3 (coding plan)"
api_model = "kimi-k3"
limits = { context_tokens = 262144, max_output_tokens = 16384 }
capabilities = { text = true, tools = true, reasoning = true }

[llm.providers.litellm.models."glm-5.3"]
display_name = "GLM 5.3 (z.ai coding plan)"
api_model = "glm-5.3"
limits = { context_tokens = 202752, max_output_tokens = 16384 }
capabilities = { text = true, tools = true, reasoning = true }

[llm.providers.litellm.models."glm-4.7"]
display_name = "GLM 4.7 (z.ai coding plan)"
api_model = "glm-4.7"
limits = { context_tokens = 202752, max_output_tokens = 16384 }
capabilities = { text = true, tools = true, reasoning = true }

# Role alias, not a model. Resolves to glm-5.3 in LiteLLM with kimi-k3 as overflow;
# see docs/adr/0003-high-reasoning-alias.md. Workflows ask for the role so the model
# behind it can change without a graph edit and a deploy.
[llm.providers.litellm.models."high-reasoning"]
display_name = "High reasoning (glm-5.3, kimi-k3 overflow)"
api_model = "high-reasoning"
limits = { context_tokens = 202752, max_output_tokens = 16384 }
capabilities = { text = true, tools = true, reasoning = true }

[llm.providers.litellm.models."kimi-for-coding"]
display_name = "Kimi for Coding (K2.8, coding plan)"
api_model = "kimi-for-coding"
limits = { context_tokens = 1048576, max_output_tokens = 16384 }
capabilities = { text = true, tools = true, reasoning = true }
