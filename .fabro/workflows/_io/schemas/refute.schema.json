{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "refute",
  "title": "refute — the refuter's verdict contract",
  "description": "The refuter's output for ADR 0016. Every shape check in review-merge's refute_gate first jq program becomes a rule here; the verdict itself (pass only when every criterion is met and there are no defects) is computed by refute_gate and is NOT expressible as a schema, so it stays in the gate. _io is stamped by the server and is not part of this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "criteria", "defects"],
  "properties": {
    "summary": {
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "status": { "enum": ["met", "not_met", "unverifiable"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "scenario"],
        "properties": {
          "file": { "type": "string" },
          "scenario": { "type": "string", "minLength": 1 },
          "line": { "type": "number" }
        }
      }
    }
  }
}
