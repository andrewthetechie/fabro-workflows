{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triage",
  "title": "triage — triage's verdict (task 10)",
  "description": "The triage agent's output (docs/stage-io, task 10). Encodes triage_gate's shape checks: readiness enum, conventional title, labels nameset, questions policy per readiness, non-empty question/decision. `basis` per decision for non-architecture issues is a gate check depending on issue.json and stays in the gate. _io is stamped by the server.",
  "type": "object",
  "additionalProperties": false,
  "required": ["readiness", "classification", "confidence", "title", "labels", "questions", "decisions", "summary"],
  "properties": {
    "readiness": { "enum": ["ready", "needs_info", "not_actionable"] },
    "classification": { "enum": ["bug", "enhancement", "mixed"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "title": { "type": "string", "pattern": "^(feat|fix|docs|chore|refactor|test|ci|build|perf|revert)(\\([a-z0-9 ./_-]+\\))?: .+" },
    "labels": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9:._-]+$" } },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "why"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "why": { "type": "string" },
          "recommended": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "decision"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "description": "The repository path that settles the question. triage_gate requires it non-empty unless the issue carries the architecture label, and the renderers print it." }
        }
      }
    },
    "summary": { "type": "string", "description": "One sentence for the operator." }
  }
}
