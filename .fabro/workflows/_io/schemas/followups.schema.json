{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "followups",
  "title": "followups — backlog extra_decompose outputs the follow-up tasks (task 10)",
  "description": "The backlog extra-axis decomposer's output (docs/stage-io, task 10). extra_gate checks status enum and each issue's id/title/body/files shape; the task queue logic stays in the gate. _io is stamped by the server.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "issues"],
  "properties": {
    "status": { "enum": ["issues", "no_work", "needs_human_review"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body", "files"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "files": { "type": "array", "items": { "type": "string" } },
          "covers": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
