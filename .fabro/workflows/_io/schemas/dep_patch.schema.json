{
  "$id": "dep_patch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The dependabot patch agent's output (ADR 0022 C7). The shape is checked here; the cross-field rules (blocked needs a blocker and no changes, patched needs changes at or above first_patched, and the diff against sync_base) are patch_gate's, as in plan.schema.json.",
  "properties": {
    "status": {"enum": ["patched", "blocked"]},
    "summary": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "properties": {
          "package": {"type": "string", "minLength": 1},
          "from": {"type": "string"},
          "to": {"type": "string", "minLength": 1},
          "manifest": {"type": "string", "minLength": 1},
          "direct": {"type": "boolean"},
          "parent": {"type": "string"}
        },
        "required": ["package", "from", "to", "manifest", "direct", "parent"],
        "type": "object"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "skipped"]}
        },
        "required": ["command", "result"],
        "type": "object"
      }
    },
    "major": {"type": "boolean"},
    "blocker": {"type": "string"}
  },
  "required": ["status", "summary", "changes", "verification", "major", "blocker"],
  "title": "dep_patch — the dependabot patch agent's contract (task 06)",
  "type": "object"
}
