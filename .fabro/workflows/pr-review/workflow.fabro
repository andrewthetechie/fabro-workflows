digraph PrReview {
    graph [
        goal="Rebase a pull request onto the tip of its base branch, review it on three axes, apply one round of fixes, verify CI, and squash-merge it when the review, the risk rating and CI all allow",
        // Bound the preamble: `compact` (the default) prepends every completed stage,
        // with up to 25 lines of command output each, to every agent prompt. Every
        // prompt here names its inputs by path, so the preamble carries no signal this
        // graph relies on. See backlog's graph block for the full reasoning.
        default_fidelity="truncate",
            // reasoning_effort: medium on the classes that run on `coders`, and only
            // those. Measured against the llama.cpp box itself (10.10.0.29, direct,
            // no gateway), identical prompt:
            //
            //   no parameter          875 completion tokens, 1496 reasoning chars
            //   reasoning_effort=low  678                    1436
            //   reasoning_effort=high 1208                   3042
            //
            // fabro defaults reasoning_effort to `high` and transmits it. Sandcastle's
            // config never set it, so opencode sent no parameter -- and llama.cpp does
            // honour the difference: `high` is 1.38x the tokens of the default. At the
            // box's measured 17.4 tok/s that is ~69s per turn instead of ~50s, which
            // over a 60-turn coder stage is the difference between 50 and 95 minutes.
            // `medium` is the closest fabro can get to "no parameter"; `low` undershoots
            // the model's own default.
            //
            // The hosted tiers (glm-4.7, kimi-for-coding, glm-5.3, kimi-k3) are left at
            // the default. The measurement above is specific to this local GGUF endpoint
            // and says nothing about z.ai or kimi, and the review classes are where the
            // thinking is the product rather than the overhead.
            //
            // coder_pool: the root stylesheet is the ONLY per-run model-routing lever
            // fabro offers -- node `model` attributes are literal text and `args.model`
            // loses to any explicit stylesheet assignment, but this template receives
            // `inputs`. The scheduler fires a run with `args.inputs.coder_pool =
            // "coders-a"` to lease one llama.cpp box for the whole run. `.rebase` also
            // covers the imported review-merge graph's `ci_fix_t1`, which carries
            // class="rebase" and has no stylesheet of its own.
            //
            // The `default('coders')` filter is LOAD-BEARING, and single quotes are
            // mandatory: the stylesheet renders in strict mode, so an unbound input
            // FAILS the run at compile (`422 run_compile_invalid`) rather than rendering
            // empty, and an unescaped `"` would terminate this DOT attribute string.
            // Do NOT bind `coder_pool` in `[run.inputs]` -- a bound default turns "no
            // input supplied" into one specific box, which silently sends every
            // hand-fired run there.
        model_stylesheet="
            *           { model: glm-5.3; }
            .review     { model: glm-5.3; }
            .rebase     { model: {{ inputs.coder_pool | default('coders') }}; reasoning_effort: medium; }
            .rebase-t2  { model: glm-5.3; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // ---- Input + claim ----
    // The sandbox clone is single-branch (`remote.origin.fetch` pins the target
    // branch), which makes `gh pr checkout` fail to set up tracking for the PR
    // head branch with "starting point 'origin/<head>' is not a branch". Claim
    // widens the refspec before checking out so the PR head resolves.
    // The input is interpolated exactly once, here, inside single quotes so a
    // non-numeric value reaches the `case` guard as data instead of being parsed
    // as shell syntax. Every later stage reads the validated number from
    // /tmp/fabro/pr_number.
    //
    // The imported phase builds the two renderer artefacts: `render.jq`, the report
    // program, and `render_comment.sh`, its wrapper. They moved into
    // `_shared/review-merge/` with the import in commit 54c21be and this comment
    // stayed behind claiming otherwise. The notes belong here all the same, because
    // render.jq carries no comments of its own -- a `//` inside it is a jq syntax
    // error and a `#` would have to be proved safe against the DOT parser.
    //
    // Kinds: `complete` and `needs-human` are the original two. `merged` and
    // `blocked` are the merge outcomes; `blocked` deliberately reuses the `complete`
    // heading, because an expected block is a successful review whose merge
    // correctly did not happen and a scarier heading would train the reader to
    // ignore it. `complete` stays because the fallback paths still render with it. A fifth
    // slurp, `ci_fix_result.json`, renders in every kind: the PR's code changed
    // after the reviewers looked at it, so the reader has to see that. It slurps to
    // `{}` when absent, which renders as nothing at all.
    validate_input [label="Validate input", shape=parallelogram, output_schema="routing", language="shell",
        script="PR='{{ inputs.pr_number }}'
# mkdir first: this node is the first to run, and /tmp/fabro is not guaranteed to
# exist yet. Writing the switch files below before the directory exists aborts the
# node on a redirection error, with nothing reported.
mkdir -p /tmp/fabro /tmp/fabro/review /tmp/fabro/feedback
case \"$PR\" in '' | *[!0-9]*) echo 'pr_number must be a positive integer' >&2; exit 1;; esac
if [ \"$PR\" -lt 1 ]; then echo 'pr_number must be a positive integer' >&2; exit 1; fi
AM='{{ inputs.auto_merge }}'
case \"$AM\" in 1) ;; *) AM=0 ;; esac
# The per-repo switch only. The host-wide switch, and the combination of the two,
# moved into the imported review-merge phase, which owns the merge decision.
echo \"$AM\" > /tmp/fabro/auto_merge_repo
echo \"$PR\" > /tmp/fabro/pr_number
echo 0 > /tmp/fabro/rebase_attempts
echo 0 > /tmp/fabro/fix_attempts
echo 0 > /tmp/fabro/recheck_done
echo '{\"context_updates\":{\"pr_number\":'$PR'}}'"]

    claim [label="Fetch and check out the PR", shape=parallelogram, output_schema="routing",
        script="set -e
PR=$(cat /tmp/fabro/pr_number)
if ! gh pr view $PR --json number,title,body,url,state,isCrossRepository,headRefName,baseRefName,headRefOid,labels,closingIssuesReferences > /tmp/fabro/pr.json; then
  echo 'Could not read PR '$PR' from GitHub.' > /tmp/fabro/needs_human_reason
  exit 1
fi
gh label create ai-review-complete --color 0E8A16 2>/dev/null || true
gh label create ai-review-needs-human --color D93F0B 2>/dev/null || true
S=$(jq -r .state /tmp/fabro/pr.json)
if [ \"$S\" != OPEN ]; then
  echo 'PR '$PR' is '$S', not OPEN. There is nothing to review.' > /tmp/fabro/needs_human_reason
  exit 1
fi
if [ \"$(jq -r .isCrossRepository /tmp/fabro/pr.json)\" = true ]; then
  echo 'PR '$PR' is from a fork. Delivery pushes to origin, which would create a branch in the base repository instead of updating this PR, so cross-repository PRs are refused.' > /tmp/fabro/needs_human_reason
  exit 1
fi
if [ \"$(git rev-parse --is-shallow-repository)\" = true ]; then
  if ! git fetch --unshallow origin; then
    echo 'Could not deepen the shallow clone. Rebasing and the three-dot review diff both need the true merge base, so this run cannot continue safely.' > /tmp/fabro/needs_human_reason
    exit 1
  fi
fi
jq -r .url /tmp/fabro/pr.json > /tmp/fabro/pr_url
jq -r .baseRefName /tmp/fabro/pr.json > /tmp/fabro/base_ref
jq -r .headRefName /tmp/fabro/pr.json > /tmp/fabro/head_ref
jq '[.closingIssuesReferences[]?]' /tmp/fabro/pr.json > /tmp/fabro/linked_issues.json
git config remote.origin.fetch \"+refs/heads/*:refs/remotes/origin/*\"
if ! gh pr checkout $PR; then
  echo 'Could not check out PR '$PR'.' > /tmp/fabro/needs_human_reason
  exit 1
fi
git rev-parse HEAD > /tmp/fabro/run_base_sha
B=$(cat /tmp/fabro/base_ref)
echo '{\"context_updates\":{\"base_ref\":\"'$B'\"}}'"]

    // ---- Rebase ladder ----
    rebase_check [label="Rebase onto base tip", shape=parallelogram, timeout="10m", output_schema="routing",
        script="B=$(cat /tmp/fabro/base_ref)
rm -f /tmp/fabro/rebase_result.json
git fetch origin \"$B\"
git rev-parse HEAD > /tmp/fabro/pre_rebase_sha
git rev-parse origin/\"$B\" > /tmp/fabro/target_sha
if git merge-base --is-ancestor origin/\"$B\" HEAD; then
  echo '{\"context_updates\":{\"rebase_state\":\"not_needed\"}}'
  exit 0
fi
if git rebase origin/\"$B\"; then
  echo '{\"context_updates\":{\"rebase_state\":\"clean\"}}'
  exit 0
fi
if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; then
  git rebase --abort || true
  echo '{\"context_updates\":{\"rebase_state\":\"conflict\"}}'
else
  git rebase --abort 2>/dev/null || true
  echo 'Plain git rebase failed for a non-conflict reason; a model cannot fix this.' > /tmp/fabro/needs_human_reason
  echo '{\"context_updates\":{\"rebase_state\":\"broken\"}}'
fi"]

    // `max_retries=1` on every agent node here, for the reason recorded at length on
    // `backlog`'s `decompose`: a provider stream that stalls without erroring reaches
    // neither the LLM retry nor the model fallback chain, so the node timeout is the
    // only backstop, and it classifies `transient_infra` with `default_max_retries` at 0.
    // Every one of these nodes routes to `mark_needs_human` on failure, so without a
    // retry a single stall ends the review and labels the PR for a human.
    rebase_agent_t1 [label="Resolve rebase (tier 1: coders)", class="rebase", timeout="30m", max_retries=1, prompt="@prompts/rebase.md.j2"]
    rebase_agent_t2 [label="Resolve rebase (tier 2: glm-5.3)", class="rebase-t2", timeout="30m", max_retries=1, prompt="@prompts/rebase.md.j2"]

    // The conflict-marker scan covers exactly the files the rebase can have
    // touched — the three-dot changed set plus anything left untracked, which
    // the next checkpoint would `git add -A`. Scanning the whole worktree
    // instead would walk build output and would fire on any repository that
    // legitimately commits a conflict-marker fixture.
    // Recovery is `git reset --hard` plus `git clean -fd`: reset alone leaves
    // untracked files behind, so a marker-bearing file the agent created would
    // survive into the next tier and fail it for the previous tier's mistake.
    // `-fd` and never `-fdx`: ignored paths are the build caches
    // (`target/`, `node_modules/`, `.venv/`) that a later `validate` needs.
    rebase_gate [label="Verify the rebase", shape=parallelogram, output_schema="routing",
        script="B=$(cat /tmp/fabro/base_ref)
A=$(cat /tmp/fabro/rebase_attempts 2>/dev/null || echo 0)
BAD=0
if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; then BAD=1; fi
if git diff --name-only --diff-filter=U | grep -q . ; then BAD=1; fi
git diff --name-only origin/\"$B\"...HEAD > /tmp/fabro/rebase_scan.txt 2>/dev/null || true
git ls-files --others --exclude-standard >> /tmp/fabro/rebase_scan.txt 2>/dev/null || true
while IFS= read -r f; do
  [ -f \"$f\" ] || continue
  if grep -qI '<<<<<<< ' \"$f\"; then BAD=1; fi
done < /tmp/fabro/rebase_scan.txt
if ! git merge-base --is-ancestor origin/\"$B\" HEAD; then BAD=1; fi
if [ $BAD -ne 0 ]; then
  git rebase --abort 2>/dev/null || true
  git reset --hard $(cat /tmp/fabro/pre_rebase_sha) || true
  git clean -fd || true
  A=$((A+1))
  echo $A > /tmp/fabro/rebase_attempts
  echo 'The rebase agent left conflict markers, an in-progress rebase, or a branch still not based on the target.' > /tmp/fabro/needs_human_reason
  echo '{\"context_updates\":{\"rebase_ok\":false,\"rebase_attempts\":'$A'}}'
else
  echo '{\"context_updates\":{\"rebase_ok\":true,\"rebase_attempts\":'$A'}}'
fi"]

    // ---- Review and merge ----
    // Imported, not defined here. `backlog` imports the same file after it opens its
    // PR, so this logic has exactly one copy rather than two that drift. Entry and
    // exit contracts are documented at the top of
    // ../_shared/review-merge/review-merge.fabro; `claim` above satisfies the entry
    // contract and `validate_input` supplies auto_merge_repo.
    review_merge [import="../_shared/review-merge/review-merge.fabro"]

    // Terminal for failures BEFORE the import. The imported phase owns its own
    // reporting and cannot be entered partway, so this graph keeps its own terminal.
    // It cannot use render_comment.sh -- that is written inside the import, which has
    // not run yet -- so it posts a plain comment.
    entry_failed [label="Label needs-human", shape=parallelogram,
        script="PR=$(cat /tmp/fabro/pr_number 2>/dev/null || echo '')
R=$(cat /tmp/fabro/needs_human_reason 2>/dev/null || echo 'The review could not start.')
if [ -z \"$PR\" ]; then echo 'no PR number recorded; nothing to label' >&2; exit 0; fi
gh pr edit $PR --add-label ai-review-needs-human || echo 'WARNING: could not add the ai-review-needs-human label.' >&2
{ echo 'Automated review could not start.'; echo; echo 'Reason: '\"$R\"; } > /tmp/fabro/entry_failed.md
gh pr comment $PR --body-file /tmp/fabro/entry_failed.md || echo 'WARNING: could not post the comment.' >&2
echo done"]

    // ---- Edges ----
    start -> validate_input
    validate_input -> claim            [condition="outcome=succeeded"]
    validate_input -> exit

    claim -> rebase_check              [condition="outcome=succeeded"]
    claim -> entry_failed

    rebase_check -> review_merge       [condition="context.rebase_state=not_needed || context.rebase_state=clean"]
    rebase_check -> rebase_agent_t1    [condition="context.rebase_state=conflict"]
    rebase_check -> entry_failed

    rebase_agent_t1 -> rebase_gate     [condition="outcome=succeeded"]
    rebase_agent_t1 -> rebase_gate
    rebase_agent_t2 -> rebase_gate     [condition="outcome=succeeded"]
    rebase_agent_t2 -> rebase_gate

    rebase_gate -> review_merge        [condition="context.rebase_ok=true", weight=10]
    rebase_gate -> rebase_agent_t2     [condition="context.rebase_ok=false && context.rebase_attempts=1"]
    rebase_gate -> entry_failed

    // The import reports every outcome on the PR before it exits, so all of them are
    // a finished run here.
    review_merge -> exit
    entry_failed -> exit
}
