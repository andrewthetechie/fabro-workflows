// issue-sharpen (issue-sharpening, ADR 0033): a local model rewrites the acceptance criteria of
// one `unverifiable` issue so the Refuter can mark each one, and the factory applies the rewrite
// with no human approval. The safety is three things instead of a person: a closed list of
// transformations, a mechanical preservation gate (`draft_gate`), and a fresh three-lens audit
// that must come back clean before anything is written to the issue.
//
// It is a **leased run**, not a background run. The scheduler gives it a coder pool the way an
// issue run gets one (`target_kind = 'sharpen'`), so it carries `box-claim` like `ralph` and
// no `box-guard`, and every agent stage runs on the lease's box through its `-bg` model row
// (`model_pool`, D1). There is no hosted model and no fallback (R17).
//
// **Nothing writes to GitHub before `apply`** (task 03). A run that stops anywhere earlier, or
// that ends `capped`, `churn` or `cannot_sharpen`, leaves the issue as it was, and the issue
// runs as written.
//
// A failed node takes its unconditional edge to `record`, which records `outcome=failed` and
// always exits 0. The scheduler reads the record from the run's own events (C11).
digraph IssueSharpen {
    graph [
        goal="Rewrite the acceptance criteria of one unverifiable issue so the Refuter can mark each one, using only a closed list of transformations and changing nothing else",
        // Above every node timeout below, `recheck`'s 40m included (R2): the watchdog must never
        // fire before a node's own timeout does, and `box-claim`'s wait counts toward it.
        stall_timeout="60m",
        // A round loops through command nodes (`draft_gate`, `audit_gate`), so R1 wants the
        // breaker at its floor or above. 20 is the floor: the loop runs at most three rounds
        // (D8), each a handful of stages, so 20 repeats of one failure signature cannot be
        // reached by a healthy run, and the breaker still stops a run that loops on a fault.
        loop_restart_signature_limit=20,
        // Bound the preamble: every prompt names its inputs by path (invariants-graph, the
        // `default_fidelity` row).
        default_fidelity="truncate",
        // Every model here is the run's `-bg` row (`model_pool`, R17): the `*` rule and the
        // two classes name the same pool, so an agent node that lost its class would still run
        // on the box and never reach a hosted model. `.preserve` runs at `high` because a miss
        // there is a weakened requirement (D22).
        model_stylesheet="
            *         { model: {{ inputs.model_pool | default('coders-a-bg') }}; reasoning_effort: medium; }
            .sharpen  { model: {{ inputs.model_pool | default('coders-a-bg') }}; reasoning_effort: medium; }
            .preserve { model: {{ inputs.model_pool | default('coders-a-bg') }}; reasoning_effort: high; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // ---- Read the issue and decide whether to sharpen it ----
    //
    // `issue_number` and `coder_pool` arrive from the scheduler's lease. `issue_number` is
    // interpolated exactly once, in single quotes, so a non-numeric value reaches the `case`
    // guard as data rather than as shell syntax. `coder_pool` is the lease's pool as it is
    // (`coders-b`, never `-bg`), and `/tmp/fabro/box` is `box-claim`'s way to learn which box
    // this run holds (R15's half of the contract, R17).
    //
    // `body_hash` is the precheck's: the first 12 hex characters of the SHA-256 of the title, a
    // newline and the body. The run goes on only when the newest precheck marker says
    // `unverifiable` for exactly this text, and no `fabro:sharpen` marker names this text as the
    // original (`body=`) or as a result (`applied=`): one sharpening per original body (D15).
    // Any other state is a quiet stop with outcome `not_needed`, which the scheduler records.
    claim [label="Read the issue", shape=parallelogram, output_schema="routing", timeout="5m",
        script="set -e
S=/tmp/fabro/sharpen
POOL='{{ inputs.coder_pool }}'
echo \"$POOL\" > /tmp/fabro/box || true
N='{{ inputs.issue_number }}'
case \"$N\" in '' | *[!0-9]*) echo 'issue_number must be a positive integer' >&2; exit 1;; esac
if [ \"$N\" -lt 1 ]; then echo 'issue_number must be a positive integer' >&2; exit 1; fi
rm -rf $S
mkdir -p $S
echo \"$N\" > $S/issue_number
if ! gh issue view \"$N\" --json number,title,body,state,url,labels > $S/issue.json; then
  echo 'Could not read issue '$N' from GitHub.' >&2
  exit 1
fi
R=$(jq -r '(.url // \"\") | split(\"/\") | .[3] + \"/\" + .[4]' $S/issue.json)
echo \"$R\" > $S/repo
if ! gh api \"repos/$R/issues/$N/comments?per_page=100\" --paginate > $S/comments.raw; then
  echo 'Could not read the comments on issue '$N'.' >&2
  exit 1
fi
jq -s 'add // []' $S/comments.raw > $S/comments.json
if command -v sha256sum >/dev/null; then SUM=sha256sum; else SUM='shasum -a 256'; fi
{ jq -j '.title // \"\"' $S/issue.json; echo; jq -j '.body // \"\"' $S/issue.json; } | $SUM | cut -c1-12 > $S/body_hash
HASH=$(cat $S/body_hash)
GO=true
WHY=eligible
ST=$(jq -r .state $S/issue.json)
if [ \"$ST\" != OPEN ]; then GO=false; WHY='the issue is '$ST', not OPEN'
elif ! jq -e 'any((.labels // [])[]; .name == \"agent\")' $S/issue.json >/dev/null; then GO=false; WHY='the issue does not carry the agent label'
elif jq -e 'any((.labels // [])[]; .name == \"agent-in-progress\")' $S/issue.json >/dev/null; then GO=false; WHY='the issue carries agent-in-progress: a run has it'
elif ! jq -e --arg h \"<!-- fabro:precheck verdict=unverifiable body=$HASH \" '[.[] | (.body // \"\") | select(startswith(\"<!-- fabro:precheck \"))] | (last // \"\") | startswith($h)' $S/comments.json >/dev/null; then GO=false; WHY='the newest precheck is not unverifiable for this text of the issue (body='$HASH')'
elif jq -e --arg a \"body=$HASH \" --arg b \"applied=$HASH \" 'any(.[]; ((.body // \"\") | startswith(\"<!-- fabro:sharpen \")) and (((.body // \"\") | split([10] | implode) | .[0]) as $m | ($m | contains($a)) or ($m | contains($b))))' $S/comments.json >/dev/null; then GO=false; WHY='this text of the issue was already sharpened or is the result of a sharpening (body='$HASH')'
fi
if [ \"$GO\" != true ]; then
  echo 'issue-sharpen: not sharpening issue '$N': '$WHY >&2
  echo not_needed > $S/outcome
  printf '%s' \"$WHY\" > $S/rule
  echo '{\"context_updates\":{\"sharpen_go\":false}}'
  exit 0
fi
echo '{\"context_updates\":{\"sharpen_go\":true}}'"]

    // ---- Stage the inputs ----
    //
    // `criteria.md` numbers the original `## Acceptance criteria` bullets AC1..ACn, which is how
    // the draft's change rows and the gate name a criterion. An issue with no such heading, no
    // bullets or no `.fabro/ci.sh` is a quiet stop: the closed list has nothing to act on.
    // The code index and the agent guide are installed exactly as `issue-precheck`'s `prep`
    // does it (this is not an R10 copy: the staging paths differ), and the one file the
    // draft reads that is not the issue's own, `rules.md`, is the USER-GUIDE's rules
    // written out from `prompts/rules.md` (a gate test keeps the two equal).
    prep [label="Stage the draft's inputs", shape=parallelogram, output_schema="routing", timeout="15m",
        script="set -e
S=/tmp/fabro/sharpen
cat > $S/lib.jq <<'JQ'
def nl: [10] | implode;
def clean: sub(\"[[:space:]]+$\"; \"\");
def blines: (. // \"\") | split(nl) | map(clean);
def trimblank: reverse | until(length == 0 or .[0] != \"\"; .[1:]) | reverse;
def sections: reduce .[] as $x ([{h: \"\", l: []}]; if ($x | test(\"^## \")) then . + [{h: $x, l: []}] else .[-1].l += [$x] end) | map(.l |= trimblank);
def parse_ac: reduce .[] as $x ({b: [], o: [], bul: false}; if ($x | test(\"^[-*] \")) then .b += [[$x]] | .bul = true elif .bul and ($x | test(\"^[[:space:]]+[^[:space:]]\")) then .b[-1] += [$x] elif $x == \"\" then .bul = false else .o += [$x] | .bul = false end);
def btext: (.[0] | sub(\"^[-*] ([[][ xX][]] )?\"; \"\")) as $f | ([$f] + .[1:]) | join(nl);
def ac_of: ([.[] | select(.h == \"## Acceptance criteria\")] | first) as $s | if $s == null then null else ($s.l | parse_ac) end;
JQ
stop() {
  echo not_needed > $S/outcome
  printf '%s' \"$1\" > $S/rule
  echo 'issue-sharpen: not sharpening: '\"$1\" >&2
  echo '{\"context_updates\":{\"prep_ok\":false}}'
  exit 0
}
if [ ! -f .fabro/ci.sh ]; then stop 'no .fabro/ci.sh'; fi
CNT=$(jq -L $S 'include \"lib\"; (.body | blines | sections | ac_of) | if . == null then -1 else (.b | length) end' $S/issue.json)
if [ \"$CNT\" -lt 0 ]; then stop 'no acceptance criteria heading'; fi
if [ \"$CNT\" -eq 0 ]; then stop 'no acceptance criteria bullets'; fi
jq -r -L $S 'include \"lib\"; (.body | blines | sections | ac_of).b | to_entries[] | \"AC\" + ((.key + 1) | tostring) + \". \" + (.value | btext)' $S/issue.json > $S/criteria.md
N=$(cat $S/issue_number)
{
  echo '# #'$N': '\"$(jq -r '.title // \"\"' $S/issue.json)\"
  echo
  echo 'Labels: '\"$(jq -r '[(.labels // [])[].name] | join(\", \")' $S/issue.json)\"
  echo
  jq -r '.body // \"\"' $S/issue.json
  echo
  echo '## Comments, oldest first (the last ten; fabro marker comments left out)'
  echo
  jq -r '[.[] | select((.body // \"\") | startswith(\"<!-- fabro:\") | not)] | .[-10:] | .[] | (\"### \" + (.user.login // \"?\") + \" at \" + (.created_at // \"?\")), \"\", ((.body // \"\") | .[0:2000]), \"\"' $S/comments.json
} > $S/issue.md
jq -r '[.[] | (.body // \"\") | select(startswith(\"<!-- fabro:precheck \"))] | last // \"\"' $S/comments.json > $S/precheck.md
cut -c3- > $S/rules.md <<'RULES'
> ### Writing criteria the factory can verify
> 
> A PR merges on its own only when the Refuter can mark every acceptance criterion
> `met` from the code, the diff and `.fabro/ci.sh`'s run. A criterion it cannot check
> holds the PR for you however good the code is: in the two weeks to 2026-11-01, 70
> of the 85 agent PRs with an unmet criterion were held by one of the first two
> cases below (#57). Skipping triage means nothing rewrites these for you, so apply
> the rules yourself (the precheck's `unverifiable` comment flags a miss before the
> run):
> 
> 1. **No criterion needs text in the PR description.** No stage after `open_pr`
>    writes the PR body, and the Refuter often runs before the PR exists.
>    - \"The PR explains why X is unreachable\" → \"a code comment at the line says
>      why X is unreachable\".
>    - \"The uncovered remainder is listed in the PR\" → the same code-comment form,
>      or drop it.
>    - \"The PR lists before/after coverage\" → drop it. Keep the before numbers in
>      the issue as context; the after numbers are in GitHub CI's coverage summary.
> 2. **A command criterion names only a command `.fabro/ci.sh` runs.** Read the
>    repository's `ci.sh` first. Otherwise name a state the Refuter can read from
>    the diff.
> 3. **\"Coverage must not drop\" becomes a raised threshold:** \"`coverage.thresholds`
>    in `<config>` (or `fail_under`) is raised to the new totals, rounded down\".
>    `ci.sh` enforces the threshold, and the Refuter verifies the raise in the diff.
>    It also ratchets coverage, which is what the criterion was for.
> 4. **A check only a human can make after merge goes under `## Post-deploy
>    checks`.** The pipeline cuts that heading from the Refuter's input and lists
>    it in the PR body for you.
> 
> A change to a file under `.github/workflows/` cannot be the agent's work at all:
> its token cannot push one, so the run stops before opening a PR. Make that edit
> yourself.
> 
> ### The closed list of transformations
> 
> A change row names exactly one of these. Nothing else is allowed, and nothing is ever deleted:
> a criterion that none of the first four can make verifiable takes `to_post_deploy`.
> 
> | Transformation | From | To | Required evidence |
> |---|---|---|---|
> | `pr_text_to_code` | a criterion that needs PR-description text | the same content as a code comment, a docs file, or a repository file the diff adds | none beyond the original quote |
> | `command_to_ci` | a command `.fabro/ci.sh` does not run | the `ci.sh` command that covers the same files | the `.fabro/ci.sh:N` line (or the script line it calls) |
> | `command_to_behaviour` | a command `ci.sh` does not run, with no `ci.sh` equivalent | a behaviour the Refuter can read from the diff (a test that asserts X exists) | `path:line` where the behaviour lives or will live |
> | `no_drop_to_threshold` | \"coverage must not drop\" and the like | \"`<config key>` in `<file>` is raised to the new totals, rounded down\" | the `path:line` of the threshold key |
> | `to_post_deploy` | a human-only check, a screenshot, a manual or staging check, a `.github/workflows/` change, or anything else the agent cannot do or the Refuter cannot verify | moved to `post_deploy_checks`, verbatim or lightly reworded | none |
RULES
{ echo '## .fabro/ci.sh'; echo; cat .fabro/ci.sh; } > $S/ci.md
: > $S/ci.seen
section() {
  if grep -qxF \"$1\" $S/ci.seen; then return 0; fi
  echo \"$1\" >> $S/ci.seen
  { echo; echo \"## $1\"; echo; cat; } >> $S/ci.md
}
grep -oE '(bash|sh|source) +[A-Za-z0-9_./-]+[.]sh|[.]/[A-Za-z0-9_./-]+[.]sh|uv run +[A-Za-z0-9_./-]+[.]py' .fabro/ci.sh | awk '{print $NF}' | sed 's|^[.]/||' | while read -r P; do
  if [ -f \"$P\" ]; then section \"$P\" < \"$P\"; elif [ -f \".fabro/$P\" ]; then section \".fabro/$P\" < \".fabro/$P\"; fi
done
grep -oE '(npm|bun) run +[A-Za-z0-9_:.-]+' .fabro/ci.sh | awk '{print $NF}' | while read -r K; do
  for PJ in package.json $(find . -maxdepth 3 -name package.json -not -path '*/node_modules/*' | sed 's|^[.]/||' | sort); do
    if [ -f \"$PJ\" ] && jq -e --arg k \"$K\" '(.scripts // {}) | has($k)' \"$PJ\" >/dev/null 2>&1; then
      jq -r --arg k \"$K\" '$k + \": \" + (.scripts[$k] | tojson)' \"$PJ\" | section \"$PJ script $K\"
      break
    fi
  done
done
grep -oE 'make +[A-Za-z0-9_.-]+' .fabro/ci.sh | awk '{print $2}' | while read -r T; do
  for MF in Makefile makefile GNUmakefile; do
    if [ -f \"$MF\" ] && grep -qE \"^$T:\" \"$MF\"; then
      awk -v t=\"$T\" 'BEGIN { tab = sprintf(\"%c\", 9) } index($0, t \":\") == 1 { p = 1; print; next } p && $0 != \"\" && substr($0, 1, 1) != \" \" && substr($0, 1, 1) != tab { p = 0 } p { print }' \"$MF\" | section \"$MF target $T\"
      break
    fi
  done
done
if [ \"$(wc -c < $S/ci.md)\" -gt 40000 ]; then
  { head -c 40000 $S/ci.md | sed '$d'; echo '- (cut to fit)'; } > $S/ci.cut
  mv $S/ci.cut $S/ci.md
fi
git rev-parse HEAD > $S/main_sha
grep -qx '.codegraph/' .git/info/exclude 2>/dev/null || echo '.codegraph/' >> .git/info/exclude
if command -v fabro-code >/dev/null; then fabro-code index >/dev/null 2>&1 || echo 'prep: fabro-code index failed; the lenses run without the index' >&2; fabro-code map >/dev/null 2>&1 || true; else echo 'prep: fabro-code is not in the image' >&2; fi
if [ -z \"$FABRO_AGENT_GUIDE\" ]; then echo 'agent guide: FABRO_AGENT_GUIDE is empty, nothing installed' >&2
elif git ls-files --error-unmatch .codex/instructions.md >/dev/null 2>&1; then echo 'agent guide: the repository tracks .codex/instructions.md, left alone' >&2
elif mkdir -p .codex && printf '%s' \"$FABRO_AGENT_GUIDE\" > .codex/instructions.md; then grep -qx '.codex/instructions.md' .git/info/exclude 2>/dev/null || echo '.codex/instructions.md' >> .git/info/exclude
else echo 'agent guide: could not write .codex/instructions.md' >&2; fi
rm -f $S/orientation.md
if gh issue list --label fabro-orientation --state open --json number,body --limit 5 > $S/orientation.raw 2>/dev/null; then
  jq -r '[.[] | (.body // \"\") | select(startswith(\"<!-- fabro:orientation \"))] | last // \"\"' $S/orientation.raw | sed 1d | jq -Rrs 'if length > 6000 then .[0:6000] + \" [cut to 6000 characters]\" else . end' > $S/orientation.md 2>/dev/null || true
fi
if ! grep -q '[^[:space:]]' $S/orientation.md 2>/dev/null; then rm -f $S/orientation.md; fi
jq -r '[.[] | (.body // \"\") | select(startswith(\"<!-- fabro:context-pack \"))] | last // \"\"' $S/comments.json | sed 1d | jq -Rrs 'if length > 8000 then .[0:8000] + \" [cut to 8000 characters]\" else . end' > $S/pack.md 2>/dev/null || true
if ! grep -q '[^[:space:]]' $S/pack.md 2>/dev/null; then rm -f $S/pack.md; fi
rm -f $S/orientation.raw
echo '{\"context_updates\":{\"prep_ok\":true}}'"]

    // The Elephant. Bounded at 20m (D21: a bound, not a measurement; task 08 re-derives it).
    draft [label="Draft the sharpened criteria", class="sharpen", timeout="20m", prompt="@prompts/draft.md.j2"]

    // ---- The preservation gate (D10, C4) ----
    //
    // The first refusal writes `outcome=cannot_sharpen` and a one-line `rule`, and routes to
    // `record`: a refusal is a model mistake, not a fault, and is never retried. On success it
    // writes the sealed audit directory the lenses read, clears the lens directory so a result
    // from an earlier round can never count, and emits `round`.
    draft_gate [label="Check the draft changes nothing it did not declare", shape=parallelogram, output_schema="routing", timeout="2m",
        script="S=/tmp/fabro/sharpen
F=$S/draft.json
R=0
[ -f $S/round ] && R=$(cat $S/round)
R=$((R+1))
echo $R > $S/round
refuse() {
  printf '%s' \"$1\" > $S/rule
  echo cannot_sharpen > $S/outcome
  echo 'draft_gate: refused: '\"$1\" >&2
  echo '{\"context_updates\":{\"draft_ok\":false}}'
  exit 0
}
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then refuse 'draft.json has no valid Input receipt, so the draft did not finish'; fi
cat > $S/lib.jq <<'JQ'
def nl: [10] | implode;
def clean: sub(\"[[:space:]]+$\"; \"\");
def blines: (. // \"\") | split(nl) | map(clean);
def trimblank: reverse | until(length == 0 or .[0] != \"\"; .[1:]) | reverse;
def sections: reduce .[] as $x ([{h: \"\", l: []}]; if ($x | test(\"^## \")) then . + [{h: $x, l: []}] else .[-1].l += [$x] end) | map(.l |= trimblank);
def parse_ac: reduce .[] as $x ({b: [], o: [], bul: false}; if ($x | test(\"^[-*] \")) then .b += [[$x]] | .bul = true elif .bul and ($x | test(\"^[[:space:]]+[^[:space:]]\")) then .b[-1] += [$x] elif $x == \"\" then .bul = false else .o += [$x] | .bul = false end);
def btext: (.[0] | sub(\"^[-*] ([[][ xX][]] )?\"; \"\")) as $f | ([$f] + .[1:]) | join(nl);
def ac_of: ([.[] | select(.h == \"## Acceptance criteria\")] | first) as $s | if $s == null then null else ($s.l | parse_ac) end;
JQ
cat > $S/gate.jq <<'JQ'
include \"lib\";
def okrow:
  if (type != \"object\") then \"a change row is not an object\"
  elif ((keys - [\"criterion_ref\", \"original\", \"proposed\", \"transformation\", \"evidence\"]) | length) > 0 or (([\"criterion_ref\", \"original\", \"proposed\", \"transformation\", \"evidence\"] - keys) | length) > 0 then \"a change row has missing or unknown keys\"
  elif ((.criterion_ref | type) != \"string\" or (.criterion_ref | test(\"^AC[0-9]+$\") | not)) then \"a criterion_ref is not ACn\"
  elif ((.original | type) != \"string\" or (.original | length) == 0) then \"a row has no original\"
  elif (.proposed != null and ((.proposed | type) != \"string\" or (.proposed | length) == 0)) then \"a row proposed is not text or null\"
  elif ([.transformation] | inside([\"pr_text_to_code\", \"command_to_ci\", \"command_to_behaviour\", \"no_drop_to_threshold\", \"to_post_deploy\"]) | not) then \"a row names a transformation outside the closed list: \" + (.transformation | tostring)
  elif ((.proposed == null) != (.transformation == \"to_post_deploy\")) then (.criterion_ref + \": proposed is null if and only if the transformation is to_post_deploy\")
  elif ((.evidence | type) != \"array\" or (.evidence | length) < 1 or (.evidence | length) > 6) then (.criterion_ref + \" has no evidence\")
  elif (all(.evidence[]; type == \"object\" and ((keys - [\"where\", \"says\"]) | length) == 0 and ((.where | type) == \"string\") and ((.says | type) == \"string\") and (.where | length) > 0 and (.where | length) <= 200 and (.says | length) > 0 and (.says | length) <= 300) | not) then (.criterion_ref + \" has malformed evidence\")
  elif (.transformation == \"command_to_ci\" and (any(.evidence[]; .where | contains(\"ci.sh\")) | not)) then (.criterion_ref + \": command_to_ci needs evidence from .fabro/ci.sh\")
  elif ((.transformation == \"command_to_behaviour\" or .transformation == \"no_drop_to_threshold\") and (any(.evidence[]; .where | test(\":[0-9]+\")) | not)) then (.criterion_ref + \": \" + .transformation + \" needs path:line evidence\")
  else \"\" end;
def schema_rule:
  if (type != \"object\") then \"the draft is not an object\"
  elif ((keys - [\"_io\", \"status\", \"reason\", \"body\", \"post_deploy_checks\", \"changes\", \"human_actions\"]) | length) > 0 then \"the draft has an unknown key\"
  elif (.status != \"proposed\" and .status != \"cannot_sharpen\") then \"the draft has no known status\"
  elif .status == \"cannot_sharpen\" then (if ((.reason | type) == \"string\" and (.reason | length) >= 1 and (.reason | length) <= 600) then \"\" else \"cannot_sharpen carries no reason of 600 characters or fewer\" end)
  elif ((.body | type) != \"string\" or (.body | length) == 0) then \"the draft has no body\"
  elif ((.post_deploy_checks | type) != \"array\" or (all(.post_deploy_checks[]; type == \"string\" and length > 0 and length <= 600 and ((explode | any(. == 10)) | not)) | not)) then \"post_deploy_checks is not a list of one-line strings\"
  elif ((.human_actions | type) != \"array\" or (all(.human_actions[]; type == \"string\" and length > 0 and length <= 300) | not)) then \"human_actions is not a list of strings of 300 characters or fewer\"
  elif ((.changes | type) != \"array\" or (.changes | length) < 1 or (.changes | length) > 20) then \"changes has no rows, or more than 20\"
  else ([.changes[] | okrow | select(. != \"\")] | first // \"\") end;
def bullet_rows($oa; $rows):
  [range(0; ($oa.b | length)) as $i | ([$rows[] | select((.criterion_ref[2:] | tonumber) == ($i + 1))] | first) as $r | if $r == null then {raw: $oa.b[$i]} elif $r.proposed != null then {t: $r.proposed} else empty end];
def preserve($orig; $d):
  ($orig | blines) as $ol
  | ($d.body | blines) as $pl
  | ($ol | sections) as $osall
  | ($osall | map(select(.h != \"## Post-deploy checks\"))) as $os
  | ($pl | sections) as $ps
  | ($os | ac_of) as $oa
  | ($ps | ac_of) as $pa
  | ($d.changes | map(.criterion_ref[2:] | tonumber)) as $ns
  | if $oa == null then \"the original body has no acceptance criteria heading\"
    elif any($ps[]; .h == \"## Post-deploy checks\") then \"the body writes a Post-deploy checks section; the gate assembles it\"
    elif ([range(0; ($ol | length)) | select(($ol[.] | startswith(\"<!-- fabro:\")) and $pl[.] != $ol[.])] | length) > 0 then (\"the marker on line \" + ([range(0; ($ol | length)) | select(($ol[.] | startswith(\"<!-- fabro:\")) and $pl[.] != $ol[.])] | first + 1 | tostring) + \" was changed or moved\")
    elif ($os | map(.h)) != ($ps | map(.h)) then \"a section heading was added, removed, renamed or moved\"
    elif ([range(0; ($os | length)) | select($os[.].h != \"## Acceptance criteria\" and $os[.].l != $ps[.].l)] | length) > 0 then (\"the section \" + ([range(0; ($os | length)) | select($os[.].h != \"## Acceptance criteria\" and $os[.].l != $ps[.].l)] | first | $os[.].h | if . == \"\" then \"before the first heading\" else . end) + \" changed\")
    elif ($pa == null) then \"the proposal has no acceptance criteria section\"
    elif $oa.o != $pa.o then \"text between the acceptance criteria bullets changed\"
    elif (($ns | length) != ($ns | unique | length)) then \"two change rows name the same criterion\"
    elif (any($ns[]; . < 1 or . > ($oa.b | length))) then \"a change row names a criterion that is not in the original\"
    elif (any($d.changes[]; (.original != ($oa.b[(.criterion_ref[2:] | tonumber) - 1] | btext)))) then (\"the original text of \" + ([$d.changes[] | select(.original != ($oa.b[(.criterion_ref[2:] | tonumber) - 1] | btext))] | first | .criterion_ref) + \" is not the bullet in the original body\")
    elif (any($d.changes[]; .proposed != null and .proposed == .original)) then \"a change row proposes the text it already has\"
    else
      bullet_rows($oa; $d.changes) as $want
      | if ($want | length) != ($pa.b | length) then \"the acceptance criteria hold a bullet that no change row accounts for, or lack one that a row keeps\"
        elif ([range(0; ($want | length)) | select(if ($want[.] | has(\"raw\")) then $want[.].raw != $pa.b[.] else $want[.].t != ($pa.b[.] | btext) end)] | length) > 0 then (\"acceptance criteria bullet \" + ([range(0; ($want | length)) | select(if ($want[.] | has(\"raw\")) then $want[.].raw != $pa.b[.] else $want[.].t != ($pa.b[.] | btext) end)] | first + 1 | tostring) + \" is not the original bullet or its change row's proposal, in order\")
        else \"\" end
    end;
def assemble($orig; $d):
  ($orig | blines | sections | map(select(.h == \"## Post-deploy checks\")) | map(.l) | add // []) as $opd
  | ($opd | parse_ac) as $pdp
  | ($pdp.b | map(btext | gsub(\"[[:space:]]+\"; \" \"))) as $have
  | ([$d.post_deploy_checks[], ($d.changes[] | select(.transformation == \"to_post_deploy\") | .original | gsub(\"[[:space:]]+\"; \" \"))] | reduce .[] as $x ([]; if (. | index($x)) == null and ($have | index($x)) == null then . + [$x] else . end)) as $new
  | ($d.body | split(nl) | reverse | until(length == 0 or (.[0] | clean) != \"\"; .[1:]) | reverse) as $bl
  | if ($opd | length) == 0 and ($new | length) == 0 then $bl
    else $bl + [\"\", \"## Post-deploy checks\", \"\"] + $opd + ($new | map(\"- [ ] \" + .)) end
  | join(nl) + nl;
def table($d):
  def cell: if . == null then \"(moved to Post-deploy checks)\" else (gsub(\"[|]\"; \"/\") | gsub(\"[[:space:]]+\"; \" \")) end;
  [\"| Criterion | Original | Proposed | Transformation | Evidence |\", \"|---|---|---|---|---|\"]
  + [$d.changes[] | \"| \" + .criterion_ref + \" | \" + (.original | cell) + \" | \" + (.proposed | cell) + \" | \" + .transformation + \" | \" + ([.evidence[] | .where + \": \" + .says] | join(\"; \") | cell) + \" |\"]
  | join(nl) + nl;
. as $d
| ($d | schema_rule) as $s
| if $s != \"\" then {rule: $s}
  elif $d.status == \"cannot_sharpen\" then {rule: (\"model:\" + $d.reason), model: true}
  else
    preserve($orig; $d) as $p
    | if $p != \"\" then {rule: $p}
      else {rule: \"\", proposed: assemble($orig; $d), changes: table($d)} end
  end
JQ
jq -j '.body // \"\"' $S/issue.json > $S/orig.md
if ! jq -L $S --rawfile orig $S/orig.md -f $S/gate.jq $F > $S/gate.json 2>$S/gate.err; then
  refuse 'the gate could not read the draft: '\"$(head -c 200 $S/gate.err)\"
fi
RULE=$(jq -r '.rule' $S/gate.json)
if [ -n \"$RULE\" ]; then refuse \"$RULE\"; fi
rm -rf $S/audit $S/lens
mkdir -p $S/audit $S/lens
jq -r '.proposed' $S/gate.json > $S/audit/proposed.md
jq -r '.changes' $S/gate.json > $S/audit/changes.md
cp $S/criteria.md $S/audit/original_criteria.md
cp $S/ci.md $S/audit/ci.md
echo 'draft_gate: round '$R' draft accepted' >&2
jq -nc --arg r \"$R\" '{context_updates:{draft_ok:true, round:$r}}'"]

    // ---- The audit: three fresh lenses, then a command node that decides (D7, D8, C5, C6) ----
    //
    // Each lens is its own agent node, so each is a fresh session, and `default_fidelity="truncate"`
    // (set above) puts no recap of an earlier stage in a lens's prompt: the draft's transcript
    // and notes cannot reach it. Its manifest inputs are exactly the four files `draft_gate`
    // copies into `/tmp/fabro/sharpen/audit/`, and its Sealed paths (guarded by `io-guard`) name
    // every other file this run keeps, the draft's own result among them. Reasoning effort is
    // `high` for `preserve` only: a miss there is a weakened requirement (D22). The timeouts
    // are bounds, not measurements (D21).
    comprehend [label="Comprehension lens", class="sharpen", timeout="15m", prompt="@prompts/comprehend.md.j2"]
    verify [label="Verifiability lens", class="sharpen", timeout="15m", prompt="@prompts/verify.md.j2"]
    preserve [label="Preservation lens", class="preserve", timeout="15m", prompt="@prompts/preserve.md.j2"]

    // A command node, not a model, decides whether the round is clean, whether to loop and
    // when to stop. It keeps the finding history, so a finding that was fixed and came back, or
    // a criterion whose proposed text alternates, ends the loop as `churn`. Round 3 not clean is
    // `capped`. On `capped` and `churn` it writes the outcome and the rule for `record`.
    audit_gate [label="Judge the round", shape=parallelogram, output_schema="routing", timeout="2m",
        script="S=/tmp/fabro/sharpen
L=$S/lens
R=$(cat $S/round 2>/dev/null || echo 1)
mkdir -p $S/rounds
cat > $S/lib.jq <<'JQ'
def nl: [10] | implode;
def clean: sub(\"[[:space:]]+$\"; \"\");
def blines: (. // \"\") | split(nl) | map(clean);
def trimblank: reverse | until(length == 0 or .[0] != \"\"; .[1:]) | reverse;
def sections: reduce .[] as $x ([{h: \"\", l: []}]; if ($x | test(\"^## \")) then . + [{h: $x, l: []}] else .[-1].l += [$x] end) | map(.l |= trimblank);
def parse_ac: reduce .[] as $x ({b: [], o: [], bul: false}; if ($x | test(\"^[-*] \")) then .b += [[$x]] | .bul = true elif .bul and ($x | test(\"^[[:space:]]+[^[:space:]]\")) then .b[-1] += [$x] elif $x == \"\" then .bul = false else .o += [$x] | .bul = false end);
def btext: (.[0] | sub(\"^[-*] ([[][ xX][]] )?\"; \"\")) as $f | ([$f] + .[1:]) | join(nl);
def ac_of: ([.[] | select(.h == \"## Acceptance criteria\")] | first) as $s | if $s == null then null else ($s.l | parse_ac) end;
JQ
cat > $S/audit1.jq <<'JQ'
include \"lib\";
def isfind: type == \"object\" and (.severity | IN(\"blocker\", \"major\", \"nit\")) and ((.message | type) == \"string\") and (.criterion_ref == null or ((.criterion_ref | type) == \"string\" and (.criterion_ref | test(\"^AC[0-9]+$\")))) and (((.evidence // []) | type) == \"array\");
def lens_ok($x; $o):
  $o != null and ($o | type) == \"object\" and ($o._io.stage == $x) and (($o._io.visit // \"\") != \"\") and (($o.findings | type) == \"array\") and all($o.findings[]; isfind)
  and (if $x == \"comprehend\" then (($o.proposed_paraphrase | type) == \"string\" and ($o.existing_system_paraphrase | type) == \"string\")
       elif $x == \"verify\" then (($o.criteria | type) == \"array\" and all($o.criteria[]; type == \"object\" and (.verdict | IN(\"checkable_from_diff\", \"checkable_by_ci\", \"unverifiable\")) and ((.text | type) == \"string\")))
       else (($o.pairs | type) == \"array\" and all($o.pairs[]; type == \"object\" and (.verdict | IN(\"same\", \"substitution\", \"contradiction_resolved\")) and ((.criterion_ref | type) == \"string\"))) end);
def own($x; $o): if lens_ok($x; $o) then [$o.findings[] | {lens: $x, severity, criterion_ref, message, evidence: (.evidence // [])}] else [] end;
def key: .lens + \"|\" + (.criterion_ref // \"-\") + \"|\" + (.message | ascii_downcase | gsub(\"[[:space:]]+\"; \" \") | sub(\"^ \"; \"\") | sub(\" $\"; \"\"));
$c[0] as $co | $v[0] as $vo | $p[0] as $po | $d[0] as $dr
| ((($prop | blines | sections | ac_of) // {b: []}) | .b | length) as $nb
| {comprehend: lens_ok(\"comprehend\"; $co), verify: lens_ok(\"verify\"; $vo), preserve: lens_ok(\"preserve\"; $po)} as $valid
| (if $valid.verify then [$vo.criteria[] | select(.verdict == \"unverifiable\") | {lens: \"verify\", severity: \"blocker\", criterion_ref: null, message: (\"The proposed criterion `\" + (.text | .[0:160]) + \"` is unverifiable: \" + (.why // \"no reason given\")), evidence: []}] else [] end) as $unver
| (if $valid.verify and ($vo.criteria | length) < $nb then [{lens: \"verify\", severity: \"blocker\", criterion_ref: null, message: (\"The proposal has \" + ($nb | tostring) + \" acceptance criteria and the verifiability lens gave \" + ($vo.criteria | length | tostring) + \" verdicts, so a criterion has none.\"), evidence: []}] else [] end) as $short
| (if $valid.preserve then [$po.pairs[] | select(.verdict != \"same\") | {lens: \"preserve\", severity: \"blocker\", criterion_ref: .criterion_ref, message: (\"The change to \" + .criterion_ref + \" is a \" + .verdict + \": \" + (.why // \"no reason given\")), evidence: []}] else [] end) as $subst
| (if $valid.preserve then [$dr.changes[] | .criterion_ref as $r | select(([$po.pairs[] | .criterion_ref] | index($r)) == null) | {lens: \"preserve\", severity: \"blocker\", criterion_ref: $r, message: (\"The change to \" + $r + \" has no verdict from the preservation lens.\"), evidence: []}] else [] end) as $nopair
| (own(\"comprehend\"; $co) + own(\"verify\"; $vo) + own(\"preserve\"; $po) + $unver + $short + $subst + $nopair) as $all
| {
    valid: $valid,
    findings: $all,
    hard: [$all[] | select(.severity != \"nit\")],
    keys: [$all[] | select(.severity != \"nit\") | key],
    paraphrase: (if $valid.comprehend then (\"**What the issue now asks for.** \" + $co.proposed_paraphrase + nl + nl + \"**How the code works today.** \" + $co.existing_system_paraphrase) else \"\" end),
    changes_map: ([$dr.changes[] | {key: .criterion_ref, value: {p: .proposed}}] | from_entries)
  }
JQ
cat > $S/audit2.jq <<'JQ'
include \"lib\";
def line: \"- [\" + .severity + \"] \" + .lens + (if .criterion_ref == null then \"\" else \" \" + .criterion_ref end) + \": \" + .message;
def evlines: [(.evidence // [])[] | \"    - `\" + .where + \"`: \" + .says];
$p1[0] as $a
| ($fps | split(nl) | map(select(. != \"\"))) as $fp
| ($a.hard | to_entries | map(.value + {fp: $fp[.key]}) | unique_by(.fp)) as $cur
| $h[0] as $hist
| ($hist | map(.fp)) as $hfp
| ($hist | map(. as $e | ($cur | map(select(.fp == $e.fp)) | first) as $c
    | if $c != null then (if $e.state == \"open\" then $e + {recur: false} else $e + {state: \"open\", round_fixed: null, recur: true} end)
      elif $e.state == \"open\" then $e + {state: \"fixed\", round_fixed: $round, recur: false}
      else $e + {recur: false} end)) as $upd
| ($cur | map(select(.fp as $f | ($hfp | index($f)) == null) | {fp, lens, criterion_ref, message, severity, round_opened: $round, state: \"open\", round_fixed: null, recur: false})) as $new
| ($upd + $new) as $all
| ($all | any(.[]; .recur)) as $recurrence
| $a.changes_map as $cm
| ($r1[0]) as $m1
| ($r2[0]) as $m2
| (($m1 != null) and ($m2 != null) and any(($cm | keys)[]; . as $k | ($m2[$k] != null) and ($m2[$k] == $cm[$k]) and ($m1[$k] != $cm[$k]))) as $alternates
| (($a.valid.comprehend and $a.valid.verify and $a.valid.preserve) and (($a.hard | length) == 0)) as $clean
| (if $clean then \"converged\" elif ($recurrence or $alternates) then \"churn\" elif $round >= 3 then \"capped\" else \"open\" end) as $result
| (($a.valid | to_entries | map(select(.value | not) | .key)) as $notrun
   | (\"round \" + ($round | tostring) + \" was not clean: \" + ($a.hard | length | tostring) + \" open finding\" + (if ($a.hard | length) == 1 then \"\" else \"s\" end) + (if ($notrun | length) > 0 then \", and the \" + ($notrun | join(\", \")) + \" lens did not run\" else \"\" end) + (if $result == \"churn\" then \"; the loop was going in circles (\" + (if $recurrence then \"a fixed finding came back\" else \"a criterion's text alternated\" end) + \")\" else \"\" end))) as $rule
| ($all | map(select(.state == \"open\"))) as $open
| ([$a.findings[] | select(.severity == \"nit\")]) as $nits
| (\"# What the audit found in round \" + ($round | tostring) + nl + nl
   + \"Fix every open finding, and change nothing a finding does not ask about.\" + nl + nl
   + \"## Open findings\" + nl + nl
   + (if ($a.hard | length) == 0 then \"None.\" else ([$a.hard[] | (line, evlines[])] | join(nl)) end) + nl
   + (if ($a.valid | all) then \"\" else nl + \"A lens did not run, so the round could not be clean. Draft again with the findings above.\" + nl end)
   + (if ($nits | length) > 0 then nl + \"## Nits (never block)\" + nl + nl + ([$nits[] | line] | join(nl)) + nl else \"\" end)
   + nl + \"## History\" + nl + nl
   + (if ($all | length) == 0 then \"None.\" else ([$all[] | \"- \" + .state + \" (opened in round \" + (.round_opened | tostring) + (if .state == \"fixed\" then \", fixed in round \" + (.round_fixed | tostring) else \"\" end) + \") \" + .lens + (if .criterion_ref == null then \"\" else \" \" + .criterion_ref end) + \": \" + .message] | join(nl)) end) + nl) as $md
| {result: $result, rule: $rule, history: ($all | map(del(.recur))), open: ($a.findings), md: $md, paraphrase: $a.paraphrase, changes_map: $cm}
JQ
[ -f $S/history.json ] || echo '[]' > $S/history.json
for X in comprehend verify preserve; do
  if jq -e . $L/$X.json >/dev/null 2>&1; then cp $L/$X.json $S/cur.$X.json; else echo null > $S/cur.$X.json; fi
done
for K in 1 2; do
  M=$((R-K))
  if [ \"$M\" -ge 1 ] && jq -e . $S/rounds/$M.json >/dev/null 2>&1; then cp $S/rounds/$M.json $S/prev$K.json; else echo null > $S/prev$K.json; fi
done
if ! jq -n -L $S --slurpfile c $S/cur.comprehend.json --slurpfile v $S/cur.verify.json --slurpfile p $S/cur.preserve.json --slurpfile d $S/draft.json --rawfile prop $S/audit/proposed.md -f $S/audit1.jq > $S/audit1.json; then
  echo 'audit_gate: could not read the lens results' >&2
  exit 1
fi
if command -v sha256sum >/dev/null; then SUM=sha256sum; else SUM='shasum -a 256'; fi
: > $S/fps.txt
jq -r '.keys[]' $S/audit1.json | while IFS= read -r K; do printf '%s' \"$K\" | $SUM | cut -d' ' -f1 >> $S/fps.txt; done
if ! jq -n -L $S --slurpfile p1 $S/audit1.json --rawfile fps $S/fps.txt --slurpfile h $S/history.json --argjson round \"$R\" --slurpfile r1 $S/prev1.json --slurpfile r2 $S/prev2.json -f $S/audit2.jq > $S/audit2.json; then
  echo 'audit_gate: could not judge the round' >&2
  exit 1
fi
RES=$(jq -r '.result' $S/audit2.json)
jq '.history' $S/audit2.json > $S/history.next && mv $S/history.next $S/history.json
jq '.changes_map' $S/audit2.json > $S/rounds/$R.json
jq '.open' $S/audit2.json > $S/open_findings.json
jq -r '.paraphrase' $S/audit2.json > $S/paraphrase.md
jq -r '.md' $S/audit2.json > $S/findings.md
case \"$RES\" in
  capped | churn)
    echo \"$RES\" > $S/outcome
    jq -j '.rule' $S/audit2.json > $S/rule ;;
esac
rm -f $S/cur.comprehend.json $S/cur.verify.json $S/cur.preserve.json $S/prev1.json $S/prev2.json
echo 'audit_gate: round '$R' is '$RES >&2
jq -nc --arg s \"$RES\" --arg r \"$R\" '{context_updates:{sharpen_result:$s, round:$r}}'"]

    // ---- Write the proposal, then judge it at once (D6, D11, D14, D15; C8, C10) ----
    //
    // `apply` is the only node that edits the issue. It re-reads the issue and stops with
    // outcome `stale` when the text is no longer the one `claim` hashed. It posts the original
    // body in a `fabro:sharpen-original` comment before the edit, so a failure of either step
    // leaves the issue as it was or as it should be, and the scheduler retries a failed run
    // (D12). The applied hash is the one the precheck will compute from the issue as GitHub
    // now stores it.
    apply [label="Write the sharpened body", shape=parallelogram, output_schema="routing", timeout="5m",
        script="S=/tmp/fabro/sharpen
N=$(cat $S/issue_number)
HASH=$(cat $S/body_hash)
RUN=$(cat $S/run_id 2>/dev/null || true)
[ -n \"$RUN\" ] || RUN=unknown
if command -v sha256sum >/dev/null; then SUM=sha256sum; else SUM='shasum -a 256'; fi
if ! gh issue view \"$N\" --json title,body > $S/issue.now.json; then
  echo 'apply: could not re-read issue '$N'; nothing was edited' >&2
  exit 1
fi
NOW=$({ jq -j '.title // \"\"' $S/issue.now.json; echo; jq -j '.body // \"\"' $S/issue.now.json; } | $SUM | cut -c1-12)
if [ \"$NOW\" != \"$HASH\" ]; then
  echo stale > $S/outcome
  printf '%s' 'the issue was edited while it was being sharpened (body '$HASH' became '$NOW')' > $S/rule
  echo 'apply: the issue changed since claim; nothing was edited' >&2
  echo '{\"context_updates\":{\"apply_result\":\"stale\"}}'
  exit 0
fi
{ echo \"<!-- fabro:sharpen-original body=$HASH run=$RUN -->\"; echo; jq -j '.body // \"\"' $S/issue.json; } > $S/original.md
if ! gh issue comment \"$N\" --body-file $S/original.md >/dev/null; then
  echo 'apply: could not post the original body; nothing was edited' >&2
  exit 1
fi
if ! gh issue edit \"$N\" --body-file $S/audit/proposed.md >/dev/null; then
  echo 'apply: could not edit the issue body' >&2
  exit 1
fi
if gh issue view \"$N\" --json title,body > $S/issue.after.json 2>/dev/null; then
  AFTER=$({ jq -j '.title // \"\"' $S/issue.after.json; echo; jq -j '.body // \"\"' $S/issue.after.json; } | $SUM | cut -c1-12)
else
  AFTER=$({ jq -j '.title // \"\"' $S/issue.json; echo; cat $S/audit/proposed.md; } | $SUM | cut -c1-12)
fi
echo \"$AFTER\" > $S/applied_hash
echo applied > $S/outcome
echo 'apply: issue '$N' body '$HASH' became '$AFTER >&2
echo '{\"context_updates\":{\"apply_result\":\"applied\"}}'"]

    // The new body is judged inside this run with the precheck's own check, so a sharpened
    // issue never waits on the background lane (D14). `recheck_prep` stages that judgment's
    // two files for the applied body; `recheck` is a copy of `issue-precheck`'s `check` prompt,
    // `recheck_gate` of its `gate` and `recheck_post` of its `post`, with the staging path
    // remapped (R10 keeps all three exact). Only `recheck_post` writes: the precheck's marker
    // for the applied body, so the scheduler's per-body-hash producer finds it.
    //
    // None of the four may fail the run. The body is already applied, so a failure takes its
    // unconditional edge to `post` with `recheck` unset, and the scheduler's per-hash producer
    // queues an ordinary precheck for the new text (D13). `recheck` runs as long as the
    // precheck's `check` (D21).
    recheck_prep [label="Stage the recheck", shape=parallelogram, output_schema="routing", timeout="5m",
        script="S=/tmp/fabro/sharpen
P=$S/recheck
N=$(cat $S/issue_number)
rm -rf $P
mkdir -p $P
echo \"$N\" > $P/issue_number
cp $S/repo $P/repo
cp $S/applied_hash $P/body_hash
cp $S/run_id $P/run_id 2>/dev/null || true
git rev-parse HEAD > $P/main_sha
if ! gh issue view \"$N\" --json number,title,body,state,url,labels > $P/issue.json; then
  echo 'recheck_prep: could not read issue '$N >&2
  exit 1
fi
R=$(cat $S/repo)
if ! gh api \"repos/$R/issues/$N/comments?per_page=100\" --paginate > $P/comments.raw; then
  echo 'recheck_prep: could not read the comments on issue '$N >&2
  exit 1
fi
jq -s 'add // []' $P/comments.raw > $P/comments.json
if ! gh issue list --state open --limit 300 --json number,title > $P/open_issues.json; then
  echo 'recheck_prep: could not list the open issues' >&2
  exit 1
fi
{
  echo '# #'$N': '\"$(jq -r '.title // \"\"' $P/issue.json)\"
  echo
  echo 'Labels: '\"$(jq -r '[(.labels // [])[].name] | join(\", \")' $P/issue.json)\"
  echo
  jq -r '.body // \"\"' $P/issue.json
  echo
  echo '## Comments, oldest first (the last ten; fabro marker comments left out)'
  echo
  jq -r '[.[] | select((.body // \"\") | startswith(\"<!-- fabro:\") | not)] | .[-10:] | .[] | (\"### \" + (.user.login // \"?\") + \" at \" + (.created_at // \"?\")), \"\", ((.body // \"\") | .[0:2000]), \"\"' $P/comments.json
} > $P/issue.md
jq -r --argjson n \"$N\" '.[] | select(.number != $n) | \"#\" + (.number | tostring) + \" \" + (.title // \"\")' $P/open_issues.json > $P/open_issues.md
echo '{\"context_updates\":{\"recheck_ready\":true}}'"]
    recheck [label="Recheck the applied body", class="sharpen", timeout="40m", prompt="@prompts/recheck.md.j2"]
    recheck_gate [label="Check the recheck verdict", shape=parallelogram, output_schema="routing", timeout="2m",
        script="F=/tmp/fabro/sharpen/recheck.json
P=/tmp/fabro/sharpen/recheck
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then
  echo 'precheck.json has no valid Input receipt, so the check did not finish; nothing is posted' >&2
  exit 1
fi
RAW=$(jq -r '.verdict // empty' $F)
case \"$RAW\" in ready | already_done | blocked | contradiction | unclear | unverifiable) ;; *) echo 'precheck.json carries no known verdict' >&2; exit 1;; esac
VERDICT=$RAW
RULE=''
if [ \"$VERDICT\" != ready ] && [ \"$(jq '(.evidence // []) | length' $F)\" -eq 0 ]; then
  VERDICT=ready
  RULE='it cited no evidence'
fi
if [ \"$VERDICT\" = blocked ]; then
  B=$(jq -r '.blocker // empty' $F)
  N=$(cat $P/issue_number)
  case \"$B\" in '' | *[!0-9]*) B=0 ;; esac
  if [ \"$B\" = \"$N\" ] || ! jq -e --argjson b \"$B\" 'any(.[]; .number == $b)' $P/open_issues.json >/dev/null 2>&1; then
    VERDICT=ready
    RULE='its blocker #'$B' is not another open issue in this repository'
  fi
fi
if [ \"$VERDICT\" = unverifiable ] && ! jq -e 'any((.evidence // [])[]; (.where // \"\") == \"issue body\")' $F >/dev/null; then
  VERDICT=ready
  RULE='it quoted no criterion from the issue body'
fi
echo \"$RAW\" > $P/raw_verdict
echo \"$VERDICT\" > $P/verdict
printf '%s' \"$RULE\" > $P/rule
echo 'gate: verdict '$VERDICT
echo '{\"context_updates\":{\"verdict\":\"'$VERDICT'\"}}'"]
    recheck_post [label="Post the precheck marker", shape=parallelogram, output_schema="routing", timeout="5m",
        script="exec 3>&1 >>/tmp/fabro/sharpen/recheck/post.log 2>&1
P=/tmp/fabro/sharpen/recheck
N=$(cat $P/issue_number)
R=$(cat $P/repo)
V=$(cat $P/verdict)
RAW=$(cat $P/raw_verdict)
RULE=$(cat $P/rule 2>/dev/null || true)
HASH=$(cat $P/body_hash)
MAIN=$(cat $P/main_sha 2>/dev/null || true)
[ -n \"$MAIN\" ] || MAIN=unknown
AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
RUN=$(cat $P/run_id 2>/dev/null || true)
[ -n \"$RUN\" ] || RUN=unknown
BODY=$P/comment.md
EXTRA=''
if [ \"$V\" = blocked ]; then
  B=$(jq -r '.blocker // empty' /tmp/fabro/sharpen/recheck.json 2>/dev/null || true)
  case \"$B\" in '' | *[!0-9]*) ;; *) EXTRA=' blocker='$B ;; esac
fi
echo \"<!-- fabro:precheck verdict=$V body=$HASH main=$MAIN at=$AT run=$RUN$EXTRA -->\" > $P/comment.head
{
  echo
  case \"$V\" in
    ready) echo '**Precheck: ready.** A local model read this issue and the code at `main` and found nothing against running it.' ;;
    already_done) echo '**Precheck: already done?** A local model read this issue and the code at `main`, and thinks the code already does what it asks.' ;;
    blocked) echo '**Precheck: blocked?** A local model read this issue and thinks it needs #'\"$(jq -r '.blocker // \"?\"' /tmp/fabro/sharpen/recheck.json)\"' first.' ;;
    contradiction) echo '**Precheck: contradiction?** A local model read this issue and thinks an acceptance criterion needs something a non-goal excludes.' ;;
    unclear) echo '**Precheck: unclear?** A local model read this issue and could not find an acceptance criterion it could check.' ;;
    unverifiable) echo '**Precheck: unverifiable?** A local model read this issue and thinks an acceptance criterion is one the factory cannot check or meet on its own, so the pull request would wait for a human.' ;;
  esac
  echo
  jq -r '.summary // \"\"' /tmp/fabro/sharpen/recheck.json
  if [ \"$(jq '(.evidence // []) | length' /tmp/fabro/sharpen/recheck.json)\" -gt 0 ]; then
    echo
    jq -r '.evidence[] | \"- `\" + .where + \"`: \" + .says' /tmp/fabro/sharpen/recheck.json
  fi
  if [ -n \"$RULE\" ]; then
    echo
    echo 'The model said `'$RAW'`, but '\"$RULE\"', so this counts as `ready`.'
  fi
} | awk -v t1=\"${FABRO_API_TOKEN:-}\" -v t2=\"${GITHUB_TOKEN:-}\" -v t3=\"${GH_TOKEN:-}\" 'function scrub(line, t,  out, i) { if (length(t) < 8) return line; out = \"\"; while ((i = index(line, t)) > 0) { out = out substr(line, 1, i - 1) \"[redacted]\"; line = substr(line, i + length(t)) } return out line } { $0 = scrub($0, t1); $0 = scrub($0, t2); $0 = scrub($0, t3); print }' > $P/comment.tail
FOOT='_Shadow mode: this note does not change the queue. The factory is measuring how often these verdicts are right before it acts on them._'
LIMIT=$((1500 - $(wc -c < $P/comment.head) - ${#FOOT} - 20))
TAIL=$(($(wc -c < $P/comment.tail)))
if [ \"$TAIL\" -gt \"$LIMIT\" ]; then
  { head -c \"$LIMIT\" $P/comment.tail | sed '$d'; echo '- (cut to fit)'; } > $P/comment.cut
else
  cp $P/comment.tail $P/comment.cut
fi
{ cat $P/comment.head $P/comment.cut; echo; echo \"$FOOT\"; } > $BODY
if [ ! -s $BODY ]; then echo 'could not build the marker comment' >&2; exit 1; fi
ID=$(gh api \"repos/$R/issues/$N/comments?per_page=100\" --paginate 2>/dev/null | jq -s 'add // []' | jq -r '[(.[] | select((.body // \"\") | startswith(\"<!-- fabro:precheck \"))) | .id] | last // \"\"')
if [ -n \"$ID\" ]; then
  if ! jq -n --rawfile b $BODY '{body: $b}' | gh api -X PATCH \"repos/$R/issues/comments/$ID\" --input - >/dev/null; then
    echo 'could not edit the existing precheck comment' >&2
    exit 1
  fi
else
  if ! gh issue comment \"$N\" --body-file $BODY >/dev/null; then
    echo 'could not post the precheck comment' >&2
    exit 1
  fi
fi
echo 'post: verdict '$V' on issue '$N
echo '{\"context_updates\":{\"posted\":true}}' >&3
exit 0"]

    // The one `fabro:sharpen` comment (C8): written for `applied`, `capped`, `churn` and
    // `stale`, edited in place when one exists. A failed write is one stderr line and does not
    // fail the run: the body is already applied, and `record` carries the outcome. It cuts the
    // comment at 60,000 characters, dropping the proposed body first and then the paraphrase,
    // and never the marker or the change table. `cannot_sharpen` and `not_needed` post nothing.
    post [label="Post the sharpen comment", shape=parallelogram, output_schema="routing", timeout="5m",
        script="exec 3>&1 >>/tmp/fabro/sharpen/post.log 2>&1
S=/tmp/fabro/sharpen
N=$(cat $S/issue_number)
R=$(cat $S/repo)
STATE=$(cat $S/outcome 2>/dev/null || echo failed)
HASH=$(cat $S/body_hash)
APPLIED=$(cat $S/applied_hash 2>/dev/null || true)
[ -n \"$APPLIED\" ] && [ \"$STATE\" = applied ] || APPLIED=-
RC=-
if [ \"$STATE\" = applied ] && [ -s $S/recheck/verdict ]; then RC=$(cat $S/recheck/verdict); fi
RND=$(cat $S/round 2>/dev/null || echo 0)
RUN=$(cat $S/run_id 2>/dev/null || true)
[ -n \"$RUN\" ] || RUN=unknown
{
  case \"$STATE\" in
    applied) echo 'The factory rewrote this issue'\"'\"'s acceptance criteria so the pipeline can verify each one. The original body is in the `fabro:sharpen-original` comment above this one, and every criterion is still here: one that cannot be verified moved to `## Post-deploy checks`.' ;;
    capped) echo 'The factory tried to sharpen this issue'\"'\"'s acceptance criteria, and a fresh audit still found problems after '\"$RND\"' rounds, so the issue was left as written.' ;;
    churn) echo 'The factory tried to sharpen this issue'\"'\"'s acceptance criteria, and the proposal kept changing instead of settling, so the issue was left as written.' ;;
    *) echo 'The issue was edited while the factory was sharpening it, so nothing was applied.' ;;
  esac
  echo
  cat $S/audit/changes.md 2>/dev/null || true
  if [ \"$(jq '(.human_actions // []) | length' $S/draft.json 2>/dev/null || echo 0)\" -gt 0 ]; then
    echo
    echo '### Human actions (not part of the issue)'
    echo
    jq -r '.human_actions[] | \"- \" + .' $S/draft.json
  fi
} > $S/comment.core
if [ \"$STATE\" != applied ] && [ -s $S/open_findings.json ] && [ \"$(jq 'length' $S/open_findings.json 2>/dev/null || echo 0)\" -gt 0 ]; then
  { echo; echo '### Open findings'; echo; jq -r 'group_by(.lens)[] | \"**\" + .[0].lens + \"**\", \"\", (.[] | \"- [\" + .severity + \"] \" + (if .criterion_ref == null then \"\" else .criterion_ref + \": \" end) + .message), \"\"' $S/open_findings.json; } > $S/comment.findings
else
  : > $S/comment.findings
fi
if grep -q '[^[:space:]]' $S/paraphrase.md 2>/dev/null; then
  { echo; echo '### What an implementer reads'; echo; cat $S/paraphrase.md; } > $S/comment.paraphrase
else
  : > $S/comment.paraphrase
fi
{ echo; echo '<details><summary>The proposed body</summary>'; echo; echo '~~~~~~markdown'; cat $S/audit/proposed.md 2>/dev/null || true; echo '~~~~~~'; echo; echo '</details>'; } > $S/comment.details
echo \"<!-- fabro:sharpen state=$STATE round=$RND body=$HASH applied=$APPLIED recheck=$RC run=$RUN -->\" > $S/comment.head
BODY=$S/comment.md
cat $S/comment.head $S/comment.core $S/comment.findings $S/comment.paraphrase $S/comment.details > $BODY
if [ \"$(wc -c < $BODY)\" -gt 60000 ]; then cat $S/comment.head $S/comment.core $S/comment.findings $S/comment.paraphrase > $BODY; fi
if [ \"$(wc -c < $BODY)\" -gt 60000 ]; then cat $S/comment.head $S/comment.core $S/comment.findings > $BODY; fi
if [ \"$(wc -c < $BODY)\" -gt 60000 ]; then cat $S/comment.head $S/comment.core > $BODY; fi
awk -v t1=\"${FABRO_API_TOKEN:-}\" -v t2=\"${GITHUB_TOKEN:-}\" -v t3=\"${GH_TOKEN:-}\" 'function scrub(line, t,  out, i) { if (length(t) < 8) return line; out = \"\"; while ((i = index(line, t)) > 0) { out = out substr(line, 1, i - 1) \"[redacted]\"; line = substr(line, i + length(t)) } return out line } { $0 = scrub($0, t1); $0 = scrub($0, t2); $0 = scrub($0, t3); print }' $BODY > $BODY.scrubbed && mv $BODY.scrubbed $BODY
if [ ! -s $BODY ]; then echo 'post: could not build the sharpen comment' >&2; echo '{\"context_updates\":{\"posted\":false}}' >&3; exit 0; fi
ID=$(gh api \"repos/$R/issues/$N/comments?per_page=100\" --paginate 2>/dev/null | jq -s 'add // []' | jq -r '[(.[] | select((.body // \"\") | startswith(\"<!-- fabro:sharpen \"))) | .id] | last // \"\"')
OK=false
if [ -n \"$ID\" ]; then
  if jq -n --rawfile b $BODY '{body: $b}' | gh api -X PATCH \"repos/$R/issues/comments/$ID\" --input - >/dev/null; then OK=true; else echo 'post: could not edit the existing sharpen comment' >&2; fi
else
  if gh issue comment \"$N\" --body-file $BODY >/dev/null; then OK=true; else echo 'post: could not post the sharpen comment' >&2; fi
fi
echo 'post: '$STATE' on issue '$N' (comment written: '$OK')' >&2
echo '{\"context_updates\":{\"posted\":'$OK'}}' >&3
exit 0"]

    // ---- The run's record (C11) ----
    //
    // Always exits 0, and every ending reaches it (R12). It emits the outcome through
    // `context_updates` on its own `stage.completed`, which is where the scheduler reads it.
    // An outcome file nobody wrote means a node failed: the record says `failed`.
    record [label="Record the outcome", shape=parallelogram, output_schema="routing", timeout="1m",
        script="S=/tmp/fabro/sharpen
rd() { cat \"$S/$1\" 2>/dev/null || true; }
OUT=$(rd outcome)
case \"$OUT\" in applied | capped | churn | stale | cannot_sharpen | not_needed) ;; *) OUT=failed ;; esac
RND=$(rd round)
[ -n \"$RND\" ] || RND=0
CH=0
TR=''
if jq -e . $S/draft.json >/dev/null 2>&1; then
  CH=$(jq '(.changes // []) | length' $S/draft.json 2>/dev/null || echo 0)
  TR=$(jq -r '[(.changes // [])[].transformation] | group_by(.) | map(.[0] + \"=\" + (length | tostring)) | join(\",\")' $S/draft.json 2>/dev/null || true)
fi
RC=''
if [ \"$OUT\" = applied ] && [ -s $S/recheck/verdict ]; then RC=$(cat $S/recheck/verdict); fi
AH=''
if [ \"$OUT\" = applied ]; then AH=$(rd applied_hash); fi
jq -nc --arg o \"$OUT\" --arg r \"$(rd rule)\" --arg n \"$RND\" --arg b \"$(rd body_hash)\" --arg a \"$AH\" --arg c \"$RC\" --arg ch \"$CH\" --arg t \"$TR\" '{context_updates:{sharpen_outcome:$o, sharpen_rule:$r, round:($n | tonumber? // 0), body_hash:$b, applied_hash:$a, recheck:$c, changes:($ch | tonumber? // 0), transformations:$t}}' || echo '{\"context_updates\":{\"sharpen_outcome\":\"failed\"}}'
exit 0"]

    // A run whose outcome is `failed` must END failed, so the lease's release sees a failure
    // and retries it (D12). `record` always succeeds, so this node does the failing: a command
    // that exits 1, taken only when `sharpen_outcome=failed`. Every other outcome, `cannot_sharpen`
    // and `not_needed` included, ends the run succeeded. Its own unconditional edge leads to
    // `exit`, which is how a failed node ends a run failed in this repository (R12).
    fail [label="End the run failed", shape=parallelogram, timeout="1m",
        script="echo 'issue-sharpen: the run failed; the scheduler retries it up to twice more (D12)' >&2
exit 1"]

    start -> claim
    claim -> prep [condition="outcome=succeeded && context.sharpen_go=true"]
    claim -> record [condition="outcome=succeeded && context.sharpen_go=false"]
    claim -> record
    prep -> draft [condition="outcome=succeeded && context.prep_ok=true"]
    prep -> record
    draft -> draft_gate [condition="outcome=succeeded"]
    draft -> record
    draft_gate -> comprehend [condition="outcome=succeeded && context.draft_ok=true"]
    draft_gate -> record
    comprehend -> verify [condition="outcome=succeeded"]
    comprehend -> record
    verify -> preserve [condition="outcome=succeeded"]
    verify -> record
    preserve -> audit_gate [condition="outcome=succeeded"]
    preserve -> record
    audit_gate -> apply [condition="outcome=succeeded && context.sharpen_result=converged"]
    audit_gate -> draft [condition="outcome=succeeded && context.sharpen_result=open"]
    audit_gate -> post [condition="outcome=succeeded && context.sharpen_result=capped"]
    audit_gate -> post [condition="outcome=succeeded && context.sharpen_result=churn"]
    audit_gate -> record
    apply -> recheck_prep [condition="outcome=succeeded && context.apply_result=applied"]
    apply -> post [condition="outcome=succeeded && context.apply_result=stale"]
    apply -> record
    recheck_prep -> recheck [condition="outcome=succeeded && context.recheck_ready=true"]
    recheck_prep -> post
    recheck -> recheck_gate [condition="outcome=succeeded"]
    recheck -> post
    recheck_gate -> recheck_post [condition="outcome=succeeded"]
    recheck_gate -> post
    recheck_post -> post
    post -> record
    record -> fail [condition="context.sharpen_outcome=failed"]
    record -> exit
    fail -> exit
}
