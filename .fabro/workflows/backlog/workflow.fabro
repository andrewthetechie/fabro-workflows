digraph Backlog {
    graph [
        goal="Backlog: decompose the next agent-labeled issue, implement each task with review, and open a PR",
        // The graph stall watchdog, raised from its 30-minute default because
        // `watch_checks` sits silent for longer than that, and of the two bounds the
        // SMALLER one silently wins.
        //
        // A command node emits exactly two events, CommandStarted and CommandCompleted
        // (handler/command.rs:94 and :155). Command output is streamed to a log recorder
        // and finalised into a blob, never into the event stream, so a node that polls
        // with `sleep 30` is invisible to the watchdog -- which re-arms only from
        // Emitter::last_activity() (pipeline/execute.rs:85-116) and parks only while the
        // run is blocked on a human. `watch_checks` is exactly that shape.
        //
        // At the 30m default (graph.rs:687) the node's own timeout was unreachable and
        // the watchdog CANCELLED the run rather than failing the stage: no
        // report_blocked, no PR comment, no ai-review-needs-human label, and the
        // 60-minute merge_deadline unspendable. Seven runs died this way between
        // 2026-09-20 and 2026-09-22, each at exactly 1800s in review_merge.watch_checks,
        // each leaving an open unmerged PR and its issue parked on `Review`:
        // 01M30HAD24GGT0G0SA7269RA88, 01M310TMY1B32BMD4GKRY6FRGF,
        // 01M317TAHWW6HFMZ6WMVVZ87W9, 01M31GMNY3YE8DYTF7C20BKVFQ,
        // 01M325W5B6FNMFM5NTWYSXG4NM, 01M33KG46HYJ9DXB34FB0Z479C and
        // 01M33KW2F4A89VDFJHXC73GD25. It is item 2 of
        // docs/research_improvements/01-tier-1-single-attribute-fixes.md, written up on
        // 2026-09-20 and applied here.
        //
        // 60m keeps EVERY node timeout strictly below it, which is the property that
        // matters: a node timeout routes -- watch_checks to mark_needs_human -- and a
        // watchdog cancel does not. The tallest command node is `watch_checks` at 50m.
        // `coder` at 180m is the only node of any kind above this, and an agent emits an
        // event per stream delta, so the watchdog only ever sees one that has genuinely
        // gone silent.
        //
        // The cost is 30 more minutes before a hung provider is caught on a long agent
        // stage. That backstop cancels the run either way, and every agent node here
        // already carries its own measured timeout.
        stall_timeout="60m",
        // Fabro's failure-signature breaker counts run-wide and never resets on success
        // (lifecycle/circuit_breaker.rs). At the default of 3 it ended run 01M4G6C8MWBYJPY84QQ8BNB6DT
        // (womens-fantasy-sports#1413) after 6.4 h: `validate` failed once on each of three
        // different tasks, the masked signatures matched, and no PR was opened. This run can
        // hit the same gate up to 8 decomposed tasks plus extra-review follow-ups, several
        // times each. The rework ladder (round 6) and the human gates already bound every
        // loop, so the breaker adds no protection the graph lacks. 100 is well above any
        // count observed (writers-app#963 saw 21 validate failures in one run).
        loop_restart_signature_limit=100,
        // Bound the preamble. `compact` (the default) prepends EVERY completed stage to
        // every agent prompt, with up to 25 lines of command output each
        // (handler/llm/preamble.rs:391, COMPACT_OUTPUT_MAX_LINES=25), plus the whole
        // context table. By task 7 of a long run that is tens of thousands of tokens of
        // jq gate chatter in front of an 8 KB prompt -- and on local llama.cpp, prefill
        // is a real share of per-turn latency.
        //
        // `truncate` is the floor: `Goal:` and `Run ID:`, about sixty characters. It
        // replaced `summary:low` on 2026-09-19 after the preamble was measured on run
        // 01M2X2MVPC2NXY1BW5CVKPFF3S -- 21 KB of 89 KB across eight agent stages, 23%,
        // of which 13.7 KB was command-node scripts printed TWICE. Fabro writes the whole
        // script into `outcome.notes` (handler/command.rs:198, \"Script completed: {script}\")
        // and the preamble then prints the same script again as `- Script:`
        // (handler/llm/preamble.rs, both the Low and Medium branches). Even the cheapest
        // summary level pays that duplication.
        //
        // Nothing here needs the recap: every prompt names its inputs by path, which is
        // the point of the file-backed contracts. The one exception was `human.gate.text`,
        // which `record_guidance` writes to a file instead.
        default_fidelity="truncate",
            // reasoning_effort: medium on the classes that run on `coders`, and only
            // those. Measured against the llama.cpp box itself (10.10.0.29, direct,
            // no gateway), identical prompt:
            //
            //   no parameter          875 completion tokens, 1496 reasoning chars
            //   reasoning_effort=low  678                    1436
            //   reasoning_effort=high 1208                   3042
            //
            // fabro defaults reasoning_effort to `high` and transmits it. Sandcastle's
            // config never set it, so opencode sent no parameter -- and llama.cpp does
            // honour the difference: `high` is 1.38x the tokens of the default. At the
            // box's measured 17.4 tok/s that is ~69s per turn instead of ~50s, which
            // over a 60-turn coder stage is the difference between 50 and 95 minutes.
            // `medium` is the closest fabro can get to "no parameter"; `low` undershoots
            // the model's own default.
            //
            // The hosted tiers (glm-5.3-flash, kimi-for-coding, glm-5.3, kimi-k3) are left
            // at the default. The measurement above is specific to this local GGUF endpoint
            // and says nothing about z.ai or kimi, and the review classes are where the
            // thinking is the product rather than the overhead.
            //
            // NO CLASS MAY NAME glm-4.7, and nothing may fall back to it. It is the only
            // model in this server's catalog whose record carries
            // `features.reasoning: false` (`fabro model list --json`); every other model
            // named here is `true`. The z.ai endpoint nonetheless RETURNS a reasoning
            // block sometimes, and on the next turn fabro has to replay that assistant
            // message against its own capability record and refuses locally -- 3ms, no
            // request leaves the host:
            //     LLM error: model zai/glm-4.7 does not support reasoning
            // It classifies `api_deterministic|zai|invalid_request`, and that category
            // both bypasses the retry budget (`max_retries=1` never engages) and skips
            // `[run.model.fallbacks]`, which only covers errors and rate limits. So the
            // stage dies outright and takes its unconditional edge to `human_rescue`.
            // Nondeterministic by nature: it fires only when the model happens to emit
            // reasoning, so `.coder-t2` passed for weeks before run
            // 01M33SDMZF55NAEV8JV29A8EA4 lost `rework_t2` to it on 2026-09-22 with six
            // of seven tasks already landed. `fabro validate` cannot see this -- the
            // graph is valid and the class resolves.
            //
            // glm-5.3-flash replaces it on `.coder-t2`: reasoning-capable, on the same
            // z.ai coding plan (unmetered), and a 262144 window against glm-4.7's 202752,
            // so the rung is strictly wider than the one it replaces. The ladder keeps
            // four distinct rungs -- box, flash, kimi-for-coding, full 5.3. The shared
            // `timeout="45m"` on all four rework tiers is a house number covering the
            // local box AND three hosted models rather than a glm-4.7 measurement, so
            // moving this class does not void it; flash is the faster of the two 5.3s
            // and t4 already runs full 5.3 inside the same budget.
            //
            // coder_pool: the root stylesheet is the ONLY per-run model-routing lever
            // fabro offers. Node-level `model` attributes are literal text (not
            // templated) and `args.model` on the run intent loses to any explicit
            // stylesheet assignment, but the root `model_stylesheet` is a MiniJinja
            // template that receives `inputs`. The scheduler fires a run with
            // `args.inputs.coder_pool = "coders-a"` to lease one llama.cpp box for the
            // whole run; the box is pinned per run, which is what stops two concurrent
            // runs queueing behind each other's turns.
            //
            // The `default('coders-a')` filter is LOAD-BEARING, and single quotes are
            // mandatory: the stylesheet renders in strict mode, so an unbound input
            // FAILS the run at compile (`422 run_compile_invalid`) rather than rendering
            // empty, and an unescaped `"` would terminate this DOT attribute string.
            // The default is a pinned box (`coders-a`), not the retired both-boxes
            // `coders` group (ADR 0007, task 04 removed it with the LiteLLM provider);
            // the escape hatch fires an explicit `coder_pool` so it never relies on this.
            //
            // `.plan` is the planner (ADR 0030): `glm-5.3` with no `reasoning_effort`,
            // exactly like `.decomp`, so it runs a configuration already proven on this
            // server. It does the dossier's job on a hosted model and also writes the edit
            // plan the coder follows -- the strong-model-plans, small-model-edits split. It
            // replaced `.improve`, which ran the same job on the run's own box at 24% of all
            // stage time (#25); the box now only codes. It is one more glm-5.3 stage per task
            // against z.ai's 3 concurrent sessions (ADR 0003), which is the cost the close of
            // the trial accepted.
            //
            // The review classes are split one-per-node rather than sharing a `.review`
            // rule. They used to share it, which meant the three per-task reviewers and
            // the three merge-phase reviewers -- the gate in front of an unattended
            // squash into `main` -- could not be tuned apart. `.review-standards` and
            // `.merge-standards` now take glm-5.3-flash: a standards review reads a
            // documented rubric rather than exercising judgement, which is the cheapest
            // kind of check to move down a tier, and flash carries a 262144 window
            // against full 5.3's 202752. Every model named here must also exist in the
            // server settings overlay or the run dies at its first node; `fabro validate`
            // does not check the catalog.
            //
            // `.refute` is the Refuter in the imported merge phase (ADR 0013 D6). It runs on
            // gpt-6-luna (openai) so its model family is unlike the coder's AND the reviewers'
            // -- the adversarial value it exists for. It moved from gpt-6.1-sol on 2026-10-14
            // for cost: luna is a twentieth of Sol's price on every token line, and the
            // Refuter's ~65 visits a day had made it ~$300/month (ADR 0013 D6 amendment). Its
            // fallback is `orfallback:qwen3.8-27b`, non-OpenAI and non-GLM, so an OpenAI outage
            // still has an independent Refuter. Change the rule here AND in the other
            // importing graphs; the `"gpt-6-luna"` fallback row lives in each workflow.toml.
        model_stylesheet="
            *                 { model: coders-a; }
            .decomp           { model: glm-5.3; }
            .plan             { model: glm-5.3; }
            .coder            { model: {{ inputs.coder_pool | default('coders-a') }}; reasoning_effort: medium; }
            .coder-t2         { model: glm-5.3-flash; }
            .coder-t3         { model: kimi-for-coding; }
            .coder-t4         { model: glm-5.3; }
            .rebase           { model: {{ inputs.coder_pool | default('coders-a') }}; reasoning_effort: medium; }
            .rebase-t2        { model: glm-5.3; }
            .review-task      { model: glm-5.3; }
            .review-standards { model: glm-5.3-flash; }
            .review-quality   { model: glm-5.3; }
            .review-frontier  { model: kimi-k3; }
            .merge-standards  { model: glm-5.3-flash; }
            .merge-spec       { model: glm-5.3; }
            .merge-fix        { model: glm-5.3; }
            .ci-fix           { model: glm-5.3-flash; }
            .refute           { model: gpt-6-luna; }
            .refute-fix       { model: {{ inputs.coder_pool | default('coders-a') }}; reasoning_effort: medium; }
            .merge-resolve    { model: {{ inputs.coder_pool | default('coders-a') }}; reasoning_effort: medium; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // ---- Claim the dispatched issue ----
    // The scheduler chose the issue and passed it as `issue_number` (overview
    // decision 3). The graph no longer selects an issue itself; the run input is the
    // only way to decide what this run works. `args.inputs` values that reach
    // this POSIX `case` guard are JSON numbers (the scheduler sends one and
    // `ops/fabro-fire-backlog.sh` sends one); a string would either fail the guard
    // or, worse, match it by accident. `pr-review`'s `validate_input` is the
    // precedent for exactly this shape.
    //
    // The label swap stays here as a fallback. The scheduler already swapped
    // `agent` -> `agent-in-progress` at dispatch (overview decision 9), but the
    // manual path does not, so `claim` is idempotent about it: add
    // `agent-in-progress` if absent, remove `agent` if present, never fail because
    // either is already in the target state.
    //
    // Fail closed. The run's job description is exactly `issue_number`; working a
    // different issue is the failure this whole design exists to prevent. So `claim`
    // quits rather than continue when the issue is gone, closed, or does not carry
    // `agent-in-progress` after the swap -- all three route to human_rescue via the
    // node's unconditional edge. (The old optimistic-claim/ULID arbitration this
    // replaced is recorded in ADR 0005 and the scheduler overview.)
    // `mkdir -p /tmp/fabro` is load bearing. `claim` is the run's first node since draft
    // 10 deleted `acquire`, and `acquire` was the only node that created that directory.
    // Without it every redirect below fails with `/tmp/fabro/issue.json: No such file or
    // directory` and the run parks on human_rescue for 4h holding its coder lease.
    // `ops/gate_tests/` stages this node against a path that does not exist, which
    // is the only way a test can catch it -- neither `fabro validate` nor
    // ops/check-graph-invariants.py runs a node's shell.
    //
    // `/tmp/fabro/issue_number` is written BEFORE the label swap and before any network
    // call, because mark_stuck needs it precisely when everything after that line failed.
    // issue.json is the usual source of the number and does not exist until the fetch
    // below succeeds, so an issue whose receipt was already written but whose fetch then
    // failed would reach mark_stuck with nothing to name, and the receipt would stay on
    // the issue forever. `pr-review` writes /tmp/fabro/pr_number for the same reason.
    //
    // The fetch is retried three times, five seconds apart. It is the one network call
    // between the receipt being written and the run being able to do anything, and a
    // single transient `gh` failure costs a coder box for four hours: the unconditional
    // edge parks the run on human_rescue, whose default choice is mark_stuck, so the run
    // ends `succeeded` and the scheduler's requeue rule -- which keys on a FAILED run's
    // reason -- never sees it. A genuinely missing or unreadable issue still fails closed,
    // which is what the whole node is for. `state` is fetched so those checks can see a
    // closed issue; the downstream readers (open_pr_prep, open_pr, mark_stuck) use
    // number/title/body/labels.
    //
    // These comments live here rather than inside `script=` on purpose. Fabro writes a
    // command node's whole script into `outcome.notes` and its preamble then prints it
    // again, so every byte inside the attribute was paid twice in the next agent's prompt
    // at any `summary:*` fidelity. `truncate` removes that cost today; keeping the prose
    // out here means raising fidelity later cannot bring it back.
    claim [label="Claim issue and fetch it", shape=parallelogram,
        script="set -e
mkdir -p /tmp/fabro
ISSUE='{{ inputs.issue_number }}'
case \"$ISSUE\" in '' | *[!0-9]*) echo 'issue_number must be a positive integer' >&2; exit 1;; esac
if [ \"$ISSUE\" -lt 1 ]; then echo 'issue_number must be a positive integer' >&2; exit 1; fi
echo $ISSUE > /tmp/fabro/issue_number
gh label create agent-in-progress --color FBCA04 2>/dev/null || true
gh label create agent-stuck --color D93F0B 2>/dev/null || true
gh label create agent-authored --color 1D76DB 2>/dev/null || true
gh label create Review --color 0E8A16 2>/dev/null || true
gh issue edit $ISSUE --add-label agent-in-progress --remove-label agent || true
A=1
while :; do
  if gh issue view $ISSUE --json state,number,title,body,labels > /tmp/fabro/issue.json 2>/tmp/fabro/issue_view.err; then break; fi
  if [ $A -ge 3 ]; then
    echo 'could not read issue '$ISSUE' after '$A' attempts:' >&2
    cat /tmp/fabro/issue_view.err >&2
    exit 1
  fi
  A=$((A + 1))
  sleep 5
done
S=$(jq -r .state /tmp/fabro/issue.json)
if [ \"$S\" != OPEN ]; then
  echo 'issue '$ISSUE' is '$S', not OPEN; refusing to work a closed issue' >&2
  exit 1
fi
if ! jq -e '.labels | map(.name) | index(\"agent-in-progress\")' /tmp/fabro/issue.json >/dev/null 2>&1; then
  echo 'issue '$ISSUE' does not carry agent-in-progress after the label swap; refusing to work the wrong issue' >&2
  exit 1
fi"]

    // `max_retries=1` because this node's whole job is one network-bound install and a
    // single transient registry failure otherwise costs the entire run plus its coder
    // lease. `prep` is the run's first real work, so there is nothing to lose by
    // repeating it: `setup.sh` is already run again by `validate` and `open_pr_prep`, so
    // it is idempotent by construction, and the three `echo 0` counters are being
    // initialised rather than advanced -- rewriting them on a second attempt is correct.
    //
    // Run 01M310TQEWFMPHZ3XG5T22X09W (womens-fantasy-sports#1205, 2026-09-21) is the
    // case: `uv` could not reach pypi.org for `hatchling` -- `Request failed after 3
    // retries in 48.6s ... operation timed out` -- and the stage ended `failed` with
    // `category: transient_infra, will_retry: false`. The classification was right and
    // changed nothing, because a node with no `max_retries` inherits
    // `default_max_retries=0`; being retry-ELIGIBLE is not the same as being retried.
    // The proof that one retry was enough: `open_pr_prep` ran the same `./.fabro/setup.sh`
    // 90 seconds later, on the same sandbox, and it PASSED. The run then walked the
    // unconditional edge to `human_rescue` and opened an empty PR (#1236) instead.
    //
    // The cost is bounded at one extra 20m attempt on a genuinely broken setup, against
    // a 4h `human_rescue` park holding one of two coder boxes. `uv`/`npm` already retry
    // internally, so this only fires on an outage that outlasts their own backoff.
    // Build the code index after .fabro/setup.sh (docs/code-context C2/C4), which can
    // create or remove files the index should see. The `command -v` guard keeps an
    // image built before task 02 working: prep runs `set -e`, and without it a missing
    // fabro-code would exit 127 and fail every run. `fabro-code index` never exits
    // non-zero and `map` has `|| true`, so an index failure cannot fail prep (ADR 0014
    // D3) -- the index makes agents faster; correctness does not depend on it.
    //
    // The last lines install the agent guide (docs/coder-tweaks 02, C1): pebble loads
    // `.codex/instructions.md` into the SYSTEM prompt next to AGENTS.md, which is where its
    // `rg` advice lives. FABRO_AGENT_GUIDE is generated into workflow.toml from
    // `_io/agent-guide.md`. It is skipped, with one stderr line, when the variable is empty
    // or the repository tracks that file; the file is excluded like `.codegraph/`, so the
    // checkpoint never commits it. It never fails the node.
    prep [label="Prep workspace and install deps", shape=parallelogram, timeout="20m", max_retries=1,
        script="set -e
mkdir -p /tmp/fabro/review /tmp/fabro/feedback /tmp/fabro/extra
echo 0 > /tmp/fabro/extra_round
echo 0 > /tmp/fabro/split_rounds
echo 0 > /tmp/fabro/tasks_coded
rm -f /tmp/fabro/remainder.json /tmp/fabro/remainder_issue /tmp/fabro/stuck_reason.md
./.fabro/setup.sh
grep -qx '.codegraph/' .git/info/exclude 2>/dev/null || echo '.codegraph/' >> .git/info/exclude
if command -v fabro-code >/dev/null; then fabro-code index; fabro-code map || true; else echo 'failed: fabro-code not in image' > /tmp/fabro/code_index; fi
if [ -z \"$FABRO_AGENT_GUIDE\" ]; then echo 'agent guide: FABRO_AGENT_GUIDE is empty, nothing installed' >&2
elif git ls-files --error-unmatch .codex/instructions.md >/dev/null 2>&1; then echo 'agent guide: the repository tracks .codex/instructions.md, left alone' >&2
elif mkdir -p .codex && printf '%s' \"$FABRO_AGENT_GUIDE\" > .codex/instructions.md; then grep -qx '.codex/instructions.md' .git/info/exclude 2>/dev/null || echo '.codex/instructions.md' >> .git/info/exclude
else echo 'agent guide: could not write .codex/instructions.md' >&2; fi"]

    // ---- The lane (ADR 0023) ----
    // An issue labelled `fast-path` beside `agent` was chosen by a human as a one-commit
    // change (operator decision O1/O2). The Scout adds the same label to a Ratchet rule
    // issue it files (ADR 0027): that issue is generated from a template, its fix is
    // bounded, and its checks run in `ci.sh`, so it takes this lane too. The label is read
    // from /tmp/fabro/issue.json, which
    // `claim` wrote with `gh issue view --json ...,labels`, so this node makes no network
    // call. It never guesses: a file it cannot read, or one without a `labels` array, exits
    // 1 and the unconditional edge goes to rescue_brief.
    //
    // The lane is exactly the label `fast-path`: `Fast-Path` and `fast-path-x` are standard.
    // In the fast lane the node writes the one task that `decompose` would have written, so
    // `next_task` and the coder run unchanged: no decompose, no plan, no excerpts, no
    // extra review. An empty issue body becomes `Resolve issue #N: <title>`, because the
    // coder needs a non-empty body. In the standard lane it writes only /tmp/fabro/lane
    // and leaves tasks.json for `decompose`.
    //
    // It also used to pick the run's arm of the plan trial (docs/plan-trial/, #25): an
    // even issue number planned on a hosted `plan` node and an odd one kept `improve` on
    // the box. The trial closed on 2026-10-21 (`result-2026-10-21.txt`) and ADR 0030 kept
    // `plan`, so `lane` is the only thing this node publishes now.
    route_lane [label="Choose the lane", shape=parallelogram, output_schema="routing", timeout="1m",
        script="set -e
F=/tmp/fabro/issue.json
jq -e '(.labels | type) == \"array\"' $F >/dev/null || exit 1
if jq -e '[.labels[].name] | index(\"fast-path\") != null' $F >/dev/null; then
  jq '[{id: \"fast-path\", title: .title, body: (if ((.body // \"\") | gsub(\"[[:space:]]\"; \"\")) == \"\" then \"Resolve issue #\" + (.number | tostring) + \": \" + .title else .body end), files: [], covers: [], source: \"fast-path\"}]' $F > /tmp/fabro/tasks.new.json
  mv /tmp/fabro/tasks.new.json /tmp/fabro/tasks.json
  echo 0 > /tmp/fabro/task_index
  echo fast > /tmp/fabro/lane
  echo '{\"context_updates\":{\"lane\":\"fast\"}}'
else
  echo standard > /tmp/fabro/lane
  echo '{\"context_updates\":{\"lane\":\"standard\"}}'
fi"]

    // ---- Decomposition (agent writes file; gate validates) ----
    // `max_retries=1` on every agent node in this graph, for the reason spelled out on
    // `coder` below: a provider stream that stalls without erroring is invisible to the
    // LLM retry and to the model fallback chain, so the node timeout is the only
    // backstop -- and it classifies `transient_infra`, which IS retry-eligible, but
    // `default_max_retries` is 0.
    //
    // Added here after run 01M2PSA224HXTXJSSVBGTVPYF1 sat blocked at human_rescue for
    // nearly six hours, holding one of two scheduler slots, because `improve` timed out
    // at 1200s and had no retry. `improve`'s longest successful run on record is 522s,
    // so a 20m timeout is a stall rather than slow work -- exactly the case a retry
    // absorbs. The first pass at this fix covered `coder` and the rework tiers only;
    // scoping it that narrowly is what cost those six hours.
    //
    // Still NOT a graph-level `default_max_retries`: that would also apply to the
    // command gates, whose `exit 1` is a routing signal and whose attempt counters an
    // engine retry would double-increment.
    decompose [label="Decompose issue", class="decomp", timeout="30m", max_retries=1, prompt="@prompts/decompose.md.j2"]

    // On `contradiction` (#17, docs/unmet-criteria C3) it writes return.json and publishes
    // `triage_questions` for return_to_triage's Discord hook; every routing object carries
    // the key. Its `QT=` line is task_block_gate's, word for word: change them together.
    decompose_gate [label="Validate decomposition", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/decomposition.json
A=$(cat /tmp/fabro/decompose_attempts 2>/dev/null || echo 0)
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
RM=0; if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then RM=1; S=invalid; else S=$(jq -r .status $F 2>/dev/null || echo invalid); fi
if [ \"$S\" != issues ] && [ \"$S\" != no_work ] && [ \"$S\" != needs_human_review ] && [ \"$S\" != contradiction ]; then S=invalid; fi
if [ \"$S\" = contradiction ]; then
  GOOD=$(jq '(.issues | type) == \"array\" and (.issues | length) == 0 and (.contradictions | type) == \"array\" and (.contradictions | length) > 0 and ([.contradictions[] | select(((.criterion // \"\") | tostring) == \"\" or ((.non_goal // \"\") | tostring) == \"\" or ((.needed_surface // \"\") | tostring) == \"\")] | length) == 0' $F 2>/dev/null || echo false)
  if [ \"$GOOD\" != true ]; then S=invalid; fi
fi
if [ \"$S\" = issues ]; then
  T=$(jq -r '.issues | type' $F 2>/dev/null || echo none)
  N=$(jq '.issues | length' $F 2>/dev/null || echo 0)
  BAD=$(jq '[.issues[] | select((.id | type) != \"string\" or (.title | type) != \"string\" or (.body | type) != \"string\" or (.files | type) != \"array\" or (.id | length) == 0 or (.title | length) == 0 or (.body | length) == 0)] | length' $F 2>/dev/null || echo 99)
  if [ \"$T\" != array ] || [ \"$N\" = 0 ] || [ \"$BAD\" != 0 ]; then S=invalid; fi
fi
if [ \"$S\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/decompose_attempts
  if [ $A -lt 2 ]; then if [ $RM = 1 ]; then echo 'no valid Input receipt: write the result with the submit tool, not write_file' >&2; else echo 'decomposition.json missing or invalid; rewrite it exactly per the contract' >&2; fi; exit 1; fi
fi
echo 0 > /tmp/fabro/decompose_attempts
if [ \"$S\" = issues ]; then
  jq '[.issues[] | . + {source: \"decompose\", covers: (if (.covers | type) == \"array\" then .covers else [] end)}]' $F > /tmp/fabro/tasks.json
  echo 0 > /tmp/fabro/task_index
fi
CNT=$(jq '.issues | length' $F 2>/dev/null || echo 0)
OVER=0
if [ \"$S\" = issues ]; then
  OVER=$(jq '[.[] | select((.covers | length) > 3)] | length' /tmp/fabro/tasks.json 2>/dev/null || echo 0)
  if [ \"$OVER\" != 0 ]; then
    echo 'WARNING: '$OVER' task(s) declare more than three covers entries, which on measured history means they will not land in one coder stage:'
    jq -r '.[] | select((.covers | length) > 3) | \"  - \" + .id + \": \" + ((.covers | length) | tostring) + \" requirements\"' /tmp/fabro/tasks.json
    echo 'plan decides what to do about it: it runs per task against the checkout as it will actually be, and can split.'
  fi
fi
if [ \"$S\" = needs_human_review ]; then jq -r '.summary // empty' $F > /tmp/fabro/stuck_reason.md 2>/dev/null || true; fi
QT=''
if [ \"$S\" = contradiction ]; then
  jq '{source: \"decompose\", summary: (.summary // \"\"), items: [.contradictions[] | {criterion, non_goal, why: .needed_surface}]}' $F > /tmp/fabro/return.json
  QT=$(jq -r '[.items[] | \"- \" + .criterion + \" (conflicts with: \" + .non_goal + \")\"] | join(\"  \")' /tmp/fabro/return.json | tr -d '\"' | cut -c1-1200)
fi
jq -nc --arg s \"$S\" --argjson c \"${CNT:-0}\" --argjson o \"${OVER:-0}\" --arg q \"$QT\" '{context_updates:{decomp_status:$s,task_count:$c,oversized_tasks:$o,triage_questions:$q}}'"]

    // The first lines drop the worktree `baseline_check` makes at /tmp/fabro/base-tree
    // (docs/coder-tweaks 04, C4): it is per task, and a stale one would hold the previous
    // task's base. They write nothing to stdout, because this node routes.

    // ---- Sequential task loop ----
    // The task budget (ADR 0011 D6, amended 2026-09-24) bounds the DECOMPOSED scope
    // of one run: at most 8 tasks from `decompose`, or slices the planner split out of
    // one, reach a coder. `improve_gate` counts them in `tasks_coded`. Once the budget
    // is spent, every decomposed task still queued moves to remainder.json, which
    // `file_remainder` files as one held issue after open_pr.
    //
    // Extra-review follow-ups are EXEMPT, and so are slices split from one (stamped
    // `from_extra` by improve_gate). They fix the branch this run is about to merge,
    // so deferring them would merge work the extra review had already said needs
    // fixing. They neither count toward the budget nor move to the remainder, and
    // the extra-review round cap in extra_prep bounds them instead. Only decomposed
    // tasks can sit ahead of them in the queue -- extra_gate appends after every
    // task has run -- so moving the decomposed ones out leaves the exempt ones in
    // order.
    // The map is re-rendered after the mainline refresh so it matches the tree the
    // next task's `plan` starts from, and the task dossier and its code excerpts
    // (`excerpts`) are deleted at the start of each task (docs/code-context C1/C3,
    // task 04/07). `fabro-code map` is stubbed out
    // (nothing to do on an old image) and must not print to stdout -- this node's
    // stdout is scanned for `context_updates`. On the merge-failed branch the tree is
    // clean at the pre-merge state, so that map is correct for the tree resolve_merge
    // starts from.
    next_task [label="Next task + mainline refresh", shape=parallelogram, output_schema="routing",
        script="git worktree remove --force /tmp/fabro/base-tree >/dev/null 2>&1
rm -rf /tmp/fabro/base-tree
git worktree prune >/dev/null 2>&1
rm -f /tmp/fabro/final_merge_conflict /tmp/fabro/task_blocked.json /tmp/fabro/task_block_scope.md
echo 0 > /tmp/fabro/merge_attempts
IDX=$(cat /tmp/fabro/task_index 2>/dev/null || echo 0)
COUNT=$(jq length /tmp/fabro/tasks.json)
if [ $IDX -ge $COUNT ]; then echo '{\"context_updates\":{\"tasks_done\":true,\"rebase_failed\":false}}'; exit 0; fi
TCD=$(cat /tmp/fabro/tasks_coded 2>/dev/null || echo 0)
case \"$TCD\" in ''|*[!0-9]*) TCD=0 ;; esac
if [ $TCD -ge 8 ]; then
  jq --argjson i $IDX '[.[$i:][] | select(((.source == \"extra-review\") or (.from_extra == true)) | not)]' /tmp/fabro/tasks.json > /tmp/fabro/remainder.new.json
  MOVED=$(jq length /tmp/fabro/remainder.new.json 2>/dev/null || echo 0)
  if [ \"$MOVED\" != 0 ]; then
    if [ -s /tmp/fabro/remainder.json ]; then cp /tmp/fabro/remainder.json /tmp/fabro/remainder.old.json; else echo '[]' > /tmp/fabro/remainder.old.json; fi
    jq -s '(.[0] + .[1]) | reduce .[] as $t ([]; if any(.[]; .id == $t.id) then . else . + [$t] end)' /tmp/fabro/remainder.old.json /tmp/fabro/remainder.new.json > /tmp/fabro/remainder.json
    jq --argjson i $IDX '.[0:$i] + [.[$i:][] | select((.source == \"extra-review\") or (.from_extra == true))]' /tmp/fabro/tasks.json > /tmp/fabro/tasks.trim.json
    mv /tmp/fabro/tasks.trim.json /tmp/fabro/tasks.json
    COUNT=$(jq length /tmp/fabro/tasks.json)
    echo 'task budget of 8 decomposed tasks spent: '$MOVED' task(s) moved to the remainder, which file_remainder files as one issue after open_pr'
  fi
  if [ $IDX -ge $COUNT ]; then echo '{\"context_updates\":{\"tasks_done\":true,\"rebase_failed\":false}}'; exit 0; fi
fi
jq '.['$IDX']' /tmp/fabro/tasks.json > /tmp/fabro/current_task.json
echo $((IDX+1)) > /tmp/fabro/task_index
echo 0 > /tmp/fabro/round
echo 0 > /tmp/fabro/review_attempts
echo 0 > /tmp/fabro/improve_attempts
rm -f /tmp/fabro/improve_result.json /tmp/fabro/improve_touched_tree
rm -f /tmp/fabro/task-context.md /tmp/fabro/task-code.md
git rev-parse HEAD > /tmp/fabro/pre_merge_sha
if git fetch origin main && git merge --no-edit origin/main; then
  git rev-parse HEAD > /tmp/fabro/task_base_sha
  fabro-code map >/dev/null 2>&1 || true
  echo '{\"context_updates\":{\"tasks_done\":false,\"rebase_failed\":false,\"review_decision\":\"none\",\"task_disposition\":\"none\",\"diff_too_large\":false}}'
else
  git merge --abort || true
  git rev-parse HEAD > /tmp/fabro/task_base_sha
  echo 'The mainline merge was attempted and aborted: leaving it in the tree would let the next checkpoint commit conflict markers. A dedicated resolve_merge stage redoes the merge and resolves it, so no rework agent should touch git.' > /tmp/fabro/feedback/rework.md
  fabro-code map >/dev/null 2>&1 || true
  echo '{\"context_updates\":{\"tasks_done\":false,\"rebase_failed\":true,\"review_decision\":\"none\",\"task_disposition\":\"none\",\"diff_too_large\":false}}'
fi"]

    // ---- Mainline conflict resolution ----
    // next_task (before a task) or final_merge (before the PR) aborted the failed merge
    // and left a clean tree. A conflicted merge
    // cannot cross a stage boundary: fabro's checkpoint would `git add -A` the
    // conflict-marked files, which git treats as resolved, and commit markers onto
    // the run branch. So the agent performs the merge itself, in one stage, and
    // resolve_merge_gate verifies the result from git rather than trusting a claim.
    resolve_merge [label="Resolve the mainline merge", class="coder-t4", timeout="30m", max_retries=1, prompt="@prompts/resolve_merge.md.j2"]

    // The conflict-marker scan covers what this merge can have touched — the files
    // changed since the pre-merge SHA, dirty tracked files, and untracked files the
    // next checkpoint would `git add -A` — rather than the whole worktree, which
    // would walk build output and would fire on any repository that legitimately
    // commits a conflict-marker fixture.
    //
    // `merge_return` says where a resolved merge goes: `pr` back to final_merge when
    // /tmp/fabro/final_merge_conflict exists, `task` on to the next task otherwise. It is
    // written on both branches. next_task deletes that file and resets merge_attempts on
    // every entry, its done branches included, so the final merge starts with both clean.
    resolve_merge_gate [label="Verify the mainline merge", shape=parallelogram, output_schema="routing",
        script="PRE=$(cat /tmp/fabro/pre_merge_sha 2>/dev/null || echo '')
A=$(cat /tmp/fabro/merge_attempts 2>/dev/null || echo 0)
RV=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
SV=$(jq -r '.visit // empty' /tmp/fabro/.io/served.json 2>/dev/null)
ROK=probe
if [ -z \"$RV\" ] || [ \"$SV\" != \"$RV\" ]; then ROK=no; fi
if [ \"$ROK\" = probe ]; then
  ROK=$(jq -r --argjson req '[\"pre_merge_sha\",\"current_task.json\",\"issue.json\"]' 'if (. as $r | all($req[]; ($r.inputs[.] // null) as $e | ($e != null) and ($e.status == \"ok\") and (($e.parts == 0) or (([range(1; ($e.parts + 1))] - ($e.served | map(select(. >= 1)))) | length == 0)))) then \"yes\" else \"no\" end' /tmp/fabro/.io/served.json 2>/dev/null || echo no)
fi
if [ \"$ROK\" != yes ]; then BAD=1; else BAD=0; fi
if [ -e .git/MERGE_HEAD ]; then BAD=1; fi
if git diff --name-only --diff-filter=U | grep -q . ; then BAD=1; fi
: > /tmp/fabro/merge_scan.txt
if [ -n \"$PRE\" ]; then git diff --name-only \"$PRE\" HEAD >> /tmp/fabro/merge_scan.txt 2>/dev/null || true; fi
git diff --name-only HEAD >> /tmp/fabro/merge_scan.txt 2>/dev/null || true
git ls-files --others --exclude-standard >> /tmp/fabro/merge_scan.txt 2>/dev/null || true
while IFS= read -r f; do
  [ -f \"$f\" ] || continue
  if grep -qI '<<<<<<< ' \"$f\"; then BAD=1; fi
done < /tmp/fabro/merge_scan.txt
if ! git merge-base --is-ancestor origin/main HEAD; then BAD=1; fi
MR=task
if [ -s /tmp/fabro/final_merge_conflict ]; then MR=pr; fi
if [ $BAD -ne 0 ]; then
  git merge --abort 2>/dev/null || true
  if [ -n \"$PRE\" ]; then git reset --hard \"$PRE\" || true; fi
  A=$((A+1))
  echo $A > /tmp/fabro/merge_attempts
  echo 'The merge agent left conflict markers, an in-progress merge, or a branch that still does not contain origin/main.' > /tmp/fabro/needs_human_reason
  echo '{\"context_updates\":{\"merge_ok\":false,\"merge_attempts\":'$A',\"merge_return\":\"'$MR'\"}}'
else
  git rev-parse HEAD > /tmp/fabro/task_base_sha
  echo '{\"context_updates\":{\"merge_ok\":true,\"merge_attempts\":'$A',\"merge_return\":\"'$MR'\"}}'
fi"]

    // Review-class agent nodes carry timeout="15m", not the 30m they had. The 30m was
    // never sized; it was the graph `stall_timeout` default written out by hand.
    //
    // Measured across runs 01M2RX2SGJJT09WK5FS8GYJCDE, 01M2RB5QBNBPS6C0F9904V25AX and
    // 01M2SBJG92TX0DBRKY5881VM34 -- 29 executions, every one of them:
    //
    //   extra_decompose  max  69s     spec      max 157s
    //   standards        max 216s     review    max 226s     quality   max 332s
    //   review_merge.standards max 384s   .spec max 262s   .review_fix max 309s
    //
    // 15m is 2.3x the slowest execution ever observed (384s) and 13x the median. The
    // old 30m was 5-26x, which is not headroom -- it is the price of a stall.
    //
    // A stalled provider is what this bounds. Run 01M2RX2SGJJT09WK5FS8GYJCDE lost 60
    // minutes to two of them: `agent.llm.started` on glm-5.3, a 502 from LiteLLM
    // 15m39s later, an immediate retry onto the SAME model, and nothing else until
    // the node timeout fired at 30m. Both stages then succeeded on the stage retry.
    // Halving the timeout halves that loss and changes nothing else -- `max_retries=1`
    // stays, so a genuinely slow stage still gets its second attempt.
    //
    // NOT retimed: `coder` (90m, max observed 2110s), `decompose` (30m, max 1009s),
    // `rework_t1..t4` (45m, never yet executed) and `resolve_merge` (30m, n=1). Those
    // have real tails or no evidence, and the same arithmetic does not hold for them.
    // See docs/perf/00-overview-and-measurements.md.
    //
    // That block used to carry a second half about `improve`, which `9b7f5ff` had moved
    // from glm-5.3 to `{{ inputs.coder_pool }}` while leaving its 15m timeout sized for
    // the hosted model. It is history now that `improve` is deleted (ADR 0030), but the
    // rule it stated holds and is why `plan` below is re-derived from its own times:
    // MOVING A CLASS TO A DIFFERENT MODEL VOIDS EVERY TIMEOUT DERIVED FROM THE OLD ONE.
    //
    // `plan` is the planner (ADR 0030): hosted glm-5.3 writes the dossier and a `## Plan`
    // section in task-context.md, ordered edits the coder makes in a fresh session. Its
    // contract is the one `improve` wrote before it, unchanged: the same `submit` output
    // (improve_result.json, schema improve_result), the same dispositions, the same
    // `improve_gate` with its split guards, task budget, revert backstop and attempt
    // counter, and the same `excerpts` after it. `improve_gate` sends a rejected result
    // back here.
    //
    // timeout="20m" is MEASURED on this node, not a peer value: docs/plan-trial/result-
    // 2026-10-21.txt, n=182 successful visits over 79 runs from 2026-10-14 to 10-21.
    //
    //   per visit minutes: p50 4.7   p90 7.5   max 12.7
    //   per run minutes:   p50 7.3   p90 27.7  max 63.2   (a run plans up to 8 tasks)
    //   stage timeouts:    1 of 183 visits, and max_retries=1 recovered it
    //
    // 20m is 1.6x the slowest successful visit and 2.7x p90. The review nodes' house rule
    // is 2.3x the slowest observed execution, which here would be 29m, and it is NOT
    // taken: this node has one failure mode -- a provider stall that produces nothing --
    // and the one stall in the window ran the full 20m and then succeeded on an 8.1-minute
    // retry. Every minute of the timeout is a minute of the run's lease (ADR 0006) and of
    // z.ai's 3 concurrent sessions (ADR 0003), so a stall stays bounded at 20m plus one
    // retry. 15m (the review peers) leaves 2.3 minutes over the observed maximum, on 1
    // visit in 182 above 12 minutes. One record in that window is not planner time and is
    // excluded: the 429-minute `plan` visit in run 01M5B0G5ZVJ2X5X5KZZACGKFRK is the
    // 10-19 disk fill (`~/.fabro-deploy/docs/FABRO-DEPLOYMENT-LOG.md`), not a stall.
    plan [label="Plan task", class="plan", timeout="20m", max_retries=1, prompt="@prompts/plan.md.j2"]

    // The `split` disposition, and why the size check lives HERE rather than in
    // `decompose`.
    //
    // Sandcastle's coder had no wall clock -- `--idle-timeout` plus a livelock
    // watchdog, both progress-based -- so an oversized task merely ran longer and
    // finished. Task size was a latency property, never a failure mode. The
    // decomposer prompt is a faithful port of that component (see
    // docs/backlog/06, `extra-issue-decomposer-prompt-prd.md`), and it splits on
    // cohesion and independence, with no notion of effort anywhere in it. Under
    // `coder`'s timeout="180m" that assumption no longer holds: a task too large
    // for one stage is killed mid-edit, so size became a correctness constraint
    // and nothing in the pipeline measured it.
    //
    // Measured on run 01M2TFEHPYXXTQST6VPXREA854 (womens-fantasy-sports#1196),
    // the third time this same task overran: `decompose` emitted two tasks, and
    // announced the problem in its own summary -- task 1 was "the fix for parent
    // criterion 2" (coder: 46m), task 2 "the consolidation for criteria 1, 3, 4,
    // 5, 6" (coder: 180m timeout + a 14m resuming retry). Across the 20 retained
    // coder/rework stages on this server the median is 24m and p90 is 47m, so
    // that task was ~4x p90 -- not a task to tune, a task to split. The signal
    // was already computed and written down in prose, and read by nothing.
    //
    // `covers` makes it a field. `decompose_gate` warns above three entries but
    // does NOT reject: rejecting costs a full retry round, and some issues
    // genuinely carry one fat criterion.
    //
    // `plan` is what acts on it, because that is where the information is. It
    // runs per task, immediately before the coder, against the checkout as it
    // ACTUALLY is -- earlier tasks in this run already committed -- so it can see
    // how much work genuinely remains. `decompose` is estimating work it has not
    // inspected, before any of the run has happened; on this same run `plan`
    // had already proved the point by catching drift the decomposer could not
    // have known about.
    //
    // Two independent guards stop a split loop, because one is not enough: slices
    // are stamped `source: "split"` and a slice can never be split again, AND
    // `split_rounds` caps the whole run at 2. Either guard alone would coerce the
    // disposition to `ready`; together they bound the queue whatever the model
    // does. The coercion deliberately leaves `current_task.json` untouched (a
    // `split` result carries no `.task` to write), so the refused task is
    // implemented as it stands rather than failing the run.
    //
    // The splice replaces the task IN PLACE at its own slot and rewinds
    // `task_index` to it, rather than appending the way `extra_gate` does. Slices
    // are prerequisites of each other and of nothing else, so appending them
    // after every remaining task would run them out of order.
    //
    // Backstop (docs/coder-tweaks/06, C5): `plan` is read-only, but runs
    // 01M3SN85YDECYRDVP3YYPYM6AM (edited 4 tracked files) and 01M3TN6GJK6PG1YEKCE786T16V
    // (stashed and popped the coder's work) show the prompt alone does not hold. The
    // first lines revert anything the planner's checkpoint changed: HEAD is its
    // checkpoint and HEAD^ the previous stage's, which holds only while EVERY stage
    // commits (`--allow-empty`); if fabro ever skips empty checkpoints this would
    // revert the previous stage. The gate's own checkpoint commits the revert. The
    // file count goes to /tmp/fabro/improve_touched_tree and never fails the task.
    // The shared triage phase's `improve` runs on a checkout nothing commits back to
    // a PR branch, so it has no backstop.
    //
    // `tasks_coded` counts a `ready` task toward the task budget (see next_task) only
    // when it is decomposed scope. EXT is read before a `ready` result overwrites
    // current_task.json, and a split of an extra-review follow-up stamps its slices
    // `from_extra: true`, because `source` becomes `split` and would otherwise lose
    // the exemption.
    improve_gate [label="Validate planned task", shape=parallelogram, output_schema="routing",
        script="if git rev-parse -q --verify HEAD^ >/dev/null 2>&1 && ! git diff --quiet HEAD^ HEAD; then
  N=$(git diff --name-only HEAD^ HEAD | wc -l | tr -d ' ')
  git diff --name-only HEAD^ HEAD | sed 's/^/plan changed (reverted): /'
  git revert --no-edit --no-commit HEAD
  echo $N > /tmp/fabro/improve_touched_tree
fi
F=/tmp/fabro/improve_result.json
A=$(cat /tmp/fabro/improve_attempts 2>/dev/null || echo 0)
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
RM=0; if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then RM=1; D=invalid; else D=$(jq -r .disposition $F 2>/dev/null || echo invalid); fi
if [ \"$D\" != ready ] && [ \"$D\" != redundant ] && [ \"$D\" != needs_human ] && [ \"$D\" != split ]; then D=invalid; fi
KEEP=0
SR=$(cat /tmp/fabro/split_rounds 2>/dev/null || echo 0)
case \"$SR\" in ''|*[!0-9]*) SR=0 ;; esac
SRC=$(jq -r '.source // \"\"' /tmp/fabro/current_task.json 2>/dev/null || echo '')
EXT=$(jq -r 'if (.source == \"extra-review\") or (.from_extra == true) then 1 else 0 end' /tmp/fabro/current_task.json 2>/dev/null || echo 0)
case \"$EXT\" in 1) ;; *) EXT=0 ;; esac
if [ \"$D\" = split ] && [ \"$SRC\" = split ]; then
  echo 'split refused: this task is already a slice of an earlier split; implementing it as-is.'
  D=ready; KEEP=1
fi
if [ \"$D\" = split ] && [ $SR -ge 2 ]; then
  echo 'split refused: the per-run split budget of 2 is spent; implementing this task as-is.'
  D=ready; KEEP=1
fi
if [ \"$D\" = ready ] && [ $KEEP = 0 ]; then
  jq -e '((.task_title | type) == \"string\") and ((.task_title | length) > 0) and ((.task_body | type) == \"string\") and ((.task_body | length) > 0)' $F >/dev/null 2>&1 || D=invalid
fi
if [ \"$D\" = split ]; then
  jq -e '(.tasks | type) == \"array\" and (.tasks | length) >= 2 and (.tasks | length) <= 4' $F >/dev/null 2>&1 || D=invalid
fi
if [ \"$D\" = split ]; then
  BAD=$(jq '[.tasks[] | select((.id | type) != \"string\" or (.title | type) != \"string\" or (.body | type) != \"string\" or (.id | length) == 0 or (.title | length) == 0 or (.body | length) == 0)] | length' $F 2>/dev/null || echo 99)
  if [ \"$BAD\" != 0 ]; then D=invalid; fi
fi
if [ \"$D\" = split ]; then
  CID=$(jq -r '.id // \"\"' /tmp/fabro/current_task.json)
  COLLIDE=$(jq --slurpfile cur /tmp/fabro/tasks.json --arg cid \"$CID\" '[.tasks[].id] as $new | (if ($new | unique | length) != ($new | length) then 1 else 0 end) + ([$new[] | select(. as $i | [$cur[0][] | select(.id != $cid) | .id] | index($i))] | length)' $F 2>/dev/null || echo 99)
  if [ \"$COLLIDE\" != 0 ]; then D=invalid; fi
fi
if [ \"$D\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/improve_attempts
  if [ $A -lt 2 ]; then if [ $RM = 1 ]; then echo 'no valid Input receipt: write the result with the submit tool, not write_file' >&2; else echo 'improve_result.json missing or invalid; rewrite it exactly per the contract' >&2; fi; exit 1; fi
fi
echo 0 > /tmp/fabro/improve_attempts
if [ \"$D\" = ready ] && [ $KEEP = 0 ]; then jq --slurpfile cur /tmp/fabro/current_task.json '{id: ($cur[0].id // .task_id), title: .task_title, body: .task_body, files: (.task_files // $cur[0].files // []), covers: (.task_covers // $cur[0].covers // []), priority: (.task_priority // $cur[0].priority)} | with_entries(select(.value != null))' $F > /tmp/fabro/current_task.new && mv /tmp/fabro/current_task.new /tmp/fabro/current_task.json; fi
if [ \"$D\" = split ]; then
  IDX=$(cat /tmp/fabro/task_index 2>/dev/null || echo 1)
  POS=$((IDX-1))
  if [ $POS -lt 0 ]; then POS=0; fi
  jq --slurpfile new $F --argjson pos $POS --argjson ext $EXT '.[0:$pos] + [$new[0].tasks[] | . + {source: \"split\", from_extra: ($ext == 1), covers: (if (.covers | type) == \"array\" then .covers else [] end)}] + .[($pos+1):]' /tmp/fabro/tasks.json > /tmp/fabro/tasks.split.json
  mv /tmp/fabro/tasks.split.json /tmp/fabro/tasks.json
  echo $POS > /tmp/fabro/task_index
  echo $((SR+1)) > /tmp/fabro/split_rounds
fi
if [ \"$D\" = ready ] && [ $EXT = 0 ]; then
  TCD=$(cat /tmp/fabro/tasks_coded 2>/dev/null || echo 0)
  case \"$TCD\" in ''|*[!0-9]*) TCD=0 ;; esac
  echo $((TCD+1)) > /tmp/fabro/tasks_coded
fi
TC=$(jq length /tmp/fabro/tasks.json 2>/dev/null || echo 0)
echo '{\"context_updates\":{\"task_disposition\":\"'$D'\",\"task_count\":'$TC'}}'"]

    // excerpts: the code the task dossier cites, copied verbatim for the coder, so its
    // first turns are edits rather than reads. On 2026-10-01 two coders (runs
    // 01M3WS83Z1736Y75GNZM89KV59, lawncare-saas#2659, and 01M3WRYJBFJVWJCEGDV6T4YRVF,
    // womens-fantasy-sports#1278) each spent ~17 minutes before their first edit. 5-7 of
    // those were whole-file reads of the files `plan` had read minutes earlier on the
    // same box (~100-120 KB at ~250 tok/s prefill), though the dossier already named every
    // range they edited. edit_file needs the exact text, so the coder had to re-read.
    //
    // Every `path:N-M` in task-context.md naming a file in the checkout is copied, and
    // every `path:N` becomes the narrowest symbol holding line N (fabro-code show, when
    // that symbol is 3 to 80 lines long) or N-3..N+12 otherwise, so a one-line constant
    // keeps the comment above it. A path alone, or a bare
    // `:N`, is skipped. Ranges are capped at 150 lines and merged per file, and the
    // whole file at 40000 bytes; anything past the cap is listed, not copied. The text
    // is the checkout as it is now, after plan and before the coder, so it cannot be
    // stale. Only `coder` reads task-code.md: rework and review run after the code
    // changed. next_task deletes it with the dossier.
    //
    // Call sites (docs/coder-tweaks/07, C6): after the code blocks and before the "Not
    // copied" list, `## Where these are used` lists `fabro-code callers NAME` for each
    // backticked identifier under `## Files and symbols` (at most 12 symbols, 15 rows
    // each, each row followed by its call line trimmed to 160 characters), so the
    // coder's commonest search is answered before it asks. It shares the 40000-byte
    // cap with the code blocks, which are counted first; a symbol's call sites are
    // dropped whole when they would not fit, never a code block. Written only when
    // fabro-code is on PATH and at least one symbol has callers.
    //
    // It ALWAYS succeeds and publishes no context key, like `autofix`: an empty or
    // missing dossier means no task-code.md, and the coder reads files as it always did.
    excerpts [label="Copy the code the dossier cites", shape=parallelogram, timeout="5m",
        script="D=/tmp/fabro/task-context.md
O=/tmp/fabro/task-code.md
R=/tmp/fabro/excerpts.refs
rm -f $O $O.tmp $R $R.merged
if [ ! -s $D ]; then echo 'excerpts: no task dossier, so there is nothing to copy'; exit 0; fi
FC=0; command -v fabro-code >/dev/null 2>&1 && FC=1
: > $R
for REF in $(grep -oE '[A-Za-z0-9_./-]+:[0-9]+(-[0-9]+)?' $D | sort -u); do
  F=${REF%:*}; L=${REF##*:}; F=${F#./}
  [ -f \"$F\" ] || continue
  N=$(awk 'END {print NR}' \"$F\")
  case $L in
    *-*) S=${L%-*}; E=${L#*-} ;;
    *) S=$((L - 3)); E=$((L + 12))
       if [ $FC = 1 ]; then
         SE=$(fabro-code show \"$F:$L\" 2>/dev/null | head -n 1 | awk '$1 == \"#\" {n = split($2, a, \":\"); split(a[n], b, \"-\"); if (b[1] + 0 > 0 && b[2] + 0 >= b[1] + 0) print b[1] \" \" b[2]}')
         case \"$SE\" in *' '*) SS=${SE% *}; EE=${SE#* }; if [ $((EE - SS)) -ge 2 ] && [ $((EE - SS)) -lt 80 ]; then S=$SS; E=$EE; fi ;; esac
       fi ;;
  esac
  if [ $S -lt 1 ]; then S=1; fi
  if [ $E -gt $N ]; then E=$N; fi
  if [ $((E - S)) -ge 150 ]; then E=$((S + 149)); fi
  if [ $S -le $E ]; then echo \"$F $S $E\" >> $R; fi
done
sort -k1,1 -k2,2n $R | awk '$1 != f || $2 > e + 3 {if (f != \"\") print f, s, e; f = $1; s = $2; e = $3; next} $3 > e {e = $3} END {if (f != \"\") print f, s, e}' > $R.merged
USED=0; OUT=0; SKIP=''
{
  echo '# Code the task dossier cites'
  echo ''
  echo 'Copied from the checkout by the excerpts node right after the planner wrote the dossier, before this stage started. Each block is the current text of the lines in its heading, without line numbers, so a block can be used as the old_string of edit_file. Lines outside these ranges are not shown.'
} > $O.tmp
while read F S E; do
  B=$(awk -v s=$S -v e=$E 'NR >= s && NR <= e' \"$F\" | wc -c)
  if [ $((USED + B)) -gt 40000 ]; then SKIP=\"$SKIP $F:$S-$E\"; continue; fi
  USED=$((USED + B)); OUT=$((OUT + 1))
  { echo ''; echo \"## $F:$S-$E\"; echo '````'; awk -v s=$S -v e=$E 'NR >= s && NR <= e' \"$F\"; echo '````'; } >> $O.tmp
done < $R.merged
CN=0
if [ $FC = 1 ] && [ $OUT -gt 0 ]; then
  SYMS=$(awk '/^## /{p=($0==\"## Files and symbols\"); next} p' $D | grep -o '`[^`]*`' | tr -d '`' | sed 's/(.*//' | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' | awk '!s[$0]++' | head -n 12)
  : > $O.cs; CB=200
  for SYM in $SYMS; do
    fabro-code callers \"$SYM\" 2>/dev/null | grep -E '^[^ ]+:[0-9]+  ' | head -n 15 > $O.rows
    [ -s $O.rows ] || continue
    { echo ''; echo \"### $SYM\"
      while read ROW; do
        REF=${ROW%% *}; P=${REF%:*}; LN=${REF##*:}
        echo \"- $ROW\"
        if [ -f \"$P\" ]; then TXT=$(awk -v l=$LN 'NR==l' \"$P\" | sed 's/^[[:space:]]*//' | cut -c1-160); if [ -n \"$TXT\" ]; then echo \"    $TXT\"; fi; fi
      done < $O.rows; } > $O.sym
    SB=$(wc -c < $O.sym)
    if [ $((USED + CB + SB)) -gt 40000 ]; then break; fi
    CB=$((CB + SB)); CN=$((CN + 1)); cat $O.sym >> $O.cs
  done
  if [ $CN -gt 0 ]; then
    { echo ''; echo '## Where these are used'; echo ''; echo 'Call sites of the symbols the dossier names, from the code index (fabro-code callers). Each row is path:line, then the enclosing symbol, then the call line itself. An absent caller is not proof of none: grep still applies.'; cat $O.cs; } >> $O.tmp
  fi
  rm -f $O.cs $O.rows $O.sym
fi
if [ -n \"$SKIP\" ]; then
  { echo ''; echo '## Not copied: over the 40000-byte cap. Read these with code_show or read_file'; for X in $SKIP; do echo \"- $X\"; done; } >> $O.tmp
fi
if [ $OUT -gt 0 ]; then
  mv $O.tmp $O
  echo \"excerpts: copied $OUT range(s), $USED bytes, to $O\"
  if [ $CN -gt 0 ]; then echo \"excerpts: call sites for $CN symbol(s) appended\"; fi
else
  rm -f $O.tmp
  echo 'excerpts: the dossier cites no line range in a file that exists; nothing to copy'
fi
rm -f $R $R.merged
exit 0"]

    // `timeout` and `max_retries` are both sized from measured data, not guessed.
    //
    // Sized from all 23 coder/rework attempts on the server, completions AND timeouts,
    // not just the ones that finished -- measuring only completions is circular, because
    // a stage that hit the ceiling produces no wall_time to measure. Completions run
    // 146s..3166s, p50 758s; 5/23 exceeded 30m and 2/23 exceeded 45m. The longest
    // completion, 3166s, is 88% of a 60m ceiling, which is not headroom. 90m is.
    //
    // The ceiling matters because fabro bounds a stage by TOTAL WALL CLOCK: a coder
    // making steady progress is killed at the same mark as one that has stalled. There
    // is no idle- or progress-based bound at the stage level (the only idle mechanism,
    // graph `stall_timeout`, cancels the whole run rather than failing the stage). So
    // the ceiling has to clear the slowest legitimate session, and the retry below is
    // what covers the stalls.
    //
    // `max_retries=1` exists for a different failure. On 2026-09-17 the `coders`
    // upstream accepted a request, streamed reasoning for 9 seconds, and then went
    // silent: fabro logged `agent.llm.first_output` at 03:01:19 and then emitted no
    // event at all for 1915 seconds, until this node's timeout killed the stage.
    // LiteLLM was retrying the hung upstream on its own 600s budget (03:01:26,
    // 03:11:26, 03:21:26) and the 200 finally landed 20 minutes late. Nothing in
    // fabro recovers from that on its own: a stream that stalls without erroring is
    // not a provider error, so neither the LLM retry (3x, transient errors only) nor
    // the model fallback chain (`coders-a` -> `glm-5.3-flash`) can fire. The node timeout is
    // the only backstop, and it classifies as `transient_infra` -- which IS
    // retry-eligible, but `default_max_retries` is 0, so the stage reported
    // `will_retry: false` and the run walked its unconditional edge to human_rescue
    // with the issue still labelled agent-in-progress.
    //
    // One retry gets a fresh session, and therefore a fresh routing decision inside
    // LiteLLM, which is the thing most likely to land on a healthy deployment.
    //
    // It also RESUMES rather than restarts, which is the larger benefit and was not
    // the reason this was added. A node retry re-runs the handler in the SAME
    // sandbox, and a failed stage writes no checkpoint -- so the previous attempt's
    // edits are still in the working tree, uncommitted. Measured on jelly-swipe#347
    // (run 01M2PS2A4QAX3ENBT929QNKZWV): attempt 1 timed out at 3600s having made 114
    // `edit_file` calls; attempt 2 read the modified tree, finished the remainder and
    // completed in 1134s. 79 minutes total for work that would otherwise have been
    // thrown away at 45m and sent to human_rescue.
    //
    // Worst case is two 60m attempts on a genuinely dead provider; the run then
    // reaches human_rescue as it does today, having actually tried.
    //
    // Do NOT promote this to a graph-level `default_max_retries`. That would also
    // apply to the command gates, whose `exit 1` is a deliberate routing signal and
    // whose attempt counters would be double-incremented by an engine retry.
    // timeout="180m" and allow_partial=true together, for one measured failure.
    //
    // Run 01M2SBJG92TX0DBRKY5881VM34, task 2 of 3 on womens-fantasy-sports
    // ("refactor(squads): one module resolving a squad's Season, actionable
    // gameweek and typed opening-build state"). The coder was NOT stuck. It ran
    // 90 minutes, was retried, ran 90 more, and was making progress both times:
    // 55 then 77 tool calls, 43 then 67 assistant turns, context grown to 158k
    // tokens. The last event before the first timeout, 11 seconds before it
    // fired, was `edit_file -> "Successfully edited"`. It was mid-edit.
    //
    // Sandcastle ran the same work on the same strix box and did not have this
    // problem, because its coder had NO wall clock. It had `--idle-timeout`
    // (fails only when stdout is SILENT for 1800s) and a livelock watchdog that
    // aborts after 5 consecutive IDENTICAL tool calls with an unchanged
    // worktree. Both measure progress. Neither would have stopped this agent --
    // it was never silent, and 13 consecutive reads of 13 different files are
    // not identical calls. Fabro has no per-node equivalent: `stall_timeout` is
    // graph-level and cancels the whole run.
    //
    // 180m is the longer budget, and it is still an arbitrary wall clock --
    // which is why it is not the real fix. allow_partial is.
    //
    // WITHOUT allow_partial, a timed-out coder ends `failed`, takes its
    // UNCONDITIONAL edge to human_rescue, and never produces a review verdict --
    // so rework_t1..t4, the escalation ladder that exists precisely for a task
    // the tier-1 coder cannot land, is never reached. Task 1 of that same run
    // went coder -> review -> rework_t1 -> review -> rework_t2 -> review ->
    // rework_t2 -> review -> integrate and shipped. Task 2 got none of it, and
    // parked a scheduler slot on an unanswered human gate for 5h31m.
    //
    // WITH it, `finalize_retries_exhausted` promotes the stage to
    // partially_succeeded (node_handler.rs:170) instead of failed. The partial
    // work is already on disk in the run's own sandbox, so prep_review picks it
    // up, validate catches anything left broken, and the reviewer's verdict
    // drives the ladder onto a DIFFERENT model. That is Sandcastle's shape:
    // whatever the agent produced gets reviewed, and escalation follows.
    coder [label="Implement task (tier 1)", class="coder", timeout="180m", max_retries=1, allow_partial=true, prompt="@prompts/coder.md.j2"]

    // task_block_gate: the coder and the rework tiers block through a contract, never by
    // substitution (#17, docs/unmet-criteria C2). A stage that implements its task submits
    // nothing, and the run goes on to autofix as before. A stage that cannot meet an
    // acceptance criterion as written calls `submit` with kind `criterion`, and the issue
    // returns to triage as a question (return_to_triage); one that cannot do the task
    // inside its files submits kind `scope`, and the unconditional edge takes the run to
    // the rescue gate, whose brief quotes task_block_scope.md. Before #17 the coder's
    // `<blocked>` marker was text nothing read, so its empty diff went to review and the
    // rework ladder, and a coder told to "implement the closest form" shipped a different
    // behaviour as the criterion (lawncare-saas#2723).
    //
    // A file from an older visit is stale (next_task also deletes it per task): `none`.
    // A file this visit wrote that is not a valid criterion block (an empty criterion, a
    // bad kind) is `scope`, never `none`: the stage tried to block. So is a file that is
    // not a JSON object, which has no receipt to call it stale by: `submit` writes only
    // objects, so it cannot be an old valid block. The
    // file is deleted once read. `triage_questions` is on every routing object, because
    // the Discord hook on return_to_triage reads it at that node's stage_start.
    // The `QT=` line is decompose_gate's, word for word: both build the question from
    // return.json the same way, so change them together.
    task_block_gate [label="Read the coder's block", shape=parallelogram, timeout="1m", output_schema="routing",
        script="F=/tmp/fabro/task_blocked.json
rm -f /tmp/fabro/task_block_scope.md
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
STALE=no
if [ ! -e $F ]; then STALE=yes
elif jq -e 'type == \"object\"' $F >/dev/null 2>&1; then
  RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
  if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then STALE=yes; fi
fi
if [ $STALE = yes ]; then
  rm -f $F
  jq -nc '{context_updates:{task_block:\"none\",triage_questions:\"\"}}'
  exit 0
fi
K=$(jq -r '.kind // empty' $F 2>/dev/null)
C=$(jq -r '.criterion // empty' $F 2>/dev/null)
W=$(jq -r '.reason // empty' $F 2>/dev/null)
B=scope
QT=''
if [ \"$K\" = criterion ] && [ -n \"$C\" ] && [ -n \"$W\" ]; then B=criterion; fi
if [ $B = criterion ]; then
  jq '{source: \"coder\", summary: .reason, items: [{criterion, non_goal: (if (.non_goal // \"\") == \"\" then \"the constraints of this task\" else .non_goal end), why: .reason}]}' $F > /tmp/fabro/return.json
  QT=$(jq -r '[.items[] | \"- \" + .criterion + \" (conflicts with: \" + .non_goal + \")\"] | join(\"  \")' /tmp/fabro/return.json | tr -d '\"' | cut -c1-1200)
else
  T=$(jq -r '.title // empty' /tmp/fabro/current_task.json 2>/dev/null)
  if [ -z \"$W\" ]; then W='it submitted a block the gate could not read (kind, criterion or reason missing)'; fi
  echo \"The coder blocked on task ${T:-unknown}: $W\" | tr -d '{}' | head -c 600 > /tmp/fabro/task_block_scope.md
fi
rm -f $F
jq -nc --arg b $B --arg q \"$QT\" '{context_updates:{task_block:$b,triage_questions:$q}}'"]

    // autofix: formatters and machine-applicable lint fixes between every coder or rework
    // stage and its review (ADR 0011 D5). It runs the target repository's optional
    // `.fabro/fix.sh` and ALWAYS succeeds: `validate` is the gate, not this node. Its
    // edits are committed by the checkpoint after this stage, before prep_review computes
    // the diff, so the reviewer reviews the formatted code. 31 of writers-app's 154
    // validate visits failed, mostly on `cargo fmt` diffs and clippy lints, and each one
    // cost a rework_t1 stage plus a second validate.
    //
    // It publishes `autofix_ran` (true when .fabro/fix.sh was started) and `autofix_rc`
    // (its exit code, -1 when it did not run), so a recheck reads whether the repository's
    // fix.sh ran from the events (ADR 0020, #13). The fix.sh output goes to autofix.log,
    // and only its tail (through tr -d '{}') reaches stdout before the routing object. The
    // `outcome=failed` edge sends a timeout on to prep_review as well, so a hung formatter
    // costs at most 15m and never parks the run on human_rescue; the unconditional edge to
    // human_rescue exists only because every command node must have one.
    autofix [label="Autofix (formatters and lint --fix)", shape=parallelogram, timeout="15m", output_schema="routing",
        script="exec 3>&1 >/tmp/fabro/autofix.log 2>&1
if [ ! -f ./.fabro/fix.sh ]; then
  echo 'autofix: no .fabro/fix.sh in this repository; nothing to do'
  RAN=false; RC=-1
else
  RAN=true
  if [ -x ./.fabro/fix.sh ]; then ./.fabro/fix.sh; RC=$?; else bash ./.fabro/fix.sh; RC=$?; fi
  echo 'autofix: .fabro/fix.sh exited '$RC'; validate is the gate, so this stage succeeds either way'
fi
{ tail -n 40 /tmp/fabro/autofix.log; git status --short 2>/dev/null || true; } | tr -d '{}' >&3
jq -nc --argjson ran $RAN --argjson rc $RC '{context_updates:{autofix_ran:$ran,autofix_rc:$rc}}' >&3
exit 0"]

    prep_review [label="Prepare review inputs", shape=parallelogram, output_schema="routing",
        script="set -e
SN=$(jq -r '.node // \"\"' /tmp/fabro/.io/stage.json 2>/dev/null || true)
if [ -n \"$SN\" ] && { [ \"${SN#coder}\" != \"$SN\" ] || [ \"${SN#rework_t}\" != \"$SN\" ]; }; then
  SV=$(jq -r '.visit // empty' /tmp/fabro/.io/served.json 2>/dev/null || true)
  RV=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null || true)
  if [ -z \"$RV\" ] || [ \"$SV\" != \"$RV\" ]; then
    echo \"fabro-io: $SN produced output without a valid inputs receipt (served '$SV' vs stage '$RV'); code is judged by the review ladder, and this does not change routing (ADR 0016 D8)\"
  fi
fi
BASE=$(cat /tmp/fabro/task_base_sha)
git diff $BASE..HEAD > /tmp/fabro/review/diff.patch
git diff --stat $BASE..HEAD > /tmp/fabro/review/diffstat.txt
git diff --name-only $BASE..HEAD > /tmp/fabro/review/changed_files.txt
BYTES=$(wc -c < /tmp/fabro/review/diff.patch | tr -d ' ')
if [ $BYTES -gt 2000000 ]; then
  echo '## Diff too large' > /tmp/fabro/feedback/rework.md
  echo 'The change diff is '$BYTES' bytes (limit 2000000). Split or shrink the change so it stays reviewable, then continue the current task in /tmp/fabro/current_task.json.' >> /tmp/fabro/feedback/rework.md
  echo '{\"context_updates\":{\"diff_too_large\":true}}'
else
  echo '{\"context_updates\":{\"diff_too_large\":false}}'
fi"]

    // ---- Task validation (ADR 0025) ----
    // The per-task gate. It used to run the repository's full `setup.sh && ci.sh` after
    // every coder and rework round: 10% of all stage time over 2026-09-25..10-11, about
    // 24 min a run. It now runs the repository's `.fabro/test.toml` checks and the tests
    // that cover the files this task changed, selected from the diff by `fabro-io
    // task-check`; Final validation in `open_pr_prep` stays the full net.
    //
    // It falls back to the full suite for anything it cannot attribute (C4): no task keys,
    // a built-in or declared `full` glob, a deleted non-test file, the Code index
    // unavailable, an unowned or out-of-cwd selected test, a `final_fix` task, or a
    // `task-check` that errored. The fallback reason is published for the scorecard, and
    // the counts are 0 on the full path.
    //
    // A red result exits 0 and routes by context: `validate -> review` requires
    // `outcome=succeeded && context.task_validation_ok=true`, and the unconditional
    // `validate -> rework_router` carries a red run. A timeout fails the node, applies no
    // context update, so `outcome=succeeded` is false and a stale `task_validation_ok=true`
    // from an earlier visit can never send it to review.
    //
    // The placeholder `rework.md` is written first because a timeout reaches
    // `rework_router` with the previous round's feedback still in the file. The file it
    // replaced is kept in /tmp/fabro/rework.prev and put back on a green visit, so a later
    // reader (`rescue_brief` quotes rework.md once round > 0) never sees a timeout that did
    // not happen. A preparation failure stops the targets; it is listed with its error,
    // because no item result carries it. The routing object is the last command: if it
    // cannot be built the node fails rather than exit 0 with no update, which would let a
    // stale `task_validation_ok=true` through. Every line of
    // the summary and the log tail goes through `tr -d '{}'`, because fabro scans stdout
    // and stderr for brace-balanced objects and the log is arbitrary test output.
    // `selected` is the number of test files passed as target arguments. A `task-check`
    // that errored keeps its output in /tmp/fabro/task_check_error.log, because the full
    // suite overwrites validate_output.log.
    validate [label="Task validation", shape=parallelogram, timeout="20m", output_schema="routing",
        script="rm -f /tmp/fabro/rework.prev /tmp/fabro/task_check.json /tmp/fabro/task_check_error.log
if [ -f /tmp/fabro/feedback/rework.md ]; then cp /tmp/fabro/feedback/rework.md /tmp/fabro/rework.prev; fi
echo '## Validation failed (timeout): task validation did not finish' > /tmp/fabro/feedback/rework.md
echo 'The stage was stopped before it finished, most likely on its 20-minute timeout. Its output is in /tmp/fabro/validate_output.log, and for a scoped run in /tmp/fabro/task_check.log.' >> /tmp/fabro/feedback/rework.md
FF=$(jq -r '.final_fix // false' /tmp/fabro/current_task.json 2>/dev/null || echo false)
MODE=full
REASON=task_check_error
if [ \"$FF\" = true ]; then
  REASON=final_fix
else
  fabro-io task-check --gate --base \"$(cat /tmp/fabro/task_base_sha)\" --out /tmp/fabro/task_check.json > /tmp/fabro/validate_output.log 2>&1
  if jq -e . /tmp/fabro/task_check.json >/dev/null 2>&1; then
    MODE=$(jq -r '.mode // \"full\"' /tmp/fabro/task_check.json)
    REASON=$(jq -r '.reason // \"\"' /tmp/fabro/task_check.json)
  else
    cp /tmp/fabro/validate_output.log /tmp/fabro/task_check_error.log 2>/dev/null
  fi
fi
SEL=0
UNT=0
UNCH=0
PREP=0
if [ \"$MODE\" = scoped ]; then
  SEL=$(jq -r '[.targets[].args[]?] | length' /tmp/fabro/task_check.json 2>/dev/null || echo 0)
  UNT=$(jq -r '.untested | length' /tmp/fabro/task_check.json 2>/dev/null || echo 0)
  UNCH=$(jq -r '.unchecked | length' /tmp/fabro/task_check.json 2>/dev/null || echo 0)
  PREP=$(jq -r '.prepared_seconds // 0' /tmp/fabro/task_check.json 2>/dev/null || echo 0)
fi
RC=0
OK=true
if [ \"$MODE\" = full ]; then
  ./.fabro/setup.sh > /tmp/fabro/validate_output.log 2>&1 && ./.fabro/ci.sh >> /tmp/fabro/validate_output.log 2>&1 || RC=$?
  if [ $RC -ne 0 ]; then
    OK=false
  fi
else
  OK=$(jq -r '.ok // false' /tmp/fabro/task_check.json 2>/dev/null || echo false)
fi
if [ \"$OK\" = true ]; then
  if [ -f /tmp/fabro/rework.prev ]; then mv /tmp/fabro/rework.prev /tmp/fabro/feedback/rework.md; else rm -f /tmp/fabro/feedback/rework.md; fi
else
  if [ \"$MODE\" = full ]; then
    echo '## Validation failed (exit '$RC'): ./.fabro/setup.sh && ./.fabro/ci.sh' > /tmp/fabro/feedback/rework.md
    echo >> /tmp/fabro/feedback/rework.md
    tail -c 6000 /tmp/fabro/validate_output.log >> /tmp/fabro/feedback/rework.md
  else
    {
      echo '## Validation failed (exit 1): task validation'
      echo
      echo 'Task validation ran the checks and tests that cover the files this task changed. The full output is in /tmp/fabro/task_check.log. Failed:'
      echo
      jq -r 'select((.prepare.exit_code // 0) != 0) | \"- preparation of the Test environment (exit \" + (.prepare.exit_code|tostring) + \")\"' /tmp/fabro/task_check.json
      jq -r '. as $r | .results[] | select(.exit_code != null and .exit_code != 0) | .name as $n | \"- \" + .kind + \" `\" + $n + \"` (exit \" + (.exit_code|tostring) + \")\" + (if .kind == \"target\" then ((($r.targets[] | select(.name == $n) | .args) // []) | if length > 0 then \": \" + join(\" \") else \"\" end) else \"\" end)' /tmp/fabro/task_check.json
      echo
      {
      jq -r 'select((.prepare.exit_code // 0) != 0) | \"### preparation\", (.prepare.error // \"\")' /tmp/fabro/task_check.json
      jq -r '.results[] | select(.exit_code != null and .exit_code != 0) | .kind + \" \" + .name' /tmp/fabro/task_check.json | while read -r KIND NAME; do
        echo \"### $KIND $NAME\"
        jq -r --arg k \"$KIND\" --arg n \"$NAME\" '.results[] | select(.kind == $k and .name == $n) | .tail // \"\"' /tmp/fabro/task_check.json
      done
      } | head -c 6000
    } > /tmp/fabro/feedback/rework.md
  fi
fi
echo 'task validation: mode='$MODE' reason='$REASON' ok='$OK' selected='$SEL' untested='$UNT' unchecked='$UNCH' prepared='$PREP's' | tr -d '{}'
tail -c 4000 /tmp/fabro/validate_output.log | tr -d '{}'
jq -nc --argjson ok $OK --arg mode \"$MODE\" --arg reason \"$REASON\" --argjson sel $SEL --argjson unt $UNT --argjson unch $UNCH --argjson prep $PREP '{context_updates:{task_validation_ok:$ok,task_validation_mode:$mode,task_validation_reason:$reason,task_validation_selected:$sel,task_validation_untested:$unt,task_validation_unchecked:$unch,task_validation_prepare_s:$prep}}' || exit 1"]

    review [label="Review task", class="review-task", timeout="15m", max_retries=1, prompt="@prompts/reviewer.md.j2"]

    review_gate [label="Validate verdict", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/review/verdict.json
A=$(cat /tmp/fabro/review_attempts 2>/dev/null || echo 0)
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/review_attempts
  if [ $A -lt 2 ]; then echo 'no valid Input receipt: write the result with the submit tool, not write_file' >&2; exit 1; fi
  echo '{\"context_updates\":{\"review_decision\":\"invalid\"}}'
  exit 0
fi
echo 0 > /tmp/fabro/review_attempts
D=$(jq -r .decision $F 2>/dev/null || echo invalid)
if [ \"$D\" = changes_requested ]; then
  B=$(jq '[.findings[]? | select(.severity == \"blocking\")] | length' $F 2>/dev/null || echo 0)
  if [ \"$B\" = 0 ]; then
    A=$((A+1))
    echo $A > /tmp/fabro/review_attempts
    if [ $A -lt 2 ]; then echo 'verdict.json requests changes with no blocking finding; rewrite it exactly per the contract' >&2; exit 1; fi
    D=invalid
  fi
fi
echo 0 > /tmp/fabro/review_attempts
if [ \"$D\" = changes_requested ]; then
  echo '## Review findings to fix' > /tmp/fabro/feedback/rework.md
  jq -r '.summary // empty' $F >> /tmp/fabro/feedback/rework.md
  echo >> /tmp/fabro/feedback/rework.md
  jq -r '.findings[]? | select(.severity == \"blocking\") | .message' $F | sed 's/^/- /' >> /tmp/fabro/feedback/rework.md
fi
echo '{\"context_updates\":{\"review_decision\":\"'$D'\"}}'"]

    integrate [label="Integrate task", shape=parallelogram,
        script="WFB=$(for C in $(git rev-list --no-merges origin/main..HEAD 2>/dev/null); do git diff-tree --no-commit-id --name-only -r \"$C\" -- .github/workflows/ | sed 's/^/'$C' /'; done)
if [ -n \"$WFB\" ]; then
  echo 'refusing to integrate: a commit of this task changes a file under .github/workflows/, which no agent may edit.' >&2
  echo 'the sandbox token lacks the `workflow` scope, so the branch could never be pushed. commits whose own diff touches it:' >&2
  echo \"$WFB\" | while read -r C F; do echo \"  $(git log -1 --format='%h %s' $C)\" >&2; echo \"    $F\" >&2; done
  exit 1
fi
T=$(jq -r .title /tmp/fabro/current_task.json)
S=$(jq -r '.summary // empty' /tmp/fabro/review/verdict.json 2>/dev/null || true)
{ echo '### Task: '$T; echo '- Review: '$S; echo; } >> /tmp/fabro/completed.md
git rev-parse HEAD > /tmp/fabro/reviewed_sha
echo integrated"]

    // `task_exempt` says whether the current task is an extra-review follow-up (or a
    // slice split from one), which the ladder's exhaustion edge needs. It is looked
    // up in tasks.json by id, not read from current_task.json: improve_gate rewrites
    // current_task.json without `source`/`from_extra`. Written on every visit.
    rework_router [label="Escalate rework round", shape=parallelogram, output_schema="routing",
        script="R=$(cat /tmp/fabro/round 2>/dev/null || echo 0)
R=$((R+1))
echo $R > /tmp/fabro/round
EX=$(jq -r --slurpfile cur /tmp/fabro/current_task.json '[.[] | select(.id == $cur[0].id)] | if length == 0 then \"false\" elif ((.[0].source == \"extra-review\") or (.[0].from_extra == true)) then \"true\" else \"false\" end' /tmp/fabro/tasks.json 2>/dev/null || echo false)
case \"$EX\" in true) ;; *) EX=false ;; esac
echo '{\"context_updates\":{\"round\":'$R',\"task_exempt\":'$EX'}}'"]

    // An extra-review follow-up that the whole rework ladder could not get past
    // review is reverted and the run goes on, instead of waiting at human_rescue.
    // The follow-up fixes a branch whose decomposed tasks all passed review, so
    // dropping it costs one fix. Waiting at the gate costs the whole run: its 4h
    // default is mark_stuck, which throws away every task that landed.
    //
    // Cost, run 01M3XB5VAKR65RAVBFVD9SYYNS on 2026-10-02, womens-fantasy-sports#1300:
    // extra_decompose emitted a follow-up that required a comment edit in
    // `.github/workflows/test-frontend.yml`. All six rework rounds correctly refused
    // to touch the file, the reviewer rejected every round for its absence, and the
    // gate expired. Three reviewed tasks and 8.5 hours were lost, and no PR was opened.
    //
    // `round=6` is the first round past tier 4 only. After a human's freeform guidance
    // (record_guidance -> rework_t4) the rounds go past 6 and use the old route back
    // to human_rescue, so the operator who is working with the run keeps it.
    // `git restore` puts the index and the tree back to the task base, and deletes
    // files the task added. The checkpoint after this node commits the revert, the
    // same as improve_gate's `--no-commit` revert. The entry in completed.md puts the
    // drop in the PR body.
    drop_followup [label="Drop the follow-up the ladder could not land", shape=parallelogram,
        script="set -e
BASE=$(cat /tmp/fabro/task_base_sha)
git cat-file -e \"$BASE^{commit}\"
git restore --source=\"$BASE\" --staged --worktree -- .
git diff --quiet \"$BASE\" --
I=$(jq -r '.id // \"?\"' /tmp/fabro/current_task.json)
T=$(jq -r '.title // \"?\"' /tmp/fabro/current_task.json)
S=$(jq -r '.summary // empty' /tmp/fabro/review/verdict.json 2>/dev/null || true)
{ echo '### Dropped follow-up: '$T; echo '- Not in this PR. The extra-review follow-up `'$I'` was still rejected after every rework tier, so its changes were reverted. It needs a human.'; echo '- Last review: '$S; echo; } >> /tmp/fabro/completed.md
echo 'dropped follow-up '$I': tree restored to the task base '$BASE"]

    // A fast-lane task that the whole rework ladder could not land. The label was wrong:
    // the issue is bigger than one commit, so it goes back to the queue for the standard
    // lane (decompose, plan) instead of waiting 4h at human_rescue on a held coder box.
    //
    // The ORDER of the label calls is load-bearing. `fast-path` comes off first, and the
    // node stops if that fails or if a re-read still shows it. Only then does `agent` go
    // back on. An issue that kept `fast-path` and got `agent` back would be dispatched
    // into the fast lane again and demoted again, without end. `agent` is added in the same
    // call that removes `agent-in-progress` (the receipt), so an interruption cannot leave
    // the issue with neither label (dispatch.py explains this order). The comment comes
    // last and is best effort. Rounds above 6 (after a human's guidance) keep the old
    // route to rescue_brief: only `round=6 && lane=fast` comes here.
    demote_lane [label="Demote the fast-path issue to the standard lane", shape=parallelogram, timeout="2m",
        script="F=/tmp/fabro
N=$(jq -r .number $F/issue.json 2>/dev/null || true)
case \"$N\" in '' | *[!0-9]*) N=$(cat $F/issue_number 2>/dev/null || true) ;; esac
case \"$N\" in '' | *[!0-9]* | 0) echo 'demote_lane: no issue number' >&2; exit 1 ;; esac
gh issue edit $N --remove-label fast-path || { echo 'demote_lane: could not remove fast-path' >&2; exit 1; }
LBL=$(gh issue view $N --json labels --jq '.labels[].name') || { echo 'demote_lane: could not re-read the labels' >&2; exit 1; }
if echo \"$LBL\" | grep -qx 'fast-path'; then echo 'demote_lane: fast-path is still on the issue' >&2; exit 1; fi
{
  echo 'The fast path could not land this issue: the task failed validate or review at every rework tier. fast-path was removed and the issue is back in the queue for the standard lane, which decomposes it first.'
  if [ -s $F/feedback/rework.md ]; then
    echo; echo '```'
    awk 'BEGIN { e = sprintf(\"%c\", 27) } { gsub(e \"[[][0-9;]*[A-Za-z]\", \"\"); gsub(/[[:cntrl:]]/, \"\"); if ($0 ~ /^[ ]*$/) next; if (++n > 20) exit; print substr($0, 1, 400) }' $F/feedback/rework.md
    echo '```'
  fi
} > $F/demote_comment.md
gh issue edit $N --add-label agent --remove-label agent-in-progress || true
gh issue comment $N --body-file $F/demote_comment.md || true
echo demoted"]

    rework_t1 [label="Rework (tier 1: coders)", class="coder", timeout="45m", max_retries=1, prompt="@prompts/rework.md.j2"]
    rework_t2 [label="Rework (tier 2: glm-5.3-flash)", class="coder-t2", timeout="45m", max_retries=1, prompt="@prompts/rework.md.j2"]
    rework_t3 [label="Rework (tier 3: kimi-for-coding)", class="coder-t3", timeout="45m", max_retries=1, prompt="@prompts/rework.md.j2"]
    rework_t4 [label="Rework (tier 4: glm-5.3)", class="coder-t4", timeout="45m", max_retries=1, prompt="@prompts/rework.md.j2"]

    // ---- Extra review rounds (whole branch) ----
    extra_prep [label="Prepare extra review", shape=parallelogram, output_schema="routing",
        script="ER=$(cat /tmp/fabro/extra_round 2>/dev/null || echo 0)
if [ $ER -ge 2 ]; then echo '{\"context_updates\":{\"extra_done\":true}}'; exit 0; fi
echo $((ER+1)) > /tmp/fabro/extra_round
git fetch origin main
git diff origin/main...HEAD > /tmp/fabro/extra/diff.patch
git diff --stat origin/main...HEAD > /tmp/fabro/extra/diffstat.txt
git diff --name-only origin/main...HEAD > /tmp/fabro/extra/changed_files.txt
echo '{\"context_updates\":{\"extra_done\":false,\"standards_status\":\"none\",\"spec_status\":\"none\",\"quality_status\":\"none\",\"new_tasks\":0,\"followup_status\":\"none\"}}'"]

    standards [label="Standards review", class="review-standards", timeout="15m", max_retries=1, prompt="@prompts/standards.md.j2"]
    standards_gate [label="Validate standards output", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/extra/standards.json
A=$(cat /tmp/fabro/standards_attempts 2>/dev/null || echo 0)
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/standards_attempts
  if [ $A -lt 2 ]; then echo 'no valid Input receipt: write the result with the submit tool, not write_file' >&2; exit 1; fi
  echo '{\"context_updates\":{\"standards_status\":\"invalid\"}}'
  exit 0
fi
echo 0 > /tmp/fabro/standards_attempts
D=$(jq -r .decision $F 2>/dev/null || echo invalid)
echo '{\"context_updates\":{\"standards_status\":\"'$D'\"}}'"]

    spec [label="Spec review", class="review-frontier", timeout="15m", max_retries=1, prompt="@prompts/spec.md.j2"]
    spec_gate [label="Validate spec output", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/extra/spec.json
A=$(cat /tmp/fabro/spec_attempts 2>/dev/null || echo 0)
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/spec_attempts
  if [ $A -lt 2 ]; then echo 'no valid Input receipt: write the result with the submit tool, not write_file' >&2; exit 1; fi
  echo '{\"context_updates\":{\"spec_status\":\"invalid\"}}'
  exit 0
fi
echo 0 > /tmp/fabro/spec_attempts
D=$(jq -r .decision $F 2>/dev/null || echo invalid)
echo '{\"context_updates\":{\"spec_status\":\"'$D'\"}}'"]

    quality [label="Code quality review", class="review-quality", timeout="15m", max_retries=1, prompt="@prompts/quality.md.j2"]
    quality_gate [label="Validate quality output", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/extra/quality.json
A=$(cat /tmp/fabro/quality_attempts 2>/dev/null || echo 0)
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/quality_attempts
  if [ $A -lt 2 ]; then echo 'no valid Input receipt: write the result with the submit tool, not write_file' >&2; exit 1; fi
  echo '{\"context_updates\":{\"quality_status\":\"invalid\"}}'
  exit 0
fi
echo 0 > /tmp/fabro/quality_attempts
D=$(jq -r .decision $F 2>/dev/null || echo invalid)
echo '{\"context_updates\":{\"quality_status\":\"'$D'\"}}'"]

    extra_decompose [label="Follow-up decomposer", class="review-frontier", timeout="15m", max_retries=1, prompt="@prompts/extra_decompose.md.j2"]
    extra_gate [label="Merge follow-up tasks", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/extra/followups.json
A=$(cat /tmp/fabro/extra_decompose_attempts 2>/dev/null || echo 0)
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
RM=0; if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then RM=1; S=invalid; else S=$(jq -r .status $F 2>/dev/null || echo invalid); fi
if [ \"$S\" != issues ] && [ \"$S\" != no_work ] && [ \"$S\" != needs_human_review ]; then S=invalid; fi
NEWCNT=0
if [ \"$S\" = issues ]; then
  T=$(jq -r '.issues | type' $F 2>/dev/null || echo none)
  N=$(jq '.issues | length' $F 2>/dev/null || echo 0)
  BAD=$(jq '[.issues[] | select((.id | type) != \"string\" or (.title | type) != \"string\" or (.body | type) != \"string\" or (.files | type) != \"array\" or (.id | length) == 0 or (.title | length) == 0 or (.body | length) == 0)] | length' $F 2>/dev/null || echo 99)
  if [ \"$T\" != array ] || [ \"$N\" = 0 ] || [ \"$BAD\" != 0 ]; then S=invalid; fi
fi
if [ \"$S\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/extra_decompose_attempts
  if [ $A -lt 2 ]; then if [ $RM = 1 ]; then echo 'no valid Input receipt: write the result with the submit tool, not write_file' >&2; else echo 'followups.json missing or invalid; rewrite it exactly per the contract' >&2; fi; exit 1; fi
fi
echo 0 > /tmp/fabro/extra_decompose_attempts
if [ \"$S\" = issues ]; then
  OLD=$(jq length /tmp/fabro/tasks.json)
  jq -n --slurpfile cur /tmp/fabro/tasks.json --slurpfile new $F '$cur[0] + [$new[0].issues[] | select(.id as $i | [$cur[0][].id] | index($i) | not) | . + {source: \"extra-review\", covers: (if (.covers | type) == \"array\" then .covers else [] end)}]' > /tmp/fabro/tasks.merged.json
  mv /tmp/fabro/tasks.merged.json /tmp/fabro/tasks.json
  NOW=$(jq length /tmp/fabro/tasks.json)
  NEWCNT=$((NOW-OLD))
  OVER=$(jq '[.[] | select(.source == \"extra-review\") | select((.covers | length) > 3)] | length' /tmp/fabro/tasks.json 2>/dev/null || echo 0)
  if [ \"$OVER\" != 0 ] && [ \"$OVER\" != \"\" ]; then
    echo 'WARNING: '$OVER' follow-up task(s) declare more than three covers entries and will not land in one coder stage:'
    jq -r '.[] | select(.source == \"extra-review\") | select((.covers | length) > 3) | \"  - \" + .id + \": \" + ((.covers | length) | tostring) + \" findings\"' /tmp/fabro/tasks.json
    echo 'plan sees each of these before its coder runs and can split it.'
  fi
fi
echo '{\"context_updates\":{\"followup_status\":\"'$S'\",\"new_tasks\":'$NEWCNT'}}'"]

    // ---- Delivery ----
    // final_merge brings main into the branch before open_pr_prep builds the PR, and hands
    // a conflict to resolve_merge the way next_task does before a task. It used to be the
    // first two lines of open_pr_prep: a bare `git merge` under `set -e`. A conflict failed
    // that node with the merge still in the tree, the checkpoint's `git add -A` marked the
    // conflicted file resolved and committed the markers as a merge commit, and from then
    // on every `[P] Accept partial` found main "Already up to date", ran CI on the
    // markers, failed, and came back to the gate -- the bare-merge version of the rule
    // that a conflicted merge never crosses a stage boundary.
    //
    // It happened twice on womens-fantasy-sports, both times because another PR landed
    // the same lines mid-run: #1834 (run 01M4PF5JV0FHXNV5TA0PC8TV3E, 2026-10-11, the
    // operator's cluster PR #1918) and #1747 (run 01M4S16BRA0W1J3W32S6ENJBXH, 2026-10-12,
    // sibling issue #1746's PR #1958 merged 11 minutes in; three trips through the gate).
    //
    // A fetch failure exits 1 to rescue_brief: resolve_merge may not fetch, so it could
    // not start the merge. A merge that fails with no unmerged path is not a conflict and
    // exits 1 the same way, with the tree reset. The conflicted paths go to
    // /tmp/fabro/final_merge_conflict: resolve_merge_gate reads it to route back here
    // instead of to the next task, and rescue_brief reads it to say why the run stopped.
    // next_task deletes it, so a task-time conflict never reads as this one. pre_merge_sha
    // is where resolve_merge_gate resets the branch when it rejects the agent's merge.
    // After a resolved merge this node runs again, a no-op unless main moved meanwhile.
    // It prints no file names: fabro scans stdout and stderr for brace-balanced objects.
    final_merge [label="Merge main before the PR", shape=parallelogram, timeout="5m", output_schema="routing",
        script="F=/tmp/fabro
mkdir -p $F
rm -f $F/final_merge_conflict $F/final_merge_conflict.new
git fetch origin main || { echo 'final_merge: git fetch origin main failed; nothing was merged' >&2; exit 1; }
git rev-parse HEAD > $F/pre_merge_sha
if git merge --no-edit origin/main; then
  echo '{\"context_updates\":{\"final_conflict\":false}}'
  exit 0
fi
git diff --name-only --diff-filter=U > $F/final_merge_conflict.new
git merge --abort || true
PRE=$(cat $F/pre_merge_sha)
if [ -e .git/MERGE_HEAD ] || [ \"$(git rev-parse HEAD)\" != \"$PRE\" ] || ! git diff --quiet HEAD; then git reset --hard \"$PRE\"; fi
if [ ! -s $F/final_merge_conflict.new ]; then
  rm -f $F/final_merge_conflict.new
  echo 'final_merge: git merge origin/main failed with no conflicted path; the branch is back at '$PRE >&2
  exit 1
fi
mv $F/final_merge_conflict.new $F/final_merge_conflict
echo 'final_merge: main conflicts with this branch in '$(wc -l < $F/final_merge_conflict)' file(s); the merge was aborted so no checkpoint commits markers, and resolve_merge redoes it'
echo '{\"context_updates\":{\"final_conflict\":true}}'"]

    // This node re-runs the SAME `setup.sh && ci.sh` that `validate` already ran, and the
    // two treat a failure completely differently: `validate` writes
    // /tmp/fabro/feedback/rework.md and takes `validate -> rework_router` into the
    // escalation ladder, while this one used to `exit 1` with no feedback at all and take
    // its unconditional edge to `human_rescue` -- a 4h gate holding a coder box, with no
    // route back to work.
    //
    // Run 01M2X2MVPC2NXY1BW5CVKPFF3S died that way on 2026-09-19 to a FLAKY TEST. The
    // evidence: `coder` touched only JoinModal.tsx and two test files, `validate` passed
    // on that tree, the three extra-round reviewers are read-only by prompt and wrote only
    // /tmp/fabro/extra/*.json, `git merge origin/main` reported `Already up to date`
    // (main had not moved in 35h and its own CI was green) -- and then an async test the
    // run never touched, useMovieCast.test.tsx, failed one assertion under a sandbox whose
    // own environment setup took 240s. Nothing the run did could have caused it and
    // nothing at the gate could fix it.
    //
    // So the suite is retried once before the node gives up. A flake passes on the second
    // run. A real failure fails twice and ROUTES (#35); it no longer exits 1. Before that,
    // the failure was classed transient_infra, the gate showed the first 600 bytes of the
    // log (a DOM dump on lawncare-saas#2733), and [P] Accept partial replayed the same tree
    // into the same failure until someone chose [X] (run 01M4PP2M37CPE6Q1874V6FBEM5).
    // The failing test names (vitest/jest FAIL, pytest FAILED/ERROR, cargo `... FAILED`,
    // go `--- FAIL:`) go to final_failures.txt and the top of feedback/rework.md, which
    // keeps the `## Validation failed` shape rework.md.j2 knows. Then `final_route`:
    //   drop    [P] brought edits no reviewer passed (partial_remainder's
    //           partial_unreviewed, and non-merge commits that change files after
    //           `reviewed_sha`) and no PR yet: drop_unreviewed resets to the reviewed work.
    //   draft   this code already failed here: the PR opens as a draft (pr_draft) and the
    //           run ends at mark_stuck instead of returning to the gate.
    //   fix     the run's first red final validation (`final_fix_attempts`, never reset):
    //           final_fix_prep -> rework_t4 -> validate -> review, then back here.
    // Its green path records HEAD's tree in /tmp/fabro/final_validated_tree;
    // the merge phase's `validate` reads it and skips the suite on that tree (C8).
    //   rescue  later red on code that has not failed here: the gate, tests in final_stop.
    //   pr      green.
    // "This code" is the patch-id of `git diff origin/main HEAD` -- the run's own change on
    // top of main, which ignores line shifts -- kept in final_fail_keys by fix and rescue.
    // Not the tree: main moves on a busy repo during the gate's 4h wait, and a tree key
    // would let the same failing code reach the gate on every [P].
    // The log never reaches stdout: this node now routes, and fabro scans stdout and
    // stderr for brace-balanced objects.
    //
    // The rest of the node derives the Conventional Commits subject, in three steps the
    // script marks inline. Two notes that do not fit on one line:
    //
    // A bracket word is as often a label name as a Conventional Commits type -- `[BUG]`
    // and `[Feature]` are the two commonest title shapes in these repos -- so step 2 maps
    // both vocabularies and strips the bracket either way. Leaving it produced subjects
    // like `fix: [BUG] ...`, which lint accepts and release-please publishes.
    //
    // The subject is truncated so that it plus the appended issue reference fits 72
    // characters, cutting at a word boundary where one exists within the last 12. The
    // reference is appended after the cut and is never truncated away.
    // THE EMPTY-DIFF FLOOR. Everything below this node derives the PR from
    // `/tmp/fabro/issue.json` -- the title from the issue title, the body from the first
    // prose paragraph of the issue body -- and NOTHING in the derivation reads the
    // working tree. That is correct for its own job and catastrophic without this guard:
    // fed a branch on which no task ever landed, it produces a perfectly well-formed PR
    // whose title and body assert that the issue was implemented, and `open_pr` publishes
    // it. The three `grep -q` assertions at the bottom of this script check the
    // DERIVATION, never that a change exists, so all of them passed on exactly that PR.
    //
    // The path that gets here with nothing is `human_rescue -> [P] Accept partial`. It
    // was designed for "some tasks landed, ship what we have" and had no floor at zero,
    // so it reads identically to "no tasks landed, ship it anyway".
    //
    // Cost, both on 2026-09-21, from the same two-line hole:
    //   01M310TQEWFMPHZ3XG5T22X09W  womens-fantasy-sports#1236, 0 files changed. `prep`
    //     died on a pypi.org timeout, so the run never decomposed. The PR body's summary
    //     is a sentence lifted verbatim out of issue #1205 -- "ADR-0021 is accepted and
    //     unimplemented" -- reading as a claim about work delivered. The merge phase's
    //     `review_fix` then read the reviewers' "this is empty" verdict and implemented
    //     the issue ITSELF, 396/-101 across 4 files, which is not its job.
    //   01M321VB0DC4N187GHA88RM0QB  writers-app#949, 0 files changed. `improve` timed out
    //     twice, so the run never ran a coder. Cancelled and the PR closed by hand.
    //
    // Two-dot `git diff --quiet origin/main HEAD` -- does the head TREE equal main's --
    // rather than three-dot, because it says the thing that matters regardless of how the
    // branch got there. final_merge, the node before this one, makes the two forms
    // equivalent here anyway, since it moves the merge base onto `origin/main`. `--quiet` exits 1 when a
    // difference EXISTS, which is why the check is the `if` condition and the failure is
    // the true branch; `set -e` does not fire on a condition's exit status.
    //
    // It runs before the setup/ci loop, not after: there is nothing to validate on a tree
    // that equals main, and the loop is two full CI runs on a 20m budget.
    //
    // `exit 1` takes the unconditional edge back to `human_rescue`, which is deliberate
    // rather than a route to `mark_stuck`: a refusal publishes no `final_route`, and an
    // operator who answers `[P]` a second time gets the same refusal rather than a PR.
    // The message names `[X] Abandon` because that is the answer that does the label
    // cleanup -- `agent-in-progress` off, `agent-stuck` on -- instead of leaving the
    // issue mid-flight.
    //
    // The SECOND floor is `.github/workflows/`. An agent that edits one poisons the whole
    // branch: the sandbox pushes over HTTPS with an OAuth App token (`gho_`), and GitHub
    // refuses any push whose new commits create or update a workflow file unless that
    // token carries the `workflow` scope. The host token does not -- its scopes are
    // `admin:public_key, gist, read:org, repo` -- and `repo` does not imply it.
    //
    // Everything about that failure is quiet until it is terminal. The checkpoint push
    // after every stage only WARNS (`Failed to push run branch ... [git_push_failed]`),
    // so the run keeps going with the remote branch frozen; `open_pr` is the first node
    // that cares, and it dies on `git push -u origin HEAD` under `set -e` in ~1s with
    // no routing schema and therefore `unknown error`. It then takes its unconditional
    // edge to `human_rescue`, whose `[P] Accept partial` leads straight back to THIS
    // node -- an unbounded loop through 2.8m of aggregate and CI, ending in the same
    // deterministic rejection every pass.
    //
    // Cost, run 01M33SDMZF55NAEV8JV29A8EA4 on 2026-09-22, womens-fantasy-sports#1201:
    // the `coder` stage on task 7 of 7 deleted one clause from a five-line YAML COMMENT
    // in `.github/workflows/test-backend.yml` -- seven lines, zero workflow semantics,
    // and the task's own reviewer flagged it as a nit to revert. That one commit
    // (7e0503d) rejected 17 of the run's 96 checkpoint pushes, froze the remote branch
    // 3.5 hours behind the sandbox, and cost two `[P] Accept partial` answers before the
    // loop was recognised. 98 commits and 71 files of real work sat only in the sandbox.
    //
    // The check walks `git rev-list --no-merges origin/main..HEAD` and reads each commit's
    // OWN diff with `git diff-tree`, not a two-dot `git diff`: the rejection is evaluated
    // against the COMMITS in the push, so a branch that edits a workflow file and reverts
    // it later still fails, and a net-diff test would call that branch clean. Merge
    // commits are skipped on purpose. A run's `git merge origin/main` creates a merge
    // commit that a path-limited `git log` lists whenever main changed a workflow file,
    // and the delta in it came entirely from main (issue #18; runs 01M4DKMH501PBVGDWXX15QSE4E,
    // 01M4DSYPAWDMJB68CCX5HM3M56, 01M4E7SM2CQP3AAA4V7AJ4TTRC, womens-fantasy-sports,
    // 2026-10-08: every task done, then refused, each holding a coder lease for hours).
    // The old list printed those merges with an empty `files:` section. This list prints
    // only the commit and file that matched. The same check runs in `integrate`, so a
    // task commit that edits a workflow file stops the run at the end of that task.
    //
    // It runs before the setup/ci loop, not after: there is nothing to validate on a tree
    // that equals main, and the loop is two full CI runs on a 20m budget.
    //
    // `exit 1` takes the unconditional edge back to `human_rescue`, which is deliberate
    // rather than a route to `mark_stuck`: a refusal publishes no `final_route`, and an
    // operator who answers `[P]` a second time gets the same refusal rather than a PR.
    // The message names `[X] Abandon` because that is the answer that does the label
    // cleanup -- `agent-in-progress` off, `agent-stuck` on -- instead of leaving the
    // issue mid-flight.
    //
    // The SECOND floor is `.github/workflows/`. An agent that edits one poisons the whole
    // branch: the sandbox pushes over HTTPS with an OAuth App token (`gho_`), and GitHub
    // refuses any push whose new commits create or update a workflow file unless that
    // token carries the `workflow` scope. The host token does not -- its scopes are
    // `admin:public_key, gist, read:org, repo` -- and `repo` does not imply it.
    //
    // Everything about that failure is quiet until it is terminal. The checkpoint push
    // after every stage only WARNS (`Failed to push run branch ... [git_push_failed]`),
    // so the run keeps going with the remote branch frozen; `open_pr` is the first node
    // that cares, and it dies on `git push -u origin HEAD` under `set -e` in ~1s with
    // no routing schema and therefore `unknown error`. It then takes its unconditional
    // edge to `human_rescue`, whose `[P] Accept partial` leads straight back to THIS
    // node -- an unbounded loop through 2.8m of aggregate and CI, ending in the same
    // deterministic rejection every pass.
    //
    // Cost, run 01M33SDMZF55NAEV8JV29A8EA4 on 2026-09-22, womens-fantasy-sports#1201:
    // the `coder` stage on task 7 of 7 deleted one clause from a five-line YAML COMMENT
    // in `.github/workflows/test-backend.yml` -- seven lines, zero workflow semantics,
    // and the task's own reviewer flagged it as a nit to revert. That one commit
    // (7e0503d) rejected 17 of the run's 96 checkpoint pushes, froze the remote branch
    // 3.5 hours behind the sandbox, and cost two `[P] Accept partial` answers before the
    // loop was recognised. 98 commits and 71 files of real work sat only in the sandbox.
    //
    // The check is `git log --no-merges origin/main..HEAD -- .github/workflows/`, not a
    // two-dot `git diff`: the rejection is evaluated against the COMMITS in the push, so a
    // branch that edits a workflow file and reverts it later still fails, and a net-diff
    // test would call that branch clean. `--no-merges` is load-bearing: without it, an
    // stale branch's `git merge origin/main` can create a merge commit whose workflow
    // tree matches neither parent (a real 3-way content merge), and path-limited history
    // simplification then INCLUDES that merge commit even though the workflow delta came
    // entirely from main -- a false positive that trips the guard, loops the Accept-partial
    // path, and dies to the deterministic breaker. The motivating case (run
    // 01M4DSYPAWDMJB68CCX5HM3M56, womens-fantasy-sports#1391) was exactly that: only the
    // merge commit `64240f8` was flagged with an empty files list. Excluding merges keeps
    // the guard aimed at agent-authored workflow commits while letting a clean
    // merge-of-main through.
    //
    // It runs before the setup/ci loop for the same reason the empty-tree floor does:
    // there is nothing to validate on a branch that cannot be pushed, and this makes the
    // Accept-partial loop cost ~1s instead of 2.8m.
    //
    // The THIRD floor is conflict markers. final_merge keeps a conflicted merge out of
    // the checkpoint, so this fires only on a branch poisoned some other way -- a run from
    // before final_merge existed, or an agent that wrote them -- and it says so in one
    // line instead of 13 lint errors. It reads only lines this branch ADDS, so a
    // repository that commits a conflict-marker fixture on main does not trip it.
    // Step 1: the issue title already carries a Conventional Commits prefix; use it as-is
    // Step 2: a [Bracket] prefix names a type
    // Step 3: an issue label maps to a type; fabro bookkeeping labels never map
    // Commit body: the first prose paragraph of the issue body, else Resolves #N: <title>
    // Assertions: a derivation bug must fail the run into human_rescue, not open an
    // unmergeable PR. These can only fire on a bug; the derivation always terminates.
    open_pr_prep [label="Final aggregate and PR prep", shape=parallelogram, timeout="20m", output_schema="routing",
        script="set -e
rm -f /tmp/fabro/pr_draft /tmp/fabro/final_stop /tmp/fabro/final_failures.txt /tmp/fabro/final_validated_tree
if git diff --quiet origin/main HEAD; then
  echo 'refusing to open a PR: the branch tree is identical to origin/main, so this run changed nothing.' >&2
  echo 'every commit on this branch is a fabro stage checkpoint touching no repository file.' >&2
  if [ -s /tmp/fabro/completed.md ]; then
    echo 'tasks recorded as landed (which contradicts the empty tree -- read the run):' >&2
    cat /tmp/fabro/completed.md >&2
  else
    echo 'no task ever reached integrate: /tmp/fabro/completed.md is absent or empty.' >&2
  fi
  echo 'a PR from here would carry a title and body derived from the issue, asserting work that does not exist.' >&2
  echo 'answer [X] Abandon at the rescue gate unless the run can be made to do the work.' >&2
  exit 1
fi
WFB=$(for C in $(git rev-list --no-merges origin/main..HEAD); do git diff-tree --no-commit-id --name-only -r \"$C\" -- .github/workflows/ | sed 's/^/'$C' /'; done)
if [ -n \"$WFB\" ]; then
  echo 'refusing to open a PR: a commit on this branch changes a file under .github/workflows/.' >&2
  echo 'the sandbox pushes over HTTPS with an OAuth App token. GitHub rejects any push whose' >&2
  echo 'new commits create or update a workflow file unless that token carries the `workflow`' >&2
  echo 'scope, and this one does not -- the push fails with:' >&2
  echo '  ! [remote rejected] (refusing to allow an OAuth App to create or update workflow' >&2
  echo '    `.github/workflows/...` without `workflow` scope)' >&2
  echo 'commits whose own diff touches it (merge commits are not listed):' >&2
  echo \"$WFB\" | while read -r C F; do echo \"  $(git log -1 --format='%h %s' $C)\" >&2; echo \"    $F\" >&2; done
  echo 'this is NOT recoverable by answering [P] Accept partial again: the rejection is' >&2
  echo 'deterministic and every later checkpoint push on this branch fails the same way.' >&2
  echo 'the operator fixes it one of two ways, both outside this run:' >&2
  echo '  1. grant the scope -- gh auth refresh -h github.com -s workflow, then reset the' >&2
  echo '     server GITHUB_TOKEN secret. Fixes the whole class for every repo.' >&2
  echo '  2. land the branch on the remote over SSH, which has no such restriction. Once' >&2
  echo '     the offending commits are on the remote, later pushes carry only new commits' >&2
  echo '     and are accepted.' >&2
  exit 1
fi
CMF=$(git diff origin/main HEAD | awk '/^[+][+][+] b[/]/ { f = substr($0, 7) } /^[+](<<<<<<<|>>>>>>>)/ { print f }' | sort -u)
if [ -n \"$CMF\" ]; then
  echo 'refusing to open a PR: the branch adds unresolved conflict markers (lines starting <<<<<<< or >>>>>>>) in:' >&2
  echo \"$CMF\" | sed 's/^/  /' >&2
  echo 'a conflicted merge reached a stage checkpoint, whose git add -A recorded the file as resolved.' >&2
  echo 'answering [P] Accept partial again cannot remove them. Type guidance for the rework agent' >&2
  echo 'to remove them, or answer [X] Abandon.' >&2
  exit 1
fi
A=1
while :; do
  RC=0
  ./.fabro/setup.sh > /tmp/fabro/validate_output.log 2>&1 && ./.fabro/ci.sh >> /tmp/fabro/validate_output.log 2>&1 || RC=$?
  if [ $RC = 0 ]; then echo 'final validation passed on attempt '$A; break; fi
  if [ $A -ge 2 ]; then break; fi
  echo '## final validation attempt '$A' failed; retrying once in case it is a flake'
  A=$((A + 1))
  sleep 5
done
if [ $RC = 0 ]; then
  git rev-parse 'HEAD^{tree}' > /tmp/fabro/final_validated_tree
fi
ROUTE=pr
if [ $RC != 0 ]; then
  awk 'BEGIN { e = sprintf(\"%c\", 27) } { gsub(e \"[[][0-9;]*[A-Za-z]\", \"\"); gsub(/[[:cntrl:]]/, \"\"); sub(/^[[:space:]]+/, \"\"); sub(/[[:space:]]+$/, \"\") } /^FAIL[[:space:]]/ || /^FAILED[[:space:]]/ || /^ERROR[[:space:]]/ || /^--- FAIL: / || /^test .* [.][.][.] FAILED$/ { if (!seen[$0]++) print substr($0, 1, 200) }' /tmp/fabro/validate_output.log | head -30 > /tmp/fabro/final_failures.txt
  mkdir -p /tmp/fabro/feedback
  {
    echo '## Validation failed (exit '$RC'): ./.fabro/setup.sh && ./.fabro/ci.sh'
    echo
    echo 'This is the final validation, run after every task passed its own validate and origin/main was merged in. It failed twice, so it is not a flake.'
    echo
    if [ -s /tmp/fabro/final_failures.txt ]; then echo 'Failing tests:'; echo; cat /tmp/fabro/final_failures.txt; else echo 'No failing test name was recognised in the output; the log tail is below.'; fi
    echo
    tail -c 6000 /tmp/fabro/validate_output.log
  } > /tmp/fabro/feedback/rework.md
  KEY=$(git diff origin/main HEAD | git patch-id --stable 2>/dev/null | cut -d' ' -f1)
  if [ -z \"$KEY\" ]; then KEY=$(git rev-parse 'HEAD^{tree}'); fi
  RS=$(cat /tmp/fabro/reviewed_sha 2>/dev/null || true)
  UNREV=''
  if [ -e /tmp/fabro/partial_unreviewed ] && [ -n \"$RS\" ] && [ ! -s /tmp/fabro/pr_number ] && git cat-file -e \"$RS^{commit}\" 2>/dev/null; then
    for C in $(git rev-list --no-merges \"$RS\"..HEAD); do
      if [ -n \"$(git diff-tree --no-commit-id --name-only -r \"$C\")\" ]; then UNREV=yes; break; fi
    done
  fi
  FA=$(cat /tmp/fabro/final_fix_attempts 2>/dev/null || echo 0)
  case \"$FA\" in '' | *[!0-9]*) FA=0 ;; esac
  if [ -n \"$UNREV\" ]; then
    ROUTE=drop
  elif grep -qxF \"$KEY\" /tmp/fabro/final_fail_keys 2>/dev/null; then
    ROUTE=draft
    : > /tmp/fabro/pr_draft
  elif [ \"$FA\" = 0 ]; then
    ROUTE=fix
    echo 1 > /tmp/fabro/final_fix_attempts
    echo \"$KEY\" >> /tmp/fabro/final_fail_keys
  else
    ROUTE=rescue
    echo \"$KEY\" >> /tmp/fabro/final_fail_keys
    if [ -s /tmp/fabro/final_failures.txt ]; then cp /tmp/fabro/final_failures.txt /tmp/fabro/final_stop
    else echo 'No failing test name was recognised; feedback/rework.md has the log tail.' > /tmp/fabro/final_stop; fi
  fi
  echo 'final validation failed twice; route '$ROUTE'. Failing tests:'
  tr -d '{}' < /tmp/fabro/final_failures.txt
  if [ $ROUTE != draft ]; then echo '{\"context_updates\":{\"final_route\":\"'$ROUTE'\"}}'; exit 0; fi
fi
N=$(jq -r .number /tmp/fabro/issue.json)
T=$(jq -r .title /tmp/fabro/issue.json | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
CC='^(feat|fix|docs|chore|refactor|test|ci|build|perf|revert)([(][a-z0-9 ._/-]+[)])?[!]?: .'
S=$T
if ! printf '%s' \"$S\" | grep -qE \"$CC\"; then
  case \"$S\" in
    '['*)
      W=${S#?}
      W=${W%%]*}
      W=$(printf '%s' \"$W\" | tr 'A-Z' 'a-z')
      case \"$W\" in
        bug) W=fix ;;
        feature|enhancement) W=feat ;;
        documentation) W=docs ;;
        performance) W=perf ;;
        chore|task) W=chore ;;
      esac
      case \"$W\" in
        feat|fix|docs|chore|refactor|test|ci|build|perf|revert)
          REST=${S#?}
          REST=${REST#*]}
          REST=$(printf '%s' \"$REST\" | sed 's/^[[:space:]]*//')
          S=\"$W: $REST\"
          ;;
      esac
      ;;
  esac
  if ! printf '%s' \"$S\" | grep -qE \"$CC\"; then
    TYPE=
    L=$(jq -r '[.labels[].name] | join(\",\")' /tmp/fabro/issue.json 2>/dev/null | tr 'A-Z' 'a-z' || true)
    case \",$L,\" in
      *,bug,*) TYPE=fix ;;
      *,enhancement,*|*,feature,*) TYPE=feat ;;
      *,documentation,*|*,docs,*) TYPE=docs ;;
      *,performance,*) TYPE=perf ;;
    esac
    if [ -n \"$TYPE\" ]; then S=\"$TYPE: $S\"; fi
    if ! printf '%s' \"$S\" | grep -qE \"$CC\"; then
      S='chore: '$S
    fi
  fi
fi
SUBJ=$(printf '%s' \"$S\" | awk -v maxd=$((72 - ${#N} - 4)) '{ if (length($0) <= maxd) { print $0; exit } t = substr($0, 1, maxd); st = maxd - 11; if (st < 1) st = 1; for (i = maxd; i >= st; i--) { if (substr(t, i, 1) == \" \") { print substr(t, 1, i - 1); exit } } print t }')
SUBJ=$(printf '%s' \"$SUBJ\" | sed 's/[[:space:]]*$//')
printf '%s (#%s)' \"$SUBJ\" \"$N\" > /tmp/fabro/commit_subject.txt
echo >> /tmp/fabro/commit_subject.txt
cp /tmp/fabro/commit_subject.txt /tmp/fabro/pr_title.txt
B=$(jq -r .body /tmp/fabro/issue.json 2>/dev/null || true)
FIRST=$(printf '%s' \"$B\" | awk 'BEGIN { RS = \"\" } $0 ~ /^[[:space:]]*#/ { next } { para = \"\"; for (i = 1; i <= NF; i++) { line = $i; sub(/^[[:space:]]*[-*+][[:space:]]+/, \"\", line); sub(/^[[:space:]]*[0-9]+[.)][[:space:]]+/, \"\", line); sub(/^[[:space:]]*#+[[:space:]]+/, \"\", line); if (para == \"\") para = line; else para = para \" \" line } if (para != \"\" && length(para) <= 500) { print para; exit } }')
if [ -n \"$FIRST\" ]; then
  { printf '%s' \"$FIRST\"; echo; echo; echo 'Resolves #'$N; } > /tmp/fabro/commit_body.md
else
  echo 'Resolves #'$N': '$T > /tmp/fabro/commit_body.md
fi
if [ -e /tmp/fabro/pr_draft ]; then
  { echo '- ./.fabro/setup.sh && ./.fabro/ci.sh failed after the final merge with origin/main, on a tree whose failure a human had already seen. This draft holds the reviewed work so it is not lost; a human makes CI pass.'; if [ -s /tmp/fabro/final_failures.txt ]; then echo; echo 'Failing tests:'; echo; echo '```'; cat /tmp/fabro/final_failures.txt; echo '```'; fi; } > /tmp/fabro/validation.md
else
  echo '- ./.fabro/setup.sh && ./.fabro/ci.sh green after final merge with origin/main' > /tmp/fabro/validation.md
fi
{ echo '## Summary'; echo; echo '<!-- fabro:commit-body:start -->'; cat /tmp/fabro/commit_body.md; echo '<!-- fabro:commit-body:end -->'; echo; cat /tmp/fabro/completed.md 2>/dev/null || true; echo '## Validation'; echo; cat /tmp/fabro/validation.md; } > /tmp/fabro/pr_body.md
jq -r '.body // \"\"' /tmp/fabro/issue.json | awk '/^## Post-deploy checks$/{s=1; next} s && /^## /{s=0} s && /^- [[] []] /{print}' > /tmp/fabro/post_items.txt
if [ -s /tmp/fabro/post_items.txt ]; then { echo; echo '## Post-deploy checks'; echo; echo 'Not checked by the agents. Verify after deploy.'; echo; cat /tmp/fabro/post_items.txt; } >> /tmp/fabro/pr_body.md; fi
grep -qE '^(feat|fix|docs|chore|refactor|test|ci|build|perf|revert)([(][a-z0-9 ._/-]+[)])?[!]?: .' /tmp/fabro/commit_subject.txt
grep -q '^Resolves #' /tmp/fabro/commit_body.md
grep -q 'fabro:commit-body:start' /tmp/fabro/pr_body.md
echo '{\"context_updates\":{\"final_route\":\"'$ROUTE'\"}}'"]

    // drop_unreviewed: open_pr_prep routes here when the final validation failed on a
    // branch that carries edits no reviewer passed -- [P] brought an unfinished task
    // (partial_remainder writes partial_unreviewed) and non-merge commits change files
    // after `reviewed_sha`, which `integrate` writes -- and no PR exists yet (#35). The
    // marker keeps a drop_followup revert or CI output a checkpoint committed from
    // reading as unreviewed work. That is
    // the `[P] Accept partial` path: it ships the unfinished task's edits, which are the
    // likeliest thing to fail, and before this node every later [P] replayed the same
    // failure (run 01M4PP2M37CPE6Q1874V6FBEM5, lawncare-saas#2733). The unfinished task is
    // already in remainder.json, so dropping its edits loses nothing that is not redone.
    //
    // A reset, not `git restore`: the commits after reviewed_sha include main's merges
    // (next_task, final_merge), and restoring the reviewed tree on top would revert main's
    // changes in the PR. final_merge merges main again next. Rewinding is safe only
    // because nothing has been pushed: backlog pushes first in open_pr, and open_pr_prep
    // routes here only when no pr_number exists. After the reset there is nothing
    // unreviewed left, so open_pr_prep cannot route here twice for the same edits.
    drop_unreviewed [label="Drop the edits no reviewer passed", shape=parallelogram,
        script="set -e
F=/tmp/fabro
RS=$(cat $F/reviewed_sha)
git cat-file -e \"$RS^{commit}\"
git reset --hard \"$RS\"
git clean -fdq
rm -f $F/partial_unreviewed
T=$(jq -r '.title // \"the unfinished task\"' $F/current_task.json 2>/dev/null || echo 'the unfinished task')
{ echo '### Dropped: the unreviewed edits of '$T; echo '- Not in this PR. The final validation failed with these edits, which no reviewer had passed, so the branch went back to the last reviewed task. The unfinished task is in the remainder issue.'; echo; } >> $F/completed.md
echo 'dropped the unreviewed edits: branch reset to the last reviewed commit '$RS"]

    // final_fix_prep: the one automatic fix turn for a red final validation (#35), and the
    // route human guidance takes after one. The failure becomes a task the existing ladder
    // can work: appended to tasks.json and selected the way next_task selects one, so
    // integrate records it, rescue_brief counts it, and next_task finds every task done
    // after it. `final_fix` marks it, so partial_remainder never files it as unfinished
    // work. The diff base is the merged HEAD: the reviewer judges the fix alone, not main's
    // merge against the last task's spec. `round` starts at 6, so a red validate or a
    // rejected review after the tier-4 turn goes to rescue_brief (round 7), never to
    // drop_followup or demote_lane, which act only on round 6. A second visit (guidance
    // after the fix task) reuses the task. The previous task's dossier is deleted, and
    // final_stop with it, so a later stop is not read as this one.
    final_fix_prep [label="Make the final validation failure a task", shape=parallelogram,
        script="set -e
F=/tmp/fabro
if [ \"$(jq -r '.final_fix // false' $F/current_task.json 2>/dev/null)\" != true ]; then
  L=$(sed 's/^/- /' $F/final_failures.txt 2>/dev/null | head -30)
  if [ -z \"$L\" ]; then L='- no test name was recognised; feedback/rework.md has the log tail'; fi
  B=\"The final validation (./.fabro/setup.sh && ./.fabro/ci.sh) failed twice on this branch, after every task passed review and origin/main was merged in. Make it pass with the smallest change. Fix the code or the test that is wrong; never skip, delete or weaken a test to make it pass.

Failing tests:
$L\"
  jq --arg b \"$B\" '. + [{id: \"final-fix\", title: \"Make the final validation pass\", body: $b, files: [], covers: [], source: \"final-fix\", final_fix: true}]' $F/tasks.json > $F/tasks.fix.json
  mv $F/tasks.fix.json $F/tasks.json
  jq '.[-1]' $F/tasks.json > $F/current_task.json
  jq length $F/tasks.json > $F/task_index
fi
git rev-parse HEAD > $F/task_base_sha
echo 6 > $F/round
echo 0 > $F/review_attempts
rm -f $F/task-context.md $F/task-code.md $F/final_stop
echo 'final-fix task '$(cat $F/task_index)' selected; diff base '$(cat $F/task_base_sha)"]

    // `open_pr` is the only node that opens a PR, including on the
    // human_rescue -> [P] Accept partial -> final_merge -> open_pr_prep -> open_pr path, so it is the
    // single place that has to publish the PR number for the trigger that follows.
    //
    // The trigger cannot read `pr_url` back out of the context: command `script`
    // substitution supports {{ goal }}, {{ inputs.* }} and {{ vars.* }} only, there is
    // no {{ context.* }}, and `stdin_source` pipes exactly one key. So this uses the
    // file-backed contract both workflows are already built on. `pr-review` states the
    // same rule for itself: every later stage reads the number from a file rather than
    // re-interpolating it.
    //
    // `sed 's|.*/||'` uses | delimiters because a backslash is illegal in a .fabro
    // file. https://github.com/o/r/pull/123 yields 123.
    // `--head` and the explicit branch argument on `gh pr view` are load bearing.
    // Never let gh infer the branch here.
    //
    // The sandbox clone is shallow and SINGLE-BRANCH: fabro clones with
    // `remote.origin.fetch = +refs/heads/main:refs/remotes/origin/main`, so there
    // is no refspec that can store a remote-tracking ref for `fabro/run/<id>`.
    // `git push -u` still reports `branch '...' set up to track '...'` and still
    // writes `branch.<name>.remote`/`.merge`, but `refs/remotes/origin/<branch>`
    // is never created and `@{u}` fails with `not stored as a remote-tracking
    // branch`. gh resolves the head remote through exactly that ref, so a bare
    // `gh pr create` aborts with \"you must first push the current branch to a
    // remote, or use the --head flag\" -- with the branch sitting on the remote at
    // exactly HEAD the whole time. That cost run 01M2VHAGXNM9JNEY71085HV82Y its
    // PR on jelly-swipe#350, after 41 minutes of completed work.
    //
    // Since ADR 0011 D1 fabro no longer pushes checkpoints, so `deliver`,
    // `ci_fix_gate` and `remerge_base` push for real. Their bare
    // `--force-with-lease` needs a remote-tracking ref, which the single-branch
    // clone does not have, and is otherwise rejected as `stale info`. So the three
    // lines after `git push -u origin HEAD` map just the run branch and fetch it.
    // The `grep -qxF` guard keeps a second visit (human_rescue -> [P]) from adding
    // the refspec twice.
    //
    // `pr-review`'s claim node hits the same clone property and solves it the
    // other way, widening the refspec to all branches (`git config
    // remote.origin.fetch \"+refs/heads/*:refs/remotes/origin/*\"`). That is the
    // right fix THERE, because `gh pr checkout` genuinely needs a local tracking
    // branch. Here the run branch is the only one that needs it, so this node
    // maps just that ref.
    //
    // The existence check also moved AHEAD of the create. The old form was
    // `gh pr create ... || gh pr view --json url > /dev/null`, which reads as
    // \"tolerate an already-open PR\" but swallows every real gh error into a
    // discarded fallback, and then dies at the next line under `set -e` with the
    // cause buried. Asking first is the same idempotency with the error intact.
    open_pr [label="Push and open PR", shape=parallelogram, output_schema="routing",
        script="set -e
B=$(git rev-parse --abbrev-ref HEAD)
git push -u origin HEAD
R=\"+refs/heads/$B:refs/remotes/origin/$B\"
git config --get-all remote.origin.fetch | grep -qxF \"$R\" || git config --add remote.origin.fetch \"$R\"
git fetch origin \"$R\"
N=$(jq -r .number /tmp/fabro/issue.json)
T=$(cat /tmp/fabro/pr_title.txt)
rm -f /tmp/fabro/draft_reason.md
DRAFT=false
if [ -e /tmp/fabro/pr_draft ]; then DRAFT=true; fi
PR_URL=$(gh pr view \"$B\" --json url --jq .url 2>/dev/null || true)
if [ -z \"$PR_URL\" ]; then
  if [ $DRAFT = true ]; then
    gh pr create --head \"$B\" --title \"$T\" --body-file /tmp/fabro/pr_body.md --label agent-authored --draft
  else
    gh pr create --head \"$B\" --title \"$T\" --body-file /tmp/fabro/pr_body.md --label agent-authored
  fi
  PR_URL=$(gh pr view \"$B\" --json url --jq .url)
elif [ $DRAFT = true ]; then
  gh pr ready \"$B\" --undo || echo 'could not turn the open PR back into a draft' >&2
  gh pr edit \"$B\" --body-file /tmp/fabro/pr_body.md || echo 'could not update the PR body' >&2
fi
if [ -z \"$PR_URL\" ]; then
  echo 'no PR is visible for head branch '\"$B\"' after create; refusing to report an empty pr_url' >&2
  exit 1
fi
if jq -e '[.labels[]?.name] | index(\"architecture\") != null' /tmp/fabro/issue.json > /dev/null 2>&1; then
  gh label create architecture --color 0E8A16 --description 'Architecture review: a deepening candidate (ADR 0012)' 2>/dev/null || true
  gh pr edit \"$B\" --add-label architecture
fi
echo $PR_URL | sed 's|.*/||' > /tmp/fabro/pr_number
if [ $DRAFT = true ]; then
  { echo 'The final validation failed twice on the same code, so this run stopped before review and merge. Draft PR '$PR_URL' holds the work that passed review; a human makes CI pass and marks it ready for review.'; if [ -s /tmp/fabro/final_failures.txt ]; then echo; echo 'Failing tests:'; echo; echo '```'; cat /tmp/fabro/final_failures.txt; echo '```'; fi; } > /tmp/fabro/draft_reason.md
else
  gh issue edit $N --remove-label agent-in-progress --add-label Review || true
  gh issue comment $N --body 'Agent run complete. PR: '$PR_URL || true
fi
echo '{\"context_updates\":{\"pr_url\":\"'$PR_URL'\",\"pr_draft\":'$DRAFT'}}'"]

    // file_remainder: the decomposed tasks this run did not start because its task
    // budget of 8 was spent (ADR 0011 D6; `next_task` moved them to /tmp/fabro/remainder.json)
    // become ONE issue, labelled `agent-remainder` and `ai-generated` -- NOT `agent`.
    // `partial_remainder` adds the unfinished and unstarted tasks to the same file when
    // an operator chooses [P] Accept partial, and marks it with remainder_kind so the
    // issue and the PR comment say why those tasks were not done.
    // The scheduler's remainder promoter adds `agent` and `priority` once this PR
    // merges (automatically or by hand), so the remainder is worked next and never
    // starts from a `main` that lacks this PR. The first body line is the marker the
    // promoter parses: `<!-- fabro:remainder parent=<N> pr=<P> -->`.
    //
    // Always exits 0: the PR is already open, and a failure here must not park the run
    // on human_rescue. If the issue cannot be filed, the unstarted tasks are listed on
    // the PR instead, so they are never lost silently. /tmp/fabro/remainder_issue makes
    // a second visit (human_rescue -> [P] -> open_pr -> here) a no-op.
    //
    // No output_schema: this node publishes no context key.
    file_remainder [label="File the remainder issue", shape=parallelogram,
        script="R=/tmp/fabro/remainder.json
if [ ! -s $R ] || [ \"$(jq length $R 2>/dev/null || echo 0)\" = 0 ]; then echo 'no remainder: every task fit the task budget'; exit 0; fi
if [ -s /tmp/fabro/remainder_issue ]; then echo 'remainder already filed as #'$(cat /tmp/fabro/remainder_issue); exit 0; fi
N=$(jq -r .number /tmp/fabro/issue.json)
T=$(jq -r .title /tmp/fabro/issue.json)
PR=$(cat /tmp/fabro/pr_number)
K=$(jq length $R)
RUN=$(basename \"$(git rev-parse --abbrev-ref HEAD)\")
gh label create agent-remainder --color C5DEF5 2>/dev/null || true
gh label create ai-generated --color EDEDED 2>/dev/null || true
gh label create priority --color B60205 2>/dev/null || true
{
  echo '<!-- fabro:remainder parent='$N' pr='$PR' -->'
  echo
  if [ -s /tmp/fabro/remainder_kind ]; then
    echo 'This issue continues #'$N'. fabro run `'$RUN'` stopped before it finished: an operator chose Accept partial at its rescue gate, and PR #'$PR' carries the tasks that landed. The '$K' task(s) below are not done. The first one may be partly in that PR.'
  else
    echo 'This issue continues #'$N'. fabro run `'$RUN'` implemented the first 8 decomposed tasks in PR #'$PR' and stopped at its task budget (fabro-workflows ADR 0011). The '$K' task(s) below were not started.'
  fi
  echo
  echo 'It is held with `agent-remainder`. The scheduler adds `agent` and `priority` as soon as PR #'$PR' merges, so it is worked next. If PR #'$PR' is closed without merging, the scheduler labels it `agent-stuck` instead. Do not add `agent` by hand before the PR merges.'
  echo
  echo 'These tasks were decomposed against an older `main`. Decompose again against the current `main`; treat them as a starting point, not a plan.'
  echo
  echo '## Remaining tasks'
  echo
  jq -r '.[] | \"### \" + .title + ([10]|implode) + ([10]|implode) + .body + ([10]|implode)' $R
} > /tmp/fabro/remainder_body.md
AR=''
if jq -e '[.labels[]?.name] | index(\"architecture\") != null' /tmp/fabro/issue.json > /dev/null 2>&1; then
  gh label create architecture --color 0E8A16 --description 'Architecture review: a deepening candidate (ADR 0012)' 2>/dev/null || true
  AR='--label architecture'
fi
URL=$(gh issue create --title \"Remainder of #$N: $T\" --body-file /tmp/fabro/remainder_body.md --label agent-remainder --label ai-generated $AR 2>/dev/null) || URL=''
M=$(printf '%s' \"$URL\" | sed 's|.*/||')
case \"$M\" in
  '' | *[!0-9]*)
    echo 'WARNING: could not file the remainder issue; listing the unstarted tasks on the PR instead' >&2
    {
      echo 'fabro could not file a remainder issue for this PR. These tasks from #'$N' were NOT implemented:'
      echo
      jq -r '.[] | \"- \" + .title' $R
    } > /tmp/fabro/remainder_comment.md
    gh pr comment \"$PR\" --body-file /tmp/fabro/remainder_comment.md || true
    exit 0 ;;
esac
echo $M > /tmp/fabro/remainder_issue
{
  if [ -s /tmp/fabro/remainder_kind ]; then
    echo 'This PR carries the tasks of #'$N' that landed before an operator chose Accept partial at the rescue gate. The other '$K' are in #'$M'.'
  else
    echo 'This PR implements the first 8 decomposed tasks of #'$N', plus any extra-review follow-ups. The other '$K' are in #'$M'.'
  fi
  echo
  echo 'The scheduler queues #'$M' with `priority` as soon as this PR merges, whether it is merged automatically or by hand.'
} > /tmp/fabro/remainder_comment.md
gh pr comment \"$PR\" --body-file /tmp/fabro/remainder_comment.md || true
echo 'remainder filed as #'$M"]

    // ---- Review and merge, in this run ----
    // The bridge is gone. It fired a separate durable `pr-review` run, which then
    // queued behind every other run on a two-slot scheduler: an 11-minute review
    // waiting hours behind eight-hour implementations, which is why PRs piled up
    // unreviewed. The review and merge phase is now spliced in here at parse time:
    // no child run, no second sandbox, no scheduler queue.
    //
    // `review_merge` is an import placeholder -- NOT to be confused with this
    // graph's own per-task `review` node. Its ids arrive prefixed
    // (`review_merge.merge_gate`), and `pr-review` imports the same file, so there is one
    // copy of this logic rather than two that drift. Entry and exit contracts are
    // documented at the top of .fabro/workflows/_shared/review-merge/review-merge.fabro.
    //
    // The reviewers inside it are fresh sessions on a fresh diff, which is the point:
    // they run after every task AND every extra-review follow-up has landed, so they
    // judge the branch that is actually going to merge.
    // No `output_schema="routing"`. This node publishes no context key -- the edge
    // out of it routes on `outcome=succeeded` alone -- and a command node that
    // declares the routing schema must print a routing object as the last JSON on
    // stdout. `echo handoff ready` is not one, so fabro failed the stage on schema
    // validation, which for a command node is deterministic and non-retryable: no
    // repair turn, no retry, straight to human_rescue with the PR already open.
    // Cost one run (01M2R057XAWN8ZG0A7ZV7YPJXK) on 2026-09-17.
    //
    // `run_base_sha` is the BRANCH POINT, not the last task's base. `task_base_sha` is
    // rewritten by `next_task` on every task, so using it would make the report's
    // "Commits with changes" section cover only the final task instead of everything
    // this run did.
    //
    // The per-repo auto-merge switch lives in the pr-review-<repo> automation's
    // description, because an automation row has no inputs or labels field. The bridge
    // used to read it; this does now, so the switch keeps working unchanged. An absent
    // token means ON (decision 10); anything present that is not `true` means OFF, and an
    // unreachable API means OFF, because a switch that cannot be read is not armed.
    //
    // The merge mode (ADR 0023 D5/D6, contracts C3 and C9): `queue` only for a fast-lane
    // run without `remainder_kind` (the [P] Accept partial path) whose diff against the
    // base is at most 200 changed lines in at most 10 files, counting neither the paths
    // the hygiene counters exclude (XP below is a copy of `exclude_paths` in the
    // review-merge `hygiene` node's default.json, kept equal by ops/gate_tests/) nor
    // a binary file's lines. Anything else, and any failure to compute the diff, writes
    // `watch`, the mode that waits for CI. Over the ceiling it posts one PR comment.
    pr_handoff [label="Hand off to review and merge", shape=parallelogram,
        script="set -e
PR=$(cat /tmp/fabro/pr_number)
gh pr view $PR --json number,title,body,url,state,isCrossRepository,headRefName,baseRefName,headRefOid,labels,closingIssuesReferences > /tmp/fabro/pr.json
jq -r .baseRefName /tmp/fabro/pr.json > /tmp/fabro/base_ref
jq -r .headRefName /tmp/fabro/pr.json > /tmp/fabro/head_ref
jq '[.closingIssuesReferences[]?]' /tmp/fabro/pr.json > /tmp/fabro/linked_issues.json
B=$(cat /tmp/fabro/base_ref)
git fetch origin \"$B\" 2>/dev/null || true
git merge-base origin/\"$B\" HEAD > /tmp/fabro/run_base_sha 2>/dev/null || git rev-parse HEAD > /tmp/fabro/run_base_sha
echo 0 > /tmp/fabro/auto_merge_repo
REPO=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || echo '')
if [ -n \"$REPO\" ] && [ -n \"${FABRO_API_URL:-}\" ] && [ -n \"${FABRO_API_TOKEN:-}\" ]; then
  if curl -fsS -H \"Authorization: Bearer $FABRO_API_TOKEN\" $FABRO_API_URL/automations > /tmp/fabro/autorows.json 2>/dev/null; then
    D=$(jq -r --arg r \"$REPO\" '[.data[] | select(.workflow == \"pr-review\" and .target.repo == $r)] | .[0].description // \"\"' /tmp/fabro/autorows.json)
    case \"$D\" in
      *auto_merge*) T=$(printf '%s' \"$D\" | grep -o 'auto_merge=[A-Za-z0-9_-]*' | tail -1 | cut -d= -f2)
                    case \"$T\" in true) echo 1 > /tmp/fabro/auto_merge_repo ;; esac ;;
      *) echo 1 > /tmp/fabro/auto_merge_repo ;;
    esac
  fi
fi
MM=watch
if [ \"$(cat /tmp/fabro/lane 2>/dev/null || echo standard)\" = fast ] && [ ! -e /tmp/fabro/remainder_kind ]; then
  XP='[\"(^|/)(package-lock[.]json|yarn[.]lock|pnpm-lock[.]yaml|bun[.]lockb?|Cargo[.]lock|poetry[.]lock|uv[.]lock)$\", \"[.]min[.](js|css)$\", \"(^|/)(dist|build|vendor|node_modules)/\"]'
  EX=$(printf '%s' \"$XP\" | jq -r 'map(\"(\" + . + \")\") | join(\"|\")')
  if git diff --numstat --no-renames \"origin/$B...HEAD\" > /tmp/fabro/numstat.txt 2>/dev/null && RES=$(awk -v ex=\"$EX\" '{ p = $0; sub(/^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/, \"\", p); if (ex != \"\" && p ~ ex) next; n++; if ($1 != \"-\") l += $1 + $2 } END { print l + 0, n + 0 }' /tmp/fabro/numstat.txt); then
    FL=${RES% *}; FF=${RES#* }
    if [ \"$FL\" -le 200 ] && [ \"$FF\" -le 10 ]; then MM=queue
    else gh pr comment $PR --body \"fast-path: this change is $FL lines in $FF files, over the fast-lane ceiling of 200 lines or 10 files, so this run merges it after CI instead of queueing it.\" || true; fi
  fi
fi
echo $MM > /tmp/fabro/merge_mode
echo handoff ready"]

    review_merge [import="../_shared/review-merge/review-merge.fabro"]

    // Posts the decomposer's summary under the fixed sentence, because the summary says WHY
    // there is no work (issue #10). Without it the operator reads a decomposer failure and
    // re-labels the issue `agent`, which burns another run. Each gh call is its own
    // statement, so a failed label cannot stop the receipt removal or the comment.
    close_noop [label="Close (no actionable work)", shape=parallelogram,
        script="N=$(jq -r .number /tmp/fabro/issue.json)
S=$(jq -r '.summary // empty' /tmp/fabro/decomposition.json 2>/dev/null || true)
{
  echo 'Agent run found no actionable decomposition for this issue; leaving it for human triage.'
  if [ -n \"$(printf '%s' \"$S\" | tr -d '[:space:]')\" ]; then
    echo
    echo 'The decomposer reported:'
    echo
    printf '%s' \"$S\" | sed 's/^/> /'
    echo
  fi
} > /tmp/fabro/noop_comment.md
gh issue edit $N --remove-label agent-in-progress || true
gh label create agent-noop --color D4C5F9 --description 'Agent run found nothing to do; read the comment before re-adding agent' 2>/dev/null || true
gh issue edit $N --add-label agent-noop || true
gh issue comment $N --body-file /tmp/fabro/noop_comment.md || true
echo done"]

    // A human gate blocks until a human answers, and with no timeout that is
    // forever. Run 01M2SBJG92TX0DBRKY5881VM34 sat here 5h31m holding one of the
    // server's two scheduler slots -- half the factory's capacity parked on a
    // question nobody was at the keyboard for. The notifications all worked: the
    // discord-rescue hook fired at stage_start (hooks_matched=1) and the host
    // monitor's C4 stuck-run condition alerted and re-alerted four hours later.
    //
    // `timeout` on a HUMAN node bounds the wait, despite the attribute table
    // saying "waiting on human input doesn't consume it" -- that describes
    // timeout_excluding_interview_wait, which pauses OTHER nodes' timeouts while
    // an interview blocks. A human node is handler-managed and copies its own
    // timeout onto the question (handler/human.rs:122).
    //
    // 4h matches the monitor's re-alert interval, so two Discord pings go out
    // before it gives up. `human.default_choice` is a NODE ID, not an edge label
    // -- make_choice_outcome puts it straight into suggested_next_ids -- so it is
    // `mark_stuck`, not "[X] Abandon". Without it, an expired gate returns
    // retry_classify("human gate timeout, no default") instead of routing.
    human_rescue [shape=hexagon, timeout="4h", human.default_choice="mark_stuck",
        label="The run stopped and needs a decision. The summary below says why and what each option does."]

    // rescue_brief: every edge into human_rescue passes through here, so the gate can
    // say why the run stopped and what [P], [X] and guidance would do in THIS run.
    // Before it, the gate showed only its fixed label and the last agent's final line
    // (on 01M3Y86Z013N2V1QDNNG591MBQ, "Verdict submitted."), and the operator had to read
    // the events to learn that the task needed a .github/workflows/ edit no agent may make.
    //
    // How the text reaches the gate: the human handler shows `response.<last_stage>`
    // as the question's context (fabro handler/human.rs, build_human_gate_question).
    // Only agent and prompt handlers set those keys, but routing `context_updates` are
    // applied unfiltered (handler/structured_output.rs, apply_routing_fields), so this
    // node sets both `last_stage` and `response.rescue_brief`.
    //
    // Why it stopped comes from `failure_signature`, which the engine writes after every
    // node as `node|failure class|normalised reason` (empty after a success). A command
    // cannot read context except one key through stdin_source. When it is empty, a gate
    // routed here on a success: a `round` of 6 or more means the rework ladder ran out,
    // anything else is a gate that rejected its agent's output.
    //
    // The [P] text mirrors open_pr_prep's three refusals and partial_remainder below; the
    // [X] text mirrors mark_stuck. Change them together. Two cases read files rather than
    // the signature. /tmp/fabro/final_merge_conflict means final_merge handed a conflict to
    // resolve_merge and its gate gave up: [P] runs the merge agent once more, and guidance
    // cannot help because the rework agent may not run git. Landed tasks on a tree equal to
    // main means main already made the change (wfs#1834 and #1747 both ended there), so the
    // brief lists main's commits since the run's first commit that touch the files the run
    // changed, and leaves closing the issue to the operator: a resolver that wrongly took
    // main's side everywhere produces the same empty tree. /tmp/fabro/final_stop means
    // open_pr_prep's final validation failed after the fix turn (#35): the brief names the
    // failing tests, and [P] says the same failure on the same code opens a draft PR
    // instead of coming back here. A signature or a merge conflict outranks it, and then
    // this node deletes final_stop, so record_guidance (which routes on that file) agrees
    // with the cause the gate showed. A `final_fix` current task is never counted as a
    // task to file, and when it is the one that failed, the brief repeats the tests the
    // final validation failed before it. The node never fails: a missing
    // file reads as "nothing", and if it did fail its unconditional edge still reaches
    // the gate, which then shows what it showed before this node existed. It prints
    // nothing but the routing object, on one line: fabro scans stdout and stderr together
    // for brace-balanced objects (structured_output.rs, find_json_objects), and finding
    // text such as `${{ secrets.X }}` echoed before it could join it into one invalid
    // candidate that names `context_updates`, which fails the node. The brief stays in
    // /tmp/fabro/rescue_brief.md.
    rescue_brief [label="Explain why the run stopped", shape=parallelogram, timeout="1m",
        output_schema="routing", stdin_source="failure_signature",
        script="mkdir -p /tmp/fabro
F=/tmp/fabro
SIG=$(head -c 600)
rm -f $F/rescue_findings.txt $F/rescue_findings.cut
N=$(jq -r .number $F/issue.json 2>/dev/null)
case \"$N\" in '' | *[!0-9]*) N=$(cat $F/issue_number 2>/dev/null) ;; esac
case \"$N\" in '' | *[!0-9]*) N='?' ;; esac
COUNT=$(jq length $F/tasks.json 2>/dev/null)
case \"$COUNT\" in '' | *[!0-9]*) COUNT=0 ;; esac
IDX=$(cat $F/task_index 2>/dev/null)
case \"$IDX\" in '' | *[!0-9]*) IDX=0 ;; esac
ROUND=$(cat $F/round 2>/dev/null)
case \"$ROUND\" in '' | *[!0-9]*) ROUND=0 ;; esac
LANDED=$(grep -c '^### Task: ' $F/completed.md 2>/dev/null)
case \"$LANDED\" in '' | *[!0-9]*) LANDED=0 ;; esac
LEFT=0
if [ $COUNT -gt $IDX ]; then LEFT=$((COUNT - IDX)); fi
CT=$(jq -r '.title // empty' $F/current_task.json 2>/dev/null)
LAST=$(grep '^### Task: ' $F/completed.md 2>/dev/null | tail -1 | cut -c11-)
CUR=''
if [ $IDX -gt 0 ] && [ -n \"$CT\" ] && [ \"$CT\" != \"$LAST\" ]; then CUR=$IDX; fi
FF=$(jq -r '.final_fix // false' $F/current_task.json 2>/dev/null)
PR=$(cat $F/pr_number 2>/dev/null)
case \"$PR\" in *[!0-9]*) PR='' ;; esac
STG=$(jq -r '.node // empty' $F/.io/stage.json 2>/dev/null)
DIFF=$(git diff --shortstat origin/main HEAD 2>/dev/null | sed 's/^ *//')
MC=$(awk 'NR <= 10 { printf \"%s%s\", (NR > 1 ? \" \" : \"\"), $0 }' $F/final_merge_conflict 2>/dev/null)
CM=''
if git diff origin/main HEAD 2>/dev/null | grep -qE '^[+](<<<<<<<|>>>>>>>)'; then CM=yes; fi
SUP=''
rm -f $F/rescue_main.txt
if [ $LANDED -gt 0 ] && [ -s $F/issue.json ] && git diff --quiet origin/main HEAD 2>/dev/null; then
  SUP=yes
  SUPF=$(git log --format= --name-only --no-merges origin/main..HEAD 2>/dev/null | sort -u | head -20)
  SINCE=$(git log --format=%cI --reverse --no-merges origin/main..HEAD 2>/dev/null | head -1)
  if [ -n \"$SUPF\" ] && [ -n \"$SINCE\" ]; then
    git log --format='%h %s' --no-merges --since=\"$SINCE\" origin/main -- $SUPF 2>/dev/null | head -5 | sed 's/^/- /' > $F/rescue_main.txt
  fi
fi
FS=''
if [ -z \"$SIG\" ] && [ -z \"$MC\" ] && [ -s $F/final_stop ]; then FS=yes; else rm -f $F/final_stop; fi
NODE=''
if [ -n \"$SIG\" ]; then
  NODE=${SIG%%|*}
  REST=${SIG#*|}
  WHAT=\"$NODE failed (${REST%%|*}): ${REST#*|}\"
elif [ -n \"$MC\" ]; then
  WHAT=\"main changed the same lines as this branch before the PR was built, and resolve_merge_gate rejected the merge agent's resolution. Conflicting files: $MC\"
elif [ -n \"$FS\" ]; then
  WHAT=\"the final validation (./.fabro/setup.sh && ./.fabro/ci.sh after main was merged in) failed twice on this branch, after the run's one automatic fix turn.\"
elif [ -s $F/task_block_scope.md ]; then
  WHAT=$(head -c 600 $F/task_block_scope.md | tr '[:cntrl:]' ' ' | sed 's/ *$//')
elif [ $ROUND -ge 6 ] && [ -n \"$CUR\" ] && [ \"$FF\" = true ]; then
  WHAT='the fix turn for the final validation failed validate or review.'
elif [ $ROUND -ge 6 ] && [ -n \"$CUR\" ]; then
  WHAT=\"the rework ladder ran out. Task $CUR failed validate or review at every tier ($ROUND rounds).\"
else
  WHAT=\"a gate rejected its agent's output after its retries. The last agent stage was ${STG:-unknown}. The run's events name the gate and its reason.\"
fi
if [ -n \"$CUR\" ] && [ $ROUND -gt 0 ] && [ -s $F/feedback/rework.md ]; then
  awk 'BEGIN { e = sprintf(\"%c\", 27) } { gsub(e \"[[][0-9;]*[A-Za-z]\", \"\"); if ($0 ~ /^[ ]*$/) next; print substr($0, 1, 400) }' $F/feedback/rework.md > $F/rescue_findings.txt 2>/dev/null
  if head -1 $F/rescue_findings.txt | grep -q 'Validation failed'; then
    { head -1 $F/rescue_findings.txt; tail -10 $F/rescue_findings.txt; } > $F/rescue_findings.cut
  else
    head -12 $F/rescue_findings.txt > $F/rescue_findings.cut
  fi
fi
WF=''
if grep -q '[.]github/workflows' $F/rescue_findings.cut 2>/dev/null; then WF=yes; fi
if [ \"${FABRO_AUTO_MERGE:-0}\" != 1 ]; then
  MERGE='Auto-merge is off on this host, so a human merges it.'
elif [ \"$(cat $F/auto_merge_repo 2>/dev/null)\" = 0 ]; then
  MERGE='Auto-merge is off for this repository, so a human merges it.'
else
  MERGE='If every merge gate passes, the merge phase merges it with no human.'
fi
MOVE=$LEFT
if [ -n \"$CUR\" ] && [ \"$FF\" != true ]; then MOVE=$((LEFT + 1)); fi
if [ ! -s $F/issue.json ]; then
  P='The run never read the issue, so there is no PR to open. You come back here.'
elif git diff --quiet origin/main HEAD 2>/dev/null; then
  P='The branch changes no file, so open_pr_prep refuses: a PR would claim work that does not exist. You come back here.'
elif [ -n \"$(for C in $(git rev-list --no-merges origin/main..HEAD 2>/dev/null); do git diff-tree --no-commit-id --name-only -r \"$C\" -- .github/workflows/; done)\" ]; then
  P='A commit on this branch changes .github/workflows/, which the sandbox token cannot push, so open_pr_prep refuses. You come back here.'
elif [ -n \"$CM\" ]; then
  P='The branch adds unresolved conflict markers (lines starting <<<<<<< or >>>>>>>), so open_pr_prep refuses. You come back here.'
elif [ -n \"$MC\" ]; then
  P='Runs the merge agent once more on the same conflict. If it resolves it, the PR is built as usual; if not, you come back here.'
elif [ -n \"$FS\" ]; then
  P=\"Main is merged in and setup and CI run again. If they fail the same way on the same code, the run opens a draft PR with the $LANDED task(s) that passed review, files the rest, and labels #$N agent-stuck, instead of coming back here.\"
else
  if [ -n \"$PR\" ]; then
    P=\"PR #$PR is already open. Main is merged in, setup and CI run again, and the PR goes through the merge phase again.\"
  else
    P=\"Opens a PR with the $LANDED task(s) that passed review\"
    if [ -n \"$CUR\" ]; then P=\"$P and the unreviewed edits of task $CUR\"; fi
    P=\"$P, after main is merged in and setup and CI pass.\"
    if [ -n \"$CUR\" ] && [ $LANDED -gt 0 ]; then P=\"$P If setup or CI fails with them, they are dropped and the PR holds only the reviewed tasks.\"; fi
  fi
  if [ $MOVE -gt 0 ]; then
    P=\"$P The $MOVE task(s) not done\"
    if [ -n \"$CUR\" ] && [ \"$FF\" != true ]; then P=\"$P (task $CUR included)\"; fi
    P=\"$P go to one held remainder issue, which the scheduler queues when the PR merges.\"
  fi
  P=\"$P $MERGE\"
fi
X=\"Labels #$N agent-stuck and posts a generic comment.\"
if [ -n \"$PR\" ]; then
  X=\"$X PR #$PR stays open. Close it by hand if you do not want it.\"
elif [ $LANDED -gt 0 ]; then
  X=\"$X No PR is opened and the branch exists only in this sandbox, so the $LANDED task(s) that passed review are lost.\"
fi
X=\"$X The gate does this by itself when its 4h timeout ends.\"
if [ -n \"$FS\" ]; then
  G='The tier-4 rework agent gets your text and the failing tests as a new task to make the final validation pass, then validate and review run again.'
elif [ \"$NODE\" = open_pr_prep ]; then
  G='The tier-4 rework agent gets your text, then validate and review run again.'
elif [ -n \"$MC\" ]; then
  G='Cannot help: guidance goes to the rework agent, which may not run git, so it cannot finish a merge. Choose [P] for one more merge attempt, or [X].'
elif [ -n \"$WF\" ]; then
  G='Cannot help: the findings need a change under .github/workflows/, which no agent may make. Choose [P] and make that edit yourself, or [X].'
elif [ -n \"$CUR\" ]; then
  G=\"The tier-4 rework agent tries task $CUR again with your text, then validate and review run again. If review rejects it again, you come back here.\"
else
  G='No task is unfinished, so the rework agent has nothing to fix. Choose [P] or [X].'
fi
{
  echo \"**Why the run stopped:** $WHAT\"
  echo
  if [ -n \"$CUR\" ]; then echo \"- Unfinished task $CUR of $COUNT: $CT\"; fi
  if [ $COUNT -gt 0 ]; then
    echo \"- Tasks: $LANDED of $COUNT passed review, $LEFT not started.\"
  else
    echo '- Tasks: none. The run stopped before the issue was decomposed.'
  fi
  if [ -n \"$DIFF\" ]; then echo \"- Branch against main: $DIFF\"; fi
  if [ -n \"$PR\" ]; then echo \"- PR: #$PR\"; fi
  if [ -n \"$SUP\" ]; then
    echo
    echo \"**Main already has this change:** $LANDED task(s) landed on this branch, but with main merged in it changes no file. Another PR most likely made the same change while this run worked.\"
    if [ -s $F/rescue_main.txt ]; then
      echo
      echo 'Commits on main since the run started that touch the files this run changed:'
      echo
      cat $F/rescue_main.txt
    fi
    echo
    echo \"If one of them resolves #$N, choose [X] Abandon, then close #$N as completed by it.\"
  fi
  if [ -n \"$FS\" ]; then
    echo
    echo '**Failing tests in the final validation:**'
    echo
    echo '```'
    cat $F/final_stop
    echo '```'
  elif [ \"$FF\" = true ] && [ -s $F/final_failures.txt ]; then
    echo
    echo '**Failing tests in the final validation, before the fix turn:**'
    echo
    echo '```'
    cat $F/final_failures.txt
    echo '```'
  fi
  if [ -s $F/rescue_findings.cut ]; then
    echo
    echo \"**Last findings for task $CUR:**\"
    echo
    echo '```'
    cat $F/rescue_findings.cut
    echo '```'
    if [ -n \"$WF\" ]; then echo; echo 'These findings need a change under .github/workflows/. No agent may edit that directory, so only a human can make it.'; fi
  fi
  echo
  echo \"- **[P] Accept partial:** $P\"
  echo \"- **[X] Abandon:** $X\"
  echo \"- **Type guidance:** $G\"
} > $F/rescue_brief.md
head -c 3500 $F/rescue_brief.md > $F/rescue_brief.cut
jq -cRs '{context_updates: {last_stage: \"rescue_brief\", \"response.rescue_brief\": .}}' < $F/rescue_brief.cut 2>/dev/null || echo '{\"context_updates\":{}}'"]

    // partial_remainder: [P] used to go straight to open_pr_prep, and the PR it opened
    // carried "Resolves #N" while the unfinished task and every task the run never
    // reached were recorded nowhere. On 01M3Y86Z013N2V1QDNNG591MBQ (womens-fantasy-sports
    // #1279) that would have dropped task 7, the auth regression spec, without a trace.
    // This moves them to remainder.json, the file next_task's task budget already fills,
    // so file_remainder files them as one held issue that the scheduler queues when the
    // PR merges (ADR 0011 D6). The unfinished task is the current one when completed.md
    // does not end with its title; its partial edits ship in the PR.
    //
    // tasks.json is trimmed to the tasks before the moved ones, so a run that comes back
    // to the gate and is then given guidance cannot start a moved task. That guidance can
    // still finish the unfinished task, which is then also in the remainder; the
    // remainder body tells the next run to decompose again, so that is a duplicate to
    // close, not a wrong change. `remainder_kind` makes file_remainder say why the tasks
    // were not done. Always exits 0.
    partial_remainder [label="Move unfinished tasks to the remainder", shape=parallelogram,
        script="F=/tmp/fabro
rm -f $F/task_block_scope.md
COUNT=$(jq length $F/tasks.json 2>/dev/null)
case \"$COUNT\" in '' | *[!0-9]*) COUNT=0 ;; esac
IDX=$(cat $F/task_index 2>/dev/null)
case \"$IDX\" in '' | *[!0-9]*) IDX=0 ;; esac
CT=$(jq -r '.title // empty' $F/current_task.json 2>/dev/null)
LAST=$(grep '^### Task: ' $F/completed.md 2>/dev/null | tail -1 | cut -c11-)
FF=$(jq -r '.final_fix // false' $F/current_task.json 2>/dev/null)
FROM=$IDX
if [ $IDX -gt 0 ] && [ -n \"$CT\" ] && [ \"$CT\" != \"$LAST\" ]; then : > $F/partial_unreviewed; fi
if [ $IDX -gt 0 ] && [ -n \"$CT\" ] && [ \"$CT\" != \"$LAST\" ] && [ \"$FF\" != true ]; then FROM=$((IDX - 1)); fi
if [ $FROM -ge $COUNT ]; then echo 'accept partial: every task finished, so nothing moves to the remainder'; exit 0; fi
jq --argjson i $FROM '.[$i:] | map(select(.final_fix != true))' $F/tasks.json > $F/remainder.new.json 2>/dev/null || { echo 'accept partial: could not read tasks.json; nothing moved' >&2; exit 0; }
if [ -s $F/remainder.json ]; then cp $F/remainder.json $F/remainder.old.json; else echo '[]' > $F/remainder.old.json; fi
jq -s '(.[0] + .[1]) | reduce .[] as $t ([]; if any(.[]; .id == $t.id) then . else . + [$t] end)' $F/remainder.old.json $F/remainder.new.json > $F/remainder.merged.json 2>/dev/null && mv $F/remainder.merged.json $F/remainder.json
jq --argjson i $FROM '.[0:$i]' $F/tasks.json > $F/tasks.trim.json 2>/dev/null && mv $F/tasks.trim.json $F/tasks.json
echo partial > $F/remainder_kind
echo 'accept partial: '$((COUNT - FROM))' unfinished task(s) moved to the remainder, which file_remainder files as one held issue after open_pr'"]

    // ---- Return a Contradiction to triage (#17, docs/unmet-criteria C4) ----
    // The issue asks for something its own non-goals forbid, found by `decompose` or by a
    // coder that blocked on a criterion. Only a human can say which side gives, so the
    // issue goes back to triage as a question instead of to `agent-stuck`, and the
    // answer re-queues it without a relabel: the comment's first line is the triage
    // marker, so issue-triage and arch-review wait for a human reply before they
    // re-triage it. No PR is opened and the branch is dropped (backlog pushes nothing
    // before open_pr), because the reviewed tasks were built on an issue about to change.
    //
    // The run ends succeeded at exit: the scheduler requeues some failed runs, and this
    // issue must leave the queue. `agent-in-progress` comes off, or the scheduler's
    // receipt scan would requeue it. stuck_reason.md is written before any gh call, so
    // the unconditional edge to mark_stuck still names the Contradiction. gh output goes
    // to return.log: stdout carries only the routing object (ADR 0020). The Discord
    // `triage-question` hook fires on this node's stage_start and reads
    // `triage_questions`, which the routing gate published.
    return_to_triage [label="Return the issue to triage", shape=parallelogram, timeout="2m", output_schema="routing",
        script="N=$(jq -r .number /tmp/fabro/issue.json 2>/dev/null || true)
case \"$N\" in '' | *[!0-9]*) N=$(cat /tmp/fabro/issue_number 2>/dev/null || echo 0) ;; esac
case \"$N\" in '' | *[!0-9]*) N=0 ;; esac
F=/tmp/fabro/return.json
L=/tmp/fabro/return.log
if ! jq -e '(.items | type) == \"array\" and (.items | length) > 0' $F >/dev/null 2>&1; then echo 'return_to_triage: return.json is missing or names no criterion; mark_stuck takes over' >&2; exit 1; fi
jq -r '([10] | implode) as $nl | \"The issue asks for something its own boundaries forbid, so it was returned to triage:\" + $nl + $nl + ([.items[] | \"- \" + .criterion + \" (conflicts with: \" + .non_goal + \"): \" + .why] | join($nl))' $F > /tmp/fabro/stuck_reason.md
if [ \"$N\" = 0 ]; then echo 'return_to_triage: no issue number; mark_stuck takes over' >&2; exit 1; fi
jq -r '([10] | implode) as $nl
| (if .source == \"decompose\" then \"the decomposer\" else \"the coder\" end) as $who
| \"<!-- fabro:triage-questions -->\" + $nl
+ \"> *This was generated by AI during an autonomous implementation run.*\" + $nl + $nl
+ \"## Returned to triage\" + $nl + $nl
+ \"The implementation run stopped before opening a pull request, because \" + $who + \" found an acceptance criterion that the boundaries of this issue forbid. A criterion that cannot be met as written is reported, never replaced by a similar behaviour, so nothing from this run was kept.\" + $nl + $nl
+ ([.items[] | \"- **Criterion:** \" + .criterion + $nl + \"  - **Conflicts with:** \" + .non_goal + $nl + \"  - **Why:** \" + .why] | join($nl + $nl)) + $nl + $nl
+ \"### Question\" + $nl + $nl
+ \"For each item: should the criterion change, or the non-goal? Edit the issue body to match, then answer in a new comment. The next triage reads the answer and, when nothing else is open, queues the issue for the agent again.\" + $nl + $nl
+ \"Answer by replying in a new comment. Editing this comment is not detected.\"' $F > /tmp/fabro/return_comment.md
gh label create needs-info --color FEF2C0 --description 'Waiting on a human for triage answers' >> $L 2>&1 || true
if ! gh issue comment $N --body-file /tmp/fabro/return_comment.md >> $L 2>&1; then echo 'return_to_triage: gh issue comment failed; see return.log' >&2; exit 1; fi
if ! gh issue edit $N --remove-label agent --remove-label agent-in-progress --add-label needs-info >> $L 2>&1; then echo 'return_to_triage: gh issue edit failed; see return.log' >&2; exit 1; fi
R=$(jq -r '\"Returned to triage: \" + ([.items[] | .criterion + \" conflicts with \" + .non_goal] | join(\"; \"))' $F | tr '[:cntrl:]' ' ' | cut -c1-300 | sed 's/ *$//')
jq -nc --arg r \"$R\" '{context_updates:{return_reason:$r}}'"]

    // Taking the receipt off is the load-bearing half of this node, not the
    // comment. `claim` swapped `agent` -> `agent-in-progress`, and an issue left
    // wearing it is in no collection the scheduler reads: `agent` no longer has
    // it, so it is out of the queue, and the only thing that repairs it is the
    // scheduler's startup receipt scan plus the periodic one added with it.
    //
    // So the number is resolved from two sources, not one. issue.json is absent
    // whenever `claim` failed before its fetch -- which is exactly the run that
    // arrives here -- and the old `|| echo 0` then silently skipped the label work
    // entirely. That is what stranded jelly-swipe#353 and lawncare-saas#2277 on
    // 2026-09-19. /tmp/fabro/issue_number is written by `claim` before any network
    // call, so it is there whenever the run got past input validation at all.
    //
    // The comment carries stuck_reason.md when one was written: the decomposer's summary
    // when decompose_gate routed here on needs_human_review, or the Contradiction when
    // return_to_triage failed after writing it (prep deletes the file). Otherwise it is
    // the generic line. The comment file is written only when a number was found, and the
    // directory exists whenever claim wrote that number.
    mark_stuck [label="Mark stuck", shape=parallelogram,
        script="N=$(jq -r .number /tmp/fabro/issue.json 2>/dev/null || true)
case \"$N\" in '' | *[!0-9]*) N=$(cat /tmp/fabro/issue_number 2>/dev/null || echo 0) ;; esac
case \"$N\" in '' | *[!0-9]*) N=0 ;; esac
if [ \"$N\" != 0 ]; then
  gh issue edit $N --remove-label agent-in-progress --add-label agent-stuck || true
  if [ -s /tmp/fabro/draft_reason.md ]; then
    gh issue edit $N --remove-label Review 2>/dev/null || true
    cp /tmp/fabro/draft_reason.md /tmp/fabro/stuck_comment.md
  elif [ -s /tmp/fabro/stuck_reason.md ]; then
    { echo 'Agent run stopped before implementing this issue. The run reported:'; echo; cat /tmp/fabro/stuck_reason.md; } > /tmp/fabro/stuck_comment.md
  else
    echo 'Agent run could not complete this issue and gave up. See the fabro run for details.' > /tmp/fabro/stuck_comment.md
  fi
  gh issue comment $N --body-file /tmp/fabro/stuck_comment.md || true
fi
echo done"]

    // ---- Edges ----
    start -> claim
    claim -> prep                   [condition="outcome=succeeded"]
    claim -> rescue_brief
    prep -> route_lane              [condition="outcome=succeeded"]
    prep -> rescue_brief

    // ADR 0023: a `fast-path` issue skips decompose, plan, excerpts and the extra
    // review; every other stage, the per-task review and the rework ladder included, runs
    // as in the standard lane. `route_lane` publishes `lane` on every run.
    route_lane -> next_task         [condition="context.lane=fast"]
    route_lane -> decompose         [condition="context.lane=standard"]
    route_lane -> rescue_brief

    decompose -> decompose_gate     [condition="outcome=succeeded"]
    decompose -> rescue_brief
    decompose_gate -> decompose     [condition="outcome=failed"]
    decompose_gate -> next_task     [condition="context.decomp_status=issues"]
    decompose_gate -> close_noop    [condition="context.decomp_status=no_work"]
    // A decomposer that says needs_human_review (most often: a declared blocker has
    // not landed) leaves nothing for the rescue gate to retry. Guidance goes to
    // rework_t4 with no task, and [P] finds an empty tree. So it goes straight to
    // mark_stuck, which posts the decomposer's summary on the issue and frees the
    // coder box, instead of holding it at the gate for up to 4h.
    decompose_gate -> mark_stuck    [condition="context.decomp_status=needs_human_review"]
    // A Contradiction (#17, docs/unmet-criteria C3) is a defect in the issue, not in the
    // run: it goes back to triage as a question, so the answer re-queues the issue
    // without a human relabelling it.
    decompose_gate -> return_to_triage [condition="context.decomp_status=contradiction"]
    decompose_gate -> rescue_brief

    // ADR 0023. extra_prep (the extra review) is skipped in the fast lane: tasks_done goes
    // straight to final_merge. The coder edge skips plan, improve_gate and excerpts.
    // `next_task` writes `rebase_failed` on every branch, so on tasks_done=true only one of
    // these matches; resolve_merge keeps its own edge, and plan stays the standard
    // lane's unconditional fallthrough.
    next_task -> extra_prep         [condition="context.tasks_done=true && context.lane!=fast"]
    next_task -> final_merge        [condition="context.tasks_done=true && context.lane=fast"]
    next_task -> resolve_merge      [condition="context.rebase_failed=true"]
    next_task -> coder              [condition="context.tasks_done=false && context.rebase_failed=false && context.lane=fast"]
    // The plan trial (#25) is closed (ADR 0030): every standard-lane task is planned, and
    // `plan` is the unconditional fallthrough for the task case. The four conditional
    // edges above are exclusive on tasks_done, rebase_failed and lane, so a run that
    // matches none of them reaches this one.
    next_task -> plan

    // A failed node still routes: resolve_merge's unconditional edge leads to its
    // gate, which detects the bad state and either retries once or asks for a
    // human. `weight` keeps the success edge winning over the merge_attempts=1
    // retry edge after a successful second attempt.
    resolve_merge -> resolve_merge_gate [condition="outcome=succeeded"]
    resolve_merge -> resolve_merge_gate
    // ADR 0023: after a resolved mainline merge the fast lane goes to the coder, skipping
    // plan; the standard lane is unchanged. A merge final_merge handed over goes back
    // to final_merge in either lane; the three success edges are exclusive on merge_return.
    resolve_merge_gate -> final_merge   [condition="context.merge_ok=true && context.merge_return=pr", weight=10]
    resolve_merge_gate -> plan          [condition="context.merge_ok=true && context.merge_return=task && context.lane!=fast", weight=10]
    resolve_merge_gate -> coder         [condition="context.merge_ok=true && context.merge_return=task && context.lane=fast", weight=10]
    resolve_merge_gate -> resolve_merge [condition="context.merge_attempts=1"]
    resolve_merge_gate -> rescue_brief

    plan -> improve_gate            [condition="outcome=succeeded"]
    plan -> rescue_brief
    // A rejected result goes back to `plan`, the node that wrote it.
    improve_gate -> plan            [condition="outcome=failed"]
    improve_gate -> next_task       [condition="context.task_disposition=redundant"]
    // A split rewound `task_index` to the slot the oversized task occupied and
    // replaced it in place, so `next_task` re-selects that slot and picks up the
    // first slice. It also re-runs the mainline merge and resets the per-task
    // counters, which is exactly right: a slice is a new task.
    improve_gate -> next_task       [condition="context.task_disposition=split"]
    improve_gate -> excerpts        [condition="context.task_disposition=ready"]
    improve_gate -> rescue_brief

    // excerpts always exits 0; the failed edge covers a timeout, and the unconditional
    // edge exists only because every command node must have one.
    excerpts -> coder               [condition="outcome=succeeded"]
    excerpts -> coder               [condition="outcome=failed"]
    excerpts -> rescue_brief

    coder -> task_block_gate        [condition="outcome=succeeded"]
    // Retries exhausted on a coder that was still working. allow_partial makes
    // that partially_succeeded rather than failed; this edge is what stops it
    // falling through to the unconditional human_rescue and skipping the ladder.
    coder -> task_block_gate        [condition="outcome=partially_succeeded"]
    coder -> rescue_brief

    autofix -> prep_review          [condition="outcome=succeeded"]
    autofix -> prep_review          [condition="outcome=failed"]
    autofix -> rescue_brief

    prep_review -> rework_router    [condition="context.diff_too_large=true"]
    prep_review -> validate

    validate -> review              [condition="outcome=succeeded && context.task_validation_ok=true"]
    validate -> rework_router

    review -> review_gate           [condition="outcome=succeeded"]
    review -> rescue_brief
    review_gate -> review           [condition="outcome=failed"]
    review_gate -> integrate        [condition="context.review_decision=approved"]
    review_gate -> rework_router    [condition="context.review_decision=changes_requested"]
    review_gate -> rescue_brief

    integrate -> next_task          [condition="outcome=succeeded"]
    integrate -> rescue_brief

    rework_router -> rework_t1      [condition="context.round<2"]
    rework_router -> rework_t2      [condition="context.round>=2 && context.round<4"]
    rework_router -> rework_t3      [condition="context.round=4"]
    rework_router -> rework_t4      [condition="context.round=5"]
    rework_router -> drop_followup  [condition="context.round=6 && context.task_exempt=true && context.lane!=fast"]
    rework_router -> demote_lane    [condition="context.round=6 && context.lane=fast"]
    rework_router -> rescue_brief

    demote_lane -> exit             [condition="outcome=succeeded"]
    demote_lane -> rescue_brief
    drop_followup -> next_task      [condition="outcome=succeeded"]
    drop_followup -> rescue_brief

    rework_t1 -> task_block_gate    [condition="outcome=succeeded"]
    // Tier 1 runs on a single-slot local box, whose failure is usually slowness or a
    // hung request, not a task no model can fix. A failed tier 1 (both attempts timed
    // out, or the session died) climbs the ladder: rework_router bumps `round` past 1,
    // which selects rework_t2 on a hosted model. Run 01M3HRXSYA5RAYP078D3NWCYSV lost
    // two 45m tier-1 attempts to box latency and parked on human_rescue with the
    // edits done. Tiers 2-4 still fail to human_rescue.
    rework_t1 -> rework_router      [condition="outcome=failed"]
    rework_t1 -> rescue_brief
    rework_t2 -> task_block_gate    [condition="outcome=succeeded"]
    rework_t2 -> rescue_brief
    rework_t3 -> task_block_gate    [condition="outcome=succeeded"]
    rework_t3 -> rescue_brief
    rework_t4 -> task_block_gate    [condition="outcome=succeeded"]
    rework_t4 -> rescue_brief

    // #17: a stage that blocked never reaches autofix. A criterion block goes back to
    // triage; a scope block, or an unreadable one, takes the unconditional edge to the
    // rescue gate, which quotes the reason. Both conditional edges require success: a
    // failed gate applies no context update, and a `none` left by an earlier task must
    // not carry an unread block past it.
    task_block_gate -> autofix      [condition="outcome=succeeded && context.task_block=none"]
    task_block_gate -> return_to_triage [condition="outcome=succeeded && context.task_block=criterion"]
    task_block_gate -> rescue_brief

    extra_prep -> final_merge       [condition="context.extra_done=true"]
    extra_prep -> standards

    standards -> standards_gate     [condition="outcome=succeeded"]
    standards -> rescue_brief
    standards_gate -> standards     [condition="outcome=failed"]
    standards_gate -> rescue_brief  [condition="context.standards_status=needs_human_review || context.standards_status=invalid"]
    standards_gate -> spec

    spec -> spec_gate               [condition="outcome=succeeded"]
    spec -> rescue_brief
    spec_gate -> spec               [condition="outcome=failed"]
    spec_gate -> rescue_brief       [condition="context.spec_status=needs_human_review || context.spec_status=invalid"]
    spec_gate -> quality

    quality -> quality_gate         [condition="outcome=succeeded"]
    quality -> rescue_brief
    quality_gate -> quality         [condition="outcome=failed"]
    quality_gate -> rescue_brief    [condition="context.quality_status=needs_human_review || context.quality_status=invalid"]
    quality_gate -> extra_decompose

    extra_decompose -> extra_gate   [condition="outcome=succeeded"]
    extra_decompose -> rescue_brief
    extra_gate -> extra_decompose   [condition="outcome=failed"]
    extra_gate -> next_task         [condition="context.new_tasks>0"]
    extra_gate -> rescue_brief      [condition="context.followup_status=needs_human_review"]
    extra_gate -> final_merge

    final_merge -> open_pr_prep     [condition="outcome=succeeded && context.final_conflict=false"]
    final_merge -> resolve_merge    [condition="outcome=succeeded && context.final_conflict=true"]
    final_merge -> rescue_brief
    // #35: open_pr_prep publishes `final_route` on every success. Each edge also requires
    // outcome=succeeded, because a refusal (exit 1) applies no context update and a
    // stale `final_route` from an earlier visit must not route it. `rescue` takes the
    // unconditional edge, as a refusal does.
    open_pr_prep -> open_pr         [condition="outcome=succeeded && context.final_route=pr"]
    open_pr_prep -> open_pr         [condition="outcome=succeeded && context.final_route=draft"]
    open_pr_prep -> drop_unreviewed [condition="outcome=succeeded && context.final_route=drop"]
    open_pr_prep -> final_fix_prep  [condition="outcome=succeeded && context.final_route=fix"]
    open_pr_prep -> rescue_brief
    drop_unreviewed -> final_merge  [condition="outcome=succeeded"]
    drop_unreviewed -> rescue_brief
    final_fix_prep -> rework_t4     [condition="outcome=succeeded"]
    final_fix_prep -> rescue_brief
    open_pr -> file_remainder       [condition="outcome=succeeded"]
    open_pr -> rescue_brief
    // A draft PR (the same tree failed the final validation twice) skips the merge phase:
    // mark_stuck labels the issue and posts open_pr's draft_reason.md. open_pr writes
    // `pr_draft` on every success, so the two success edges are exclusive.
    file_remainder -> mark_stuck    [condition="outcome=succeeded && context.pr_draft=true"]
    file_remainder -> pr_handoff    [condition="outcome=succeeded && context.pr_draft=false"]
    file_remainder -> rescue_brief
    pr_handoff -> review_merge      [condition="outcome=succeeded"]
    pr_handoff -> rescue_brief
    // The import reports both outcomes on the PR itself before it exits, so a
    // merged PR and a deliberately-unmerged one are both finished runs. Only a
    // failure of the placeholder needs a human.
    review_merge -> rescue_brief    [condition="outcome=failed"]
    review_merge -> exit

    close_noop -> exit

    // The only channel from the rescue gate's free text into a file. Mirrors
    // issue-triage's `record_answer`: a command node cannot read context, and
    // `stdin_source` pipes exactly one key. This exists so `rework.md.j2` can read the
    // guidance from a path like every other input, which in turn lets the graph run at
    // `truncate` fidelity -- every level below `compact` drops the context table, and the
    // guidance used to reach the rework agent only through it.
    //
    // It routes (#35): guidance after a final-validation stop (open_pr_prep wrote
    // final_stop) goes through final_fix_prep, so the rework agent and the reviewer get a
    // task whose diff base is the merged branch. Straight to rework_t4, the reviewer would
    // judge the fix together with main's merge against the last task's spec.
    record_guidance [label="Record the human guidance", shape=parallelogram, output_schema="routing",
        stdin_source="human.gate.text",
        script="mkdir -p /tmp/fabro/feedback
cat > /tmp/fabro/feedback/rescue.md
if [ -e /tmp/fabro/final_stop ]; then G=true; else G=false; fi
echo '{\"context_updates\":{\"guidance_final\":'$G'}}'"]

    rescue_brief -> human_rescue

    human_rescue -> record_guidance [freeform=true]
    record_guidance -> final_fix_prep [condition="outcome=succeeded && context.guidance_final=true"]
    record_guidance -> rework_t4
    human_rescue -> partial_remainder [label="[P] Accept partial: open a PR with what landed, file the rest"]
    human_rescue -> mark_stuck      [label="[X] Abandon: label the issue agent-stuck, open no PR"]
    partial_remainder -> final_merge [condition="outcome=succeeded"]
    partial_remainder -> rescue_brief

    return_to_triage -> exit        [condition="outcome=succeeded"]
    return_to_triage -> mark_stuck
    mark_stuck -> exit
}
