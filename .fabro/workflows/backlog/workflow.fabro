digraph Backlog {
    graph [
        goal="Backlog: decompose the next agent-labeled issue, implement each task with review, and open a PR",
        // Bound the preamble. `compact` (the default) prepends EVERY completed stage to
        // every agent prompt, with up to 25 lines of command output each
        // (handler/llm/preamble.rs:391, COMPACT_OUTPUT_MAX_LINES=25), plus the whole
        // context table. By task 7 of a long run that is tens of thousands of tokens of
        // jq gate chatter in front of an 8 KB prompt -- and on local llama.cpp, prefill
        // is a real share of per-turn latency. `summary:low` keeps the last two stages
        // and an omission count. Every prompt here names its inputs by path, so nothing
        // in the preamble is load bearing; the one exception was `human.gate.text`,
        // which `record_guidance` now writes to a file instead.
        default_fidelity="summary:low",
            // reasoning_effort: medium on the classes that run on `coders`, and only
            // those. Measured against the llama.cpp box itself (10.10.0.29, direct,
            // no gateway), identical prompt:
            //
            //   no parameter          875 completion tokens, 1496 reasoning chars
            //   reasoning_effort=low  678                    1436
            //   reasoning_effort=high 1208                   3042
            //
            // fabro defaults reasoning_effort to `high` and transmits it. Sandcastle's
            // config never set it, so opencode sent no parameter -- and llama.cpp does
            // honour the difference: `high` is 1.38x the tokens of the default. At the
            // box's measured 17.4 tok/s that is ~69s per turn instead of ~50s, which
            // over a 60-turn coder stage is the difference between 50 and 95 minutes.
            // `medium` is the closest fabro can get to "no parameter"; `low` undershoots
            // the model's own default.
            //
            // The hosted tiers (glm-4.7, kimi-for-coding, glm-5.3, kimi-k3) are left at
            // the default. The measurement above is specific to this local GGUF endpoint
            // and says nothing about z.ai or kimi, and the review classes are where the
            // thinking is the product rather than the overhead.
        model_stylesheet="
            *                { model: coders; }
            .decomp          { model: glm-5.3; }
            .improve         { model: glm-5.3; }
            .coder           { model: coders; reasoning_effort: medium; }
            .coder-t2        { model: glm-4.7; }
            .coder-t3        { model: kimi-for-coding; }
            .coder-t4        { model: glm-5.3; }
            .rebase          { model: coders; reasoning_effort: medium; }
            .rebase-t2       { model: glm-5.3; }
            .review          { model: glm-5.3; }
            .review-frontier { model: kimi-k3; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // ---- Deterministic acquisition (no LLM) ----
    acquire [label="Acquire issue", shape=parallelogram,
        script="mkdir -p /tmp/fabro && gh issue list --label agent --state open --json number,title,labels --limit 10 > /tmp/fabro/candidates.json && jq '[.[] | select(([.labels[].name] | contains([\"agent-in-progress\"]) | not))] | sort_by(.number) | .[0:1]' /tmp/fabro/candidates.json > /tmp/fabro/acquire.json && test \"$(jq length /tmp/fabro/acquire.json)\" != \"0\""]

    // `acquire` and `claim` are separate stages, and the pair is NOT atomic: `acquire`
    // reads the issue list, `claim` writes the label swap, and GitHub offers no
    // compare-and-swap on labels. Two runs whose `acquire` stages both complete before
    // either `claim` lands will both claim the same issue, and `gh issue edit` is
    // idempotent so the second one succeeds silently.
    //
    // Observed live on 2026-09-17, both runs on jelly-swipe#356:
    //   PVWESA acquire 15:20:34.447 -> 15:20:35.381   claim 15:20:37.203 -> 15:20:41.628
    //   PWQXPC acquire 15:20:38.358 -> 15:20:39.511   claim 15:20:41.386 -> 15:20:44.870
    // PWQXPC read the list 2.1s before PVWESA's label swap landed. Both then
    // implemented the same issue on separate branches. The scheduler frees slots in
    // pairs, so this recurs whenever two backlog runs for one repo start together.
    //
    // Fixed by optimistic claim plus arbitration rather than a lock, which GitHub
    // cannot give us. Each run posts a marker comment carrying its run id, waits for
    // the window to settle, re-reads, and the LOWEST run id wins. ULIDs are
    // lexicographically ordered by creation time, so the lowest is the run that was
    // created first -- a deterministic winner both sides compute identically.
    //
    // The settle is 20s against an observed 4s window between two claims. It has to
    // exceed the window: a run that re-reads before its rival has posted would see
    // only its own marker and wrongly conclude it won, and if its id were the higher
    // of the two, BOTH runs would think they had won. Only reached by a run that
    // actually claimed, so it never costs the quiet-exit path anything.
    //
    // Markers are matched within a 15-minute recency window. Without it, an issue that
    // was reclaimed later (agent-stuck -> agent) would still carry markers from the
    // original run, whose older ULID would win forever and starve every new attempt.
    // The window is computed in jq from `now` rather than with `date -d`, which is a
    // GNU extension.
    claim [label="Claim issue and fetch it", shape=parallelogram, output_schema="routing",
        script="set -e
N=$(jq -r '.[0].number' /tmp/fabro/acquire.json)
gh label create agent-in-progress --color FBCA04 2>/dev/null || true
gh label create agent-stuck --color D93F0B 2>/dev/null || true
gh label create agent-authored --color 1D76DB 2>/dev/null || true
gh label create Review --color 0E8A16 2>/dev/null || true
gh issue edit $N --add-label agent-in-progress --remove-label agent
RID=$(basename $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo ''))
if [ ${#RID} -ne 26 ]; then RID=''; fi
case \"$RID\" in *[!0-9A-Z]*) RID='' ;; esac
LOST=false
if [ -n \"$RID\" ]; then
  gh issue comment $N --body '<!-- fabro:claim:'$RID' -->' || true
  sleep 20
  if gh issue view $N --json comments > /tmp/fabro/claim_comments.json 2>/dev/null; then
    W=$(jq -r '[.comments[] | select(.body | test(\"fabro:claim:\")) | select((.createdAt | fromdateiso8601) > (now - 900)) | (.body | capture(\"fabro:claim:(?<i>[0-9A-Z]{26})\").i)] | sort | .[0] // \"\"' /tmp/fabro/claim_comments.json)
    if [ -n \"$W\" ] && [ \"$W\" != \"$RID\" ]; then LOST=true; fi
  fi
fi
if [ \"$LOST\" = true ]; then
  # Stand down. The winner holds agent-in-progress and both runs applied the same
  # label swap, so the issue is already in the right state -- touching it here would
  # unclaim the winner's issue.
  echo 'lost the claim race for issue '$N' to run '$W'; standing down'
  echo '{\"context_updates\":{\"claim_lost\":\"true\",\"issue_number\":'$N'}}'
  exit 0
fi
gh issue view $N --json number,title,body,labels,comments > /tmp/fabro/issue.json
echo '{\"context_updates\":{\"claim_lost\":\"false\",\"issue_number\":'$N'}}'"]

    prep [label="Prep workspace and install deps", shape=parallelogram, timeout="20m",
        script="set -e
mkdir -p /tmp/fabro/review /tmp/fabro/feedback /tmp/fabro/extra
echo 0 > /tmp/fabro/extra_round
./.fabro/setup.sh"]

    // ---- Decomposition (agent writes file; gate validates) ----
    // `max_retries=1` on every agent node in this graph, for the reason spelled out on
    // `coder` below: a provider stream that stalls without erroring is invisible to the
    // LLM retry and to the model fallback chain, so the node timeout is the only
    // backstop -- and it classifies `transient_infra`, which IS retry-eligible, but
    // `default_max_retries` is 0.
    //
    // Added here after run 01M2PSA224HXTXJSSVBGTVPYF1 sat blocked at human_rescue for
    // nearly six hours, holding one of two scheduler slots, because `improve` timed out
    // at 1200s and had no retry. `improve`'s longest successful run on record is 522s,
    // so a 20m timeout is a stall rather than slow work -- exactly the case a retry
    // absorbs. The first pass at this fix covered `coder` and the rework tiers only;
    // scoping it that narrowly is what cost those six hours.
    //
    // Still NOT a graph-level `default_max_retries`: that would also apply to the
    // command gates, whose `exit 1` is a routing signal and whose attempt counters an
    // engine retry would double-increment.
    decompose [label="Decompose issue", class="decomp", timeout="30m", max_retries=1, prompt="@prompts/decompose.md.j2"]

    decompose_gate [label="Validate decomposition", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/decomposition.json
A=$(cat /tmp/fabro/decompose_attempts 2>/dev/null || echo 0)
S=$(jq -r .status $F 2>/dev/null || echo invalid)
if [ \"$S\" != issues ] && [ \"$S\" != no_work ] && [ \"$S\" != needs_human_review ]; then S=invalid; fi
if [ \"$S\" = issues ]; then
  T=$(jq -r '.issues | type' $F 2>/dev/null || echo none)
  N=$(jq '.issues | length' $F 2>/dev/null || echo 0)
  BAD=$(jq '[.issues[] | select((.id | type) != \"string\" or (.title | type) != \"string\" or (.body | type) != \"string\" or (.files | type) != \"array\" or (.id | length) == 0 or (.title | length) == 0 or (.body | length) == 0)] | length' $F 2>/dev/null || echo 99)
  if [ \"$T\" != array ] || [ \"$N\" = 0 ] || [ \"$BAD\" != 0 ]; then S=invalid; fi
fi
if [ \"$S\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/decompose_attempts
  if [ $A -lt 2 ]; then echo 'decomposition.json missing or invalid; rewrite it exactly per the contract' >&2; exit 1; fi
fi
echo 0 > /tmp/fabro/decompose_attempts
if [ \"$S\" = issues ]; then
  jq '[.issues[] | . + {source: \"decompose\"}]' $F > /tmp/fabro/tasks.json
  echo 0 > /tmp/fabro/task_index
fi
CNT=$(jq '.issues | length' $F 2>/dev/null || echo 0)
echo '{\"context_updates\":{\"decomp_status\":\"'$S'\",\"task_count\":'$CNT'}}'"]

    // ---- Sequential task loop ----
    next_task [label="Next task + mainline refresh", shape=parallelogram, output_schema="routing",
        script="IDX=$(cat /tmp/fabro/task_index 2>/dev/null || echo 0)
COUNT=$(jq length /tmp/fabro/tasks.json)
if [ $IDX -ge $COUNT ]; then echo '{\"context_updates\":{\"tasks_done\":true}}'; exit 0; fi
jq '.['$IDX']' /tmp/fabro/tasks.json > /tmp/fabro/current_task.json
echo $((IDX+1)) > /tmp/fabro/task_index
echo 0 > /tmp/fabro/round
echo 0 > /tmp/fabro/review_attempts
echo 0 > /tmp/fabro/improve_attempts
echo 0 > /tmp/fabro/merge_attempts
git rev-parse HEAD > /tmp/fabro/pre_merge_sha
if git fetch origin main && git merge --no-edit origin/main; then
  git rev-parse HEAD > /tmp/fabro/task_base_sha
  echo '{\"context_updates\":{\"tasks_done\":false,\"rebase_failed\":false,\"review_decision\":\"none\",\"task_disposition\":\"none\",\"diff_too_large\":false}}'
else
  git merge --abort || true
  git rev-parse HEAD > /tmp/fabro/task_base_sha
  echo 'The mainline merge was attempted and aborted: leaving it in the tree would let the next checkpoint commit conflict markers. A dedicated resolve_merge stage redoes the merge and resolves it, so no rework agent should touch git.' > /tmp/fabro/feedback/rework.md
  echo '{\"context_updates\":{\"tasks_done\":false,\"rebase_failed\":true,\"review_decision\":\"none\",\"task_disposition\":\"none\",\"diff_too_large\":false}}'
fi"]

    // ---- Mainline conflict resolution ----
    // next_task aborted the failed merge and left a clean tree. A conflicted merge
    // cannot cross a stage boundary: fabro's checkpoint would `git add -A` the
    // conflict-marked files, which git treats as resolved, and commit markers onto
    // the run branch. So the agent performs the merge itself, in one stage, and
    // resolve_merge_gate verifies the result from git rather than trusting a claim.
    resolve_merge [label="Resolve the mainline merge", class="coder-t4", timeout="30m", max_retries=1, prompt="@prompts/resolve_merge.md.j2"]

    // The conflict-marker scan covers what this merge can have touched — the files
    // changed since the pre-merge SHA, dirty tracked files, and untracked files the
    // next checkpoint would `git add -A` — rather than the whole worktree, which
    // would walk build output and would fire on any repository that legitimately
    // commits a conflict-marker fixture.
    resolve_merge_gate [label="Verify the mainline merge", shape=parallelogram, output_schema="routing",
        script="PRE=$(cat /tmp/fabro/pre_merge_sha 2>/dev/null || echo '')
A=$(cat /tmp/fabro/merge_attempts 2>/dev/null || echo 0)
BAD=0
if [ -e .git/MERGE_HEAD ]; then BAD=1; fi
if git diff --name-only --diff-filter=U | grep -q . ; then BAD=1; fi
: > /tmp/fabro/merge_scan.txt
if [ -n \"$PRE\" ]; then git diff --name-only \"$PRE\" HEAD >> /tmp/fabro/merge_scan.txt 2>/dev/null || true; fi
git diff --name-only HEAD >> /tmp/fabro/merge_scan.txt 2>/dev/null || true
git ls-files --others --exclude-standard >> /tmp/fabro/merge_scan.txt 2>/dev/null || true
while IFS= read -r f; do
  [ -f \"$f\" ] || continue
  if grep -qI '<<<<<<< ' \"$f\"; then BAD=1; fi
done < /tmp/fabro/merge_scan.txt
if ! git merge-base --is-ancestor origin/main HEAD; then BAD=1; fi
if [ $BAD -ne 0 ]; then
  git merge --abort 2>/dev/null || true
  if [ -n \"$PRE\" ]; then git reset --hard \"$PRE\" || true; fi
  A=$((A+1))
  echo $A > /tmp/fabro/merge_attempts
  echo 'The merge agent left conflict markers, an in-progress merge, or a branch that still does not contain origin/main.' > /tmp/fabro/needs_human_reason
  echo '{\"context_updates\":{\"merge_ok\":false,\"merge_attempts\":'$A'}}'
else
  git rev-parse HEAD > /tmp/fabro/task_base_sha
  echo '{\"context_updates\":{\"merge_ok\":true,\"merge_attempts\":'$A'}}'
fi"]

    // Review-class agent nodes carry timeout="15m", not the 30m they had. The 30m was
    // never sized; it was the graph `stall_timeout` default written out by hand.
    //
    // Measured across runs 01M2RX2SGJJT09WK5FS8GYJCDE, 01M2RB5QBNBPS6C0F9904V25AX and
    // 01M2SBJG92TX0DBRKY5881VM34 -- 29 executions, every one of them:
    //
    //   extra_decompose  max  69s     improve   max 180s     spec      max 157s
    //   standards        max 216s     review    max 226s     quality   max 332s
    //   review_merge.standards max 384s   .spec max 262s   .review_fix max 309s
    //
    // 15m is 2.3x the slowest execution ever observed (384s) and 13x the median. The
    // old 30m was 5-26x, which is not headroom -- it is the price of a stall.
    //
    // A stalled provider is what this bounds. Run 01M2RX2SGJJT09WK5FS8GYJCDE lost 60
    // minutes to two of them: `agent.llm.started` on glm-5.3, a 502 from LiteLLM
    // 15m39s later, an immediate retry onto the SAME model, and nothing else until
    // the node timeout fired at 30m. Both stages then succeeded on the stage retry.
    // Halving the timeout halves that loss and changes nothing else -- `max_retries=1`
    // stays, so a genuinely slow stage still gets its second attempt.
    //
    // NOT retimed: `coder` (90m, max observed 2110s), `decompose` (30m, max 1009s),
    // `rework_t1..t4` (45m, never yet executed) and `resolve_merge` (30m, n=1). Those
    // have real tails or no evidence, and the same arithmetic does not hold for them.
    // See docs/perf/00-overview-and-measurements.md.
    improve [label="Improve task spec", class="improve", timeout="15m", max_retries=1, prompt="@prompts/improve.md.j2"]

    improve_gate [label="Validate improved task", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/improve_result.json
A=$(cat /tmp/fabro/improve_attempts 2>/dev/null || echo 0)
D=$(jq -r .disposition $F 2>/dev/null || echo invalid)
if [ \"$D\" != ready ] && [ \"$D\" != redundant ] && [ \"$D\" != needs_human ]; then D=invalid; fi
if [ \"$D\" = ready ]; then
  jq -e '.task and ((.task.title | type) == \"string\") and ((.task.body | type) == \"string\") and ((.task.body | length) > 0)' $F >/dev/null 2>&1 || D=invalid
fi
if [ \"$D\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/improve_attempts
  if [ $A -lt 2 ]; then echo 'improve_result.json missing or invalid; rewrite it exactly per the contract' >&2; exit 1; fi
fi
echo 0 > /tmp/fabro/improve_attempts
if [ \"$D\" = ready ]; then jq .task $F > /tmp/fabro/current_task.json; fi
echo '{\"context_updates\":{\"task_disposition\":\"'$D'\"}}'"]

    // `timeout` and `max_retries` are both sized from measured data, not guessed.
    //
    // Sized from all 23 coder/rework attempts on the server, completions AND timeouts,
    // not just the ones that finished -- measuring only completions is circular, because
    // a stage that hit the ceiling produces no wall_time to measure. Completions run
    // 146s..3166s, p50 758s; 5/23 exceeded 30m and 2/23 exceeded 45m. The longest
    // completion, 3166s, is 88% of a 60m ceiling, which is not headroom. 90m is.
    //
    // The ceiling matters because fabro bounds a stage by TOTAL WALL CLOCK: a coder
    // making steady progress is killed at the same mark as one that has stalled. There
    // is no idle- or progress-based bound at the stage level (the only idle mechanism,
    // graph `stall_timeout`, cancels the whole run rather than failing the stage). So
    // the ceiling has to clear the slowest legitimate session, and the retry below is
    // what covers the stalls.
    //
    // `max_retries=1` exists for a different failure. On 2026-09-17 the `coders`
    // upstream accepted a request, streamed reasoning for 9 seconds, and then went
    // silent: fabro logged `agent.llm.first_output` at 03:01:19 and then emitted no
    // event at all for 1915 seconds, until this node's timeout killed the stage.
    // LiteLLM was retrying the hung upstream on its own 600s budget (03:01:26,
    // 03:11:26, 03:21:26) and the 200 finally landed 20 minutes late. Nothing in
    // fabro recovers from that on its own: a stream that stalls without erroring is
    // not a provider error, so neither the LLM retry (3x, transient errors only) nor
    // the model fallback chain (`coders` -> `glm-4.7`) can fire. The node timeout is
    // the only backstop, and it classifies as `transient_infra` -- which IS
    // retry-eligible, but `default_max_retries` is 0, so the stage reported
    // `will_retry: false` and the run walked its unconditional edge to human_rescue
    // with the issue still labelled agent-in-progress.
    //
    // One retry gets a fresh session, and therefore a fresh routing decision inside
    // LiteLLM, which is the thing most likely to land on a healthy deployment.
    //
    // It also RESUMES rather than restarts, which is the larger benefit and was not
    // the reason this was added. A node retry re-runs the handler in the SAME
    // sandbox, and a failed stage writes no checkpoint -- so the previous attempt's
    // edits are still in the working tree, uncommitted. Measured on jelly-swipe#347
    // (run 01M2PS2A4QAX3ENBT929QNKZWV): attempt 1 timed out at 3600s having made 114
    // `edit_file` calls; attempt 2 read the modified tree, finished the remainder and
    // completed in 1134s. 79 minutes total for work that would otherwise have been
    // thrown away at 45m and sent to human_rescue.
    //
    // Worst case is two 60m attempts on a genuinely dead provider; the run then
    // reaches human_rescue as it does today, having actually tried.
    //
    // Do NOT promote this to a graph-level `default_max_retries`. That would also
    // apply to the command gates, whose `exit 1` is a deliberate routing signal and
    // whose attempt counters would be double-incremented by an engine retry.
    // timeout="180m" and allow_partial=true together, for one measured failure.
    //
    // Run 01M2SBJG92TX0DBRKY5881VM34, task 2 of 3 on womens-fantasy-sports
    // ("refactor(squads): one module resolving a squad's Season, actionable
    // gameweek and typed opening-build state"). The coder was NOT stuck. It ran
    // 90 minutes, was retried, ran 90 more, and was making progress both times:
    // 55 then 77 tool calls, 43 then 67 assistant turns, context grown to 158k
    // tokens. The last event before the first timeout, 11 seconds before it
    // fired, was `edit_file -> "Successfully edited"`. It was mid-edit.
    //
    // Sandcastle ran the same work on the same strix box and did not have this
    // problem, because its coder had NO wall clock. It had `--idle-timeout`
    // (fails only when stdout is SILENT for 1800s) and a livelock watchdog that
    // aborts after 5 consecutive IDENTICAL tool calls with an unchanged
    // worktree. Both measure progress. Neither would have stopped this agent --
    // it was never silent, and 13 consecutive reads of 13 different files are
    // not identical calls. Fabro has no per-node equivalent: `stall_timeout` is
    // graph-level and cancels the whole run.
    //
    // 180m is the longer budget, and it is still an arbitrary wall clock --
    // which is why it is not the real fix. allow_partial is.
    //
    // WITHOUT allow_partial, a timed-out coder ends `failed`, takes its
    // UNCONDITIONAL edge to human_rescue, and never produces a review verdict --
    // so rework_t1..t4, the escalation ladder that exists precisely for a task
    // the tier-1 coder cannot land, is never reached. Task 1 of that same run
    // went coder -> review -> rework_t1 -> review -> rework_t2 -> review ->
    // rework_t2 -> review -> integrate and shipped. Task 2 got none of it, and
    // parked a scheduler slot on an unanswered human gate for 5h31m.
    //
    // WITH it, `finalize_retries_exhausted` promotes the stage to
    // partially_succeeded (node_handler.rs:170) instead of failed. The partial
    // work is already on disk in the run's own sandbox, so prep_review picks it
    // up, validate catches anything left broken, and the reviewer's verdict
    // drives the ladder onto a DIFFERENT model. That is Sandcastle's shape:
    // whatever the agent produced gets reviewed, and escalation follows.
    coder [label="Implement task (tier 1)", class="coder", timeout="180m", max_retries=1, allow_partial=true, prompt="@prompts/coder.md.j2"]

    prep_review [label="Prepare review inputs", shape=parallelogram, output_schema="routing",
        script="set -e
BASE=$(cat /tmp/fabro/task_base_sha)
git diff $BASE..HEAD > /tmp/fabro/review/diff.patch
git diff --stat $BASE..HEAD > /tmp/fabro/review/diffstat.txt
git diff --name-only $BASE..HEAD > /tmp/fabro/review/changed_files.txt
BYTES=$(wc -c < /tmp/fabro/review/diff.patch | tr -d ' ')
if [ $BYTES -gt 2000000 ]; then
  echo '## Diff too large' > /tmp/fabro/feedback/rework.md
  echo 'The change diff is '$BYTES' bytes (limit 2000000). Split or shrink the change so it stays reviewable, then continue the current task in /tmp/fabro/current_task.json.' >> /tmp/fabro/feedback/rework.md
  echo '{\"context_updates\":{\"diff_too_large\":true}}'
else
  echo '{\"context_updates\":{\"diff_too_large\":false}}'
fi"]

    validate [label="Validate (setup + ci)", shape=parallelogram, timeout="20m",
        script="./.fabro/setup.sh > /tmp/fabro/validate_output.log 2>&1 && ./.fabro/ci.sh >> /tmp/fabro/validate_output.log 2>&1
RC=$?
tail -c 8000 /tmp/fabro/validate_output.log
if [ $RC -ne 0 ]; then
  echo '## Validation failed (exit '$RC'): ./.fabro/setup.sh && ./.fabro/ci.sh' > /tmp/fabro/feedback/rework.md
  echo >> /tmp/fabro/feedback/rework.md
  tail -c 6000 /tmp/fabro/validate_output.log >> /tmp/fabro/feedback/rework.md
  exit 1
fi"]

    review [label="Review task", class="review", timeout="15m", max_retries=1, prompt="@prompts/reviewer.md.j2"]

    review_gate [label="Validate verdict", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/review/verdict.json
A=$(cat /tmp/fabro/review_attempts 2>/dev/null || echo 0)
D=$(jq -r .decision $F 2>/dev/null || echo invalid)
if [ \"$D\" != approved ] && [ \"$D\" != changes_requested ] && [ \"$D\" != needs_human_review ]; then D=invalid; fi
if [ \"$D\" = changes_requested ]; then
  B=$(jq '[.findings[]? | select(.severity == \"blocking\")] | length' $F 2>/dev/null || echo 0)
  if [ \"$B\" = 0 ]; then D=invalid; fi
fi
if [ \"$D\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/review_attempts
  if [ $A -lt 2 ]; then echo 'verdict.json is missing, malformed, or requests changes with no blocking finding; rewrite it exactly per the contract' >&2; exit 1; fi
fi
echo 0 > /tmp/fabro/review_attempts
if [ \"$D\" = changes_requested ]; then
  echo '## Review findings to fix' > /tmp/fabro/feedback/rework.md
  jq -r '.summary // empty' $F >> /tmp/fabro/feedback/rework.md
  echo >> /tmp/fabro/feedback/rework.md
  jq -r '.findings[]? | select(.severity == \"blocking\") | .message' $F | sed 's/^/- /' >> /tmp/fabro/feedback/rework.md
fi
echo '{\"context_updates\":{\"review_decision\":\"'$D'\"}}'"]

    integrate [label="Integrate task", shape=parallelogram,
        script="T=$(jq -r .title /tmp/fabro/current_task.json)
S=$(jq -r '.summary // empty' /tmp/fabro/review/verdict.json 2>/dev/null || true)
{ echo '### Task: '$T; echo '- Review: '$S; echo; } >> /tmp/fabro/completed.md
echo integrated"]

    rework_router [label="Escalate rework round", shape=parallelogram, output_schema="routing",
        script="R=$(cat /tmp/fabro/round 2>/dev/null || echo 0)
R=$((R+1))
echo $R > /tmp/fabro/round
echo '{\"context_updates\":{\"round\":'$R'}}'"]

    rework_t1 [label="Rework (tier 1: coders)", class="coder", timeout="45m", max_retries=1, prompt="@prompts/rework.md.j2"]
    rework_t2 [label="Rework (tier 2: glm-4.7)", class="coder-t2", timeout="45m", max_retries=1, prompt="@prompts/rework.md.j2"]
    rework_t3 [label="Rework (tier 3: kimi-for-coding)", class="coder-t3", timeout="45m", max_retries=1, prompt="@prompts/rework.md.j2"]
    rework_t4 [label="Rework (tier 4: glm-5.3)", class="coder-t4", timeout="45m", max_retries=1, prompt="@prompts/rework.md.j2"]

    // ---- Extra review rounds (whole branch) ----
    extra_prep [label="Prepare extra review", shape=parallelogram, output_schema="routing",
        script="ER=$(cat /tmp/fabro/extra_round 2>/dev/null || echo 0)
if [ $ER -ge 2 ]; then echo '{\"context_updates\":{\"extra_done\":true}}'; exit 0; fi
echo $((ER+1)) > /tmp/fabro/extra_round
git fetch origin main
git diff origin/main...HEAD > /tmp/fabro/extra/diff.patch
git diff --stat origin/main...HEAD > /tmp/fabro/extra/diffstat.txt
git diff --name-only origin/main...HEAD > /tmp/fabro/extra/changed_files.txt
echo '{\"context_updates\":{\"extra_done\":false,\"standards_status\":\"none\",\"spec_status\":\"none\",\"quality_status\":\"none\",\"new_tasks\":0,\"followup_status\":\"none\"}}'"]

    standards [label="Standards review", class="review", timeout="15m", max_retries=1, prompt="@prompts/standards.md.j2"]
    standards_gate [label="Validate standards output", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/extra/standards.json
A=$(cat /tmp/fabro/standards_attempts 2>/dev/null || echo 0)
D=$(jq -r .decision $F 2>/dev/null || echo invalid)
if [ \"$D\" != approve ] && [ \"$D\" != findings ] && [ \"$D\" != needs_human_review ]; then D=invalid; fi
if [ \"$D\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/standards_attempts
  if [ $A -lt 2 ]; then echo 'standards.json missing or invalid; rewrite it exactly per the contract' >&2; exit 1; fi
fi
echo 0 > /tmp/fabro/standards_attempts
echo '{\"context_updates\":{\"standards_status\":\"'$D'\"}}'"]

    spec [label="Spec review", class="review-frontier", timeout="15m", max_retries=1, prompt="@prompts/spec.md.j2"]
    spec_gate [label="Validate spec output", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/extra/spec.json
A=$(cat /tmp/fabro/spec_attempts 2>/dev/null || echo 0)
D=$(jq -r .decision $F 2>/dev/null || echo invalid)
if [ \"$D\" != approve ] && [ \"$D\" != findings ] && [ \"$D\" != needs_human_review ]; then D=invalid; fi
if [ \"$D\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/spec_attempts
  if [ $A -lt 2 ]; then echo 'spec.json missing or invalid; rewrite it exactly per the contract' >&2; exit 1; fi
fi
echo 0 > /tmp/fabro/spec_attempts
echo '{\"context_updates\":{\"spec_status\":\"'$D'\"}}'"]

    quality [label="Code quality review", class="review", timeout="15m", max_retries=1, prompt="@prompts/quality.md.j2"]
    quality_gate [label="Validate quality output", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/extra/quality.json
A=$(cat /tmp/fabro/quality_attempts 2>/dev/null || echo 0)
D=$(jq -r .decision $F 2>/dev/null || echo invalid)
if [ \"$D\" != approve ] && [ \"$D\" != findings ] && [ \"$D\" != needs_human_review ]; then D=invalid; fi
if [ \"$D\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/quality_attempts
  if [ $A -lt 2 ]; then echo 'quality.json missing or invalid; rewrite it exactly per the contract' >&2; exit 1; fi
fi
echo 0 > /tmp/fabro/quality_attempts
echo '{\"context_updates\":{\"quality_status\":\"'$D'\"}}'"]

    extra_decompose [label="Follow-up decomposer", class="review-frontier", timeout="15m", max_retries=1, prompt="@prompts/extra_decompose.md.j2"]
    extra_gate [label="Merge follow-up tasks", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/extra/followups.json
A=$(cat /tmp/fabro/extra_decompose_attempts 2>/dev/null || echo 0)
S=$(jq -r .status $F 2>/dev/null || echo invalid)
if [ \"$S\" != issues ] && [ \"$S\" != no_work ] && [ \"$S\" != needs_human_review ]; then S=invalid; fi
NEWCNT=0
if [ \"$S\" = issues ]; then
  T=$(jq -r '.issues | type' $F 2>/dev/null || echo none)
  N=$(jq '.issues | length' $F 2>/dev/null || echo 0)
  BAD=$(jq '[.issues[] | select((.id | type) != \"string\" or (.title | type) != \"string\" or (.body | type) != \"string\" or (.files | type) != \"array\" or (.id | length) == 0 or (.title | length) == 0 or (.body | length) == 0)] | length' $F 2>/dev/null || echo 99)
  if [ \"$T\" != array ] || [ \"$N\" = 0 ] || [ \"$BAD\" != 0 ]; then S=invalid; fi
fi
if [ \"$S\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/extra_decompose_attempts
  if [ $A -lt 2 ]; then echo 'followups.json missing or invalid; rewrite it exactly per the contract' >&2; exit 1; fi
fi
echo 0 > /tmp/fabro/extra_decompose_attempts
if [ \"$S\" = issues ]; then
  OLD=$(jq length /tmp/fabro/tasks.json)
  jq -n --slurpfile cur /tmp/fabro/tasks.json --slurpfile new $F '$cur[0] + [$new[0].issues[] | select(.id as $i | [$cur[0][].id] | index($i) | not) | . + {source: \"extra-review\"}]' > /tmp/fabro/tasks.merged.json
  mv /tmp/fabro/tasks.merged.json /tmp/fabro/tasks.json
  NOW=$(jq length /tmp/fabro/tasks.json)
  NEWCNT=$((NOW-OLD))
fi
echo '{\"context_updates\":{\"followup_status\":\"'$S'\",\"new_tasks\":'$NEWCNT'}}'"]

    // ---- Delivery ----
    open_pr_prep [label="Final aggregate and PR prep", shape=parallelogram, timeout="20m",
        script="set -e
git fetch origin main
git merge --no-edit origin/main
if ./.fabro/setup.sh > /tmp/fabro/validate_output.log 2>&1 && ./.fabro/ci.sh >> /tmp/fabro/validate_output.log 2>&1; then
  tail -c 4000 /tmp/fabro/validate_output.log
else
  tail -c 4000 /tmp/fabro/validate_output.log
  exit 1
fi
N=$(jq -r .number /tmp/fabro/issue.json)
T=$(jq -r .title /tmp/fabro/issue.json | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
CC='^(feat|fix|docs|chore|refactor|test|ci|build|perf|revert)([(][a-z0-9 ._/-]+[)])?[!]?: .'
S=$T
# Step 1: the issue title already carries a Conventional Commits prefix; use it as-is
if ! printf '%s' \"$S\" | grep -qE \"$CC\"; then
  # Step 2: a [Bracket] prefix names a type
  case \"$S\" in
    '['*)
      W=${S#?}
      W=${W%%]*}
      W=$(printf '%s' \"$W\" | tr 'A-Z' 'a-z')
      # A bracket word is as often a label name as a Conventional Commits type --
      # [BUG] and [Feature] are the two commonest title shapes in these repos -- so
      # map both vocabularies and strip the bracket either way. Leaving it produced
      # subjects like `fix: [BUG] ...`, which lint accepts and release-please
      # publishes.
      case \"$W\" in
        bug) W=fix ;;
        feature|enhancement) W=feat ;;
        documentation) W=docs ;;
        performance) W=perf ;;
        chore|task) W=chore ;;
      esac
      case \"$W\" in
        feat|fix|docs|chore|refactor|test|ci|build|perf|revert)
          REST=${S#?}
          REST=${REST#*]}
          REST=$(printf '%s' \"$REST\" | sed 's/^[[:space:]]*//')
          S=\"$W: $REST\"
          ;;
      esac
      ;;
  esac
  if ! printf '%s' \"$S\" | grep -qE \"$CC\"; then
    # Step 3: an issue label maps to a type; fabro bookkeeping labels never map
    TYPE=
    L=$(jq -r '[.labels[].name] | join(\",\")' /tmp/fabro/issue.json 2>/dev/null | tr 'A-Z' 'a-z' || true)
    case \",$L,\" in
      *,bug,*) TYPE=fix ;;
      *,enhancement,*|*,feature,*) TYPE=feat ;;
      *,documentation,*|*,docs,*) TYPE=docs ;;
      *,performance,*) TYPE=perf ;;
    esac
    if [ -n \"$TYPE\" ]; then S=\"$TYPE: $S\"; fi
    if ! printf '%s' \"$S\" | grep -qE \"$CC\"; then
      S='chore: '$S
    fi
  fi
fi
# Truncate so subject plus the appended issue reference fits 72 characters, cutting
# at a word boundary where one exists within the last 12 characters. The reference
# is appended after the cut and is never truncated away.
SUBJ=$(printf '%s' \"$S\" | awk -v maxd=$((72 - ${#N} - 4)) '{ if (length($0) <= maxd) { print $0; exit } t = substr($0, 1, maxd); st = maxd - 11; if (st < 1) st = 1; for (i = maxd; i >= st; i--) { if (substr(t, i, 1) == \" \") { print substr(t, 1, i - 1); exit } } print t }')
SUBJ=$(printf '%s' \"$SUBJ\" | sed 's/[[:space:]]*$//')
printf '%s (#%s)' \"$SUBJ\" \"$N\" > /tmp/fabro/commit_subject.txt
echo >> /tmp/fabro/commit_subject.txt
cp /tmp/fabro/commit_subject.txt /tmp/fabro/pr_title.txt
# Commit body: the first prose paragraph of the issue body, else Resolves #N: <title>
B=$(jq -r .body /tmp/fabro/issue.json 2>/dev/null || true)
FIRST=$(printf '%s' \"$B\" | awk 'BEGIN { RS = \"\" } $0 ~ /^[[:space:]]*#/ { next } { para = \"\"; for (i = 1; i <= NF; i++) { line = $i; sub(/^[[:space:]]*[-*+][[:space:]]+/, \"\", line); sub(/^[[:space:]]*[0-9]+[.)][[:space:]]+/, \"\", line); sub(/^[[:space:]]*#+[[:space:]]+/, \"\", line); if (para == \"\") para = line; else para = para \" \" line } if (para != \"\" && length(para) <= 500) { print para; exit } }')
if [ -n \"$FIRST\" ]; then
  { printf '%s' \"$FIRST\"; echo; echo; echo 'Resolves #'$N; } > /tmp/fabro/commit_body.md
else
  echo 'Resolves #'$N': '$T > /tmp/fabro/commit_body.md
fi
{ echo '## Summary'; echo; echo '<!-- fabro:commit-body:start -->'; cat /tmp/fabro/commit_body.md; echo '<!-- fabro:commit-body:end -->'; echo; cat /tmp/fabro/completed.md 2>/dev/null || true; echo '## Validation'; echo; echo '- ./.fabro/setup.sh && ./.fabro/ci.sh green after final merge with origin/main'; } > /tmp/fabro/pr_body.md
# Assertions: a derivation bug must fail the run into human_rescue, not open an
# unmergeable PR. These can only fire on a bug; the derivation always terminates.
grep -qE '^(feat|fix|docs|chore|refactor|test|ci|build|perf|revert)([(][a-z0-9 ._/-]+[)])?[!]?: .' /tmp/fabro/commit_subject.txt
grep -q '^Resolves #' /tmp/fabro/commit_body.md
grep -q 'fabro:commit-body:start' /tmp/fabro/pr_body.md"]

    // `open_pr` is the only node that opens a PR, including on the
    // human_rescue -> [P] Accept partial -> open_pr_prep -> open_pr path, so it is the
    // single place that has to publish the PR number for the trigger that follows.
    //
    // The trigger cannot read `pr_url` back out of the context: command `script`
    // substitution supports {{ goal }}, {{ inputs.* }} and {{ vars.* }} only, there is
    // no {{ context.* }}, and `stdin_source` pipes exactly one key. So this uses the
    // file-backed contract both workflows are already built on. `pr-review` states the
    // same rule for itself: every later stage reads the number from a file rather than
    // re-interpolating it.
    //
    // `sed 's|.*/||'` uses | delimiters because a backslash is illegal in a .fabro
    // file. https://github.com/o/r/pull/123 yields 123.
    open_pr [label="Push and open PR", shape=parallelogram, output_schema="routing",
        script="set -e
git push -u origin HEAD
N=$(jq -r .number /tmp/fabro/issue.json)
T=$(cat /tmp/fabro/pr_title.txt)
gh pr create --title \"$T\" --body-file /tmp/fabro/pr_body.md --label agent-authored || gh pr view --json url > /dev/null
PR_URL=$(gh pr view --json url --jq .url)
echo $PR_URL | sed 's|.*/||' > /tmp/fabro/pr_number
gh issue edit $N --remove-label agent-in-progress --add-label Review || true
gh issue comment $N --body 'Agent run complete. PR: '$PR_URL || true
echo '{\"context_updates\":{\"pr_url\":\"'$PR_URL'\"}}'"]

    // ---- Review and merge, in this run ----
    // The bridge is gone. It fired a separate durable `pr-review` run, which then
    // queued behind every other run on a two-slot scheduler: an 11-minute review
    // waiting hours behind eight-hour implementations, which is why PRs piled up
    // unreviewed. The review and merge phase is now spliced in here at parse time:
    // no child run, no second sandbox, no scheduler queue.
    //
    // `review_merge` is an import placeholder -- NOT to be confused with this
    // graph's own per-task `review` node. Its ids arrive prefixed
    // (`review_merge.merge_gate`), and `pr-review` imports the same file, so there is one
    // copy of this logic rather than two that drift. Entry and exit contracts are
    // documented at the top of .fabro/workflows/_shared/review-merge/review-merge.fabro.
    //
    // The reviewers inside it are fresh sessions on a fresh diff, which is the point:
    // they run after every task AND every extra-review follow-up has landed, so they
    // judge the branch that is actually going to merge.
    // No `output_schema="routing"`. This node publishes no context key -- the edge
    // out of it routes on `outcome=succeeded` alone -- and a command node that
    // declares the routing schema must print a routing object as the last JSON on
    // stdout. `echo handoff ready` is not one, so fabro failed the stage on schema
    // validation, which for a command node is deterministic and non-retryable: no
    // repair turn, no retry, straight to human_rescue with the PR already open.
    // Cost one run (01M2R057XAWN8ZG0A7ZV7YPJXK) on 2026-09-17.
    pr_handoff [label="Hand off to review and merge", shape=parallelogram,
        script="set -e
PR=$(cat /tmp/fabro/pr_number)
gh pr view $PR --json number,title,body,url,state,isCrossRepository,headRefName,baseRefName,headRefOid,labels,closingIssuesReferences > /tmp/fabro/pr.json
jq -r .baseRefName /tmp/fabro/pr.json > /tmp/fabro/base_ref
jq -r .headRefName /tmp/fabro/pr.json > /tmp/fabro/head_ref
jq '[.closingIssuesReferences[]?]' /tmp/fabro/pr.json > /tmp/fabro/linked_issues.json
# The branch point, not the last task's base. `task_base_sha` is rewritten by
# `next_task` on every task, so using it would make the report's \"Commits with
# changes\" section cover only the final task instead of everything this run did.
B=$(cat /tmp/fabro/base_ref)
git fetch origin \"$B\" 2>/dev/null || true
git merge-base origin/\"$B\" HEAD > /tmp/fabro/run_base_sha 2>/dev/null || git rev-parse HEAD > /tmp/fabro/run_base_sha
# The per-repo auto-merge switch lives in the pr-review-<repo> automation's
# description, because an automation row has no inputs or labels field. The bridge
# used to read it; this does now, so the switch keeps working unchanged. An absent
# token means ON (decision 10); anything present that is not `true` means OFF, and an
# unreachable API means OFF, because a switch that cannot be read is not armed.
echo 0 > /tmp/fabro/auto_merge_repo
REPO=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || echo '')
if [ -n \"$REPO\" ] && [ -n \"${FABRO_API_URL:-}\" ] && [ -n \"${FABRO_API_TOKEN:-}\" ]; then
  if curl -fsS -H \"Authorization: Bearer $FABRO_API_TOKEN\" $FABRO_API_URL/automations > /tmp/fabro/autorows.json 2>/dev/null; then
    D=$(jq -r --arg r \"$REPO\" '[.data[] | select(.workflow == \"pr-review\" and .target.repo == $r)] | .[0].description // \"\"' /tmp/fabro/autorows.json)
    case \"$D\" in
      *auto_merge*) T=$(printf '%s' \"$D\" | grep -o 'auto_merge=[A-Za-z0-9_-]*' | tail -1 | cut -d= -f2)
                    case \"$T\" in true) echo 1 > /tmp/fabro/auto_merge_repo ;; esac ;;
      *) echo 1 > /tmp/fabro/auto_merge_repo ;;
    esac
  fi
fi
echo handoff ready"]

    review_merge [import="../_shared/review-merge/review-merge.fabro"]

    close_noop [label="Close (no actionable work)", shape=parallelogram,
        script="N=$(jq -r .number /tmp/fabro/issue.json)
gh issue edit $N --remove-label agent-in-progress || true
gh issue comment $N --body 'Agent run found no actionable decomposition for this issue; leaving it for human triage.' || true
echo done"]

    // A human gate blocks until a human answers, and with no timeout that is
    // forever. Run 01M2SBJG92TX0DBRKY5881VM34 sat here 5h31m holding one of the
    // server's two scheduler slots -- half the factory's capacity parked on a
    // question nobody was at the keyboard for. The notifications all worked: the
    // discord-rescue hook fired at stage_start (hooks_matched=1) and the host
    // monitor's C4 stuck-run condition alerted and re-alerted four hours later.
    //
    // `timeout` on a HUMAN node bounds the wait, despite the attribute table
    // saying "waiting on human input doesn't consume it" -- that describes
    // timeout_excluding_interview_wait, which pauses OTHER nodes' timeouts while
    // an interview blocks. A human node is handler-managed and copies its own
    // timeout onto the question (handler/human.rs:122).
    //
    // 4h matches the monitor's re-alert interval, so two Discord pings go out
    // before it gives up. `human.default_choice` is a NODE ID, not an edge label
    // -- make_choice_outcome puts it straight into suggested_next_ids -- so it is
    // `mark_stuck`, not "[X] Abandon". Without it, an expired gate returns
    // retry_classify("human gate timeout, no default") instead of routing.
    human_rescue [shape=hexagon, timeout="4h", human.default_choice="mark_stuck",
        label="Agent stuck. Type guidance to retry, or choose an option."]

    mark_stuck [label="Mark stuck", shape=parallelogram,
        script="N=$(jq -r .number /tmp/fabro/issue.json 2>/dev/null || echo 0)
if [ \"$N\" != 0 ]; then
  gh issue edit $N --remove-label agent-in-progress --add-label agent-stuck || true
  gh issue comment $N --body 'Agent run could not complete this issue and gave up. See the fabro run for details.' || true
fi
echo done"]

    // ---- Edges ----
    start -> acquire
    acquire -> claim
    acquire -> exit                 [condition="outcome=failed"]
    claim -> exit                   [condition="context.claim_lost=true", weight=10]
    claim -> prep                   [condition="outcome=succeeded"]
    claim -> human_rescue
    prep -> decompose               [condition="outcome=succeeded"]
    prep -> human_rescue

    decompose -> decompose_gate     [condition="outcome=succeeded"]
    decompose -> human_rescue
    decompose_gate -> decompose     [condition="outcome=failed"]
    decompose_gate -> next_task     [condition="context.decomp_status=issues"]
    decompose_gate -> close_noop    [condition="context.decomp_status=no_work"]
    decompose_gate -> human_rescue

    next_task -> extra_prep         [condition="context.tasks_done=true"]
    next_task -> resolve_merge      [condition="context.rebase_failed=true"]
    next_task -> improve

    // A failed node still routes: resolve_merge's unconditional edge leads to its
    // gate, which detects the bad state and either retries once or asks for a
    // human. `weight` keeps the success edge winning over the merge_attempts=1
    // retry edge after a successful second attempt.
    resolve_merge -> resolve_merge_gate [condition="outcome=succeeded"]
    resolve_merge -> resolve_merge_gate
    resolve_merge_gate -> improve       [condition="context.merge_ok=true", weight=10]
    resolve_merge_gate -> resolve_merge [condition="context.merge_attempts=1"]
    resolve_merge_gate -> human_rescue

    improve -> improve_gate         [condition="outcome=succeeded"]
    improve -> human_rescue
    improve_gate -> improve         [condition="outcome=failed"]
    improve_gate -> next_task       [condition="context.task_disposition=redundant"]
    improve_gate -> coder           [condition="context.task_disposition=ready"]
    improve_gate -> human_rescue

    coder -> prep_review            [condition="outcome=succeeded"]
    // Retries exhausted on a coder that was still working. allow_partial makes
    // that partially_succeeded rather than failed; this edge is what stops it
    // falling through to the unconditional human_rescue and skipping the ladder.
    coder -> prep_review            [condition="outcome=partially_succeeded"]
    coder -> human_rescue

    prep_review -> rework_router    [condition="context.diff_too_large=true"]
    prep_review -> validate

    validate -> review              [condition="outcome=succeeded"]
    validate -> rework_router

    review -> review_gate           [condition="outcome=succeeded"]
    review -> human_rescue
    review_gate -> review           [condition="outcome=failed"]
    review_gate -> integrate        [condition="context.review_decision=approved"]
    review_gate -> rework_router    [condition="context.review_decision=changes_requested"]
    review_gate -> human_rescue

    integrate -> next_task

    rework_router -> rework_t1      [condition="context.round<2"]
    rework_router -> rework_t2      [condition="context.round>=2 && context.round<4"]
    rework_router -> rework_t3      [condition="context.round=4"]
    rework_router -> rework_t4      [condition="context.round=5"]
    rework_router -> human_rescue

    rework_t1 -> prep_review        [condition="outcome=succeeded"]
    rework_t1 -> human_rescue
    rework_t2 -> prep_review        [condition="outcome=succeeded"]
    rework_t2 -> human_rescue
    rework_t3 -> prep_review        [condition="outcome=succeeded"]
    rework_t3 -> human_rescue
    rework_t4 -> prep_review        [condition="outcome=succeeded"]
    rework_t4 -> human_rescue

    extra_prep -> open_pr_prep      [condition="context.extra_done=true"]
    extra_prep -> standards

    standards -> standards_gate     [condition="outcome=succeeded"]
    standards -> human_rescue
    standards_gate -> standards     [condition="outcome=failed"]
    standards_gate -> human_rescue  [condition="context.standards_status=needs_human_review || context.standards_status=invalid"]
    standards_gate -> spec

    spec -> spec_gate               [condition="outcome=succeeded"]
    spec -> human_rescue
    spec_gate -> spec               [condition="outcome=failed"]
    spec_gate -> human_rescue       [condition="context.spec_status=needs_human_review || context.spec_status=invalid"]
    spec_gate -> quality

    quality -> quality_gate         [condition="outcome=succeeded"]
    quality -> human_rescue
    quality_gate -> quality         [condition="outcome=failed"]
    quality_gate -> human_rescue    [condition="context.quality_status=needs_human_review || context.quality_status=invalid"]
    quality_gate -> extra_decompose

    extra_decompose -> extra_gate   [condition="outcome=succeeded"]
    extra_decompose -> human_rescue
    extra_gate -> extra_decompose   [condition="outcome=failed"]
    extra_gate -> next_task         [condition="context.new_tasks>0"]
    extra_gate -> human_rescue      [condition="context.followup_status=needs_human_review"]
    extra_gate -> open_pr_prep

    open_pr_prep -> open_pr         [condition="outcome=succeeded"]
    open_pr_prep -> human_rescue
    open_pr -> pr_handoff           [condition="outcome=succeeded"]
    open_pr -> human_rescue
    pr_handoff -> review_merge      [condition="outcome=succeeded"]
    pr_handoff -> human_rescue
    // The import reports both outcomes on the PR itself before it exits, so a
    // merged PR and a deliberately-unmerged one are both finished runs. Only a
    // failure of the placeholder needs a human.
    review_merge -> human_rescue    [condition="outcome=failed"]
    review_merge -> exit

    close_noop -> exit

    // The only channel from the rescue gate's free text into a file. Mirrors
    // issue-triage's `record_answer`: a command node cannot read context, and
    // `stdin_source` pipes exactly one key. This exists so `rework.md.j2` can read the
    // guidance from a path like every other input, which in turn lets the graph run at
    // `summary:low` fidelity -- that level drops the context table, and the guidance
    // used to reach the rework agent only through it.
    record_guidance [label="Record the human guidance", shape=parallelogram,
        stdin_source="human.gate.text",
        script="mkdir -p /tmp/fabro/feedback
cat > /tmp/fabro/feedback/rescue.md
echo recorded"]

    human_rescue -> record_guidance [freeform=true]
    record_guidance -> rework_t4
    human_rescue -> open_pr_prep    [label="[P] Accept partial"]
    human_rescue -> mark_stuck      [label="[X] Abandon"]

    mark_stuck -> exit
}
