// flaky-investigation (more-local-inference task 10): a local model reads what FlakeRadar
// holds about one queued flaky-test issue and the code at `main`, and writes the likely cause
// and a proposed fix as the issue's one marker comment. The `backlog` or `ralph` run that
// later takes the issue reads it through `background.md` (C9), so the hosted planners and the
// coder start from a diagnosis instead of an empty page.
//
// It is a **background package** (D4, R16): every agent stage resolves to the run's `-bg`
// model row, `box-guard` protects the box, and nothing here takes a box-claim. The scheduler
// starts it in a coder loop's gap and may cancel it at any moment before `post` (D9).
//
// **It does not reproduce the test, and that is the design.** Reproducing needs the
// repository's `.fabro/setup.sh` and its test environment, which take longer than any gap the
// lane can predict: a 30-minute job fits 5 of the 58 predicted gaps, which is why the PR
// doctor was retired. FlakeRadar already holds what a reproduction would show -- the failure
// messages and tracebacks across runs, the failure category, whether the test both passed and
// failed on one commit, and the file and line at the last failing commit -- so `claim` reads
// that (its GET endpoints need no token, only `FLAKERADAR_URL`), `investigate` reads the code,
// and the comment says plainly that it is a diagnosis from records, not a reproduction.
//
// **One diagnosis per issue unless the issue changes.** The marker carries `at=`, and `claim`
// compares it with the issue's last body edit (`userContentEdits`' newest `editedAt`), never
// with `updated_at`: this package's own comment bumps `updated_at`, so that comparison would
// re-diagnose the issue on every run. A marker newer than the last edit stops the run.
//
// **Nothing writes to GitHub before `post`**, and `post` writes only the marker comment, so a
// cancel anywhere before it leaves nothing behind and the job is simply queued again.
//
// A failed node takes its unconditional edge to `exit`, which ends the run failed, so the lane
// records it as a failure rather than a diagnosis. `stop` is the one quiet ending: an issue
// that is closed, no longer carries `flaky-test`, or already has a current diagnosis.
digraph FlakyInvestigation {
    graph [
        goal="Diagnose one queued flaky-test issue from FlakeRadar records and the code at main, and record the cause and a proposed fix in one marker comment",
        // Above every node timeout below (`prep`'s 15m included): R2 compares them, and the
        // watchdog must never fire before a node's own timeout does.
        stall_timeout="30m",
        // Bound the preamble: the prompt names its inputs by path (invariants-graph, the
        // `default_fidelity` row).
        default_fidelity="truncate",
        // Every model in a background package is the run's `-bg` pool (R16): the `*` rule and
        // `.bg` are the same expression, so an agent node that lost its class would still run
        // on the box and never reach a hosted model. There is no `[run.model.fallbacks]` row for
        // either `-bg` name, so a box error fails the stage instead of spending credits (R14).
        model_stylesheet="
            *   { model: {{ inputs.coder_pool | default('coders-a-bg') }}; reasoning_effort: medium; }
            .bg { model: {{ inputs.coder_pool | default('coders-a-bg') }}; reasoning_effort: medium; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // ---- Read the issue and FlakeRadar's record, and decide whether to diagnose it ----
    //
    // `issue_number` arrives from the scheduler's producer and is interpolated exactly once,
    // in single quotes, as in `issue-precheck`. `/tmp/fabro/box` is this package's half of
    // C2/R16: the pool arrives with the `-bg` suffix, and `box-guard` looks up the loop's box,
    // which never carries it.
    //
    // The scout names its subject in the issue body's first line, the C3 fingerprint
    // (`docs/scout/00-overview-and-contracts.md` D10, read against lawncare-saas#2971 and
    // writers-app#1206 on 2026-10-31): `<!-- fabro:scout fp=flaky:test-<project>:<fingerprint>
    // -->` for a test, `flaky:<workflow>:<job slug>` for a CI job. A test is found in
    // FlakeRadar by `fingerprint` (`/api/tests`); a job by the issue it is linked to
    // (`/api/jobs`' `github_issue_number`, which the scout's write-back sets, C11). Neither
    // id is in the body, and the dashboard link's `&test=<id>` is not parsed: a fingerprint is
    // FlakeRadar's stable identity (F3) and does not move when the test does.
    //
    // A FlakeRadar read that fails is **not** fatal: the agent still has the issue and the
    // code, `flakeradar.md` is simply absent, and the prompt says the diagnosis then rests on
    // those two. An empty `FLAKERADAR_URL` is the same, and so is a repository FlakeRadar does
    // not cover. Every read is a bounded `curl` (at most five, 15 s each), never a pipe.
    //
    // The `test=` in the marker is FlakeRadar's numeric id of the test **or of the job**, and
    // `unknown` when nothing resolved: one field, one meaning ("the FlakeRadar entity this
    // diagnosis is about"), because C6 gives the marker one slot for it.
    claim [label="Read the issue and FlakeRadar", shape=parallelogram, output_schema="routing", timeout="5m",
        script="set -e
P=/tmp/fabro/flaky
mkdir -p $P
POOL='{{ inputs.coder_pool }}'
echo \"${POOL%-bg}\" > /tmp/fabro/box || true
N='{{ inputs.issue_number }}'
case \"$N\" in '' | *[!0-9]*) echo 'issue_number must be a positive integer' >&2; exit 1;; esac
if [ \"$N\" -lt 1 ]; then echo 'issue_number must be a positive integer' >&2; exit 1; fi
rm -f /tmp/fabro/flaky.json $P/issue.md $P/flakeradar.md $P/entity $P/entity_id $P/fp $P/history.json $P/tests.json $P/jobs.json $P/edits.json $P/curl.err $P/comments.raw
echo \"$N\" > $P/issue_number
if ! gh issue view \"$N\" --json number,title,body,state,url,labels > $P/issue.json; then
  echo 'Could not read issue '$N' from GitHub.' >&2
  exit 1
fi
R=$(jq -r '(.url // \"\") | split(\"/\") | .[3] + \"/\" + .[4]' $P/issue.json)
echo \"$R\" > $P/repo
if ! gh api \"repos/$R/issues/$N/comments?per_page=100\" --paginate > $P/comments.raw; then
  echo 'Could not read the comments on issue '$N'.' >&2
  exit 1
fi
jq -s 'add // []' $P/comments.raw > $P/comments.json
jq -r '.body // \"\"' $P/issue.json > $P/body.md
FP=$(sed -n 1p $P/body.md | jq -Rr 'try (capture(\"fabro:scout fp=(?<fp>[^ ]+)\").fp) catch \"\"')
echo \"$FP\" > $P/fp
GO=true
WHY=eligible
S=$(jq -r .state $P/issue.json)
case \"$S\" in OPEN) ;; *) GO=false; WHY='the issue is '$S', not OPEN' ;; esac
if [ \"$GO\" = true ] && ! jq -e '[(.labels // [])[].name] | index(\"flaky-test\")' $P/issue.json >/dev/null 2>&1; then
  GO=false
  WHY='the issue does not carry the flaky-test label'
fi
if [ \"$GO\" = true ]; then
  AT=$(jq -r '[.[] | (.body // \"\") | select(startswith(\"<!-- fabro:flaky-investigation \"))] | last // \"\" | try (capture(\"at=(?<at>[^ ]+)\").at) catch \"\"' $P/comments.json)
  if [ -n \"$AT\" ]; then
    LAST_EDIT=''
    if gh api graphql -f query='query($owner: String!, $name: String!, $n: Int!) { repository(owner: $owner, name: $name) { issue(number: $n) { userContentEdits(last: 100) { nodes { editedAt } } } } }' -f owner=\"${R%%/*}\" -f name=\"${R##*/}\" -F n=\"$N\" > $P/edits.json 2>/dev/null; then
      LAST_EDIT=$(jq -r '[.data.repository.issue.userContentEdits.nodes[]?.editedAt] | max // \"\"' $P/edits.json 2>/dev/null || true)
    fi
    FRESH=$(jq -rn --arg at \"$AT\" --arg le \"$LAST_EDIT\" 'try ((($le | fromdateiso8601) <= ($at | fromdateiso8601))) catch true' 2>/dev/null || echo true)
    case \"$FRESH\" in
      true) GO=false; WHY='the issue already has a diagnosis ('$AT') and its text has not changed since' ;;
      *) echo 'claim: the issue was edited after its diagnosis; diagnosing it again' >&2 ;;
    esac
  fi
fi
if [ \"$GO\" != true ]; then
  echo 'flaky-investigation: not investigating issue '$N': '$WHY >&2
  echo '{\"context_updates\":{\"flaky_go\":false}}'
  exit 0
fi
{
  echo '# #'$N': '\"$(jq -r '.title // \"\"' $P/issue.json)\"
  echo
  echo 'Labels: '\"$(jq -r '[(.labels // [])[].name] | join(\", \")' $P/issue.json)\"
  echo
  echo 'Scout fingerprint: '\"$(printf '%s' \"$FP\" | sed 's/^$/none/')\"
  echo
  jq -r '.body // \"\"' $P/issue.json
  echo
  echo '## Comments, oldest first (the last ten; fabro marker comments left out)'
  echo
  jq -r '[.[] | select((.body // \"\") | startswith(\"<!-- fabro:\") | not)] | .[-10:] | .[] | (\"### \" + (.user.login // \"?\") + \" at \" + (.created_at // \"?\")), \"\", ((.body // \"\") | .[0:2000]), \"\"' $P/comments.json
} > $P/issue.md
B=${FLAKERADAR_URL:-}
rm -f $P/flakeradar.md
if [ -z \"$B\" ]; then
  echo 'claim: FLAKERADAR_URL is empty; the diagnosis runs on the issue and the code alone' >&2
elif [ -z \"$FP\" ]; then
  echo 'claim: the issue carries no scout fingerprint; the diagnosis runs on the issue and the code alone' >&2
else
  B=${B%/}
  ENT=''
  ID=''
  fr_get() {
    C=$(curl -sS -m 15 -o \"$2\" -w '%{http_code}' \"$1\" < /dev/null 2>$P/curl.err || echo 000)
    printf '%s' \"$C\" | cut -c1-3
  }
  case \"$FP\" in
    flaky:test-*)
      SEG=${FP##*:}
      PAGE=1
      while [ \"$PAGE\" -le 3 ]; do
        C=$(fr_get \"$B/api/tests?repo=$R&sort=score&page_size=100&page=$PAGE\" $P/tests.json)
        if [ \"$C\" != 200 ]; then echo 'claim: FlakeRadar answered '$C' for its test list' >&2; break; fi
        ID=$(jq -r --arg seg \"$SEG\" '[.items[] | select(.fingerprint == $seg)][0].id // empty' $P/tests.json 2>/dev/null || true)
        [ -n \"$ID\" ] && break
        TOTAL=$(jq -r '.total // 0' $P/tests.json 2>/dev/null || echo 0)
        [ $((PAGE * 100)) -lt \"$TOTAL\" ] || break
        PAGE=$((PAGE + 1))
      done
      if [ -n \"$ID\" ]; then
        C=$(fr_get \"$B/api/tests/$ID/history?limit=100\" $P/history.json)
        if [ \"$C\" = 200 ]; then ENT=tests; else echo 'claim: FlakeRadar answered '$C' for the test history' >&2; fi
      else
        echo 'claim: FlakeRadar has no test with fingerprint '$SEG >&2
      fi
      ;;
    flaky:*)
      C=$(fr_get \"$B/api/jobs?repo=$R&include_stable=true&has_issue=true&page_size=100\" $P/jobs.json)
      if [ \"$C\" = 200 ]; then
        ID=$(jq -r --argjson n \"$N\" '[.items[] | select(.github_issue_number == $n)][0].id // empty' $P/jobs.json 2>/dev/null || true)
      else
        echo 'claim: FlakeRadar answered '$C' for its job list' >&2
      fi
      if [ -z \"$ID\" ]; then
        C=$(fr_get \"$B/api/jobs?repo=$R&include_stable=true&page_size=100\" $P/jobs.json)
        if [ \"$C\" = 200 ]; then
          ID=$(jq -r --argjson n \"$N\" '[.items[] | select(.github_issue_number == $n)][0].id // empty' $P/jobs.json 2>/dev/null || true)
        fi
      fi
      if [ -n \"$ID\" ]; then
        C=$(fr_get \"$B/api/jobs/$ID/history\" $P/history.json)
        if [ \"$C\" = 200 ]; then ENT=jobs; else echo 'claim: FlakeRadar answered '$C' for the job history' >&2; fi
      else
        echo 'claim: FlakeRadar has no job linked to issue '$N >&2
      fi
      ;;
    *) echo 'claim: the scout fingerprint '$FP' is not a flaky one; the diagnosis runs on the issue and the code alone' >&2 ;;
  esac
  if [ -n \"$ENT\" ]; then
    echo \"$ENT\" > $P/entity
    echo \"$ID\" > $P/entity_id
    if [ \"$ENT\" = tests ]; then
      {
        echo '# What FlakeRadar holds for this test'
        echo
        jq -r '.test as $t | [\"- test id **\" + ($t.id | tostring) + \"**, in project `\" + $t.project + \"`\", (if ($t.suite // \"\") != \"\" then \"- suite `\" + $t.suite + \"`\" else empty end), (if ($t.classname // \"\") != \"\" then \"- class `\" + $t.classname + \"`\" else empty end), \"- name `\" + $t.name + \"`\", (if ($t.file // \"\") != \"\" then \"- file `\" + $t.file + \"`\" + (if $t.line then \" line \" + ($t.line | tostring) else \"\" end) else empty end), \"- tier `\" + $t.tier + \"`, score \" + ($t.flakiness_score | tostring) + \", proven flakes \" + ($t.confirmed_flake_count | tostring) + (if ($t.failure_category // \"\") != \"\" then \", failure category `\" + $t.failure_category + \"`\" else \"\" end) + \", quarantined \" + ($t.quarantined | tostring), \"- last seen \" + ((($t.last_seen_at // \"?\")[0:19]) + \"Z\") + \", last status \" + ($t.last_status // \"?\"), \"- last failing commit \" + ((.last_failing_sha // \"unknown\")[0:8]) + \" on `\" + (.last_failing_branch // \"unknown\") + \"`\", (if (.location.path // \"\") != \"\" then \"- the runner last reported it at `\" + .location.path + \"`\" + (if .location.line then \" line \" + (.location.line | tostring) else \"\" end) else empty end)] | .[]' $P/history.json
        echo
        echo '## Recent failures, newest first'
        echo
        FAILS=$(jq -r '[.executions[] | select(.status == \"failed\" or .status == \"error\")] | length' $P/history.json)
        echo 'The executions FlakeRadar keeps for this test: '\"$(jq -r '.executions | length' $P/history.json)\"', of which '\"$FAILS\"' failed or errored. A test that has not failed recently is not a flake to fix today, and saying so is a useful answer.'
        echo
        if [ \"$FAILS\" = 0 ]; then
          echo 'FlakeRadar holds no failure in the executions it keeps for this test.'
        else
          jq -r '[.executions[] | select(.status == \"failed\" or .status == \"error\")][0:3] | to_entries | .[] | \"### \" + ((.value.created_at[0:19]) + \"Z\") + \" on `\" + (.value.branch // \"?\") + \"`, run \" + (.value.ci_run_id // \"?\") + \", attempt \" + (.value.attempt | tostring), \"\", \"`\" + ((.value.message // \"\") | .[0:400]) + \"`\", \"\", (if .key == 0 and ((.value.details // \"\") != \"\") then \"````text\", (.value.details | .[0:2000]), \"````\" else empty end), \"\"' $P/history.json
        fi
      } > $P/flakeradar.md
    else
      {
        echo '# What FlakeRadar holds for this CI job'
        echo
        jq -r '. as $h | $h.job as $j | [\"- job id **\" + ($j.id | tostring) + \"**: `\" + $j.name + \"` in `\" + $j.pipeline + \"`\", \"- tier `\" + $j.tier + \"`, score \" + ($j.flakiness_score | tostring) + \", confirmed flakes \" + ($j.confirmed_flake_count | tostring) + \", last status \" + $j.last_status + \", last seen \" + ((($j.last_seen_at // \"?\")[0:19]) + \"Z\"), \"- over the runs it keeps: \" + ($h.explained_failures | tostring) + \" failure(s) a test explained, \" + ($h.unexplained_failures | tostring) + \" it could not\"] | .[]' $P/history.json
        echo
        echo '## Runs, newest first'
        echo
        UNEX=$(jq -r '[.executions[] | select(.outcome == \"failed\")] | length' $P/history.json)
        if [ \"$UNEX\" = 0 ]; then
          echo 'FlakeRadar holds no unexplained failure for this job: every red run it saw had a failing test to blame.'
        else
          jq -r '[.executions[] | select(.outcome == \"failed\" or .outcome == \"explained\")][0:3] | to_entries | .[] | \"### run \" + (.value.ci_run_id // \"?\") + \", attempt \" + ((.value.ci_run_attempt // 1) | tostring) + \", on `\" + (.value.branch // \"?\") + \"`\", \"\", \"- outcome `\" + .value.outcome + \"`, commit \" + ((.value.commit_sha // \"unknown\")[0:8]), \"- runner `\" + (.value.runner_name // \"?\") + \"` (\" + ((.value.runner_labels // []) | join(\", \")) + \")\", (if ((.value.explained_by // []) | length) > 0 then \"- explained by: \" + ((.value.explained_by | map(.name) | join(\", \"))) else \"- no test explained it\" end), \"\"' $P/history.json
        fi
      } > $P/flakeradar.md
    fi
    if [ ! -s $P/flakeradar.md ]; then
      rm -f $P/flakeradar.md
      echo 'claim: FlakeRadar answered, but nothing could be rendered from it; the diagnosis runs on the issue and the code alone' >&2
    else
      echo 'claim: FlakeRadar record for '$ENT'/'$ID' written to flakeradar.md' >&2
    fi
  fi
fi
echo '{\"context_updates\":{\"flaky_go\":true}}'"]

    stop [label="Leave the issue alone", shape=parallelogram, output_schema="routing", timeout="1m",
        script="echo 'flaky-investigation: the run stops without writing anything to GitHub.' >&2
echo '{\"context_updates\":{\"flaky_stop\":true}}'"]

    // ---- The checkout at main, and the code index the diagnosis reads ----
    //
    // `issue-precheck`'s `prep`, byte for byte apart from the two recorded replacements
    // (R10_CALIBRATION_COPIES): the code index and the agent guide are what let the model
    // answer a code question in one call, and `main_sha` records which tree it read. An index
    // that cannot be built costs `investigate` its fast tools, not the run.
    prep [label="Index the checkout", shape=parallelogram, output_schema="routing", timeout="15m",
        script="set -e
git rev-parse HEAD > /tmp/fabro/flaky/main_sha
grep -qx '.codegraph/' .git/info/exclude 2>/dev/null || echo '.codegraph/' >> .git/info/exclude
if command -v fabro-code >/dev/null; then fabro-code index >/dev/null 2>&1 || echo 'prep: fabro-code index failed; investigate runs without the index' >&2; fabro-code map >/dev/null 2>&1 || true; else echo 'prep: fabro-code is not in the image' >&2; fi
if [ -z \"$FABRO_AGENT_GUIDE\" ]; then echo 'agent guide: FABRO_AGENT_GUIDE is empty, nothing installed' >&2
elif git ls-files --error-unmatch .codex/instructions.md >/dev/null 2>&1; then echo 'agent guide: the repository tracks .codex/instructions.md, left alone' >&2
elif mkdir -p .codex && printf '%s' \"$FABRO_AGENT_GUIDE\" > .codex/instructions.md; then grep -qx '.codex/instructions.md' .git/info/exclude 2>/dev/null || echo '.codex/instructions.md' >> .git/info/exclude
else echo 'agent guide: could not write .codex/instructions.md' >&2; fi
echo '{\"context_updates\":{\"prep_ok\":true}}'"]

    // The box's one agent stage. Bounded at 12m; the prompt asks for about twenty-five tool
    // calls (the model has no clock), and the scheduler's `typical_box_minutes` for the whole
    // run is 8.
    investigate [label="Diagnose the failure", class="bg", timeout="12m", prompt="@prompts/investigate.md.j2"]

    // Checks the Input receipt, requires a cause the package knows, and drops every cited
    // `file:line` that is not in the checkout -- a wrong pointer costs the coder more than a
    // missing one, and a citation that does not exist is the model guessing. With no evidence
    // left there is no diagnosis worth posting, so the node fails and nothing is written. It
    // renders the comment and holds it to 2,360 characters, which with the marker and the
    // footer keeps the whole thing inside C9's 2,500.
    gate [label="Check the diagnosis", shape=parallelogram, output_schema="routing", timeout="2m",
        script="F=/tmp/fabro/flaky.json
P=/tmp/fabro/flaky
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then
  echo 'flaky.json has no valid Input receipt, so investigate did not finish; nothing is posted' >&2
  exit 1
fi
CAUSE=$(jq -r '.cause // empty' $F)
case \"$CAUSE\" in
  timing | ordering | shared-state | resource | network | environment | test-data | other) ;;
  *) echo 'flaky.json carries no cause this package knows' >&2; exit 1 ;;
esac
: > $P/found
jq -r '[(.evidence // [])[].where, (.fix // [])[].where] | unique | .[] | select(. != \"flakeradar\" and . != \"issue\" and . != \"test\")' $F | while IFS= read -r W; do
  case \"$W\" in /* | *..*) continue ;; esac
  FILE_=${W%%:*}
  LINE_=${W##*:}
  [ \"$LINE_\" = \"$W\" ] && LINE_=''
  [ -e \"$FILE_\" ] || continue
  if [ -n \"$LINE_\" ]; then
    case \"$LINE_\" in *[!0-9]*) continue ;; esac
    [ \"$(wc -l < \"$FILE_\")\" -ge \"$LINE_\" ] || continue
  fi
  echo \"$W\" >> $P/found
done
jq -R . $P/found | jq -s . > $P/found.json
if ! jq --slurpfile ok $P/found.json '$ok[0] as $k | .evidence = [(.evidence // [])[] | select((.where == \"flakeradar\") or (.where == \"issue\") or (.where as $w | any($k[]; . == $w)))] | .fix = [(.fix // [])[] | select((.where == \"test\") or (.where as $w | any($k[]; . == $w)))]' $F > $P/kept.json; then
  echo 'could not read flaky.json' >&2
  exit 1
fi
DROPPED=$(( $(jq '((.evidence // []) | length) + ((.fix // []) | length)' $F) - $(jq '(.evidence | length) + (.fix | length)' $P/kept.json) ))
echo \"$DROPPED\" > $P/dropped
if [ \"$(jq '.evidence | length' $P/kept.json)\" -eq 0 ]; then
  echo 'not one cited file:line exists in the checkout; a diagnosis with no evidence is not posted' >&2
  exit 1
fi
echo \"$CAUSE\" > $P/cause
{
  echo '**Flaky investigation.** A local model read what FlakeRadar holds for this failure and the code at `main`. It did not run the test: reproducing it needs the repository test environment, which does not fit the gap this run happens in.'
  echo
  jq -r '\"- cause `\" + .cause + \"`, confidence `\" + .confidence + \"`\"' $P/kept.json
  echo
  jq -r '.summary // \"\"' $P/kept.json
  echo
  echo '**Evidence**'
  echo
  jq -r '.evidence[] | \"- `\" + .where + \"`: \" + .says' $P/kept.json
  if [ \"$(jq '(.fix // []) | length' $P/kept.json)\" -gt 0 ]; then
    echo
    echo '**Proposed fix** (a proposal: this run changes nothing)'
    echo
    jq -r '.fix[] | \"- `\" + .where + \"`: \" + .change' $P/kept.json
  fi
} > $P/comment.md
SIZE=$(wc -c < $P/comment.md)
LIMIT=2360
if [ \"$SIZE\" -gt \"$LIMIT\" ]; then
  { head -c \"$LIMIT\" $P/comment.md | sed '$d'; echo '- (cut to fit: the run that takes this issue reads 2,500 characters of this note)'; } > $P/comment.cut
  mv $P/comment.cut $P/comment.md
  SIZE=$(wc -c < $P/comment.md)
fi
echo 'gate: cause '$CAUSE', '$SIZE' characters, '$DROPPED' pointer(s) dropped'
echo '{\"context_updates\":{\"flaky_ok\":true}}'"]

    // ---- The one node that writes to GitHub (D9, C6) ----
    //
    // It posts the issue's flaky-investigation marker comment, or edits the existing one in
    // place. The body carries the model's text, and two of the repositories are public, so the
    // values of `FABRO_API_TOKEN`, `GITHUB_TOKEN` and `GH_TOKEN` are replaced before anything
    // is posted (a literal match, as `issue-precheck`'s `post` does it). The marker's `at=` is
    // what `claim` compares with the issue's last edit, so it is written with the marker.
    post [label="Post the diagnosis", shape=parallelogram, output_schema="routing", timeout="5m",
        script="exec 3>&1 >>/tmp/fabro/flaky/post.log 2>&1
P=/tmp/fabro/flaky
N=$(cat $P/issue_number)
R=$(cat $P/repo)
CAUSE=$(cat $P/cause)
ID=$(cat $P/entity_id 2>/dev/null || true)
[ -n \"$ID\" ] || ID=unknown
AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
RUN=$(cat $P/run_id 2>/dev/null || true)
[ -n \"$RUN\" ] || RUN=unknown
BODY=$P/comment.full
FOOT='_From FlakeRadar records and the code at `main`, not a reproduction: this run did not execute the test._'
echo \"<!-- fabro:flaky-investigation test=$ID cause=$CAUSE at=$AT run=$RUN -->\" > $P/comment.head
{
  cat $P/comment.head
  echo
  cat $P/comment.md
  echo
  echo \"$FOOT\"
} | awk -v t1=\"${FABRO_API_TOKEN:-}\" -v t2=\"${GITHUB_TOKEN:-}\" -v t3=\"${GH_TOKEN:-}\" 'function scrub(line, t,  out, i) { if (length(t) < 8) return line; out = \"\"; while ((i = index(line, t)) > 0) { out = out substr(line, 1, i - 1) \"[redacted]\"; line = substr(line, i + length(t)) } return out line } { $0 = scrub($0, t1); $0 = scrub($0, t2); $0 = scrub($0, t3); print }' > $BODY
SIZE=$(wc -c < $BODY)
if [ \"$SIZE\" -gt 2500 ]; then
  { head -c 2500 $BODY | sed '$d'; echo '- (cut to fit)'; } > $BODY.cut
  mv $BODY.cut $BODY
fi
if [ ! -s $BODY ]; then echo 'could not build the marker comment' >&2; exit 1; fi
OLD=$(gh api \"repos/$R/issues/$N/comments?per_page=100\" --paginate 2>/dev/null | jq -s 'add // []' | jq -r '[(.[] | select((.body // \"\") | startswith(\"<!-- fabro:flaky-investigation \"))) | .id] | last // \"\"')
if [ -n \"$OLD\" ]; then
  if ! jq -n --rawfile b $BODY '{body: $b}' | gh api -X PATCH \"repos/$R/issues/comments/$OLD\" --input - >/dev/null; then
    echo 'could not edit the existing flaky-investigation comment' >&2
    exit 1
  fi
else
  if ! gh issue comment \"$N\" --body-file $BODY >/dev/null; then
    echo 'could not post the flaky-investigation comment' >&2
    exit 1
  fi
fi
echo 'post: flaky investigation on issue '$N
echo '{\"context_updates\":{\"posted\":true}}' >&3
exit 0"]

    start -> claim
    claim -> prep [condition="outcome=succeeded && context.flaky_go=true"]
    claim -> stop [condition="outcome=succeeded && context.flaky_go=false"]
    claim -> exit
    prep -> investigate [condition="outcome=succeeded && context.prep_ok=true"]
    prep -> exit
    investigate -> gate
    gate -> post [condition="outcome=succeeded"]
    gate -> exit
    post -> exit
    stop -> exit
}
