// issue-precheck (more-local-inference task 07): a local model reads one queued issue and the
// code at `main`, before the factory spends hosted credits on it, and says whether it is worth
// running.
//
// It is a **background package** (D4, R16): every agent stage resolves to the run's `-bg`
// model row, `box-guard` protects the box, and nothing here takes a box-claim. The scheduler
// starts it in a coder loop's gap and may cancel it at any moment before `post` (D9).
//
// **Shadow mode (operator decision, 2026-10-30).** The verdict is posted as the issue's one
// precheck marker comment and recorded on the scheduler's job row, and that is all: the
// scheduler does not hold, label or reorder anything on it yet. Each verdict is compared with
// how the issue's run actually ended (`close_noop`, `return_to_triage`, `mark_stuck`, merged)
// before any verdict is allowed to keep an issue out of the queue (task 07's D20 holds).
//
// **Nothing writes to GitHub before `post`**, and `post` writes only the marker comment, so a
// cancel anywhere before it leaves nothing behind and the job is simply queued again.
//
// A failed node takes its unconditional edge to `exit`, which ends the run failed, so the lane
// records it as a failure rather than a verdict. `stop` is the one quiet ending: an issue that
// is no longer open, or whose current text already has a precheck, gets nothing.
digraph IssuePrecheck {
    graph [
        goal="Read one queued issue and the code at main, and say whether the factory should run it; record the verdict in one marker comment",
        // Above every node timeout below (`check`'s 20m included): R2 compares them, and the
        // watchdog must never fire before a node's own timeout does.
        stall_timeout="30m",
        // Bound the preamble: the prompt names its inputs by path (invariants-graph, the
        // `default_fidelity` row).
        default_fidelity="truncate",
        // Every model in a background package is the run's `-bg` pool (R16): the `*` rule and
        // `.bg` are the same expression, so an agent node that lost its class would still run
        // on the box and never reach a hosted model. There is no `[run.model.fallbacks]` row for
        // either `-bg` name, so a box error fails the stage instead of spending credits (R14).
        model_stylesheet="
            *   { model: {{ inputs.coder_pool | default('coders-a-bg') }}; reasoning_effort: medium; }
            .bg { model: {{ inputs.coder_pool | default('coders-a-bg') }}; reasoning_effort: medium; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // ---- Read the issue, decide whether to check it, and stage the inputs ----
    //
    // `issue_number` arrives from the scheduler's producer. It is interpolated exactly once, in
    // single quotes, so a non-numeric value reaches the `case` guard as data rather than as
    // shell syntax. `/tmp/fabro/box` is this package's half of C2/R16: the pool arrives with
    // the `-bg` suffix the scheduler added, and `box-guard` looks up the loop's box, which
    // never carries it.
    //
    // `body=` is C6's hash: the first 12 hex characters of the SHA-256 of the title, a
    // newline, and the body. A precheck marker that already carries this hash means this
    // exact text was checked, so the run stops without writing.
    //
    // `issue.md` is what the check reads: the issue, its labels, and its last ten comments
    // that are not fabro markers. `open_issues.json` is the repository's open issues, which
    // `gate` uses to test a `blocked` verdict's blocker.
    claim [label="Read the issue", shape=parallelogram, output_schema="routing", timeout="5m",
        script="set -e
P=/tmp/fabro/precheck
mkdir -p $P
POOL='{{ inputs.coder_pool }}'
echo \"${POOL%-bg}\" > /tmp/fabro/box || true
N='{{ inputs.issue_number }}'
case \"$N\" in '' | *[!0-9]*) echo 'issue_number must be a positive integer' >&2; exit 1;; esac
if [ \"$N\" -lt 1 ]; then echo 'issue_number must be a positive integer' >&2; exit 1; fi
rm -f /tmp/fabro/precheck.json $P/verdict $P/raw_verdict $P/rule $P/run_id $P/main_sha $P/body_hash $P/issue.md $P/open_issues.md
echo \"$N\" > $P/issue_number
if ! gh issue view \"$N\" --json number,title,body,state,url,labels > $P/issue.json; then
  echo 'Could not read issue '$N' from GitHub.' >&2
  exit 1
fi
R=$(jq -r '(.url // \"\") | split(\"/\") | .[3] + \"/\" + .[4]' $P/issue.json)
echo \"$R\" > $P/repo
if ! gh api \"repos/$R/issues/$N/comments?per_page=100\" --paginate > $P/comments.raw; then
  echo 'Could not read the comments on issue '$N'.' >&2
  exit 1
fi
jq -s 'add // []' $P/comments.raw > $P/comments.json
if command -v sha256sum >/dev/null; then SUM=sha256sum; else SUM='shasum -a 256'; fi
{ jq -j '.title // \"\"' $P/issue.json; echo; jq -j '.body // \"\"' $P/issue.json; } | $SUM | cut -c1-12 > $P/body_hash
HASH=$(cat $P/body_hash)
GO=true
WHY=eligible
S=$(jq -r .state $P/issue.json)
case \"$S\" in OPEN) ;; *) GO=false; WHY='the issue is '$S', not OPEN' ;; esac
if jq -e --arg h \"body=$HASH \" '[.[] | (.body // \"\") | select(startswith(\"<!-- fabro:precheck \"))] | (last // \"\") | contains($h)' $P/comments.json >/dev/null; then
  GO=false
  WHY='this text of the issue already has a precheck (body='$HASH')'
fi
if [ \"$GO\" != true ]; then
  echo 'issue-precheck: not checking issue '$N': '$WHY >&2
  echo '{\"context_updates\":{\"precheck_go\":false}}'
  exit 0
fi
if ! gh issue list --state open --limit 300 --json number,title > $P/open_issues.json; then
  echo 'Could not list the open issues.' >&2
  exit 1
fi
{
  echo '# #'$N': '\"$(jq -r '.title // \"\"' $P/issue.json)\"
  echo
  echo 'Labels: '\"$(jq -r '[(.labels // [])[].name] | join(\", \")' $P/issue.json)\"
  echo
  jq -r '.body // \"\"' $P/issue.json
  echo
  echo '## Comments, oldest first (the last ten; fabro marker comments left out)'
  echo
  jq -r '[.[] | select((.body // \"\") | startswith(\"<!-- fabro:\") | not)] | .[-10:] | .[] | (\"### \" + (.user.login // \"?\") + \" at \" + (.created_at // \"?\")), \"\", ((.body // \"\") | .[0:2000]), \"\"' $P/comments.json
} > $P/issue.md
jq -r --argjson n \"$N\" '.[] | select(.number != $n) | \"#\" + (.number | tostring) + \" \" + (.title // \"\")' $P/open_issues.json > $P/open_issues.md
echo '{\"context_updates\":{\"precheck_go\":true}}'"]

    stop [label="Leave the issue alone", shape=parallelogram, output_schema="routing", timeout="1m",
        script="echo 'issue-precheck: the run stops without writing anything to GitHub.' >&2
echo '{\"context_updates\":{\"precheck_stop\":true}}'"]

    // ---- The checkout at main, and the code index the check's tools read ----
    //
    // The sandbox clones the target repository at `main`, so HEAD is the commit the verdict is
    // about; the marker records it as `main=`. The code index and the agent guide are
    // installed exactly as pr-review's `claim` does it: the guide promises the `code_*` tools,
    // which answer nothing without an index. Both paths go in `.git/info/exclude`. An index
    // that cannot be built costs the check its fast tools, not the run.
    prep [label="Index the checkout", shape=parallelogram, output_schema="routing", timeout="15m",
        script="set -e
git rev-parse HEAD > /tmp/fabro/precheck/main_sha
grep -qx '.codegraph/' .git/info/exclude 2>/dev/null || echo '.codegraph/' >> .git/info/exclude
if command -v fabro-code >/dev/null; then fabro-code index >/dev/null 2>&1 || echo 'prep: fabro-code index failed; the check runs without the index' >&2; fabro-code map >/dev/null 2>&1 || true; else echo 'prep: fabro-code is not in the image' >&2; fi
if [ -z \"$FABRO_AGENT_GUIDE\" ]; then echo 'agent guide: FABRO_AGENT_GUIDE is empty, nothing installed' >&2
elif git ls-files --error-unmatch .codex/instructions.md >/dev/null 2>&1; then echo 'agent guide: the repository tracks .codex/instructions.md, left alone' >&2
elif mkdir -p .codex && printf '%s' \"$FABRO_AGENT_GUIDE\" > .codex/instructions.md; then grep -qx '.codex/instructions.md' .git/info/exclude 2>/dev/null || echo '.codex/instructions.md' >> .git/info/exclude
else echo 'agent guide: could not write .codex/instructions.md' >&2; fi
echo '{\"context_updates\":{\"prep_ok\":true}}'"]

    // The box's one agent stage. Bounded at 20m and told when it is done; the scheduler's
    // `typical_box_minutes` for the whole run is 10.
    check [label="Check the issue against main", class="bg", timeout="20m", prompt="@prompts/check.md.j2"]

    // Checks the Input receipt and applies task 07's two rules. A missing receipt (a failed,
    // timed-out or unsubmitted turn) fails the node, so the run ends failed and nothing is
    // posted. The model's own verdict is kept as `raw_verdict`, so the marker can say when a
    // rule overrode it.
    gate [label="Check the verdict", shape=parallelogram, output_schema="routing", timeout="2m",
        script="F=/tmp/fabro/precheck.json
P=/tmp/fabro/precheck
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then
  echo 'precheck.json has no valid Input receipt, so the check did not finish; nothing is posted' >&2
  exit 1
fi
RAW=$(jq -r '.verdict // empty' $F)
case \"$RAW\" in ready | already_done | blocked | contradiction | unclear) ;; *) echo 'precheck.json carries no known verdict' >&2; exit 1;; esac
VERDICT=$RAW
RULE=''
if [ \"$VERDICT\" != ready ] && [ \"$(jq '(.evidence // []) | length' $F)\" -eq 0 ]; then
  VERDICT=ready
  RULE='it cited no evidence'
fi
if [ \"$VERDICT\" = blocked ]; then
  B=$(jq -r '.blocker // empty' $F)
  N=$(cat $P/issue_number)
  case \"$B\" in '' | *[!0-9]*) B=0 ;; esac
  if [ \"$B\" = \"$N\" ] || ! jq -e --argjson b \"$B\" 'any(.[]; .number == $b)' $P/open_issues.json >/dev/null 2>&1; then
    VERDICT=ready
    RULE='its blocker #'$B' is not another open issue in this repository'
  fi
fi
echo \"$RAW\" > $P/raw_verdict
echo \"$VERDICT\" > $P/verdict
printf '%s' \"$RULE\" > $P/rule
echo 'gate: verdict '$VERDICT
echo '{\"context_updates\":{\"verdict\":\"'$VERDICT'\"}}'"]

    // ---- The one node that writes to GitHub (D9, C6) ----
    //
    // It posts the issue's precheck marker comment, or edits the existing one in place. The
    // body is capped at 1,500 characters, the size C9 gives a precheck in `background.md`, by
    // cutting the model's text at a whole line so the shadow-mode footer always survives. It
    // carries the model's text verbatim, and two of the repositories are public, so the values
    // of `FABRO_API_TOKEN`, `GITHUB_TOKEN` and `GH_TOKEN` are replaced before anything is
    // posted (a literal match, as pr-doctor's `publish` does it).
    post [label="Post the verdict", shape=parallelogram, output_schema="routing", timeout="5m",
        script="exec 3>&1 >>/tmp/fabro/precheck/post.log 2>&1
P=/tmp/fabro/precheck
N=$(cat $P/issue_number)
R=$(cat $P/repo)
V=$(cat $P/verdict)
RAW=$(cat $P/raw_verdict)
RULE=$(cat $P/rule 2>/dev/null || true)
HASH=$(cat $P/body_hash)
MAIN=$(cat $P/main_sha 2>/dev/null || true)
[ -n \"$MAIN\" ] || MAIN=unknown
AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
RUN=$(cat $P/run_id 2>/dev/null || true)
[ -n \"$RUN\" ] || RUN=unknown
BODY=$P/comment.md
echo \"<!-- fabro:precheck verdict=$V body=$HASH main=$MAIN at=$AT run=$RUN -->\" > $P/comment.head
{
  echo
  case \"$V\" in
    ready) echo '**Precheck: ready.** A local model read this issue and the code at `main` and found nothing against running it.' ;;
    already_done) echo '**Precheck: already done?** A local model read this issue and the code at `main`, and thinks the code already does what it asks.' ;;
    blocked) echo '**Precheck: blocked?** A local model read this issue and thinks it needs #'\"$(jq -r '.blocker // \"?\"' /tmp/fabro/precheck.json)\"' first.' ;;
    contradiction) echo '**Precheck: contradiction?** A local model read this issue and thinks an acceptance criterion needs something a non-goal excludes.' ;;
    unclear) echo '**Precheck: unclear?** A local model read this issue and could not find an acceptance criterion it could check.' ;;
  esac
  echo
  jq -r '.summary // \"\"' /tmp/fabro/precheck.json
  if [ \"$(jq '(.evidence // []) | length' /tmp/fabro/precheck.json)\" -gt 0 ]; then
    echo
    jq -r '.evidence[] | \"- `\" + .where + \"`: \" + .says' /tmp/fabro/precheck.json
  fi
  if [ -n \"$RULE\" ]; then
    echo
    echo 'The model said `'$RAW'`, but '\"$RULE\"', so this counts as `ready`.'
  fi
} | awk -v t1=\"${FABRO_API_TOKEN:-}\" -v t2=\"${GITHUB_TOKEN:-}\" -v t3=\"${GH_TOKEN:-}\" 'function scrub(line, t,  out, i) { if (length(t) < 8) return line; out = \"\"; while ((i = index(line, t)) > 0) { out = out substr(line, 1, i - 1) \"[redacted]\"; line = substr(line, i + length(t)) } return out line } { $0 = scrub($0, t1); $0 = scrub($0, t2); $0 = scrub($0, t3); print }' > $P/comment.tail
FOOT='_Shadow mode: this note does not change the queue. The factory is measuring how often these verdicts are right before it acts on them._'
LIMIT=$((1500 - $(wc -c < $P/comment.head) - ${#FOOT} - 20))
TAIL=$(($(wc -c < $P/comment.tail)))
if [ \"$TAIL\" -gt \"$LIMIT\" ]; then
  { head -c \"$LIMIT\" $P/comment.tail | sed '$d'; echo '- (cut to fit)'; } > $P/comment.cut
else
  cp $P/comment.tail $P/comment.cut
fi
{ cat $P/comment.head $P/comment.cut; echo; echo \"$FOOT\"; } > $BODY
if [ ! -s $BODY ]; then echo 'could not build the marker comment' >&2; exit 1; fi
ID=$(gh api \"repos/$R/issues/$N/comments?per_page=100\" --paginate 2>/dev/null | jq -s 'add // []' | jq -r '[(.[] | select((.body // \"\") | startswith(\"<!-- fabro:precheck \"))) | .id] | last // \"\"')
if [ -n \"$ID\" ]; then
  if ! jq -n --rawfile b $BODY '{body: $b}' | gh api -X PATCH \"repos/$R/issues/comments/$ID\" --input - >/dev/null; then
    echo 'could not edit the existing precheck comment' >&2
    exit 1
  fi
else
  if ! gh issue comment \"$N\" --body-file $BODY >/dev/null; then
    echo 'could not post the precheck comment' >&2
    exit 1
  fi
fi
echo 'post: verdict '$V' on issue '$N
echo '{\"context_updates\":{\"posted\":true}}' >&3
exit 0"]

    start -> claim
    claim -> prep [condition="outcome=succeeded && context.precheck_go=true"]
    claim -> stop [condition="outcome=succeeded && context.precheck_go=false"]
    claim -> exit
    prep -> check [condition="outcome=succeeded && context.prep_ok=true"]
    prep -> exit
    check -> gate
    gate -> post [condition="outcome=succeeded"]
    gate -> exit
    post -> exit
    stop -> exit
}
