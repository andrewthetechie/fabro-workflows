digraph Triage {
    // Shared triage phase. IMPORTED, never run on its own.
    //
    // `issue-triage` imports it once and `arch-review` imports it inside a loop, both as
    // `triage_phase [import="../_shared/triage/triage.fabro"]`. Node ids arrive
    // prefixed (`triage_phase.post_questions`), so hook matchers are written
    // `(^|[.])post_questions$`.
    //
    // ## Entry contract (the importing graph MUST do both)
    //
    //   /tmp/fabro/                  exists
    //   /tmp/fabro/issue_number      the issue to triage, digits only
    //
    // ## Exit contract
    //
    //   /tmp/fabro/triage_outcome and context.triage_outcome =
    //     ready | split | needs_info | not_actionable | skipped | released
    //
    // There is no human gate (ADR 0012 D3). Questions go on the issue as a comment, the
    // issue gets `needs-info`, and the `(^|[.])post_questions$` stage_start hook sends
    // one Discord message. A human answers in a new comment, and the next triage of the
    // issue reads that comment from issue.json.
    //
    // The phase can run many times in one run. A context key from the previous issue is
    // still set when this one starts, so every conditional edge also tests
    // `outcome=succeeded`, and `claim` resets `triage_readiness`.

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // Claims, fetches, archives the reporter's original body once, and resets every
    // per-issue file. A claim held by another run is respected for 24 hours, measured
    // from the newest `labeled` event for `triage-in-progress`; after that it is
    // abandoned and taken over (ADR 0012 D6). An unreadable event list counts as a
    // fresh claim, because skipping changes nothing on the issue.
    // issue.json is fetched to a temporary file and moved, because `>` truncates first.
    claim [label="Claim issue and fetch it", shape=parallelogram, output_schema="routing",
        script="set -e
mkdir -p /tmp/fabro
N=$(cat /tmp/fabro/issue_number)
rm -f /tmp/fabro/triage_outcome /tmp/fabro/issue.json /tmp/fabro/improve.json /tmp/fabro/triage.json /tmp/fabro/triage.md /tmp/fabro/plan.json /tmp/fabro/plan_ok /tmp/fabro/task_map.md /tmp/fabro/split_children.json
echo 0 > /tmp/fabro/improve_attempts
echo 0 > /tmp/fabro/triage_attempts
echo 0 > /tmp/fabro/plan_attempts
gh issue view $N --json number,title,body,labels,comments,url > /tmp/fabro/issue.next.json
mv /tmp/fabro/issue.next.json /tmp/fabro/issue.json
U=$(jq -r .url /tmp/fabro/issue.json)
if jq -e '[.labels[].name] | index(\"triage-in-progress\") != null' /tmp/fabro/issue.json > /dev/null; then
  L=$(gh api \"repos/{owner}/{repo}/issues/$N/events\" --paginate 2>/dev/null | jq -s '[add[]? | select(.event == \"labeled\" and .label.name == \"triage-in-progress\") | .created_at | fromdateiso8601] | max // empty' 2>/dev/null || true)
  case \"$L\" in
    '' | *[!0-9]*) S=skipped ;;
    *) if [ $(( $(date +%s) - $L )) -lt 86400 ]; then S=skipped; else S=stale; fi ;;
  esac
  if [ \"$S\" = skipped ]; then
    echo skipped > /tmp/fabro/triage_outcome
    jq -nc --arg n \"$N\" --arg u \"$U\" '{context_updates:{issue_number:$n,issue_url:$u,claim_state:\"skipped\",triage_readiness:\"none\",plan_status:\"none\"}}'
    exit 0
  fi
fi
gh label create needs-info --color FEF2C0 --description 'Waiting on a human for triage answers' 2>/dev/null || true
gh label create triage-in-progress --color FBCA04 --description 'Owned by the fabro issue-triage loop' 2>/dev/null || true
gh label create agent --color 5319E7 --description 'Handled by fabro backlog automation' 2>/dev/null || true
gh issue edit $N --add-label triage-in-progress
if ! jq -e '[.comments[].body] | any(test(\"fabro:triage-original\"))' /tmp/fabro/issue.json > /dev/null; then
  { echo '<!-- fabro:triage-original -->'
    echo 'Original report, captured before automated improvement.'
    echo
    jq -r .body /tmp/fabro/issue.json ; } > /tmp/fabro/original.md
  gh issue comment $N --body-file /tmp/fabro/original.md
fi
jq -nc --arg n \"$N\" --arg u \"$U\" '{context_updates:{issue_number:$n,issue_url:$u,claim_state:\"claimed\",triage_readiness:\"none\",plan_status:\"none\"}}'"]

    // ---- Improve ----
    // `max_retries=1`: a stalled provider stream is invisible to the LLM retry and the
    // fallback chain, so the node timeout is the only backstop.
    improve [label="Improve the issue body", class="improve", prompt="@prompts/improve.md.j2", timeout="30m", max_retries=1]

    // Applies the body only. A second invalid improve.json exits ZERO on purpose and
    // takes the succeeded edge to `triage`: improving the body is best effort, the
    // triage verdict is the value.
    // The body is written over the issue verbatim, so the gate restores an
    // Architecture issue's first-line slug marker (contract C2) when the agent dropped
    // or moved it: deduplication reads only that marker, and without it the next review
    // files the same candidate again.
    improve_gate [label="Validate and apply the improved body", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/improve.json
A=$(cat /tmp/fabro/improve_attempts 2>/dev/null || echo 0)
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
RM=0; if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then RM=1; S=invalid; else S=$(jq -r '.status // \"invalid\"' $F 2>/dev/null || echo invalid); fi
N=$(jq -r .number /tmp/fabro/issue.json)
if [ \"$S\" != improved ] && [ \"$S\" != unchanged ]; then S=invalid; fi
if [ \"$S\" = improved ]; then
  B=$(jq -r '.body // \"\"' $F 2>/dev/null || echo '')
  if [ -z \"$B\" ]; then S=invalid; fi
fi
if [ \"$S\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/improve_attempts
  if [ $A -lt 2 ]; then if [ $RM = 1 ]; then echo 'no valid Input receipt: write the result with the submit tool, not write_file' >&2; else echo 'improve.json is missing or invalid; rewrite it exactly per the contract' >&2; fi; exit 1; fi
  jq -nc '{context_updates:{improve_status:\"invalid\"}}'
  exit 0
fi
echo 0 > /tmp/fabro/improve_attempts
if [ \"$S\" = improved ]; then
  jq -r .body $F > /tmp/fabro/improved_body.md
  MK=$(jq -r '.body // \"\"' /tmp/fabro/issue.json | head -1 | grep -E '^<!-- fabro:arch-candidate slug=[a-z0-9-]+ -->$' || true)
  if [ -n \"$MK\" ] && [ \"$(head -1 /tmp/fabro/improved_body.md)\" != \"$MK\" ]; then
    { echo \"$MK\"; echo; grep -vF \"$MK\" /tmp/fabro/improved_body.md; } > /tmp/fabro/improved_body.next
    mv /tmp/fabro/improved_body.next /tmp/fabro/improved_body.md
  fi
  gh issue edit $N --body-file /tmp/fabro/improved_body.md
  gh issue view $N --json number,title,body,labels,comments,url > /tmp/fabro/issue.next.json && mv /tmp/fabro/issue.next.json /tmp/fabro/issue.json
fi
jq -nc --arg s \"$S\" '{context_updates:{improve_status:$s}}'"]

    // ---- Triage ----
    triage [label="Triage the issue", class="triage", prompt="@prompts/triage.md.j2", timeout="30m", max_retries=1]

    // Validates readiness, the Conventional Commits title, the label shapes and the
    // artifact, then publishes the questions so the Discord hook can carry them. `"` is
    // stripped from the questions because the hook reads them with a grep that stops
    // at the first quote.
    triage_gate [label="Validate the triage", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/triage.json
A=$(cat /tmp/fabro/triage_attempts 2>/dev/null || echo 0)
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
RM=0; if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then RM=1; R=invalid; else R=$(jq -r '.readiness // \"invalid\"' $F 2>/dev/null || echo invalid); fi
case \"$R\" in ready|needs_info|not_actionable) ;; *) R=invalid ;; esac
T=$(jq -r '.title // \"\"' $F 2>/dev/null || echo '')
if ! echo \"$T\" | grep -Eq '^(feat|fix|docs|chore|refactor|test|ci|build|perf|revert)([(][a-z0-9 ./_-]+[)])?: .+'; then R=invalid; fi
if echo \"$T\" | grep -Eq '^[a-z]+([(][^)]*[)])?!'; then R=invalid; fi
if echo \"$T\" | grep -q 'BREAKING CHANGE'; then R=invalid; fi
if [ ! -s /tmp/fabro/triage.md ]; then R=invalid; fi
BAD=$(jq '[.labels[]? | select(test(\"^[a-z0-9:._-]+$\") | not)] | length' $F 2>/dev/null || echo 99)
if [ \"$BAD\" != 0 ]; then R=invalid; fi
Q=$(jq '.questions | length' $F 2>/dev/null || echo 0)
if [ \"$R\" = needs_info ] && [ \"$Q\" = 0 ]; then R=invalid; fi
if [ \"$R\" = ready ] && [ \"$Q\" != 0 ]; then R=invalid; fi
if [ \"$R\" = not_actionable ] && [ \"$Q\" != 0 ]; then R=invalid; fi
DT=$(jq -r '(.decisions // []) | type' $F 2>/dev/null || echo bad)
if [ \"$DT\" != array ]; then R=invalid; fi
DB=$(jq '[(.decisions // [])[]? | select(((.question // \"\") | tostring) == \"\" or ((.decision // \"\") | tostring) == \"\")] | length' $F 2>/dev/null || echo 99)
if [ \"$DB\" != 0 ]; then R=invalid; fi
if ! jq -e '[.labels[].name] | index(\"architecture\") != null' /tmp/fabro/issue.json > /dev/null 2>&1; then
  NB=$(jq '[(.decisions // [])[]? | select(((.basis // \"\") | tostring) == \"\")] | length' $F 2>/dev/null || echo 99)
  if [ \"$NB\" != 0 ]; then R=invalid; fi
fi
if [ \"$R\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/triage_attempts
  if [ $A -lt 2 ]; then if [ $RM = 1 ]; then echo 'no valid Input receipt: write the result with the submit tool, not write_file' >&2; else echo 'triage.json or triage.md is missing or invalid; rewrite both exactly per the contract' >&2; fi; exit 1; fi
fi
echo 0 > /tmp/fabro/triage_attempts
QT=$(jq -r '[.questions[]? | \"- \" + (.question // \"\") + (if (.recommended // \"\") == \"\" then \"\" else \"  (suggested: \" + .recommended + \")\" end)] | join(\"  \")' $F 2>/dev/null | tr -d '\"' | cut -c1-1200)
jq -nc --arg r \"$R\" --arg q \"$Q\" --arg qt \"$QT\" '{context_updates:{triage_readiness:$r,question_count:$q,triage_questions:$qt}}'"]

    // ---- Plan: the task map and split (ADR 0015) ----
    // Drafts the task map for a ready issue, and proposes a split into up to
    // three ordered children when the map is large (C1). Fail-open: a dead plan
    // agent routes straight to apply_ready with no map (ADR 0015 D1).
    plan [label="Draft the task map", class="plan", prompt="@prompts/plan.md.j2", timeout="30m", max_retries=1]

    // Implements C1 and C4. Publishes plan_status (map|split|too_large|none) and
    // task_count. On map/split it writes plan_ok and renders task_map.md (C2), the
    // newline via `([10]|implode)`, because the newline escape is not allowed in a .fabro
    // file; on split it also writes split_children.json; on too_large it
    // rewrites triage.json to a needs_info scoping question, appends the too-large
    // map to triage.md, and republishes question_count/triage_questions (triage_gate
    // published an empty list for the ready verdict, and the Discord hook reads them).
    // Rule 3 is C1's: the children partition the tasks (any grouping), and each
    // child lists its own tasks in `tasks` order. One repair turn; a second invalid
    // file is plan_status=none (C1 rule 5, fail-open) so apply_ready runs with no map.
    // Its failure line is its own, so the run-wide breaker counts plan_gate apart
    // from the other gates.
    plan_gate [label="Validate and apply the task map", shape=parallelogram, output_schema="routing",
        script="F=/tmp/fabro/plan.json
A=$(cat /tmp/fabro/plan_attempts 2>/dev/null || echo 0)
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
N=$(jq -r '.number // 0' /tmp/fabro/issue.json 2>/dev/null || echo 0)
RM=0
ST=invalid
K=0
if [ -z \"$V\" ] || [ \"$RV\" != \"$V\" ]; then
  RM=1; ST=invalid
else
  K=$(jq '(.tasks // []) | if type==\"array\" then length else 0 end' $F 2>/dev/null || echo 0)
  GOOD=$(jq -r 'if (.tasks|type) != \"array\" then \"no\"
  elif (.tasks|length) == 0 then \"no\"
  elif ([.tasks[] | select(
      ((.id // \"\")|type) != \"string\" or ((.id // \"\")|length)==0
      or ((.title // \"\")|type) != \"string\" or ((.title // \"\")|length)==0
      or ((.intent // \"\")|type) != \"string\" or ((.intent // \"\")|length)==0
      or ((.files // [])|type) != \"array\"
      or ((.covers // [])|type) != \"array\")] | length) > 0 then \"no\"
  elif ([.tasks[].id]|length) != ([.tasks[].id]|unique|length) then \"no\"
  else \"yes\" end' $F 2>/dev/null || echo no)
  if [ \"$GOOD\" != yes ]; then
    ST=invalid
  elif [ \"$K\" -gt 12 ]; then
    ST=too_large
  elif [ \"$K\" -le 4 ]; then
    if [ \"$(jq '(.children // -1) | if type==\"array\" then length else -1 end' $F 2>/dev/null || echo -1)\" = 0 ]; then ST=map; else ST=invalid; fi
  else
    SP=$(jq -r '[.tasks[].id] as $ids
    | ([.children[].tasks[]?]) as $flat
    | ( [.children | to_entries[] | .key as $i | (.value.after) as $af
        | ($af != null) and ( (($af|type) != \"number\") or ($af < 0) or ($af >= $i) or (($af|floor) != $af) ) ] | any ) as $badafter
    | if (.children|type) != \"array\" then \"no\"
      elif (.children|length) < 2 or (.children|length) > 3 then \"no\"
      elif ($flat|length) != ($ids|length) or ($flat|sort) != ($ids|sort) then \"no\"
      elif any(.children[]; ((.tasks|type)!=\"array\") or ((.tasks|length)<1) or ((.tasks|length)>4)) then \"no\"
      elif any(.children[]; [.tasks[] as $x | $ids | index($x)] as $p | $p != ($p|sort)) then \"no\"
      elif any(.children[]; ((.title|type)!=\"string\") or ((.title//\"\")|length)==0
           or ((.summary|type)!=\"string\") or ((.summary//\"\")|length)==0
           or ((.criteria|type)!=\"array\") or ((.criteria|length)<1)
           or any(.criteria[]; (type!=\"string\") or (length==0))
           or ((.title//\"\")|test(\"BREAKING CHANGE\"))) then \"no\"
      elif $badafter then \"no\"
      else \"yes\" end' $F 2>/dev/null || echo no)
    if [ \"$SP\" = yes ]; then ST=split; else ST=invalid; fi
    if [ \"$ST\" = split ]; then
      rm -f /tmp/fabro/plan_title_bad
      jq -r '.children[].title' $F | while read -r T; do
        if ! echo \"$T\" | grep -Eq '^(feat|fix|docs|chore|refactor|test|ci|build|perf|revert)([(][a-z0-9 ./_-]+[)])?: .+'; then : > /tmp/fabro/plan_title_bad; break; fi
        if echo \"$T\" | grep -Eq '^[a-z]+([(][^)]*[)])?!'; then : > /tmp/fabro/plan_title_bad; break; fi
      done
      if [ -f /tmp/fabro/plan_title_bad ]; then rm -f /tmp/fabro/plan_title_bad; ST=invalid; fi
    fi
  fi
fi
if [ \"$ST\" = invalid ]; then
  A=$((A+1))
  echo $A > /tmp/fabro/plan_attempts
  if [ $A -lt 2 ]; then
    if [ $RM = 1 ]; then echo 'no valid Input receipt: write the result with the submit tool, not write_file' >&2
    else echo 'plan.json missing or invalid; rewrite it exactly per the contract' >&2; fi
    exit 1
  fi
  rm -f /tmp/fabro/plan_ok /tmp/fabro/task_map.md /tmp/fabro/split_children.json
  echo 0 > /tmp/fabro/plan_attempts
  jq -nc '{context_updates:{plan_status:\"none\",task_count:0}}'
  exit 0
fi
echo 0 > /tmp/fabro/plan_attempts
SHA=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)
DT=$(date -u +%F)
RENDER='([10]|implode) as $nl |
\"## Proposed task map\" + $nl + $nl + \"Drafted by triage against `main` at `\" + $sha + \"` on \" + $date + \". A hint for the implementer: the checkout wins where they disagree.\" + $nl + $nl +
( [ .tasks | to_entries[] |
    ((.value.covers // []) | join(\", \")) as $cov
    | ((.value.files // []) | map(\"`\" + . + \"`\") | join(\", \")) as $f
    | ((.key + 1) | tostring) as $n
    | $n + \". **\" + .value.title + \"** (`\" + .value.id + \"`): \" + .value.intent + $nl
      + \"   - files: \" + $f + $nl
      + (if $cov == \"\" then \"\" else \"   - covers: \" + $cov + $nl end) ] | join(\"\") )'
if [ \"$ST\" = map ]; then
  : > /tmp/fabro/plan_ok
  jq -r --arg sha \"$SHA\" --arg date \"$DT\" \"$RENDER\" $F > /tmp/fabro/task_map.md
  jq -nc --argjson k \"$K\" '{context_updates:{plan_status:\"map\",task_count:$k}}'
  exit 0
fi
if [ \"$ST\" = split ]; then
  : > /tmp/fabro/plan_ok
  jq -r --arg sha \"$SHA\" --arg date \"$DT\" \"$RENDER\" $F > /tmp/fabro/task_map.md
  CHILD='. as $g
| ([10]|implode) as $nl
| $g.tasks as $all
| $g.children
| to_entries
| map(
    .value as $c
    | ( [ $all[] | . as $t | select( ($c.tasks | index($t.id)) != null ) ] ) as $tasks
    | ( \"## Proposed task map\" + $nl + $nl + \"Drafted by triage against `main` at `\" + $sha + \"` on \" + $date + \". A hint for the implementer: the checkout wins where they disagree.\" + $nl + $nl +
        ( [ $tasks | to_entries[] |
            ((.value.covers // []) | join(\", \")) as $cov
            | ((.value.files // []) | map(\"`\" + . + \"`\") | join(\", \")) as $f
            | ((.key + 1) | tostring) as $n
            | $n + \". **\" + .value.title + \"** (`\" + .value.id + \"`): \" + .value.intent + $nl
              + \"   - files: \" + $f + $nl
              + (if $cov == \"\" then \"\" else \"   - covers: \" + $cov + $nl end) ] | join(\"\") )
      ) as $tm
    | { title: $c.title, summary: $c.summary, criteria: $c.criteria, after: $c.after, tasks: $tasks, task_map: $tm }
  )'
  jq -c --arg sha \"$SHA\" --arg date \"$DT\" \"$CHILD\" $F > /tmp/fabro/split_children.json
  jq -nc --argjson k \"$K\" '{context_updates:{plan_status:\"split\",task_count:$k}}'
  exit 0
fi
if [ \"$ST\" = too_large ]; then
  jq '.readiness=\"needs_info\" | .questions=[{\"id\":\"scope\",\"question\":\"This issue decomposes into more than 12 implementation tasks. Narrow its scope or split it into separate issues.\",\"why\":\"More than 12 tasks is too many to split into two or three children.\"}] | .summary=\"Too large to split: more than 12 implementation tasks.\"' /tmp/fabro/triage.json > /tmp/fabro/triage.next.json
  mv /tmp/fabro/triage.next.json /tmp/fabro/triage.json
  TOOLARGE='([10]|implode) as $nl |
\"### Proposed task map (too large to split)\" + $nl + $nl + \"Drafted by triage against `main` at `\" + $sha + \"` on \" + $date + \". A hint for the implementer: the checkout wins where they disagree.\" + $nl + $nl +
( [ .tasks | to_entries[] |
    ((.value.covers // []) | join(\", \")) as $cov
    | ((.value.files // []) | map(\"`\" + . + \"`\") | join(\", \")) as $f
    | ((.key + 1) | tostring) as $n
    | $n + \". **\" + .value.title + \"** (`\" + .value.id + \"`): \" + .value.intent + $nl
      + \"   - files: \" + $f + $nl
      + (if $cov == \"\" then \"\" else \"   - covers: \" + $cov + $nl end) ] | join(\"\") )'
  jq -r --arg sha \"$SHA\" --arg date \"$DT\" \"$TOOLARGE\" $F >> /tmp/fabro/triage.md
  QT=$(jq -r '[.questions[]? | \"- \" + (.question // \"\")] | join(\"  \")' /tmp/fabro/triage.json | tr -d '\"' | cut -c1-1200)
  jq -nc --argjson k \"$K\" --arg qt \"$QT\" '{context_updates:{plan_status:\"too_large\",task_count:$k,question_count:\"1\",triage_questions:$qt}}'
  exit 0
fi
jq -nc '{context_updates:{plan_status:\"none\",task_count:0}}'
exit 0"]

    // ---- Terminal applications ----
    // set -e, and every agent-authored label created first: `gh issue edit` resolves
    // label names before it sends anything, so ONE missing label applies nothing.
    // Each writes its outcome word to /tmp/fabro/triage_outcome as its last step before
    // the routing object; `done` publishes it.
    post_questions [label="Post the questions", shape=parallelogram, output_schema="routing",
        script="set -e
N=$(jq -r .number /tmp/fabro/issue.json)
T=$(jq -r .title /tmp/fabro/triage.json)
for x in $(jq -r '.labels[]?' /tmp/fabro/triage.json); do
  gh label create \"$x\" --color EDEDED --description 'Created by fabro issue triage' 2>/dev/null || true
done
L=$(jq -r '[.labels[]?] | map(\"--add-label=\" + .) | join(\" \")' /tmp/fabro/triage.json)
R=$(jq -r '[.labels[].name] | map(select(. == \"needs-triage\" or . == \"triage-in-progress\")) | map(\"--remove-label=\" + .) | join(\" \")' /tmp/fabro/issue.json)
D=$(jq '[.decisions[]?] | length' /tmp/fabro/triage.json 2>/dev/null || echo 0)
if [ \"$D\" != 0 ]; then
  { jq -r '.body // \"\"' /tmp/fabro/issue.json | awk '/^## Decisions made during triage$/{s=1; next} s && /^## /{s=0} !s{print}'
    echo '## Decisions made during triage'
    echo
    echo 'Triage made these choices without asking. Edit this section to reverse one before the issue is worked.'
    echo
    jq -r '.decisions[] | \"- **\" + .question + \"** \" + .decision + (if (.basis // \"\") == \"\" then \"\" else \" (basis: \" + .basis + \")\" end)' /tmp/fabro/triage.json ; } > /tmp/fabro/decided_body.md
  gh issue edit $N --body-file /tmp/fabro/decided_body.md
fi
{ echo '<!-- fabro:triage-questions -->'
  cat /tmp/fabro/triage.md
  echo
  echo 'Answer by replying in a new comment. Editing this comment is not detected.' ; } > /tmp/fabro/questions.md
gh issue comment $N --body-file /tmp/fabro/questions.md
gh issue edit $N --title \"$T\" --add-label needs-info $L $R
echo needs_info > /tmp/fabro/triage_outcome
jq -nc '{context_updates:{triage_outcome:\"needs_info\"}}'"]

    // Unquoted word-splitting of $L is safe: triage_gate refuses any label outside
    // ^[a-z0-9:._-]+$, so none can contain a space.
    // Decisions (ADR 0012 D4) are appended to the issue body, replacing any section an
    // earlier triage wrote, so a human can reverse one before `backlog` works it. Only
    // that section is dropped, up to the next `## ` heading; text below it is kept.
    apply_ready [label="Promote to the backlog queue", shape=parallelogram, output_schema="routing",
        script="set -e
N=$(jq -r .number /tmp/fabro/issue.json)
T=$(jq -r .title /tmp/fabro/triage.json)
for x in $(jq -r '.labels[]?' /tmp/fabro/triage.json); do
  gh label create \"$x\" --color EDEDED --description 'Created by fabro issue triage' 2>/dev/null || true
done
L=$(jq -r '[.labels[]?] | map(\"--add-label=\" + .) | join(\" \")' /tmp/fabro/triage.json)
R=$(jq -r '[.labels[].name] | map(select(. == \"needs-triage\" or . == \"needs-info\" or . == \"triage-in-progress\")) | map(\"--remove-label=\" + .) | join(\" \")' /tmp/fabro/issue.json)
D=$(jq '[.decisions[]?] | length' /tmp/fabro/triage.json 2>/dev/null || echo 0)
EDIT=0
if [ -f /tmp/fabro/plan_ok ]; then EDIT=1; fi
if [ \"$D\" != 0 ]; then EDIT=1; fi
if [ \"$EDIT\" = 1 ]; then
  { jq -r '.body // \"\"' /tmp/fabro/issue.json | awk '/^## Decisions made during triage$/||/^## Proposed task map$/{s=1; next} s && /^## /{s=0} !s{print}'
    if [ \"$D\" != 0 ]; then
      echo '## Decisions made during triage'
      echo
      echo 'Triage made these choices without asking. Edit this section to reverse one before the issue is worked.'
      echo
      jq -r '.decisions[] | \"- **\" + .question + \"** \" + .decision + (if (.basis // \"\") == \"\" then \"\" else \" (basis: \" + .basis + \")\" end)' /tmp/fabro/triage.json
    fi
    if [ -f /tmp/fabro/plan_ok ]; then
      cat /tmp/fabro/task_map.md
    fi ; } > /tmp/fabro/decided_body.md
  gh issue edit $N --body-file /tmp/fabro/decided_body.md
fi
{ echo '<!-- fabro:triage-report -->' ; cat /tmp/fabro/triage.md ; } > /tmp/fabro/report.md
gh issue comment $N --body-file /tmp/fabro/report.md
gh issue edit $N --title \"$T\" --add-label agent $L $R
echo ready > /tmp/fabro/triage_outcome
jq -nc '{context_updates:{triage_outcome:\"ready\"}}' "]

    // Creates the Child issues a split map proposes (C2/C3/C4). Idempotent through
    // the sub-issues API, whose entries are plain issue objects: a child whose title
    // already exists as a sub-issue is reused, so a retried split never double-creates
    // (C3). The read fails closed -- treating an unreadable list as empty would create
    // every child again. Children are created in order, so `after` -- the
    // predecessor's issue number -- is always already known, and a create that yields
    // no issue number stops the node rather than strand a later child behind
    // `after=0`. A failed link is success only when a re-read shows the child is
    // already a sub-issue (the 422 on a duplicate link); anything else stops the node,
    // because an unlinked child is invisible to the idempotency check and to the
    // scheduler's parent closer. A child carries the parent's labels and the ones
    // triage chose, minus the triage labels and every queue-state label (a held child
    // that inherited `agent` would be worked before its predecessor lands). The
    // parent is labelled agent-split, and `agent` is removed if it is there. Every
    // label is created first, per the phase's rule.
    apply_split [label="Create the Children", shape=parallelogram, output_schema="routing",
        script="set -e
N=$(jq -r .number /tmp/fabro/issue.json)
T=$(jq -r .title /tmp/fabro/triage.json)
gh label create agent-held --color C5DEF5 --description 'A child issue waiting on an earlier child (ADR 0015)' 2>/dev/null || true
gh label create agent-split --color BFD4F2 --description 'A split parent waiting on its children (ADR 0015)' 2>/dev/null || true
for x in $(jq -r '.labels[]?' /tmp/fabro/triage.json); do
  gh label create \"$x\" --color EDEDED --description 'Created by fabro issue triage' 2>/dev/null || true
done
gh api \"repos/{owner}/{repo}/issues/$N/sub_issues\" --paginate > /tmp/fabro/sub_pages.json
jq -s 'add // []' /tmp/fabro/sub_pages.json > /tmp/fabro/sub_existing.json
jq -n '[]' > /tmp/fabro/split_numbers.json
PL=$(jq -r --slurpfile t /tmp/fabro/triage.json '([.labels[].name] + [$t[0].labels[]?]) | unique | map(select(. as $l | [\"needs-triage\",\"needs-info\",\"triage-in-progress\",\"agent\",\"agent-held\",\"agent-split\",\"agent-in-progress\",\"agent-stuck\",\"agent-remainder\",\"priority\",\"agent-noop\"] | index($l) | not)) | map(\"--label=\" + .) | join(\" \")' /tmp/fabro/issue.json)
CN=$(jq length /tmp/fabro/split_children.json)
I=0
while [ $I -lt $CN ]; do
  jq --argjson i $I '.[$i]' /tmp/fabro/split_children.json > /tmp/fabro/child.json
  CT=$(jq -r .title /tmp/fabro/child.json)
  C=$(jq -r --arg t \"$CT\" '[.[] | select(.title == $t) | .number][0] // empty' /tmp/fabro/sub_existing.json)
  if [ -z \"$C\" ]; then
    AF=$(jq -r '.after // \"null\"' /tmp/fabro/child.json)
    if [ \"$AF\" = null ]; then AFTER=0; CL='agent'
    else
      AFTER=$(jq -r --argjson a \"$AF\" '.[$a] // empty' /tmp/fabro/split_numbers.json); CL='agent-held'
      case \"$AFTER\" in ''|0|*[!0-9]*) echo \"child $I: predecessor child $AF has no issue number\" >&2; exit 1 ;; esac
    fi
    { echo \"<!-- fabro:split-child parent=$N after=$AFTER -->\"
      echo
      jq -r .summary /tmp/fabro/child.json
      echo
      echo \"Part of #$N.\"
      echo
      echo '## Acceptance criteria'
      echo
      echo \"The criteria of #$N that this child delivers:\"
      echo
      jq -r '.criteria[]? | \"- \" + .' /tmp/fabro/child.json
      echo
      jq -r .task_map /tmp/fabro/child.json ; } > /tmp/fabro/child_body.md
    URL=$(gh issue create --title \"$CT\" --body-file /tmp/fabro/child_body.md --label $CL $PL)
    C=$(printf '%s' \"$URL\" | sed 's|.*/||')
    case \"$C\" in ''|0|*[!0-9]*) echo \"child $I: gh issue create returned no issue number: $URL\" >&2; exit 1 ;; esac
    ID=$(gh api \"repos/{owner}/{repo}/issues/$C\" --jq .id)
    if ! gh api -X POST \"repos/{owner}/{repo}/issues/$N/sub_issues\" -F sub_issue_id=$ID > /dev/null; then
      gh api \"repos/{owner}/{repo}/issues/$N/sub_issues\" --paginate > /tmp/fabro/sub_pages.json
      if ! jq -s -e --argjson c \"$C\" 'add // [] | any(.number == $c)' /tmp/fabro/sub_pages.json > /dev/null; then
        echo \"child #$C: linking it as a sub-issue of #$N failed\" >&2; exit 1
      fi
    fi
  fi
  jq --argjson c \"$C\" '. + [$c]' /tmp/fabro/split_numbers.json > /tmp/fabro/split_numbers.next
  mv /tmp/fabro/split_numbers.next /tmp/fabro/split_numbers.json
  I=$((I+1))
done
K=$(jq '[.[].tasks[]] | length' /tmp/fabro/split_children.json)
NUMS=$(jq -r 'map(\"#\" + tostring) | join(\", \")' /tmp/fabro/split_numbers.json)
{ jq -r '.body // \"\"' /tmp/fabro/issue.json | awk '/^## Decisions made during triage$|^## Proposed task map$|^## Split into$/{s=1; next} s && /^## /{s=0} !s{print}'
  echo '## Decisions made during triage'
  echo
  echo 'Triage made these choices without asking. Edit this section to reverse one before the issue is worked.'
  echo
  jq -r '.decisions[] | \"- **\" + .question + \"** \" + .decision + (if (.basis // \"\") == \"\" then \"\" else \" (basis: \" + .basis + \")\" end)' /tmp/fabro/triage.json
  echo \"- **Split this issue?** Into $NUMS (basis: task map of $K tasks; ADR 0015 D3)\"
  echo
  cat /tmp/fabro/task_map.md
  echo
  echo '## Split into'
  echo
  jq -r --slurpfile n /tmp/fabro/split_numbers.json 'to_entries[] | \"- [ ] #\" + ($n[0][.key]|tostring) + \" \" + .value.title' /tmp/fabro/split_children.json ; } > /tmp/fabro/split_parent_body.md
gh issue edit $N --body-file /tmp/fabro/split_parent_body.md
{ echo '<!-- fabro:triage-report -->' ; cat /tmp/fabro/triage.md ; } > /tmp/fabro/report.md
gh issue comment $N --body-file /tmp/fabro/report.md
L=$(jq -r '[.labels[]?] | map(\"--add-label=\" + .) | join(\" \")' /tmp/fabro/triage.json)
R=$(jq -r '[.labels[].name] | map(select(. == \"needs-triage\" or . == \"needs-info\" or . == \"triage-in-progress\" or . == \"agent\")) | map(\"--remove-label=\" + .) | join(\" \")' /tmp/fabro/issue.json)
gh issue edit $N --title \"$T\" --add-label agent-split $L $R
echo split > /tmp/fabro/triage_outcome
jq -nc '{context_updates:{triage_outcome:\"split\"}}'"]


    // Labels and comments. Never closes the issue.
    apply_not_actionable [label="Record not actionable", shape=parallelogram, output_schema="routing",
        script="set -e
N=$(jq -r .number /tmp/fabro/issue.json)
T=$(jq -r .title /tmp/fabro/triage.json)
for x in $(jq -r '.labels[]?' /tmp/fabro/triage.json); do
  gh label create \"$x\" --color EDEDED --description 'Created by fabro issue triage' 2>/dev/null || true
done
L=$(jq -r '[.labels[]?] | map(\"--add-label=\" + .) | join(\" \")' /tmp/fabro/triage.json)
R=$(jq -r '[.labels[].name] | map(select(. == \"needs-triage\" or . == \"needs-info\" or . == \"triage-in-progress\")) | map(\"--remove-label=\" + .) | join(\" \")' /tmp/fabro/issue.json)
{ echo '<!-- fabro:triage-report -->' ; cat /tmp/fabro/triage.md ; } > /tmp/fabro/report.md
gh issue comment $N --body-file /tmp/fabro/report.md
gh issue edit $N --title \"$T\" $L $R
echo not_actionable > /tmp/fabro/triage_outcome
jq -nc '{context_updates:{triage_outcome:\"not_actionable\"}}'"]

    // The phase's failure node. Removes this run's claim, records `released`, and
    // routes to `done`. The `(^|[.])release$` stage_start hook notifies. It removes the
    // claim only when issue.json names an issue, which `claim` writes only after it has
    // decided the claim is not someone else's.
    release [label="Release the claim", shape=parallelogram,
        script="echo released > /tmp/fabro/triage_outcome
N=$(jq -r '.number // 0' /tmp/fabro/issue.json 2>/dev/null || echo 0)
if [ \"$N\" != 0 ]; then
  gh issue edit $N --remove-label triage-in-progress || true
fi
echo done"]

    // The single exit (import contract). Publishes the outcome word from the file, and
    // turns anything unexpected into `released`.
    done [label="Triage phase complete", shape=parallelogram, output_schema="routing",
        script="O=$(cat /tmp/fabro/triage_outcome 2>/dev/null || echo released)
case \"$O\" in ready|split|needs_info|not_actionable|skipped|released) ;; *) O=released ;; esac
jq -nc --arg o \"$O\" '{context_updates:{triage_outcome:$o}}'"]

    // ---- Edges ----
    start -> claim

    claim -> done                   [condition="outcome=succeeded && context.claim_state=skipped"]
    claim -> improve                [condition="outcome=succeeded && context.claim_state=claimed"]
    claim -> release

    improve -> improve_gate         [condition="outcome=succeeded"]
    improve -> release
    improve_gate -> improve         [condition="outcome=failed"]
    improve_gate -> triage          [condition="outcome=succeeded"]
    improve_gate -> release

    triage -> triage_gate           [condition="outcome=succeeded"]
    triage -> release
    triage_gate -> triage           [condition="outcome=failed"]
    triage_gate -> plan             [condition="outcome=succeeded && context.triage_readiness=ready"]
    triage_gate -> apply_not_actionable [condition="outcome=succeeded && context.triage_readiness=not_actionable"]
    triage_gate -> post_questions   [condition="outcome=succeeded && context.triage_readiness=needs_info"]
    triage_gate -> release

    // plan is fail-open (ADR 0015 D1): its unconditional edge goes to apply_ready.
    plan -> plan_gate               [condition="outcome=succeeded"]
    plan -> apply_ready
    plan_gate -> plan               [condition="outcome=failed"]
    plan_gate -> apply_ready        [condition="outcome=succeeded && context.plan_status=map"]
    plan_gate -> apply_ready        [condition="outcome=succeeded && context.plan_status=none"]
    plan_gate -> apply_split        [condition="outcome=succeeded && context.plan_status=split"]
    plan_gate -> post_questions     [condition="outcome=succeeded && context.plan_status=too_large"]
    plan_gate -> release

    post_questions -> done          [condition="outcome=succeeded"]
    post_questions -> release
    apply_ready -> done             [condition="outcome=succeeded"]
    apply_ready -> release
    apply_not_actionable -> done    [condition="outcome=succeeded"]
    apply_not_actionable -> release
    apply_split -> done             [condition="outcome=succeeded"]
    apply_split -> release

    release -> done
    done -> exit
}
