digraph Dependabot {
    graph [
        goal="Daily Dependabot run: merge the open Dependabot PRs that validate, patch one open alert group through the shared review and merge phase, and report",
        default_fidelity="truncate",
        // Above every node timeout in this graph (the longest is 20m). The patch agent runs
        // with its own 45m timeout; if this were lower, the watchdog would stop the run first.
        stall_timeout="60m",
        // The graph has a cycle through command nodes (the merge loop) and will import the
        // shared review-and-merge phase. Fabro stops a run when one failure signature repeats
        // this many times, and it counts run-wide. The phase's gates print one fixed line on a
        // bad contract, so a few repeats across PRs and groups must not stop the run mid-queue.
        loop_restart_signature_limit=20,
        // Every class is on glm-5.3-flash (ADR 0022 D14). `.merge-spec` and `.refute` take
        // their own models in the stylesheet that task 07 adds.
        model_stylesheet="
            *                 { model: glm-5.3-flash; }
            .dep-patch        { model: glm-5.3-flash; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // Resets the run-local files, reads the repository's default branch, and reads this
    // repository's switch from its `dependabot-<repo>` row (ADR 0022 D17). The switch is read
    // once, here, so the rest of the run agrees with itself.
    prep [label="Prepare the workspace", shape=parallelogram,
        script="set -e
mkdir -p /tmp/fabro/dep
echo prep > /tmp/fabro/dep/stopped_at
rm -f /tmp/fabro/dep/alerts.json /tmp/fabro/dep/prs.json /tmp/fabro/dep/cur.json /tmp/fabro/dep/cur_result.json
rm -f /tmp/fabro/dep/group.json /tmp/fabro/dep/group_alerts.json /tmp/fabro/dep/patch.json /tmp/fabro/dep/patch_feedback.md
rm -f /tmp/fabro/dep/no_patch.json /tmp/fabro/dep/skipped_groups.json /tmp/fabro/dep/loop_started /tmp/fabro/dep/cursor
rm -f /tmp/fabro/dep/run_branch /tmp/fabro/dep/merge_enabled /tmp/fabro/dep/merge_off_reason /tmp/fabro/dep/sync_base_sha
rm -f /tmp/fabro/dep/stop_reason /tmp/fabro/dep/alert_count /tmp/fabro/dep/dep_pr_count
rm -f /tmp/fabro/issue.json /tmp/fabro/pr_number /tmp/fabro/review_merge_outcome /tmp/fabro/auto_merge_repo
date +%s > /tmp/fabro/run_started
echo '[]' > /tmp/fabro/dep/results.json
gh repo view --json nameWithOwner,defaultBranchRef > /tmp/fabro/dep/repo.json
jq -r .defaultBranchRef.name /tmp/fabro/dep/repo.json > /tmp/fabro/base_ref
grep -qx '.codegraph/' .git/info/exclude 2>/dev/null || echo '.codegraph/' >> .git/info/exclude
if command -v fabro-code >/dev/null; then fabro-code index >/dev/null 2>&1; fabro-code map >/dev/null 2>&1 || true; else echo 'failed: fabro-code not in image' > /tmp/fabro/code_index; fi
if [ -z \"$FABRO_AGENT_GUIDE\" ]; then echo 'agent guide: FABRO_AGENT_GUIDE is empty, nothing installed' >&2
elif git ls-files --error-unmatch .codex/instructions.md >/dev/null 2>&1; then echo 'agent guide: the repository tracks .codex/instructions.md, left alone' >&2
elif mkdir -p .codex && printf '%s' \"$FABRO_AGENT_GUIDE\" > .codex/instructions.md; then grep -qx '.codex/instructions.md' .git/info/exclude 2>/dev/null || echo '.codex/instructions.md' >> .git/info/exclude
else echo 'agent guide: could not write .codex/instructions.md' >&2; fi
REPO=$(jq -r .nameWithOwner /tmp/fabro/dep/repo.json)
NAME=${REPO#*/}
echo 0 > /tmp/fabro/auto_merge_repo
if [ -n \"${FABRO_API_URL:-}\" ] && [ -n \"${FABRO_API_TOKEN:-}\" ] && curl -fsS -H \"Authorization: Bearer $FABRO_API_TOKEN\" $FABRO_API_URL/automations > /tmp/fabro/autorows.json 2>/dev/null; then
  D=$(jq -r --arg r \"$REPO\" '[.data[] | select(.workflow == \"dependabot\" and .target.repo == $r)] | .[0].description // \"\"' /tmp/fabro/autorows.json)
  case \"$D\" in
    *auto_merge*) T=$(printf '%s' \"$D\" | grep -o 'auto_merge=[A-Za-z0-9_-]*' | tail -1 | cut -d= -f2)
                  case \"$T\" in true) echo 1 > /tmp/fabro/auto_merge_repo ;; esac ;;
    *) echo 1 > /tmp/fabro/auto_merge_repo ;;
  esac
fi
AM=$(cat /tmp/fabro/auto_merge_repo)
H=\"${FABRO_AUTO_MERGE:-0}\"
case \"$H\" in 1) ;; *) H=0 ;; esac
if [ \"$AM\" = 1 ] && [ \"$H\" = 1 ]; then
  echo 1 > /tmp/fabro/dep/merge_enabled
  : > /tmp/fabro/dep/merge_off_reason
elif [ \"$AM\" != 1 ]; then
  echo 0 > /tmp/fabro/dep/merge_enabled
  echo 'Auto-merge is switched off for this repository. Flip it with ops/fabro-auto-merge-switch.sh.' > /tmp/fabro/dep/merge_off_reason
else
  echo 0 > /tmp/fabro/dep/merge_enabled
  echo 'Auto-merge is switched off host-wide: the FABRO_AUTO_MERGE server variable is not 1. Re-arm it with ops/fabro-auto-merge-switch.sh host on.' > /tmp/fabro/dep/merge_off_reason
fi
echo \"prep: repo=$NAME merge_enabled=$(cat /tmp/fabro/dep/merge_enabled)\"
rm -f /tmp/fabro/dep/stopped_at
echo ready"]

    // Task 03: the open alerts (C1) and the open Dependabot PRs in queue order (C2). `match.jq`
    // includes `version.jq`, which holds the version comparator and the requirement parser
    // (task 06's patch_gate loads the same module). Both files are written from these heredocs on
    // every visit, so this node owns them. A failed `gh` call exits 1 and leaves stopped_at
    // at `inventory`, and summarize says alerts could not be read (task 08).
    inventory [label="Count the open alerts and Dependabot PRs", shape=parallelogram, output_schema="routing", timeout="5m",
        script="set -e
echo inventory > /tmp/fabro/dep/stopped_at
R=$(jq -r .nameWithOwner /tmp/fabro/dep/repo.json)
cat > /tmp/fabro/dep/version.jq <<'JQ'
def norm: ltrimstr(\"v\") | split(\"+\") | .[0];
def vkey:
  norm as $s
  | ($s | capture(\"^(?<rel>[0-9.]*)(?<rest>.*)$\")) as $c
  | {rel: ($c.rel | rtrimstr(\".\") | split(\".\") | map(tonumber? // 0)),
     pre: ($c.rest | ltrimstr(\"-\"))};
def vcmp($a; $b):
  ($a | vkey) as $x
  | ($b | vkey) as $y
  | ([$x.rel|length, $y.rel|length] | max) as $n
  | ($x.rel + [range(0; $n - ($x.rel|length)) | 0]) as $p
  | ($y.rel + [range(0; $n - ($y.rel|length)) | 0]) as $q
  | if $p != $q then (if $p < $q then -1 else 1 end)
    elif $x.pre == $y.pre then 0
    elif $x.pre == \"\" then 1
    elif $y.pre == \"\" then -1
    elif $x.pre < $y.pre then -1
    else 1 end;
def target_version:
  if test(\"^v?[0-9][0-9.a-zA-Z+-]*$\") then .
  elif test(\">=|==\") then (capture(\"(>=|==)(?<v>[0-9][^,; ]*)\").v)
  else null end;
JQ
cat > /tmp/fabro/dep/match.jq <<'JQ'
include \"version\";
def eco_of_slug:
  . as $k
  | {\"npm_and_yarn\": \"npm\", \"bun\": \"npm\", \"uv\": \"pip\", \"cargo\": \"rust\"}
  | .[$k] // $k;
def adir:
  if test(\"/\") then (split(\"/\") | .[:-1] | join(\"/\")) else \"\" end;
def pr_dir:
  ([(.title | scan(\"in (/[^ ]*)\")), (.body | scan(\"in the (/[^ ]*) directory\"))]
   | flatten | .[0] // \"/\" | ltrimstr(\"/\"));
def pr_updates:
  . as $pr
  | ($pr.headRefName | split(\"/\")) as $b
  | ($b[1] | eco_of_slug) as $eco
  | pr_dir as $dir
  | ([$pr.body | scan(\"Updates `([^`]+)` from ([^[:space:]]+) to ([^[:space:]]+)\")]
     | map({package: .[0], to: (.[2] | target_version)})) as $rows
  | (if ($rows | length) > 0 then $rows
     else ($pr.title
           | [capture(\"(?:bump|update) (?<package>[^ ]+) (?:requirement )?from (?<from>[^ ]+) to (?<to>[^ ]+)\"; \"i\")]
           | map({package: (.package | split(\"[\")[0]), to: (.to | target_version)}))
     end) as $us
  | if ($dir != \"\") and ((($b[2:] | join(\"/\")) | startswith($dir + \"/\")) | not)
    then []
    else $us | map(. + {eco: $eco, dir: $dir})
    end;
def fixes($alerts):
  . as $pr
  | ($pr | pr_updates) as $us
  | [$alerts[]
     | select(.first_patched != null)
     | . as $a
     | select([$us[] | select((.package | ascii_downcase) == ($a.package | ascii_downcase) and .eco == $a.ecosystem
                              and .dir == ($a.manifest | adir) and .to != null
                              and vcmp(.to; $a.first_patched) >= 0)] | length > 0)
     | .number] | sort;
$prs[0]
| map(. as $pr | {number, title, head_ref: .headRefName, head_sha: .headRefOid, created_at: .createdAt, url, fixes: ($pr | fixes($alerts[0]))})
| sort_by([(.fixes | length == 0), .created_at])
JQ
gh api \"repos/$R/dependabot/alerts?state=open&per_page=100\" --paginate > /tmp/fabro/dep/alerts_raw.json || { echo 'inventory: the open alerts could not be read' >&2; exit 1; }
jq -s 'add // [] | [.[] | {number, ecosystem: .dependency.package.ecosystem, package: .dependency.package.name, manifest: .dependency.manifest_path, severity: .security_advisory.severity, scope: (.dependency.scope // \"unknown\"), first_patched: .security_vulnerability.first_patched_version.identifier, ghsa: .security_advisory.ghsa_id, cve: .security_advisory.cve_id, created_at: .created_at, url: .html_url}]' /tmp/fabro/dep/alerts_raw.json > /tmp/fabro/dep/alerts.json
gh pr list --author app/dependabot --state open --limit 100 --json number,title,headRefName,headRefOid,createdAt,url,body > /tmp/fabro/dep/prs_raw.json
jq -n -L /tmp/fabro/dep --slurpfile alerts /tmp/fabro/dep/alerts.json --slurpfile prs /tmp/fabro/dep/prs_raw.json -f /tmp/fabro/dep/match.jq > /tmp/fabro/dep/prs.json
A=$(jq length /tmp/fabro/dep/alerts.json)
P=$(jq length /tmp/fabro/dep/prs.json)
echo $A > /tmp/fabro/dep/alert_count
echo $P > /tmp/fabro/dep/dep_pr_count
rm -f /tmp/fabro/dep/stopped_at
jq -cn --argjson a $A --argjson p $P '{context_updates: {alert_count: $a, dep_pr_count: $p}}'
"]

    // One PR per visit (ADR 0022 D12). The first visit records the loop's start and the run branch.
    // Every visit asserts the checkout is the run branch and is clean (rule 4, D20): a dirty tree
    // never reaches the patch path. The cap is 5 PRs or 90 minutes; the rest of the queue is
    // written to results.json as skipped_cap. It publishes dep_pr_next on every branch.
    dep_next [label="dep_next", shape=parallelogram, output_schema="routing", timeout="2m",
        script="echo dep_next > /tmp/fabro/dep/stopped_at
D=/tmp/fabro/dep
if [ ! -f $D/loop_started ]; then
  date +%s > $D/loop_started
  echo 0 > $D/cursor
  git symbolic-ref --short HEAD > $D/run_branch
fi
RB=$(cat $D/run_branch)
if [ \"$(git symbolic-ref --short HEAD)\" != \"$RB\" ] || [ -n \"$(git status --porcelain)\" ]; then
  echo \"dep_next: the checkout is not clean on $RB\" > $D/stop_reason
  echo \"dep_next: the checkout is not clean on $RB\" >&2
  jq -cn '{context_updates: {dep_pr_next: \"no\"}}'
  exit 1
fi
CUR=$(cat $D/cursor)
N=$(jq length $D/prs.json)
NOW=$(date +%s)
START=$(cat $D/loop_started)
rm -f $D/stopped_at
if [ \"$CUR\" -ge 5 ] || [ $((NOW - START)) -ge 5400 ]; then
  jq -c --argjson c \"$CUR\" '.[$c:] | map({pr: .number, outcome: \"skipped_cap\", reason: \"the loop stopped at 5 PRs or 90 minutes\", fixes: .fixes})' $D/prs.json > $D/skipped.json
  jq --slurpfile s $D/skipped.json '. + $s[0]' $D/results.json > $D/results.tmp && mv $D/results.tmp $D/results.json
  jq -cn '{context_updates: {dep_pr_next: \"no\"}}'
  exit 0
fi
if [ \"$CUR\" -lt \"$N\" ]; then
  jq -c --argjson c \"$CUR\" '.[$c]' $D/prs.json > $D/cur.json
  echo $((CUR + 1)) > $D/cursor
  rm -f $D/cur_result.json
  jq -cn '{context_updates: {dep_pr_next: \"yes\"}}'
else
  jq -cn '{context_updates: {dep_pr_next: \"no\"}}'
fi"]

    // Refreshes the PR (stale: not OPEN, or the head moved; conflict: CONFLICTING). Otherwise polls
    // `gh pr checks` every DEP_POLL seconds, for at most DEP_CHECK_BOUND (900 s, below this node's 20m)
    // after which the checks count as pending; a PR with no checks after DEP_NO_CHECKS_GRACE (300 s) is
    // no_checks (D23). Any failed check is red. The DEP_ variables are test hooks with the defaults shown.
    // A red, pending, no_checks, conflicting or stale PR skips validation (dep_merge records it).
    dep_checks [label="dep_checks", shape=parallelogram, output_schema="routing", timeout="20m",
        script="echo dep_checks > /tmp/fabro/dep/stopped_at
D=/tmp/fabro/dep
N=$(jq -r .number $D/cur.json)
SHA=$(jq -r .head_sha $D/cur.json)
gh pr view \"$N\" --json state,headRefOid,mergeable,comments > $D/pr_now.json 2>/dev/null || echo '{}' > $D/pr_now.json
ST=$(jq -r '.state // \"\"' $D/pr_now.json)
HD=$(jq -r '.headRefOid // \"\"' $D/pr_now.json)
MG=$(jq -r '.mergeable // \"\"' $D/pr_now.json)
if [ \"$ST\" != OPEN ] || [ \"$HD\" != \"$SHA\" ]; then
  jq -cn '{outcome: \"stale\", reason: \"\"}' > $D/cur_result.json
  rm -f $D/stopped_at
  jq -cn '{context_updates: {dep_checks: \"stale\"}}'
  exit 0
fi
if [ \"$MG\" = CONFLICTING ]; then
  jq -cn '{outcome: \"conflict\", reason: \"\"}' > $D/cur_result.json
  rm -f $D/stopped_at
  jq -cn '{context_updates: {dep_checks: \"red\"}}'
  exit 0
fi
T0=$(date +%s)
FIRST_EMPTY=0
while :; do
  gh pr checks \"$N\" --json name,bucket > $D/checks.json 2>/dev/null || true
  [ -s $D/checks.json ] || echo '[]' > $D/checks.json
  COUNT=$(jq length $D/checks.json)
  FAILED=$(jq -r '[.[] | select(.bucket == \"fail\" or .bucket == \"cancel\")] | .[0].name // \"\"' $D/checks.json)
  PENDING=$(jq '[.[] | select(.bucket == \"pending\")] | length' $D/checks.json)
  NOW=$(date +%s)
  if [ -n \"$FAILED\" ]; then OUT=red; REASON=\"GitHub check $FAILED failed\"; break; fi
  if [ \"$COUNT\" = 0 ]; then
    [ \"$FIRST_EMPTY\" = 0 ] && FIRST_EMPTY=$NOW
    if [ $((NOW - FIRST_EMPTY)) -ge ${DEP_NO_CHECKS_GRACE:-300} ]; then OUT=no_checks; REASON=\"no checks were reported\"; break; fi
  elif [ \"$PENDING\" = 0 ]; then OUT=green; break; fi
  if [ $((NOW - T0)) -ge ${DEP_CHECK_BOUND:-900} ]; then OUT=pending; REASON=\"checks were still pending after 15 minutes\"; break; fi
  sleep ${DEP_POLL:-15}
done
rm -f $D/stopped_at
if [ \"$OUT\" = green ]; then
  rm -f $D/cur_result.json
  jq -cn '{context_updates: {dep_checks: \"green\"}}'
else
  jq -cn --arg o \"$OUT\" --arg r \"$(printf '%s' \"$REASON\" | cut -c1-300)\" '{outcome: $o, reason: $r}' > $D/cur_result.json
  jq -cn '{context_updates: {dep_checks: \"red\"}}'
fi"]

    // The D20 sequence, in this checkout: merge the PR head into origin/<base>, run setup.sh and ci.sh
    // under an inner `timeout` (DEP_VALIDATE_TIMEOUT, default 1020 s, below this node's 20m), then restore
    // the run branch and clean the tree. The identity is passed on the merge only: the plain image has none.
    // The restore runs whatever the outcome; a dirty checkout afterwards exits 1 without publishing dep_valid.
    // The tail of the log is printed with its braces replaced, so fabro's routing scan reads one object.
    dep_validate [label="dep_validate", shape=parallelogram, output_schema="routing", timeout="20m",
        script="echo dep_validate > /tmp/fabro/dep/stopped_at
D=/tmp/fabro/dep
N=$(jq -r .number $D/cur.json)
SHA=$(jq -r .head_sha $D/cur.json)
RB=$(cat $D/run_branch)
B=$(cat /tmp/fabro/base_ref)
ID=\"-c user.email=noreply@fabro.sh -c user.name=fabro-dependabot\"
restore() { git merge --abort >/dev/null 2>&1; git checkout -q -f \"$RB\" && git clean -fdq; }
clean_or_stop() {
  if [ \"$(git symbolic-ref --short HEAD)\" != \"$RB\" ] || [ -n \"$(git status --porcelain)\" ]; then
    echo \"dep_validate: the checkout is not clean on $RB after restore\" > $D/stop_reason
    echo \"dep_validate: the checkout is not clean on $RB after restore\" >&2
    exit 1
  fi
}
if ! git fetch -q origin \"$B\" \"pull/$N/head\" >/dev/null 2>&1; then
  restore; clean_or_stop
  jq -cn '{outcome: \"validate_failed\", reason: \"could not fetch the PR head\"}' > $D/cur_result.json
  rm -f $D/stopped_at
  jq -cn '{context_updates: {dep_valid: \"fail\"}}'
  exit 0
fi
git checkout -q --detach \"origin/$B\"
if ! git $ID merge -q --no-edit --no-ff \"$SHA\" > $D/merge_$N.log 2>&1; then
  restore; clean_or_stop
  jq -cn '{outcome: \"conflict\", reason: \"\"}' > $D/cur_result.json
  rm -f $D/stopped_at
  jq -cn '{context_updates: {dep_valid: \"conflict\"}}'
  exit 0
fi
timeout \"${DEP_VALIDATE_TIMEOUT:-1020}\" sh -c './.fabro/setup.sh && ./.fabro/ci.sh' > $D/validate_$N.log 2>&1
RC=$?
restore; clean_or_stop
if [ \"$RC\" = 0 ]; then
  rm -f $D/cur_result.json
  V=pass
else
  if [ \"$RC\" = 124 ]; then
    REASON=\"the validation timed out after ${DEP_VALIDATE_TIMEOUT:-1020} seconds\"
  else
    REASON=$(grep -v '^[[:space:]]*$' $D/validate_$N.log | tail -n 1 | cut -c1-300)
  fi
  jq -cn --arg r \"$REASON\" '{outcome: \"validate_failed\", reason: $r}' > $D/cur_result.json
  V=fail
fi
rm -f $D/stopped_at
tail -c 6000 $D/validate_$N.log | tr '{}' '()'
echo
jq -cn --arg v \"$V\" '{context_updates: {dep_valid: $v}}'"]

    // Ends every merge-loop visit with exactly one results.json entry for the current PR (C5). A PR the
    // checks or validation stopped records that outcome and is not merged. A conflict first gets one
    // `@dependabot rebase` comment, unless this token already posted one in the last 24 hours. A merge
    // needs the merge switch on (merge_enabled from prep); otherwise the PR records switch_off.
    // The merge re-reads the head (invariants-merge, Merging) and retries once on "Base branch was modified".
    dep_merge [label="dep_merge", shape=parallelogram, output_schema="routing", timeout="10m",
        script="echo dep_merge > /tmp/fabro/dep/stopped_at
D=/tmp/fabro/dep
N=$(jq -r .number $D/cur.json)
SHA=$(jq -r .head_sha $D/cur.json)
FIXES=$(jq -c .fixes $D/cur.json)
record() {
  jq -c --argjson pr \"$N\" --arg o \"$1\" --arg r \"$2\" --argjson f \"$FIXES\" '. + [{pr: $pr, outcome: $o, reason: $r, fixes: $f}]' $D/results.json > $D/results.tmp && mv $D/results.tmp $D/results.json
}
if [ -f $D/cur_result.json ]; then
  O=$(jq -r .outcome $D/cur_result.json)
  R=$(jq -r .reason $D/cur_result.json)
  if [ \"$O\" = conflict ]; then
    gh api user > $D/user.json 2>/dev/null || echo '{}' > $D/user.json
    LOGIN=$(jq -r '.login // \"\"' $D/user.json)
    gh pr view \"$N\" --json comments > $D/comments.json 2>/dev/null || echo '{\"comments\":[]}' > $D/comments.json
    RECENT=$(jq -r --arg l \"$LOGIN\" --argjson now \"$(date +%s)\" '[.comments[] | select(.author.login == $l and (.body | contains(\"@dependabot rebase\")) and ($now - (.createdAt | fromdateiso8601) < 86400))] | length' $D/comments.json)
    if [ \"$RECENT\" = 0 ]; then
      gh pr comment \"$N\" --body \"@dependabot rebase\" >/dev/null 2>&1 || echo \"dep_merge: could not comment on #$N\" >&2
    fi
  fi
  record \"$O\" \"$R\"
elif [ \"$(cat $D/merge_enabled)\" != 1 ]; then
  record switch_off \"$(cat $D/merge_off_reason)\"
else
  gh pr view \"$N\" --json state,headRefOid,mergeable > $D/pr_now.json 2>/dev/null || echo '{}' > $D/pr_now.json
  ST=$(jq -r '.state // \"\"' $D/pr_now.json)
  HD=$(jq -r '.headRefOid // \"\"' $D/pr_now.json)
  if [ \"$ST\" != OPEN ] || [ \"$HD\" != \"$SHA\" ]; then
    record stale \"\"
  else
    i=0
    while [ $i -lt 6 ]; do
      MG=$(jq -r '.mergeable // \"\"' $D/pr_now.json)
      [ -n \"$MG\" ] && [ \"$MG\" != UNKNOWN ] && break
      sleep ${DEP_MERGE_WAIT:-5}
      gh pr view \"$N\" --json state,headRefOid,mergeable > $D/pr_now.json 2>/dev/null || echo '{}' > $D/pr_now.json
      i=$((i + 1))
    done
    ATTEMPT=0
    OK=0
    while [ $ATTEMPT -lt 3 ]; do
      ATTEMPT=$((ATTEMPT + 1))
      if gh pr merge \"$N\" --squash --delete-branch=false --match-head-commit \"$SHA\" > $D/merge_$N.out 2>&1; then OK=1; break; fi
      grep -q 'Base branch was modified' $D/merge_$N.out || break
      sleep ${DEP_RETRY_WAIT:-10}
    done
    if [ $OK = 1 ]; then
      record merged \"\"
    else
      record merge_failed \"$(tail -n 1 $D/merge_$N.out | cut -c1-300)\"
    fi
  fi
fi
rm -f $D/stopped_at
jq -cn '{context_updates: {}}'"]

    // Builds the one-line summary from the files that exist, and always exits 0 (D24).
    // Task 08 gives it its final form.
    summarize [label="Summarize the run", shape=parallelogram, output_schema="routing", timeout="2m",
        script="R=$(jq -r .nameWithOwner /tmp/fabro/dep/repo.json 2>/dev/null || echo unknown)
A=$(cat /tmp/fabro/dep/alert_count 2>/dev/null || echo 0)
P=$(cat /tmp/fabro/dep/dep_pr_count 2>/dev/null || echo 0)
S=$(cat /tmp/fabro/dep/stopped_at 2>/dev/null || echo '')
if [ -n \"$S\" ]; then M=\"Stopped at $S\"; else M=\"$R: $A alerts open, $P Dependabot PRs open (skeleton run; nothing merged or patched)\"; fi
echo \"$M\"
jq -cn --arg m \"$M\" --arg s \"$S\" '{context_updates: {dep_summary: $m, stopped_at: $s}}'
exit 0"]

    // The target of the summary hook (task 08). Exists here so the hook has a stage to fire on.
    finish [label="Finish", shape=parallelogram, timeout="1m", script="echo done"]

    start -> prep
    prep -> inventory                 [condition="outcome=succeeded"]
    prep -> summarize
    // pick_group (task 05) does not exist yet: the no-PR and no-group exits go to summarize.
    inventory -> dep_next             [condition="outcome=succeeded && context.dep_pr_count!=0"]
    inventory -> summarize            [condition="outcome=succeeded && context.dep_pr_count=0"]
    inventory -> summarize
    dep_next -> dep_checks            [condition="outcome=succeeded && context.dep_pr_next=yes"]
    dep_next -> summarize             [condition="outcome=succeeded && context.dep_pr_next=no"]
    dep_next -> summarize
    dep_checks -> dep_validate        [condition="outcome=succeeded && context.dep_checks=green"]
    dep_checks -> dep_merge           [condition="outcome=succeeded && context.dep_checks!=green"]
    dep_checks -> summarize
    dep_validate -> dep_merge         [condition="outcome=succeeded"]
    dep_validate -> summarize
    dep_merge -> dep_next             [condition="outcome=succeeded"]
    dep_merge -> summarize
    summarize -> finish               [condition="outcome=succeeded"]
    summarize -> finish
    finish -> exit
}
