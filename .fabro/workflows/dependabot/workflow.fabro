digraph Dependabot {
    graph [
        goal="Daily Dependabot run: merge the open Dependabot PRs that validate, patch one open alert group through the shared review and merge phase, and report",
        default_fidelity="truncate",
        // Above every node timeout in this graph (the longest is 20m). The patch agent runs
        // with its own 45m timeout; if this were lower, the watchdog would stop the run first.
        stall_timeout="60m",
        // The graph has a cycle through command nodes (the merge loop) and will import the
        // shared review-and-merge phase. Fabro stops a run when one failure signature repeats
        // this many times, and it counts run-wide. The phase's gates print one fixed line on a
        // bad contract, so a few repeats across PRs and groups must not stop the run mid-queue.
        loop_restart_signature_limit=20,
        // The default and the patch are on glm-5.3-flash, and the merge phase's classes follow pr-review
        // (ADR 0022 D14), with two differences. `.merge-spec` and `.rebase-t2` are on glm-5.3, as pr-review has
        // them. `.merge-fix` is on glm-5.3-flash here, by D14, where pr-review has glm-5.3: review_fix's 15m
        // timeout was measured on glm-5.3, so it is unmeasured for this graph (invariants-graph, Timeouts). Task 10
        // records the first durations. `.refute` is non-GLM, as in every importing graph.
        // `.merge-resolve` (resolve_base, #37) resolves a conflict with the base, so it is on glm-5.3 with `.rebase-t2`.
        model_stylesheet="
            *                 { model: glm-5.3-flash; }
            .dep-patch        { model: glm-5.3-flash; }
            .merge-standards  { model: glm-5.3-flash; }
            .merge-spec       { model: glm-5.3; }
            .merge-fix        { model: glm-5.3-flash; }
            .ci-fix           { model: glm-5.3-flash; }
            .rebase-t2        { model: glm-5.3; }
            .refute           { model: gpt-6.1-sol; }
            .refute-fix       { model: glm-5.3-flash; }
            .merge-resolve    { model: glm-5.3; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // Resets the run-local files, records the run branch, reads the repository's default branch, and reads this
    // repository's switch from its `dependabot-<repo>` row (ADR 0022 D17). The run branch is recorded here, not
    // in dep_next: a repository with no Dependabot PR never visits dep_next, and sync_base needs it (the first
    // lawncare-saas run, 01M4M6TEY2QGCQBCAQ103RECX8, stopped there). The switch is read
    // once, here, so the rest of the run agrees with itself.
    prep [label="Prepare the workspace", shape=parallelogram,
        script="set -e
mkdir -p /tmp/fabro/dep
echo prep > /tmp/fabro/dep/stopped_at
rm -f /tmp/fabro/dep/alerts.json /tmp/fabro/dep/prs.json /tmp/fabro/dep/cur.json /tmp/fabro/dep/cur_result.json
rm -f /tmp/fabro/dep/group.json /tmp/fabro/dep/group_alerts.json /tmp/fabro/dep/patch.json /tmp/fabro/dep/patch_feedback.md
rm -f /tmp/fabro/dep/no_patch.json /tmp/fabro/dep/skipped_groups.json /tmp/fabro/dep/loop_started /tmp/fabro/dep/cursor
rm -f /tmp/fabro/dep/run_branch /tmp/fabro/dep/merge_enabled /tmp/fabro/dep/merge_off_reason /tmp/fabro/dep/sync_base_sha
rm -f /tmp/fabro/dep/stop_reason /tmp/fabro/dep/alert_count /tmp/fabro/dep/dep_pr_count
rm -f /tmp/fabro/issue.json /tmp/fabro/pr_number /tmp/fabro/review_merge_outcome /tmp/fabro/auto_merge_repo
rm -f /tmp/fabro/dep/patch_visits /tmp/fabro/dep/patch_feedback.md /tmp/fabro/dep/patch.json /tmp/fabro/dep/patch_status
date +%s > /tmp/fabro/run_started
git symbolic-ref --short HEAD > /tmp/fabro/dep/run_branch
echo '[]' > /tmp/fabro/dep/results.json
gh repo view --json nameWithOwner,defaultBranchRef > /tmp/fabro/dep/repo.json
jq -r .defaultBranchRef.name /tmp/fabro/dep/repo.json > /tmp/fabro/base_ref
grep -qx '.codegraph/' .git/info/exclude 2>/dev/null || echo '.codegraph/' >> .git/info/exclude
if command -v fabro-code >/dev/null; then fabro-code index >/dev/null 2>&1; fabro-code map >/dev/null 2>&1 || true; else echo 'failed: fabro-code not in image' > /tmp/fabro/code_index; fi
if [ -z \"$FABRO_AGENT_GUIDE\" ]; then echo 'agent guide: FABRO_AGENT_GUIDE is empty, nothing installed' >&2
elif git ls-files --error-unmatch .codex/instructions.md >/dev/null 2>&1; then echo 'agent guide: the repository tracks .codex/instructions.md, left alone' >&2
elif mkdir -p .codex && printf '%s' \"$FABRO_AGENT_GUIDE\" > .codex/instructions.md; then grep -qx '.codex/instructions.md' .git/info/exclude 2>/dev/null || echo '.codex/instructions.md' >> .git/info/exclude
else echo 'agent guide: could not write .codex/instructions.md' >&2; fi
REPO=$(jq -r .nameWithOwner /tmp/fabro/dep/repo.json)
NAME=${REPO#*/}
echo 0 > /tmp/fabro/auto_merge_repo
if [ -n \"${FABRO_API_URL:-}\" ] && [ -n \"${FABRO_API_TOKEN:-}\" ] && curl -fsS -H \"Authorization: Bearer $FABRO_API_TOKEN\" $FABRO_API_URL/automations > /tmp/fabro/autorows.json 2>/dev/null; then
  D=$(jq -r --arg r \"$REPO\" '[.data[] | select(.workflow == \"dependabot\" and .target.repo == $r)] | .[0].description // \"\"' /tmp/fabro/autorows.json)
  case \"$D\" in
    *auto_merge*) T=$(printf '%s' \"$D\" | grep -o 'auto_merge=[A-Za-z0-9_-]*' | tail -1 | cut -d= -f2)
                  case \"$T\" in true) echo 1 > /tmp/fabro/auto_merge_repo ;; esac ;;
    *) echo 1 > /tmp/fabro/auto_merge_repo ;;
  esac
fi
AM=$(cat /tmp/fabro/auto_merge_repo)
H=\"${FABRO_AUTO_MERGE:-0}\"
case \"$H\" in 1) ;; *) H=0 ;; esac
if [ \"$AM\" = 1 ] && [ \"$H\" = 1 ]; then
  echo 1 > /tmp/fabro/dep/merge_enabled
  : > /tmp/fabro/dep/merge_off_reason
elif [ \"$AM\" != 1 ]; then
  echo 0 > /tmp/fabro/dep/merge_enabled
  echo \"Auto-merge is switched off for dependabot-$NAME. Flip it with ops/fabro-auto-merge-switch.sh dependabot-$NAME on.\" > /tmp/fabro/dep/merge_off_reason
else
  echo 0 > /tmp/fabro/dep/merge_enabled
  echo 'Auto-merge is switched off host-wide: the FABRO_AUTO_MERGE server variable is not 1. Re-arm it with ops/fabro-auto-merge-switch.sh host on.' > /tmp/fabro/dep/merge_off_reason
fi
echo \"prep: repo=$NAME merge_enabled=$(cat /tmp/fabro/dep/merge_enabled)\"
rm -f /tmp/fabro/dep/stopped_at
echo ready"]

    // Task 03: the open alerts (C1) and the open Dependabot PRs in queue order (C2). `match.jq`
    // includes `version.jq`, which holds the version comparator and the requirement parser
    // (task 06's patch_gate loads the same module). Both files are written from these heredocs on
    // every visit, so this node owns them. A failed `gh` call exits 1 and leaves stopped_at
    // at `inventory`, and summarize says alerts could not be read (task 08).
    inventory [label="Count the open alerts and Dependabot PRs", shape=parallelogram, output_schema="routing", timeout="5m",
        script="set -e
echo inventory > /tmp/fabro/dep/stopped_at
stop() { printf '%s' \"$1\" > /tmp/fabro/dep/stop_reason; echo \"$1\" >&2; exit 1; }
R=$(jq -r .nameWithOwner /tmp/fabro/dep/repo.json)
cat > /tmp/fabro/dep/version.jq <<'JQ'
def norm: ltrimstr(\"v\") | split(\"+\") | .[0];
def vkey:
  norm as $s
  | ($s | capture(\"^(?<rel>[0-9.]*)(?<rest>.*)$\")) as $c
  | {rel: ($c.rel | rtrimstr(\".\") | split(\".\") | map(tonumber? // 0)),
     pre: ($c.rest | ltrimstr(\"-\"))};
def vcmp($a; $b):
  ($a | vkey) as $x
  | ($b | vkey) as $y
  | ([$x.rel|length, $y.rel|length] | max) as $n
  | ($x.rel + [range(0; $n - ($x.rel|length)) | 0]) as $p
  | ($y.rel + [range(0; $n - ($y.rel|length)) | 0]) as $q
  | if $p != $q then (if $p < $q then -1 else 1 end)
    elif $x.pre == $y.pre then 0
    elif $x.pre == \"\" then 1
    elif $y.pre == \"\" then -1
    elif $x.pre < $y.pre then -1
    else 1 end;
def target_version:
  if test(\"^v?[0-9][0-9.a-zA-Z+-]*$\") then .
  elif test(\">=|==\") then (capture(\"(>=|==)(?<v>[0-9][^,; ]*)\").v)
  else null end;
JQ
cat > /tmp/fabro/dep/match.jq <<'JQ'
include \"version\";
def eco_of_slug:
  . as $k
  | {\"npm_and_yarn\": \"npm\", \"bun\": \"npm\", \"uv\": \"pip\", \"cargo\": \"rust\"}
  | .[$k] // $k;
def adir:
  if test(\"/\") then (split(\"/\") | .[:-1] | join(\"/\")) else \"\" end;
def pr_dir:
  ([(.title | scan(\"in (/[^ ]*)\")), (.body | scan(\"in the (/[^ ]*) directory\"))]
   | flatten | .[0] // \"/\" | ltrimstr(\"/\"));
def pr_updates:
  . as $pr
  | ($pr.headRefName | split(\"/\")) as $b
  | ($b[1] | eco_of_slug) as $eco
  | pr_dir as $dir
  | ([$pr.body | scan(\"Updates `([^`]+)` from ([^[:space:]]+) to ([^[:space:]]+)\")]
     | map({package: .[0], to: (.[2] | target_version)})) as $rows
  | (if ($rows | length) > 0 then $rows
     else ($pr.title
           | [capture(\"(?:bump|update) (?<package>[^ ]+) (?:requirement )?from (?<from>[^ ]+) to (?<to>[^ ]+)\"; \"i\")]
           | map({package: (.package | split(\"[\")[0]), to: (.to | target_version)}))
     end) as $us
  | if ($dir != \"\") and ((($b[2:] | join(\"/\")) | startswith($dir + \"/\")) | not)
    then []
    else $us | map(. + {eco: $eco, dir: $dir})
    end;
def fixes($alerts):
  . as $pr
  | ($pr | pr_updates) as $us
  | [$alerts[]
     | select(.first_patched != null)
     | . as $a
     | select([$us[] | select((.package | ascii_downcase) == ($a.package | ascii_downcase) and .eco == $a.ecosystem
                              and .dir == ($a.manifest | adir) and .to != null
                              and vcmp(.to; $a.first_patched) >= 0)] | length > 0)
     | .number] | sort;
$prs[0]
| map(. as $pr | {number, title, head_ref: .headRefName, head_sha: .headRefOid, created_at: .createdAt, url, fixes: ($pr | fixes($alerts[0])), updates: ($pr | pr_updates | map({package, eco, dir}))})
| sort_by([(.fixes | length == 0), .created_at])
JQ
gh api \"repos/$R/dependabot/alerts?state=open&per_page=100\" --paginate > /tmp/fabro/dep/alerts_raw.json || stop 'inventory: the open alerts could not be read'
jq -s 'add // [] | [.[] | {number, ecosystem: .dependency.package.ecosystem, package: .dependency.package.name, manifest: .dependency.manifest_path, severity: .security_advisory.severity, scope: (.dependency.scope // \"unknown\"), first_patched: .security_vulnerability.first_patched_version.identifier, ghsa: .security_advisory.ghsa_id, cve: .security_advisory.cve_id, created_at: .created_at, url: .html_url}]' /tmp/fabro/dep/alerts_raw.json > /tmp/fabro/dep/alerts.json
gh pr list --author app/dependabot --state open --limit 100 --json number,title,headRefName,headRefOid,createdAt,url,body > /tmp/fabro/dep/prs_raw.json || stop 'inventory: the open Dependabot PRs could not be listed'
jq -n -L /tmp/fabro/dep --slurpfile alerts /tmp/fabro/dep/alerts.json --slurpfile prs /tmp/fabro/dep/prs_raw.json -f /tmp/fabro/dep/match.jq > /tmp/fabro/dep/prs.json
A=$(jq length /tmp/fabro/dep/alerts.json)
P=$(jq length /tmp/fabro/dep/prs.json)
echo $A > /tmp/fabro/dep/alert_count
echo $P > /tmp/fabro/dep/dep_pr_count
rm -f /tmp/fabro/dep/stopped_at
jq -cn --argjson a $A --argjson p $P '{context_updates: {alert_count: $a, dep_pr_count: $p}}'
"]

    // One PR per visit (ADR 0022 D12). The first visit records the loop's start and the run branch.
    // Every visit asserts the checkout is the run branch and is clean (rule 4, D20): a dirty tree
    // never reaches the patch path. The cap is 5 PRs or 90 minutes; the rest of the queue is
    // written to results.json as skipped_cap. It publishes dep_pr_next on every branch.
    dep_next [label="dep_next", shape=parallelogram, output_schema="routing", timeout="2m",
        script="echo dep_next > /tmp/fabro/dep/stopped_at
stop() { printf '%s' \"$1\" > /tmp/fabro/dep/stop_reason; echo \"$1\" >&2; exit 1; }
D=/tmp/fabro/dep
if [ ! -f $D/loop_started ]; then
  date +%s > $D/loop_started
  echo 0 > $D/cursor
  [ -s $D/run_branch ] || git symbolic-ref --short HEAD > $D/run_branch
fi
RB=$(cat $D/run_branch)
if [ \"$(git symbolic-ref --short HEAD)\" != \"$RB\" ] || [ -n \"$(git status --porcelain)\" ]; then
  jq -cn '{context_updates: {dep_pr_next: \"no\"}}'
  stop \"dep_next: the checkout is not clean on $RB\"
fi
CUR=$(cat $D/cursor)
N=$(jq length $D/prs.json)
NOW=$(date +%s)
START=$(cat $D/loop_started)
rm -f $D/stopped_at
if [ \"$CUR\" -ge 5 ] || [ $((NOW - START)) -ge 5400 ]; then
  jq -c --argjson c \"$CUR\" '.[$c:] | map({pr: .number, outcome: \"skipped_cap\", reason: \"the loop stopped at 5 PRs or 90 minutes\", fixes: .fixes})' $D/prs.json > $D/skipped.json
  jq --slurpfile s $D/skipped.json '. + $s[0]' $D/results.json > $D/results.tmp && mv $D/results.tmp $D/results.json
  jq -cn '{context_updates: {dep_pr_next: \"no\"}}'
  exit 0
fi
if [ \"$CUR\" -lt \"$N\" ]; then
  jq -c --argjson c \"$CUR\" '.[$c]' $D/prs.json > $D/cur.json
  echo $((CUR + 1)) > $D/cursor
  rm -f $D/cur_result.json $D/validated_base
  jq -cn '{context_updates: {dep_pr_next: \"yes\"}}'
else
  jq -cn '{context_updates: {dep_pr_next: \"no\"}}'
fi"]

    // Refreshes the PR (stale: not OPEN, or the head moved; conflict: CONFLICTING). Otherwise polls
    // `gh pr checks` every DEP_POLL seconds, for at most DEP_CHECK_BOUND (900 s, below this node's 20m)
    // after which the checks count as pending; a PR with no checks after DEP_NO_CHECKS_GRACE (300 s) is
    // no_checks (D23). Any failed check is red. The DEP_ variables are test hooks with the defaults shown.
    // A red, pending, no_checks, conflicting or stale PR skips validation (dep_merge records it).
    dep_checks [label="dep_checks", shape=parallelogram, output_schema="routing", timeout="20m",
        script="echo dep_checks > /tmp/fabro/dep/stopped_at
D=/tmp/fabro/dep
N=$(jq -r .number $D/cur.json)
SHA=$(jq -r .head_sha $D/cur.json)
gh pr view \"$N\" --json state,headRefOid,mergeable,comments > $D/pr_now.json 2>/dev/null || echo '{}' > $D/pr_now.json
ST=$(jq -r '.state // \"\"' $D/pr_now.json)
HD=$(jq -r '.headRefOid // \"\"' $D/pr_now.json)
MG=$(jq -r '.mergeable // \"\"' $D/pr_now.json)
if [ \"$ST\" != OPEN ] || [ \"$HD\" != \"$SHA\" ]; then
  jq -cn '{outcome: \"stale\", reason: \"\"}' > $D/cur_result.json
  rm -f $D/stopped_at
  jq -cn '{context_updates: {dep_checks: \"stale\"}}'
  exit 0
fi
if [ \"$MG\" = CONFLICTING ]; then
  jq -cn '{outcome: \"conflict\", reason: \"\"}' > $D/cur_result.json
  rm -f $D/stopped_at
  jq -cn '{context_updates: {dep_checks: \"red\"}}'
  exit 0
fi
T0=$(date +%s)
FIRST_EMPTY=0
while :; do
  gh pr checks \"$N\" --json name,bucket > $D/checks.json 2>/dev/null || true
  [ -s $D/checks.json ] || echo '[]' > $D/checks.json
  COUNT=$(jq length $D/checks.json)
  FAILED=$(jq -r '[.[] | select(.bucket == \"fail\" or .bucket == \"cancel\")] | .[0].name // \"\"' $D/checks.json)
  PENDING=$(jq '[.[] | select(.bucket == \"pending\")] | length' $D/checks.json)
  NOW=$(date +%s)
  if [ -n \"$FAILED\" ]; then OUT=red; REASON=\"GitHub check $FAILED failed\"; break; fi
  if [ \"$COUNT\" = 0 ]; then
    [ \"$FIRST_EMPTY\" = 0 ] && FIRST_EMPTY=$NOW
    if [ $((NOW - FIRST_EMPTY)) -ge ${DEP_NO_CHECKS_GRACE:-300} ]; then OUT=no_checks; REASON=\"no checks were reported\"; break; fi
  elif [ \"$PENDING\" = 0 ]; then OUT=green; break; fi
  if [ $((NOW - T0)) -ge ${DEP_CHECK_BOUND:-900} ]; then OUT=pending; REASON=\"checks were still pending after 15 minutes\"; break; fi
  sleep ${DEP_POLL:-15}
done
rm -f $D/stopped_at
if [ \"$OUT\" = green ]; then
  rm -f $D/cur_result.json
  jq -cn '{context_updates: {dep_checks: \"green\"}}'
else
  jq -cn --arg o \"$OUT\" --arg r \"$(printf '%s' \"$REASON\" | cut -c1-300)\" '{outcome: $o, reason: $r}' > $D/cur_result.json
  jq -cn '{context_updates: {dep_checks: \"red\"}}'
fi"]

    // The D20 sequence, in this checkout: merge the PR head into origin/<base>, run setup.sh and ci.sh
    // under an inner `timeout` (DEP_VALIDATE_TIMEOUT, default 1020 s, below this node's 20m), then restore
    // the run branch and clean the tree. The identity is passed on the merge only: the plain image has none.
    // validated_base records the base commit the PR was validated on, for dep_merge's --admin rule.
    // The restore runs whatever the outcome; a dirty checkout afterwards exits 1 without publishing dep_valid.
    // The tail of the log is printed with its braces replaced, so fabro's routing scan reads one object.
    dep_validate [label="dep_validate", shape=parallelogram, output_schema="routing", timeout="20m",
        script="echo dep_validate > /tmp/fabro/dep/stopped_at
stop() { printf '%s' \"$1\" > /tmp/fabro/dep/stop_reason; echo \"$1\" >&2; exit 1; }
D=/tmp/fabro/dep
N=$(jq -r .number $D/cur.json)
SHA=$(jq -r .head_sha $D/cur.json)
RB=$(cat $D/run_branch)
B=$(cat /tmp/fabro/base_ref)
ID=\"-c user.email=noreply@fabro.sh -c user.name=fabro-dependabot\"
restore() { git merge --abort >/dev/null 2>&1; git checkout -q -f \"$RB\" && git clean -fdq; }
clean_or_stop() {
  if [ \"$(git symbolic-ref --short HEAD)\" != \"$RB\" ] || [ -n \"$(git status --porcelain)\" ]; then
    stop \"dep_validate: the checkout is not clean on $RB after restore\"
  fi
}
if ! git fetch -q origin \"$B\" \"pull/$N/head\" >/dev/null 2>&1; then
  restore; clean_or_stop
  jq -cn '{outcome: \"validate_failed\", reason: \"could not fetch the PR head\"}' > $D/cur_result.json
  rm -f $D/stopped_at
  jq -cn '{context_updates: {dep_valid: \"fail\"}}'
  exit 0
fi
git rev-parse \"origin/$B\" > $D/validated_base
git checkout -q --detach \"origin/$B\"
if ! git $ID merge -q --no-edit --no-ff \"$SHA\" > $D/merge_$N.log 2>&1; then
  restore; clean_or_stop
  jq -cn '{outcome: \"conflict\", reason: \"\"}' > $D/cur_result.json
  rm -f $D/stopped_at
  jq -cn '{context_updates: {dep_valid: \"conflict\"}}'
  exit 0
fi
timeout \"${DEP_VALIDATE_TIMEOUT:-1020}\" sh -c './.fabro/setup.sh && ./.fabro/ci.sh' > $D/validate_$N.log 2>&1
RC=$?
restore; clean_or_stop
if [ \"$RC\" = 0 ]; then
  rm -f $D/cur_result.json
  V=pass
else
  if [ \"$RC\" = 124 ]; then
    REASON=\"the validation timed out after ${DEP_VALIDATE_TIMEOUT:-1020} seconds\"
  else
    REASON=$(grep -v '^[[:space:]]*$' $D/validate_$N.log | tail -n 1 | cut -c1-300)
  fi
  jq -cn --arg r \"$REASON\" '{outcome: \"validate_failed\", reason: $r}' > $D/cur_result.json
  V=fail
fi
rm -f $D/stopped_at
tail -c 6000 $D/validate_$N.log | tr '{}' '()'
echo
jq -cn --arg v \"$V\" '{context_updates: {dep_valid: $v}}'"]

    // Ends every merge-loop visit with exactly one results.json entry for the current PR (C5). A PR the
    // checks or validation stopped records that outcome and is not merged. A conflict first gets one
    // `@dependabot rebase` comment, unless this token already posted one in the last 24 hours. A merge
    // needs the merge switch on (merge_enabled from prep); otherwise the PR records switch_off.
    // The merge re-reads the head (invariants-merge, Merging) and retries on "Base branch was modified".
    // A branch protection that requires an up-to-date branch (jelly-swipe) refuses every PR after the first
    // merge of a run, because the base moved. That refusal alone is retried with --admin, and only while the
    // base tip is still validated_base: dep_validate already ran setup.sh and ci.sh on this head merged into
    // that commit, which is what the protection asks for, and dep_checks saw the checks green (operator
    // decision, 2026-10-10). If the base moved since, nothing validated the result, so it is merge_failed.
    dep_merge [label="dep_merge", shape=parallelogram, output_schema="routing", timeout="10m",
        script="echo dep_merge > /tmp/fabro/dep/stopped_at
D=/tmp/fabro/dep
N=$(jq -r .number $D/cur.json)
SHA=$(jq -r .head_sha $D/cur.json)
FIXES=$(jq -c .fixes $D/cur.json)
record() {
  jq -c --argjson pr \"$N\" --arg o \"$1\" --arg r \"$2\" --argjson f \"$FIXES\" '. + [{pr: $pr, outcome: $o, reason: $r, fixes: $f}]' $D/results.json > $D/results.tmp && mv $D/results.tmp $D/results.json
}
if [ -f $D/cur_result.json ]; then
  O=$(jq -r .outcome $D/cur_result.json)
  R=$(jq -r .reason $D/cur_result.json)
  if [ \"$O\" = conflict ]; then
    gh api user > $D/user.json 2>/dev/null || echo '{}' > $D/user.json
    LOGIN=$(jq -r '.login // \"\"' $D/user.json)
    gh pr view \"$N\" --json comments > $D/comments.json 2>/dev/null || echo '{\"comments\":[]}' > $D/comments.json
    RECENT=$(jq -r --arg l \"$LOGIN\" --argjson now \"$(date +%s)\" '[.comments[] | select(.author.login == $l and (.body | contains(\"@dependabot rebase\")) and ($now - (.createdAt | fromdateiso8601) < 86400))] | length' $D/comments.json)
    if [ \"$RECENT\" = 0 ]; then
      gh pr comment \"$N\" --body \"@dependabot rebase\" >/dev/null 2>&1 || echo \"dep_merge: could not comment on #$N\" >&2
    fi
  fi
  record \"$O\" \"$R\"
elif [ \"$(cat $D/merge_enabled)\" != 1 ]; then
  record switch_off \"$(cat $D/merge_off_reason)\"
else
  gh pr view \"$N\" --json state,headRefOid,mergeable > $D/pr_now.json 2>/dev/null || echo '{}' > $D/pr_now.json
  ST=$(jq -r '.state // \"\"' $D/pr_now.json)
  HD=$(jq -r '.headRefOid // \"\"' $D/pr_now.json)
  if [ \"$ST\" != OPEN ] || [ \"$HD\" != \"$SHA\" ]; then
    record stale \"\"
  else
    i=0
    while [ $i -lt 6 ]; do
      MG=$(jq -r '.mergeable // \"\"' $D/pr_now.json)
      [ -n \"$MG\" ] && [ \"$MG\" != UNKNOWN ] && break
      sleep ${DEP_MERGE_WAIT:-5}
      gh pr view \"$N\" --json state,headRefOid,mergeable > $D/pr_now.json 2>/dev/null || echo '{}' > $D/pr_now.json
      i=$((i + 1))
    done
    B=$(cat /tmp/fabro/base_ref)
    ATTEMPT=0
    OK=0
    ADMIN=''
    WHY=''
    while [ $ATTEMPT -lt 3 ]; do
      ATTEMPT=$((ATTEMPT + 1))
      if gh pr merge \"$N\" --squash --delete-branch=false --match-head-commit \"$SHA\" $ADMIN > $D/merge_$N.out 2>&1; then OK=1; break; fi
      if [ -z \"$ADMIN\" ] && grep -q 'not up to date with the base branch' $D/merge_$N.out; then
        TIP=$(git ls-remote origin \"refs/heads/$B\" 2>/dev/null | cut -f1)
        if [ -n \"$TIP\" ] && [ \"$TIP\" = \"$(cat $D/validated_base 2>/dev/null)\" ]; then ADMIN=--admin; continue; fi
        WHY=\"the branch is behind $B, and $B moved after the validation\"
        break
      fi
      grep -q 'Base branch was modified' $D/merge_$N.out || break
      sleep ${DEP_RETRY_WAIT:-10}
    done
    if [ $OK = 1 ]; then
      if [ -n \"$ADMIN\" ]; then record merged \"merged with --admin: behind $B, validated on $(cut -c1-12 $D/validated_base)\"; else record merged \"\"; fi
    else
      [ -n \"$WHY\" ] || WHY=$(grep -v '^[[:space:]]*$' $D/merge_$N.out | head -n 1 | cut -c1-300)
      record merge_failed \"$WHY\"
    fi
  fi
fi
rm -f $D/stopped_at
jq -cn '{context_updates: {}}'"]

    // Groups the open alerts that have a patched version (C4), drops the ones a PR merged in this run
    // fixed, and ranks the rest by D16. It walks the ranking and takes the first group the tracking-issue
    // rules (C6, D22) do not skip. A group with a switch_off PR is dropped, since that PR will merge. A group
    // whose package a Dependabot PR merged in this run updated (same ecosystem and directory) is skipped for the
    // day even when C3 matched none of its alerts: jelly-swipe #450's title named 2.1.7, so it matched alert 70
    // only, but it also moved the 5.x copy past alert 69, and the patch agent then found nothing to do.
    // The issue lookup is by the marker on the first line, over every `security` issue; `startswith` is exact
    // because the marker ends in ` -->`. It does not use `--search`: the search index lags a new issue, and a
    // miss files a duplicate tracking issue. Publishes patch_group (a key or `none`) and writes group.json or skipped_groups.json.
    pick_group [label="pick_group", shape=parallelogram, timeout="5m", output_schema="routing",
        script="D=/tmp/fabro/dep
cat > $D/pick.jq <<'JQ'
include \"version\";
def sevrank: {\"critical\": 0, \"high\": 1, \"medium\": 2, \"low\": 3}[.] // 4;
def scoperank: if . == \"runtime\" then 0 else 1 end;
def adir: if test(\"/\") then (split(\"/\") | .[:-1] | join(\"/\")) else \"\" end;
$results[0] as $res
| $prs[0] as $pl
| ([$res[] | select(.outcome == \"merged\") | .fixes[]]) as $merged
| ([$res[] | select(.outcome == \"switch_off\") | .fixes[]]) as $held
| ([$res[] | select(.outcome == \"merged\") | .pr]) as $mprs
| ([$pl[] | select(.number as $n | $mprs | index($n)) | .updates[]?]) as $mup
| [$alerts[0][] | select(.first_patched != null) | select(.number as $n | ([$merged[] | select(. == $n)] | length) == 0)] as $live
| [$live | group_by([.ecosystem, .manifest, .package])[]
   | . as $g
   | {
       key: ($g[0].ecosystem + \":\" + $g[0].manifest + \":\" + $g[0].package),
       ecosystem: $g[0].ecosystem, manifest: $g[0].manifest, package: $g[0].package,
       severity: (min_by(.severity | sevrank) | .severity),
       scope: (if any($g[]; .scope == \"runtime\") then \"runtime\" else $g[0].scope end),
       alerts: ($g | map(.number) | sort),
       first_patched: ($g | map(.first_patched) | reduce .[] as $v (null; if . == null then $v elif vcmp($v; .) > 0 then $v else . end)),
       created: ($g | map(.created_at) | min),
       touched: any($mup[]; (.package | ascii_downcase) == ($g[0].package | ascii_downcase) and .eco == $g[0].ecosystem and .dir == ($g[0].manifest | adir)),
       held: ([$g[] | .number as $n | select(([$held[] | select(. == $n)] | length) > 0)] | length > 0),
       replaces: [$pl[] as $p
                  | select(([$p.fixes[] as $f | select(([$g[] | select(.number == $f)] | length) > 0)] | length) > 0)
                  | select((([$res[] | select(.pr == $p.number and (.outcome == \"merged\" or .outcome == \"switch_off\"))] | length) == 0))
                  | $p.number]
     }
   | select(.held | not)
   | del(.held)
  ]
| sort_by([(.severity | sevrank), (.scope | scoperank), (-(.alerts | length)), .created])
| map(del(.created))
JQ
echo pick_group > /tmp/fabro/dep/stopped_at
stop() { printf '%s' \"$1\" > /tmp/fabro/dep/stop_reason; echo \"$1\" >&2; exit 1; }
D=/tmp/fabro/dep
rm -f /tmp/fabro/review_merge_outcome $D/skipped_groups.json
jq -c '[.[] | select(.first_patched == null)]' $D/alerts.json > $D/no_patch.json
jq -n -L $D --slurpfile alerts $D/alerts.json --slurpfile prs $D/prs.json --slurpfile results $D/results.json -f $D/pick.jq > $D/ranked.json || stop 'pick_group: could not rank the groups'
: > $D/skipped.lines
NOW=$(date +%s)
CHOSEN=none
jq -c '.[]' $D/ranked.json > $D/ranked.lines
while IFS= read -r G; do
  KEY=$(printf '%s' \"$G\" | jq -r .key)
  if [ \"$(printf '%s' \"$G\" | jq -r .touched)\" = true ]; then
    jq -cn --arg k \"$KEY\" '{key: $k, reason: \"a Dependabot PR merged in this run updated it; Dependabot rescans first\"}' >> $D/skipped.lines; continue
  fi
  gh issue list --state all --label security --limit 500 --json number,state,stateReason,closedAt,labels,body > $D/issues.json || stop 'pick_group: could not list the tracking issues'
  ISSUE=$(jq -c --arg m \"<!-- fabro:dep-group key=$KEY -->\" '[.[] | select((.body // \"\") | startswith($m))] | .[0] // null' $D/issues.json)
  if [ \"$ISSUE\" = null ]; then
    CHOSEN=$KEY; NUM=0; break
  fi
  NUM=$(printf '%s' \"$ISSUE\" | jq -r .number)
  ST=$(printf '%s' \"$ISSUE\" | jq -r .state)
  SR=$(printf '%s' \"$ISSUE\" | jq -r '.stateReason // \"\"')
  CA=$(printf '%s' \"$ISSUE\" | jq -r '.closedAt // \"\"')
  if [ \"$ST\" = OPEN ]; then
    if printf '%s' \"$ISSUE\" | jq -e 'any(.labels[]; .name == \"needs-human\")' >/dev/null; then
      jq -cn --arg k \"$KEY\" '{key: $k, reason: \"its tracking issue has needs-human\"}' >> $D/skipped.lines; continue
    fi
    if printf '%s' \"$ISSUE\" | jq -e 'any(.labels[]; .name == \"Review\")' >/dev/null; then
      gh pr list --state open --json number,closingIssuesReferences > $D/open_prs.json || stop 'pick_group: could not list the open PRs'
      if jq -e --argjson n \"$NUM\" 'any(.[]; any(.closingIssuesReferences[]?; .number == $n))' $D/open_prs.json >/dev/null; then
        jq -cn --arg k \"$KEY\" '{key: $k, reason: \"its patch PR is open\"}' >> $D/skipped.lines; continue
      fi
      gh issue edit \"$NUM\" --remove-label Review >/dev/null 2>&1 || true
    fi
    CHOSEN=$KEY; break
  fi
  if [ \"$SR\" = COMPLETED ] && [ -n \"$CA\" ]; then
    CLOSED=$(jq -rn --arg t \"$CA\" '$t | fromdateiso8601')
    if [ $((NOW - CLOSED)) -lt 259200 ]; then
      jq -cn --arg k \"$KEY\" '{key: $k, reason: \"its tracking issue closed completed less than 3 days ago\"}' >> $D/skipped.lines; continue
    fi
    LIST=$(printf '%s' \"$G\" | jq -r '.alerts | map(\"#\" + tostring) | join(\", \")')
    gh issue reopen \"$NUM\" >/dev/null 2>&1 || true
    gh issue edit \"$NUM\" --add-label needs-human >/dev/null 2>&1 || true
    gh issue comment \"$NUM\" --body \"The patch for this group merged on $CA, but alerts $LIST are still open after 3 days. A human should check whether the fix reached the lockfile.\" >/dev/null 2>&1 || true
    jq -cn --arg k \"$KEY\" '{key: $k, reason: \"its patch merged more than 3 days ago and the alerts are still open; the issue was reopened with needs-human\"}' >> $D/skipped.lines
    continue
  fi
  CHOSEN=$KEY; break
done < $D/ranked.lines
if [ \"$CHOSEN\" = none ]; then
  jq -s '.' $D/skipped.lines > $D/skipped_groups.json
  rm -f $D/stopped_at
  jq -cn '{context_updates: {patch_group: \"none\"}}'
  exit 0
fi
jq -c --arg k \"$CHOSEN\" --argjson n \"$NUM\" '[.[] | select(.key == $k)] | .[0] + {issue: $n} | del(.touched)' $D/ranked.json > $D/group.json
jq -s '.' $D/skipped.lines > $D/skipped_groups.json
rm -f $D/stopped_at
jq -cn --arg k \"$CHOSEN\" '{context_updates: {patch_group: $k}}'"]

    // Finds or files the tracking issue for the chosen group (C6). The body is rendered from the alert
    // records. An issue closed as completed is reopened here only when the group was chosen anyway (a
    // closed-not-planned issue, for example). The group_alerts.json file is the patch's input (task 06).
    // A failure to file exits 1: a patch with no issue cannot pass merge_gate.
    track_issue [label="track_issue", shape=parallelogram, output_schema="routing", timeout="5m",
        script="echo track_issue > /tmp/fabro/dep/stopped_at
stop() { printf '%s' \"$1\" > /tmp/fabro/dep/stop_reason; echo \"$1\" >&2; exit 1; }
D=/tmp/fabro/dep
KEY=$(jq -r .key $D/group.json)
PKG=$(jq -r .package $D/group.json)
MAN=$(jq -r .manifest $D/group.json)
NUM=$(jq -r .issue $D/group.json)
gh label create security --color d73a4a --description \"Security vulnerability alert\" >/dev/null 2>&1 || true
gh label create dependencies --color 0366d6 --description \"Pull requests that update a dependency file\" >/dev/null 2>&1 || true
gh label create ai-generated --color bf0f66 >/dev/null 2>&1 || true
gh label create needs-human --color d93f0b --description \"A human must look before the run continues\" >/dev/null 2>&1 || true
gh label create Review --color 0e8a16 --description \"Agent produced a review-ready branch; open a PR.\" >/dev/null 2>&1 || true
jq -r '.alerts | join(\",\")' $D/group.json > $D/group_numbers.txt
jq --argjson nums \"[$(cat $D/group_numbers.txt)]\" '[.[] | select(.number as $n | $nums | index($n))]' $D/alerts_raw.json > $D/group_alerts.json
jq -r -n --arg key \"$KEY\" --arg pkg \"$PKG\" --arg man \"$MAN\" --slurpfile g $D/group.json --slurpfile ra $D/alerts_raw.json --slurpfile pr $D/prs.json '
  ($g[0].alerts) as $nums
  | ($ra[0] | map(select(.number as $n | $nums | index($n)))) as $al
  | \"<!-- fabro:dep-group key=\" + $key + \" -->\",
    \"> Filed by the daily dependabot run (fabro-workflows ADR 0022).\",
    \"\",
    (\"Patch `\" + $pkg + \"` in `\" + $man + \"` for the open security alerts below. The patch PR says `Resolves #N` for this issue.\"),
    \"\",
    \"| Alert | Severity | Scope | Vulnerable | First patched | Advisory |\",
    \"|---|---|---|---|---|---|\",
    ($al | sort_by(.number) | .[] | \"| [#\" + (.number | tostring) + \"](\" + .html_url + \") | \" + .security_advisory.severity + \" | \" + (.dependency.scope // \"unknown\") + \" | \" + (.security_vulnerability.vulnerable_version_range // \"\") + \" | \" + (.security_vulnerability.first_patched_version.identifier // \"\") + \" | \" + .security_advisory.ghsa_id + (if .security_advisory.cve_id then \" / \" + .security_advisory.cve_id else \"\" end) + \" |\"),
    (if ($g[0].replaces | length) > 0 then \"\", \"Replaces:\", ($g[0].replaces[] as $r | ($pr[0] | map(select(.number == $r)) | .[0].url) as $u | \"- [#\" + ($r | tostring) + \"](\" + $u + \")\") else empty end)
' > $D/issue_body.md
TITLE=$(jq -rn --arg p \"$PKG\" --arg m \"$MAN\" 'def ttl($p; $m; $lim): (\"fix(deps): patch \" + $p + \" security alerts\") as $h | [$h + \" in \" + $m, $h + \" in \" + ($m | split(\"/\") | last), $h] | map(select(length <= $lim)) | .[0] // ((\"fix(deps): patch \" + $p) | .[0:$lim]); ttl($p; $m; 72)')
if [ \"$NUM\" = 0 ]; then
  URL=$(gh issue create --title \"$TITLE\" --body-file $D/issue_body.md --label security --label dependencies --label ai-generated) || stop 'track_issue: could not file the tracking issue'
  NUM=${URL##*/}
else
  gh issue edit \"$NUM\" --body-file $D/issue_body.md >/dev/null || stop 'track_issue: could not update the tracking issue'
  if [ \"$(gh issue view \"$NUM\" --json state --jq .state)\" = CLOSED ]; then gh issue reopen \"$NUM\" >/dev/null 2>&1 || true; fi
fi
jq --argjson n \"$NUM\" '. + {issue: $n}' $D/group.json > $D/group.tmp && mv $D/group.tmp $D/group.json
gh issue view \"$NUM\" --json number,title,body,labels,url,state > /tmp/fabro/issue.json
rm -f $D/stopped_at
jq -cn --argjson n \"$NUM\" '{context_updates: {issue_number: $n}}'"]

    // Merges origin/<base> into the run branch before the patch starts (D21), so the patch sees the
    // Dependabot PRs this run merged. The run branch holds only empty checkpoint commits, so the merge
    // should not conflict; if it does, merge --abort and exit 1, and a human looks. It records the
    // resulting HEAD in sync_base_sha for patch_gate (task 06).
    sync_base [label="sync_base", shape=parallelogram, timeout="5m",
        script="echo sync_base > /tmp/fabro/dep/stopped_at
stop() { printf '%s' \"$1\" > /tmp/fabro/dep/stop_reason; echo \"$1\" >&2; exit 1; }
D=/tmp/fabro/dep
B=$(cat /tmp/fabro/base_ref)
git fetch -q origin \"$B\" || stop 'sync_base: could not fetch the base'
if ! git -c user.email=noreply@fabro.sh -c user.name=fabro-dependabot merge -q --no-edit \"origin/$B\" >/dev/null 2>&1; then
  git merge --abort >/dev/null 2>&1
  stop 'sync_base: the run branch conflicts with the base; that should not happen (it holds only checkpoints). A human should look.'
fi
git rev-parse HEAD > $D/sync_base_sha
if [ \"$(git symbolic-ref --short HEAD)\" != \"$(cat $D/run_branch)\" ] || [ -n \"$(git status --porcelain)\" ]; then
  stop 'sync_base: the checkout is not clean on the run branch'
fi
rm -f $D/stopped_at
echo synced"]

    // Counts the patch loop's visits (at most 3: one attempt and two repairs, from the gate or from
    // validation). The first visit of the run clears the feedback; every visit clears the contract, so the
    // gate never reads an earlier attempt (invariants-graph, Routing and contracts).
    patch_prep [label="Count the patch attempt", shape=parallelogram, timeout="2m",
        script="echo patch_prep > /tmp/fabro/dep/stopped_at
D=/tmp/fabro/dep
if [ ! -f $D/patch_visits ]; then
  echo 0 > $D/patch_visits
  rm -f $D/patch_feedback.md
fi
rm -f $D/patch.json
echo $(($(cat $D/patch_visits) + 1)) > $D/patch_visits
rm -f $D/stopped_at
echo ready"]

    // The one agent that writes code in this package (ADR 0022 D1, D6). It runs on glm-5.3-flash, which the
    // `.dep-patch` class sets (D14). Its timeout is unmeasured: task 10 records the first real durations. Its
    // inputs and output are the Stage manifest's `patch` entry, and it has no git exception (rule 3).
    patch [label="Patch the alert group", class="dep-patch", timeout="45m", max_retries=1, prompt="@prompts/patch.md.j2"]

    // The receipt check (the scan_gate pattern), then the contract's cross-field rules: blocked needs a blocker
    // and no changes; patched needs changes, every `to` at or above first_patched by the module's comparator, a
    // diff against sync_base_sha, and no added lockfile the repository did not have. Below the third visit an
    // invalid contract exits 1 (the repair turn). At the third it publishes patch_status = failed.
    patch_gate [label="Check the patch contract", shape=parallelogram, output_schema="routing", timeout="5m",
        script="echo patch_gate > /tmp/fabro/dep/stopped_at
D=/tmp/fabro/dep
F=$D/patch.json
V=$(jq -r '.visit // empty' /tmp/fabro/.io/stage.json 2>/dev/null)
RV=$(jq -r '._io.visit // empty' $F 2>/dev/null)
A=$(cat $D/patch_visits)
OK=no
if [ -n \"$V\" ] && [ \"$RV\" = \"$V\" ]; then
  ST=$(jq -r '.status // \"\"' $F)
  NCH=$(jq '.changes | length' $F)
  BLK=$(jq -r '.blocker // \"\"' $F)
  if [ \"$ST\" = blocked ]; then
    if [ -n \"$BLK\" ] && [ \"$NCH\" = 0 ]; then OK=yes; fi
  elif [ \"$ST\" = patched ] && [ \"$NCH\" -ge 1 ]; then
    FP=$(jq -r .first_patched $D/group.json)
    LOW=$(jq -n -L $D --arg fp \"$FP\" --slurpfile c $F 'include \"version\"; [$c[0].changes[] | select(vcmp(.to; $fp) < 0)] | length')
    SB=$(cat $D/sync_base_sha)
    ADDED=$(git diff --name-only --diff-filter=A \"$SB\" HEAD | grep -E '(^|/)(package-lock[.]json|yarn[.]lock|pnpm-lock[.]yaml|bun[.]lockb|bun[.]lock|uv[.]lock|poetry[.]lock|Cargo[.]lock)$' || true)
    if [ \"$LOW\" = 0 ] && [ -z \"$ADDED\" ] && ! git diff --quiet \"$SB\" HEAD; then OK=yes; fi
  fi
fi
if [ \"$OK\" = yes ]; then
  ST=$(jq -r .status $F)
  rm -f $D/stopped_at
  jq -cn --arg s \"$ST\" '{context_updates: {patch_status: $s}}'
  exit 0
fi
if [ \"$A\" -lt 3 ]; then
  echo 'patch_gate: patch.json is missing or invalid; submit the contract again' >&2
  exit 1
fi
rm -f $D/stopped_at
echo failed > $D/patch_status
jq -cn '{context_updates: {patch_status: \"failed\"}}'"]

    // The repository's own gate on the run branch (D25): setup.sh and ci.sh under an inner timeout. Green goes
    // on to the pull request. Red goes back to the agent with the log tail, up to the third visit, and then to
    // patch_blocked. patch_retry says which: the two red edges are mutually exclusive.
    patch_validate [label="Validate the patch", shape=parallelogram, output_schema="routing", timeout="20m",
        script="echo patch_validate > /tmp/fabro/dep/stopped_at
D=/tmp/fabro/dep
A=$(cat $D/patch_visits)
timeout 1020 sh -c './.fabro/setup.sh && ./.fabro/ci.sh' > $D/patch_validate.log 2>&1
RC=$?
rm -f $D/stopped_at
if [ \"$RC\" = 0 ]; then
  rm -f $D/patch_feedback.md
  jq -cn '{context_updates: {patch_ci: \"green\", patch_retry: \"no\"}}'
  exit 0
fi
tail -c 6000 $D/patch_validate.log > $D/patch_feedback.md
if [ \"$A\" -lt 3 ]; then
  jq -cn '{context_updates: {patch_ci: \"red\", patch_retry: \"yes\"}}'
else
  echo failed > $D/patch_status
  jq -cn '{context_updates: {patch_ci: \"red\", patch_retry: \"no\"}}'
fi"]

    // A blocked or failed patch never opens a pull request. The tracking issue gets the blocker, or the last
    // validation log tail, and needs-human. Every gh call is `|| true`, so a failure here cannot fail the run.
    patch_blocked [label="Report the blocked patch", shape=parallelogram, timeout="5m",
        script="echo patch_blocked > /tmp/fabro/dep/stopped_at
D=/tmp/fabro/dep
ISSUE=$(jq -r '.issue // 0' $D/group.json 2>/dev/null || echo 0)
{
  if [ -f $D/patch.json ] && [ \"$(jq -r '.status // \"\"' $D/patch.json)\" = blocked ]; then
    echo 'The patch for this group is blocked. A human should act on this:'
    echo ''
    jq -r '.blocker' $D/patch.json
  else
    echo 'The patch for this group did not pass validation after three attempts. The last log tail:'
    echo ''
    echo '```'
    tail -c 3000 $D/patch_validate.log 2>/dev/null
    echo '```'
  fi
} > $D/patch_blocked.md 2>/dev/null
if [ \"$ISSUE\" != 0 ]; then
  gh issue comment \"$ISSUE\" --body-file $D/patch_blocked.md >/dev/null 2>&1 || true
  gh issue edit \"$ISSUE\" --add-label needs-human >/dev/null 2>&1 || true
fi
rm -f $D/stopped_at
echo blocked"]

    // The patch PR (ADR 0022 D5, D6). The subject is `fix:`, deliberately: release-please cuts a patch release
    // for a security fix on jelly-swipe and lawncare-saas, which is right. The commit body's marker block holds
    // `Resolves #N`, which GitHub reads, and the shared phase reads `linked_issues.json` from the link.
    open_pr [label="Push and open the patch PR", shape=parallelogram, output_schema="routing", timeout="10m",
        script="echo open_pr > /tmp/fabro/dep/stopped_at
stop() { printf '%s' \"$1\" > /tmp/fabro/dep/stop_reason; echo \"$1\" >&2; exit 1; }
set -e
D=/tmp/fabro/dep
PKG=$(jq -r .package $D/group.json)
MAN=$(jq -r .manifest $D/group.json)
N=$(jq -r .issue $D/group.json)
TO=$(jq -r '.changes[0].to // \"\"' $D/patch.json)
jq -rn --arg p \"$PKG\" --arg m \"$MAN\" --argjson n \"$N\" 'def ttl($p; $m; $lim): (\"fix(deps): patch \" + $p + \" security alerts\") as $h | [$h + \" in \" + $m, $h + \" in \" + ($m | split(\"/\") | last), $h] | map(select(length <= $lim)) | .[0] // ((\"fix(deps): patch \" + $p) | .[0:$lim]); (\" (#\" + ($n | tostring) + \")\") as $s | ttl($p; $m; 72 - ($s | length)) + $s' > /tmp/fabro/commit_subject.txt
cp /tmp/fabro/commit_subject.txt /tmp/fabro/pr_title.txt
{ jq -r '.summary' $D/patch.json | cut -c1-500; echo; echo \"Resolves #$N\"; } > /tmp/fabro/commit_body.md
{
  echo '## Summary'
  echo
  echo '<!-- fabro:commit-body:start -->'
  cat /tmp/fabro/commit_body.md
  echo '<!-- fabro:commit-body:end -->'
  echo
  echo '## Alerts'
  echo
  jq -r .body /tmp/fabro/issue.json | grep '^|' || true
  echo
  echo '## Changes'
  echo
  jq -r '.changes[] | \"- \" + .package + \" \" + .from + \" to \" + .to + \" (\" + .manifest + \"; \" + (if .direct then \"direct\" else \"via \" + .parent end) + \")\"' $D/patch.json
  if [ \"$(jq -r .major $D/patch.json)\" = true ]; then echo; echo '**major: true**'; fi
  echo
  echo '## Validation'
  echo
  jq -r '.verification[] | \"- `\" + .command + \"`: \" + .result' $D/patch.json
  echo '- ./.fabro/setup.sh && ./.fabro/ci.sh green before the PR opened'
  if [ \"$(jq '.replaces | length' $D/group.json)\" -gt 0 ]; then
    echo
    echo '## Replaces'
    echo
    jq -r '.replaces[] | \"- #\" + tostring' $D/group.json
  fi
} > /tmp/fabro/pr_body.md
grep -q '^fix(deps): ' /tmp/fabro/commit_subject.txt
grep -q '^Resolves #' /tmp/fabro/commit_body.md
grep -q 'fabro:commit-body:start' /tmp/fabro/pr_body.md
B=$(git rev-parse --abbrev-ref HEAD)
git push -u origin HEAD
R=\"+refs/heads/$B:refs/remotes/origin/$B\"
git config --get-all remote.origin.fetch | grep -qxF \"$R\" || git config --add remote.origin.fetch \"$R\"
git fetch origin \"$R\"
T=$(cat /tmp/fabro/pr_title.txt)
PR_URL=$(gh pr view \"$B\" --json url --jq .url 2>/dev/null || true)
if [ -z \"$PR_URL\" ]; then
  gh pr create --head \"$B\" --title \"$T\" --body-file /tmp/fabro/pr_body.md --label agent-authored --label security --label dependencies
  PR_URL=$(gh pr view \"$B\" --json url --jq .url)
fi
if [ -z \"$PR_URL\" ]; then
  stop \"no PR is visible for head branch $B after create; refusing to report an empty pr_url\"
fi
echo \"$PR_URL\" | sed 's|.*/||' > /tmp/fabro/pr_number
gh issue edit \"$N\" --add-label Review >/dev/null 2>&1 || true
rm -f $D/stopped_at
jq -cn --arg u \"$PR_URL\" '{context_updates: {pr_url: $u}}'"]

    // The contract the shared phase reads (its entry check): pr_number, base_ref, head_ref, pr.json, the linked
    // issues and run_base_sha. The switch is not read again here (prep already wrote auto_merge_repo, and a
    // second read could disagree within one run). No routing schema: it publishes no key, and it routes on its
    // outcome alone. run_base_sha is the merge-base with the base, which after sync_base is the base tip, so the
    // phase's commit list covers the patch only. GitHub links the issue up to about 20 s after the PR opens (S4),
    // so an empty closingIssuesReferences is read again for up to a minute. The phase accepts `[]`, so a PR that
    // still links nothing is reviewed without the issue rather than left unreviewed.
    pr_handoff [label="Hand off to review and merge", shape=parallelogram, timeout="5m",
        script="echo pr_handoff > /tmp/fabro/dep/stopped_at
stop() { printf '%s' \"$1\" > /tmp/fabro/dep/stop_reason; echo \"$1\" >&2; exit 1; }
PR=$(cat /tmp/fabro/pr_number)
i=0
while :; do
  gh pr view \"$PR\" --json number,title,body,url,state,isCrossRepository,headRefName,baseRefName,headRefOid,labels,closingIssuesReferences > /tmp/fabro/pr.json || stop \"pr_handoff: could not read PR #$PR\"
  [ \"$(jq '[.closingIssuesReferences[]?] | length' /tmp/fabro/pr.json)\" -gt 0 ] && break
  i=$((i + 1))
  if [ $i -ge ${DEP_LINK_TRIES:-6} ]; then echo \"pr_handoff: PR #$PR links no issue yet; the review runs without it\" >&2; break; fi
  sleep ${DEP_LINK_WAIT:-10}
done
jq -r .baseRefName /tmp/fabro/pr.json > /tmp/fabro/base_ref
jq -r .headRefName /tmp/fabro/pr.json > /tmp/fabro/head_ref
jq '[.closingIssuesReferences[]?]' /tmp/fabro/pr.json > /tmp/fabro/linked_issues.json
B=$(cat /tmp/fabro/base_ref)
git fetch origin \"$B\" 2>/dev/null || true
git merge-base origin/\"$B\" HEAD > /tmp/fabro/run_base_sha 2>/dev/null || git rev-parse HEAD > /tmp/fabro/run_base_sha
rm -f /tmp/fabro/dep/stopped_at
echo handoff ready"]

    // The shared review-and-merge phase, spliced unchanged (ADR 0022 D1). Its gates, Refuter, hygiene and merge
    // gate are the ones every agent change gets. Its report hooks are below.
    review_merge [import="../_shared/review-merge/review-merge.fabro"]

    // Reads the phase's outcome file. merged: close the Dependabot PRs this patch replaces, each with a comment.
    // Anything else, or a missing file (the phase failed before it reported): label the tracking issue
    // needs-human, so the next run skips the group (D16). It always exits 0.
    after_merge [label="Close superseded PRs or label the issue", shape=parallelogram, timeout="5m",
        script="echo after_merge > /tmp/fabro/dep/stopped_at
D=/tmp/fabro/dep
OUT=$(cat /tmp/fabro/review_merge_outcome 2>/dev/null || echo needs_human)
ISSUE=$(jq -r .issue $D/group.json 2>/dev/null || echo 0)
PR=$(cat /tmp/fabro/pr_number 2>/dev/null || echo '')
PKG=$(jq -r .package $D/group.json 2>/dev/null || echo '')
if [ \"$OUT\" = merged ]; then
  TO=$(jq -r '.changes[0].to // \"\"' $D/patch.json 2>/dev/null || echo '')
  for P in $(jq -r '.replaces[]?' $D/group.json 2>/dev/null); do
    gh pr close \"$P\" --comment \"Superseded by #$PR, which patched $PKG to $TO and merged. Closing on behalf of the daily dependabot run (ADR 0022 D4).\" >/dev/null 2>&1 || true
  done
else
  R=$(cat /tmp/fabro/merge_block_reason 2>/dev/null || cat /tmp/fabro/needs_human_reason 2>/dev/null || echo 'the review phase failed before it reported')
  R=$(printf '%s' \"$R\" | cut -c1-300)
  if [ \"$ISSUE\" != 0 ]; then
    gh issue edit \"$ISSUE\" --add-label needs-human >/dev/null 2>&1 || true
    gh issue comment \"$ISSUE\" --body \"The patch PR ${PR:+#$PR }was not auto-merged: $R\" >/dev/null 2>&1 || true
  fi
fi
rm -f $D/stopped_at
exit 0"]

    // Builds the one-line summary from the files that exist, and always exits 0 (D24).
    // Task 08 gives it its final form.
    summarize [label="Summarize the run", shape=parallelogram, output_schema="routing", timeout="2m",
        script="D=/tmp/fabro/dep
R=$(jq -r .nameWithOwner $D/repo.json 2>/dev/null || echo unknown)
A=$(jq length $D/alerts.json 2>/dev/null || echo 0)
P=$(jq length $D/prs.json 2>/dev/null || echo 0)
S=$(cat $D/stopped_at 2>/dev/null || echo '')
PARTS=''
add() { [ -n \"$1\" ] || return 0; if [ -n \"$PARTS\" ]; then PARTS=\"$PARTS | $1\"; else PARTS=\"$1\"; fi; }
if [ \"$A\" = 0 ] && [ \"$P\" = 0 ] && [ -z \"$S\" ]; then
  add \"Nothing to do: 0 alerts open, 0 Dependabot PRs open.\"
else
  if [ \"$P\" != 0 ]; then
    NM=$(jq '[.[] | select(.outcome == \"merged\")] | length' $D/results.json 2>/dev/null || echo 0)
    MG=$(jq -r '[.[] | select(.outcome == \"merged\") | \"#\" + (.pr | tostring)] | join(\" \")' $D/results.json 2>/dev/null)
    OT=$(jq -r '[.[] | select(.outcome != \"merged\") | \"#\" + (.pr | tostring) + \" \" + (if .outcome == \"conflict\" then \"conflict, rebase requested\" else .outcome + (if (.reason // \"\") != \"\" then \" (\" + (.reason | .[0:60]) + \")\" else \"\" end) end)] | join(\"; \")' $D/results.json 2>/dev/null)
    LINE=\"PRs: merged $NM of $P\"
    [ -n \"$MG\" ] && LINE=\"$LINE ($MG)\"
    [ -n \"$OT\" ] && LINE=\"$LINE; $OT\"
    add \"$LINE\"
  fi
  if [ -f $D/group.json ]; then
    PK=$(jq -r '.package + \" in \" + .manifest + \" (\" + ((.alerts | length) | tostring) + \" alerts)\"' $D/group.json)
    PN=$(cat /tmp/fabro/pr_number 2>/dev/null || echo '')
    RO=$(cat /tmp/fabro/review_merge_outcome 2>/dev/null || echo '')
    PS=$(jq -r '.status // \"\"' $D/patch.json 2>/dev/null || echo '')
    if [ -n \"$PN\" ]; then add \"Patch: $PK -> #$PN, ${RO:-not reported}\"
    elif [ \"$PS\" = blocked ]; then add \"Patch: $PK blocked: $(jq -r '.blocker // \"\"' $D/patch.json | cut -c1-80)\"
    elif [ \"$(cat $D/patch_status 2>/dev/null)\" = failed ]; then add \"Patch: $PK red after 3 attempts\"
    else add \"Patch: $PK not opened\"; fi
  elif [ -z \"$S\" ]; then
    add \"Patch: no group to patch\"
  fi
  NP=$(jq length $D/no_patch.json 2>/dev/null || echo 0)
  NPL=$(jq -r '[.[] | \"#\" + (.number | tostring)] | join(\" \")' $D/no_patch.json 2>/dev/null)
  SK=$(jq -r '[.[] | .key + \": \" + .reason] | join(\"; \")' $D/skipped_groups.json 2>/dev/null)
  LEFT=\"\"
  [ \"$NP\" != 0 ] && LEFT=\"$NP alerts with no patched version ($NPL)\"
  if [ -n \"$SK\" ]; then
    [ -n \"$LEFT\" ] && LEFT=\"$LEFT; \"
    NS=$(jq length $D/skipped_groups.json); W=groups; [ \"$NS\" = 1 ] && W=group; LEFT=\"$LEFT$NS $W skipped ($SK)\"
  fi
  [ -n \"$LEFT\" ] && add \"Left: $LEFT\"
  if [ -n \"$S\" ]; then add \"Stopped at $S: $(cat $D/stop_reason 2>/dev/null || echo 'no reason recorded')\"; fi
fi
BS=$(awk 'BEGIN{printf \"%c\", 92}')
SUM=$(printf '%s' \"$PARTS\" | tr -d '\"{}' | tr -d \"$BS\" | head -c 1500)
echo \"$SUM\" | awk 'BEGIN{RS=\" [|] \"} {print}'
jq -cn --arg m \"$SUM\" --arg s \"$S\" '{context_updates: {dep_summary: $m, stopped_at: $s}}'
exit 0"]

    // The target of the summary hook (task 08). Exists here so the hook has a stage to fire on.
    finish [label="Finish", shape=parallelogram, timeout="1m", script="echo done"]

    start -> prep
    prep -> inventory                 [condition="outcome=succeeded"]
    prep -> summarize
    inventory -> dep_next             [condition="outcome=succeeded && context.dep_pr_count!=0"]
    inventory -> pick_group           [condition="outcome=succeeded && context.dep_pr_count=0"]
    inventory -> summarize
    dep_next -> dep_checks            [condition="outcome=succeeded && context.dep_pr_next=yes"]
    dep_next -> pick_group            [condition="outcome=succeeded && context.dep_pr_next=no"]
    dep_next -> summarize
    dep_checks -> dep_validate        [condition="outcome=succeeded && context.dep_checks=green"]
    dep_checks -> dep_merge           [condition="outcome=succeeded && context.dep_checks!=green"]
    dep_checks -> summarize
    dep_validate -> dep_merge         [condition="outcome=succeeded"]
    dep_validate -> summarize
    dep_merge -> dep_next             [condition="outcome=succeeded"]
    dep_merge -> summarize
    pick_group -> track_issue         [condition="outcome=succeeded && context.patch_group!=none"]
    pick_group -> summarize           [condition="outcome=succeeded && context.patch_group=none"]
    pick_group -> summarize
    track_issue -> sync_base          [condition="outcome=succeeded"]
    track_issue -> summarize
    sync_base -> patch_prep           [condition="outcome=succeeded"]
    sync_base -> summarize
    patch_prep -> patch               [condition="outcome=succeeded"]
    patch_prep -> summarize
    patch -> patch_gate               [condition="outcome=succeeded"]
    patch -> patch_blocked
    patch_gate -> patch_prep          [condition="outcome=failed"]
    patch_gate -> patch_validate      [condition="outcome=succeeded && context.patch_status=patched"]
    patch_gate -> patch_blocked       [condition="outcome=succeeded && context.patch_status!=patched"]
    patch_gate -> patch_blocked
    patch_validate -> open_pr         [condition="outcome=succeeded && context.patch_ci=green"]
    patch_validate -> patch_prep      [condition="outcome=succeeded && context.patch_ci=red && context.patch_retry=yes"]
    patch_validate -> patch_blocked   [condition="outcome=succeeded && context.patch_ci=red && context.patch_retry=no"]
    patch_validate -> patch_blocked
    open_pr -> pr_handoff             [condition="outcome=succeeded"]
    open_pr -> summarize
    pr_handoff -> review_merge        [condition="outcome=succeeded"]
    pr_handoff -> summarize
    review_merge -> after_merge
    after_merge -> summarize
    patch_blocked -> summarize
    summarize -> finish               [condition="outcome=succeeded"]
    summarize -> finish
    finish -> exit
}
